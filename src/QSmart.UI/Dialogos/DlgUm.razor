@* Escolha de um item (duplo clique ou Aplicar) *@
<Modal Titulo="@Titulo" Texto="@Dica" Classe="lista" AoCancelar="() => Fechar(null)">
    <ChildContent>
        <div class="campo-busca"><Icone Nome="busca" Tamanho="16" /><input class="campo" placeholder="Buscar…" @bind="_busca" @bind:event="oninput" id="dlg-busca" /></div>
        <div class="lista-marcar">
            @foreach (var (v, r) in Opcoes.Where(o => _busca.Trim() == "" || Texto.CaseFold(o.rotulo).Contains(Texto.CaseFold(_busca.Trim()))))
            {
                <div class="item-um @(_atual == v ? "sel" : "")" @onclick="() => _atual = v" @ondblclick="() => Fechar(v)">@r</div>
            }
        </div>
    </ChildContent>
    <Rodape>
        <button class="btn btn-sec" @onclick="@(() => Fechar(""))">@Limpar</button>
        <span class="mola"></span>
        <button class="btn btn-sec" @onclick="() => Fechar(null)">Cancelar</button>
        <button class="btn btn-pri" disabled="@(_atual == null)" @onclick="() => Fechar(_atual)">Aplicar</button>
    </Rodape>
</Modal>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Dica { get; set; } = "";
    [Parameter] public string Limpar { get; set; } = "Limpar escolha";
    [Parameter] public string Atual { get; set; } = "";
    [Parameter] public List<(string valor, string rotulo)> Opcoes { get; set; } = new();
    [Parameter] public Action<object?> Fechar { get; set; } = _ => { };
    string? _atual;
    string _busca = "";
    protected override void OnInitialized() => _atual = Opcoes.Any(o => o.valor == Atual) ? Atual : null;
}
