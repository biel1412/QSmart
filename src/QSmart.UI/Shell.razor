@inherits LayoutComponentBase
@implements IDisposable
@inject Estado E
@inject NavigationManager Rotas

@if (_cadernoPublico != null)
{
    <CadernoPublico Token="@_cadernoPublico" />
}
else if (E.Iniciado && !E.Conta.Logado)
{
    <Acesso />
}
else
{
<div class="app @(E.Prefs.Recolhido ? "recolhido" : "") @(_menuMovel ? "menu-aberto" : "")">
    <aside class="lateral" aria-label="Menu principal">
        <div class="marca">
            <a href="" class="marca-link" title="Início" @onclick="FecharMovel"><Logo Tamanho="36" /></a>
            <div class="marca-txt"><span class="marca-nome"><b>Q</b>Smart</span><span class="marca-emp">by Insi</span></div>
        </div>
        <button class="item recolher" @onclick="E.AlternarMenu" title="@(E.Prefs.Recolhido ? "Expandir menu" : "Recolher menu")">
            <Icone Nome="@(E.Prefs.Recolhido ? "expandir" : "recolher")" />
            <span class="item-txt">Recolher menu</span>
        </button>
        <nav class="menu">
            <NavLink class="item m-inicio" href="" Match="NavLinkMatch.All" title="Início" @onclick="FecharMovel">
                <Icone Nome="inicio" /><span class="item-txt">Início</span>
            </NavLink>
            @foreach (var g in Abas.Grupos)
            {
                var itens = Abas.Todas.Where(a => a.Grupo == g && E.AbaAtiva(a.Chave)).ToList();
                if (itens.Count == 0) continue;
                <div class="grupo">@g</div>
                @foreach (var a in itens)
                {
                    if (a.Externo)
                    {
                        <a class="@($"item m-{Abas.Cor(a.Grupo)}")" href="@a.Rota" target="_blank" rel="noopener" title="@($"{a.Nome} (abre em nova aba)")" @onclick="FecharMovel">
                            <Icone Nome="@a.Icone" /><span class="item-txt">@a.Menu</span><span class="item-ext"><Icone Nome="externo" Tamanho="13" /></span>
                        </a>
                        continue;
                    }
                    if (PrecisaIA.Contains(a.Chave))
                    {
                        <a class="@($"item m-{Abas.Cor(a.Grupo)} {(Rotas.Uri.Contains("/" + a.Rota) ? "active" : "")}")" href="@a.Rota" title="@a.Nome" @onclick="() => AbrirComIA(a.Rota)" @onclick:preventDefault="true">
                            <Icone Nome="@a.Icone" /><span class="item-txt">@a.Menu</span>
                        </a>
                        continue;
                    }
                    <NavLink class="@($"item m-{Abas.Cor(a.Grupo)}")" href="@a.Rota" title="@a.Nome" @onclick="FecharMovel">
                        <Icone Nome="@a.Icone" /><span class="item-txt">@a.Menu</span>
                        @if (Indicador(a.Chave)) { <span class="ponto" title="Planilha carregada"></span> }
                    </NavLink>
                }
            }
        </nav>
        <div class="lateral-rodape">
            <button class="item" @onclick="E.AlternarTema" title="@(E.Prefs.Tema == "claro" ? "Modo escuro" : "Modo claro")">
                <Icone Nome="@(E.Prefs.Tema == "claro" ? "lua" : "sol")" /><span class="item-txt">@(E.Prefs.Tema == "claro" ? "Modo escuro" : "Modo claro")</span>
            </button>
            <button class="item" @onclick="Config" title="Configurações">
                <Icone Nome="config" /><span class="item-txt">Configurações</span>
            </button>
            <div class="selo-insi" title="QSmart é um sistema da Insi"><span class="selo-i">Insi</span><span class="item-txt">Sistema da Insi</span></div>
        </div>
    </aside>
    <div class="cortina" @onclick="FecharMovel"></div>

    <div class="principal">
        <div class="topo-movel">
            <button class="btn-icone" @onclick="() => _menuMovel = !_menuMovel" aria-label="Abrir menu"><Icone Nome="menu" /></button>
            <Logo Tamanho="28" /><span class="marca-nome"><b>Q</b>Smart</span>
        </div>
        <div class="progresso @(E.Carregando ? "ativo" : "")"><span></span></div>
        @if (E.Conta.Perfil is { } pf)
        {
            var res = Nivel();
            <div class="topo-dir">
                <a class="td-bt @(NaRota("feed") ? "on" : "")" href="feed" title="Feed do QSmart" @onclick="FecharMovel"><Icone Nome="feed" Tamanho="20" /></a>
                <button class="td-bt @(_sino ? "on" : "")" title="Notificações" @onclick="AbrirSino">
                    <span class="@(E.Sino.Total > 0 ? "td-sino-bal" : "")"><Icone Nome="sino" Tamanho="20" /></span>
                    @if (E.Sino.Total > 0) { <em class="td-num">@(E.Sino.Total > 9 ? "9+" : E.Sino.Total.ToString())</em> }
                </button>
                <a class="conta-canto" href="perfil" title="Meu perfil · @pf.NomeCompleto · nível @res.Nivel" @onclick="FecharMovel">
                    <span class="cc-anel" style="--p:@((int)(res.ProgressoNivel * 100))"></span>
                    <span class="cc-av">@if (pf.Foto != "") { <img src="@pf.Foto" alt="" /> } else { @pf.Iniciais }</span>
                    <span class="cc-nv">@res.Nivel</span>
                </a>
            </div>
            @if (_sino)
            {
                <div class="sino-fundo" @onclick="() => _sino = false"></div>
                <div class="sino-painel">
                    <div class="sino-cab"><b>Notificações</b><a href="feed" @onclick="() => _sino = false">Abrir o Feed</a></div>
                    <div class="sino-lista">
                        @{ var fer = E.Sino.FeriadosProximos; var hoje = DateOnly.FromDateTime(DateTime.Today); }
                        @foreach (var f in fer)
                        {
                            int faltam = f.Data.DayNumber - hoje.DayNumber;
                            <div class="sino-it feriado @(_novosFeriados.Contains(f.Data) ? "nova" : "")">
                                <span class="sino-ic"><Icone Nome="calendario" Tamanho="18" /></span>
                                <div><b>@(faltam == 0 ? "Hoje é feriado" : faltam == 1 ? "Amanhã é feriado" : $"Feriado em {faltam} dias")</b>
                                    <span>@f.Nome · @QSmart.Core.Feriados.DiaCurto(f.Data) @f.Data.ToString("dd/MM")</span></div>
                            </div>
                        }
                        @foreach (var n in E.Sino.Itens)
                        {
                            <a class="sino-it @(n.Lida ? "" : "nova")" href="@($"feed?post={n.PostId}")" @onclick="() => _sino = false">
                                <span class="sino-av" style="background:@CorNome(n.Nome)">@if (n.Foto != "") { <img src="@n.Foto" alt="" /> } else { @IniciaisDe(n.Nome) }
                                    <i class="t-@n.Tipo"><Icone Nome="@(n.Tipo == "curtida" ? "coracao-cheio" : n.Tipo == "post" ? "feed" : "conversa")" Tamanho="10" /></i></span>
                                <div><b>@n.Texto</b>@if (n.Trecho != "") { <span>“@n.Trecho”</span> }<small>@QSmart.UI.Paginas.FeedPag.Quando(n.CriadoEm)</small></div>
                            </a>
                        }
                        @if (fer.Count == 0 && E.Sino.Itens.Count == 0)
                        {
                            <div class="sino-vazio"><Icone Nome="sino" Tamanho="28" /><p>Nada por aqui. Avisamos quando alguém publicar, curtir ou comentar no Feed, e quando tiver feriado chegando.</p></div>
                        }
                    </div>
                </div>
            }
        }
        <main class="conteudo">
            @if (E.Iniciado) { @Body }
        </main>
        <footer class="rodape">
            @foreach (var (nome, arq) in Fontes())
            {
                <span class="fonte" title="@(arq ?? "nenhuma planilha carregada")"><i class="@(arq != null ? "on" : "")">●</i> <b>@nome</b> @(arq == null ? "—" : arq.Length <= 22 ? arq : arq[..21] + "…")</span>
            }
            <span class="mola"></span>
            <span class="fonte"><Icone Nome="escudo" Tamanho="14" /> Arquivos processados só neste computador</span>
            <span class="fonte">@E.UltimoBackupTexto</span>
        </footer>
    </div>
</div>
}
<JanelasHost />
@if (E.Iniciado && E.Conta.Logado) { <MrSmartChat /> }

@code {
    bool _menuMovel;
    // link compartilhado do Smart Note (?caderno=...): abre só a leitura, sem login
    string? _cadernoPublico;
    protected override void OnParametersSet()
    {
        var q = new Uri(Rotas.Uri).Query.TrimStart('?').Split('&').Select(x => x.Split('=', 2)).FirstOrDefault(x => x.Length == 2 && x[0] == "caderno");
        _cadernoPublico = q != null && q[1].Length >= 20 ? Uri.UnescapeDataString(q[1]) : null;
    }
    DotNetObjectReference<Estado>? _ref;

    protected override async Task OnInitializedAsync()
    {
        E.Mudou += Atualizar;
        E.Conta.Mudou += AoMudarConta;
        E.Sino.Mudou += Atualizar;
        Rotas.LocationChanged += AoNavegar;
        await E.Iniciar();
        Proteger();
    }

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (primeira)
        {
            _ref = DotNetObjectReference.Create(E);
            await E.Nav.AoOcultar(_ref);
            await E.Nav.Pronto();
        }
    }

    void AoNavegar(object? s, LocationChangedEventArgs e) { Proteger(); ContarUso(); InvokeAsync(StateHasChanged); }

    /// <summary>Abrir uma aba conta para as medalhas do perfil.</summary>
    void ContarUso()
    {
        var rel = Rotas.ToBaseRelativePath(Rotas.Uri).Split('?', '#')[0].Trim('/');
        if (Abas.Todas.FirstOrDefault(a => a.Rota == rel) is { } aba) _ = E.Conta.Registrar(aba.Chave);
    }

    static readonly string[] ChavesFerramentas = Abas.Todas.Where(a => !a.Externo).Select(a => a.Chave).ToArray();
    QSmart.Core.Conta.ResumoConta Nivel() => QSmart.Core.Conta.Conquistas.Calcular(E.Conta.Uso, E.Conta.Dias, ChavesFerramentas, DateOnly.FromDateTime(DateTime.Today));

    /// <summary>Página de uma aba desativada volta para o início (aplicar_abas do original).</summary>
    void Proteger()
    {
        var rel = Rotas.ToBaseRelativePath(Rotas.Uri).Split('?', '#')[0].Trim('/');
        var aba = Abas.Todas.FirstOrDefault(a => a.Rota == rel);
        if (aba != null && E.Iniciado && !E.AbaAtiva(aba.Chave)) Rotas.NavigateTo("");
    }

    void Atualizar() { InvokeAsync(() => { Proteger(); StateHasChanged(); }); }

    // ---- sininho: busca as notificações a cada minuto enquanto estiver logado ----
    bool _sino;
    HashSet<DateOnly> _novosFeriados = new();
    System.Threading.Timer? _timerSino;
    bool _logadoAntes;
    void AoMudarConta()
    {
        if (E.Conta.Logado && !_logadoAntes) { _logadoAntes = true; _ = E.Sino.Carregar(); _timerSino ??= new System.Threading.Timer(_ => InvokeAsync(E.Sino.Carregar), null, 60000, 60000); }
        else if (!E.Conta.Logado) { _logadoAntes = false; _sino = false; _timerSino?.Dispose(); _timerSino = null; }
        Atualizar();
    }
    async Task AbrirSino()
    {
        _sino = !_sino;
        if (!_sino) return;
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        _novosFeriados = E.Sino.FeriadosNovos > 0 ? E.Sino.FeriadosProximos.Select(f => f.Data).ToHashSet() : new();
        await E.Sino.Carregar();
        await E.Sino.MarcarLidas();
    }
    bool NaRota(string r) => Rotas.ToBaseRelativePath(Rotas.Uri).Split('?', '#')[0].Trim('/') == r;
    static readonly string[] PaletaAv = { "#0EA5E9", "#8B5CF6", "#EC4899", "#F59E0B", "#10B981", "#6366F1", "#14B8A6", "#F97316" };
    static string CorNome(string n) { int h = 0; foreach (var ch in n) h = unchecked(h * 31 + ch); return PaletaAv[(int)((uint)h % PaletaAv.Length)]; }
    static string IniciaisDe(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return (p.Length == 0 ? "?" : p.Length == 1 ? p[0][..1] : $"{p[0][0]}{p[^1][0]}").ToUpperInvariant(); }
    void FecharMovel() => _menuMovel = false;
    static readonly HashSet<string> PrecisaIA = new() { "servicos3069" };
    async Task AbrirComIA(string rota)
    {
        _menuMovel = false;
        if (!await E.IAConfigurada()) { await E.Janelas.Aviso("Contate o suporte", Estado.MsgSemIA); return; }
        Rotas.NavigateTo(rota);
    }

    async Task Config() { _menuMovel = false; await E.Janelas.Configuracoes(); }

    bool Indicador(string chave) => chave switch
    {
        "resumo" or "usuarios" => E.Resultado != null,
        "evolucao" => E.Evolucao != null,
        "historico" => E.Historico.Count > 0,
        "pareceres" => E.ParDf != null,
        "inspecao" => E.IntRes != null,
        "volume" => E.VolComp != null,
        "monitor" => E.MonBase != null,
        "corredor" => E.CorItens.Count > 0 || E.CorPdfs.Count > 0,
        "depurador" => E.DepRes != null,
        "pontos" => E.PtsRes != null,
        "oneaone" => E.OneBase != null,
        _ => false,
    };

    IEnumerable<(string, string?)> Fontes()
    {
        yield return ("Aprovações", E.Resultado?.Arquivo);
        yield return ("Inspeção", E.Evolucao?.Arquivo);
        yield return ("Pareceres", E.ParDf != null ? E.ParArquivo?.Nome : null);
    }

    public void Dispose()
    {
        E.Mudou -= Atualizar;
        E.Conta.Mudou -= AoMudarConta; E.Sino.Mudou -= Atualizar; _timerSino?.Dispose();
        Rotas.LocationChanged -= AoNavegar;
        _ref?.Dispose();
    }
}
