@page "/perfil"
@inject NavigationManager Navegar
@using QSmart.Core.Conta
@using Microsoft.AspNetCore.Components.Forms
@inject Estado E
@inject Janelas J
@implements IDisposable

@if (E.Conta.Perfil is { } p)
{
    var r = Calc();
    <div class="pf">
        <section class="pf-cap">
            <div class="pf-foto">
                <span class="pf-anel" style="--p:@((int)(r.ProgressoNivel * 100))"></span>
                <span class="pf-img">@if (p.Foto != "") { <img src="@p.Foto" alt="Foto de @p.Nome" /> } else { @p.Iniciais }</span>
                <label class="pf-cam" title="Trocar a foto">
                    <InputFile OnChange="TrocarFoto" accept="image/*" />
                    @if (_enviando) { <span class="ia-spin"></span> } else { <Icone Nome="camera" Tamanho="17" /> }
                </label>
                <span class="pf-lv">NÍVEL @r.Nivel</span>
            </div>
            <div class="pf-nm">
                <h1>@p.NomeCompleto</h1>
                <div class="pf-tags">
                    <span>@("@" + p.Usuario)</span>
                    <span class="papel @p.Papel">@p.PapelNome</span>
                    @if (p.Lideranca != "") { <span>Equipe: @p.Lideranca</span> }
                    @if (Desde(p.CriadoEm) is { } d) { <span>no QSmart desde @d</span> }
                </div>
                <div class="pf-xp">
                    <div class="pf-barra"><i style="width:@F(r.ProgressoNivel * 100)%"></i></div>
                    <small><span><b>@r.Titulo</b> · @Num(r.Xp) / @Num(r.XpProximo) XP</span><span>faltam @Num(r.XpProximo - r.Xp) XP para o nível @(r.Nivel + 1)</span></small>
                </div>
            </div>
            <div class="pf-kp">
                <div><b>@r.Seguidos @(r.Seguidos == 1 ? "dia" : "dias")</b><small>seguidos usando</small></div>
                <div><b>@r.Dias</b><small>dias de uso</small></div>
                <div><b>@r.MedalhasGanhas</b><small>medalhas de @r.Medalhas.Count</small></div>
                <div><b>@r.TrofeusGanhos</b><small>troféus de @r.Trofeus.Count</small></div>
            </div>
        </section>

        <div class="pf-sec"><b>Estante de troféus</b><span>sobem de bronze para prata e ouro</span></div>
        <div class="pf-trof">
            @foreach (var t in r.Trofeus)
            {
                <div class="pf-tr @(t.Grau == 0 ? "off" : "")" style="--c:@t.Cor" title="@TituloTrofeu(t)">
                    <span class="pf-tr-g">@t.GrauNome</span>
                    <div class="pf-tr-ic"><Icone Nome="@t.Icone" Tamanho="38" /></div>
                    <b>@t.Nome</b>
                    <small>@t.Valor @t.Como</small>
                    @if (t.ProximaMeta is { } m)
                    {
                        <div class="pf-pb"><i style="width:@F(Math.Min(100, t.Valor * 100.0 / m))%"></i></div>
                        <small class="pf-meta">próximo: @m</small>
                    }
                    else { <small class="pf-meta">nível máximo!</small> }
                </div>
            }
        </div>

        <div class="pf-sec"><b>Medalhas</b><span>@r.MedalhasGanhas de @r.Medalhas.Count · passe o mouse para ver como ganhar</span></div>
        <div class="pf-md">
            @foreach (var m in r.Medalhas.OrderByDescending(m => m.Ganha).ThenByDescending(m => m.Progresso))
            {
                <div class="pf-m @(m.Ganha ? "" : "off")" style="--c:@m.Cor" title="@TituloMedalha(m)">
                    <div class="pf-h"><Icone Nome="@m.Icone" Tamanho="28" /></div>
                    <b>@m.Nome</b>
                    <small>@m.Como</small>
                    @if (!m.Ganha) { <div class="pf-pb"><i style="width:@F(m.Progresso * 100)%"></i></div> }
                </div>
            }
        </div>

        <div class="pf-g2">
            <div class="pf-card">
                <div class="pf-ct"><Icone Nome="cadeado" Tamanho="16" /> TROCAR A SENHA</div>
                <input class="campo" type="password" placeholder="Senha atual" @bind="_atual" autocomplete="current-password" />
                <input class="campo" type="password" placeholder="Nova senha (mínimo 8 caracteres)" @bind="_nova" autocomplete="new-password" />
                <input class="campo" type="password" placeholder="Confirmar a nova senha" @bind="_nova2" autocomplete="new-password" />
                <button class="btn btn-pri" @onclick="TrocarSenha">Trocar a senha</button>
            </div>
            <div class="pf-card">
                <div class="pf-ct"><Icone Nome="escudo" Tamanho="16" /> SUA CONTA</div>
                <p class="muted">A senha é guardada com criptografia de mão única: nem o administrador consegue ler. A cada vez que abrir o QSmart, ela é pedida de novo.</p>
                <p class="muted">Perdeu o código de recuperação? Peça um novo ao administrador.</p>
                <button class="btn btn-sec" @onclick="Sair"><Icone Nome="sair" Tamanho="16" /> Sair do QSmart</button>
            </div>
        </div>

        @if (p.Coordenacao)
        {
            <div class="pf-sec"><b>Base de colaboradores</b><span>cadastrada pelas lideranças · alimenta o One a One e as Férias</span></div>
            <div class="pf-card pf-base">
                <div class="pf-base-ac">
                    <span class="pf-base-ic"><Icone Nome="grade-planilha" Tamanho="26" /></span>
                    <div>
                        <b>A base agora vem das lideranças</b>
                        <p class="muted pequeno">Para não haver duas planilhas brigando, quem carrega a planilha de colaboradores (nome, admissão e nascimento) é cada <b>liderança</b>, em Perfil › Minha equipe.
                            Tudo o que elas cadastram chega aqui na hora, no One a One e nas Férias. A coordenação continua podendo ver, ajustar, transferir e excluir pessoa por pessoa no botão abaixo.</p>
                    </div>
                </div>
                <div class="pf-base-info">
                    @if (_base == null) { <p class="muted pequeno"><span class="ia-spin pequeno"></span> Carregando…</p> }
                    else
                    {
                        <button class="btn btn-sec pf-base-ver" @onclick="AbrirColabs"><Icone Nome="usuarios" Tamanho="15" /> @(_colabsAberto ? "Fechar a lista" : "Ver, adicionar e excluir colaboradores")</button>
                        <div class="pf-base-coords">
                            @foreach (var c in (_base["coordenacoes"] as System.Text.Json.Nodes.JsonArray ?? new()).Where(c => Txt(c, "nome") != ""))
                            {
                                var dono = TxtOuNulo(c, "coordenador");
                                <div class="@(Sim(c, "minha") ? "pf-base-c minha" : "pf-base-c")">
                                    <b>@Txt(c, "nome")</b>
                                    <span>@Num(c, "pessoas") pessoas</span>
                                    @if (dono != null) { <em class="ok"><Icone Nome="check" Tamanho="12" /> @dono</em> }
                                    else { <em class="sem" title="Nenhuma conta de coordenador com esse nome. O administrador pode escrever esse nome no campo Equipe do coordenador, em Equipe e acessos."><Icone Nome="alerta" Tamanho="12" /> sem coordenador</em> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (p.Coordenacao && _colabsAberto)
        {
            var lista = Colabs();
            var lids = (E.OneBase?.Pessoas ?? new()).Select(x => x.Lideranca).Where(x => x != "").Distinct().OrderBy(x => x).ToList();
            <div class="pf-card pf-colabs">
                <div class="pf-colabs-cab">
                    <b>Colaboradores @(p.Admin ? (CoordAdmin() is { } ca ? $"de {ca}" : "de todas as coordenações") : "da sua coordenação")</b>
                    <span class="muted pequeno">@lista.Count pessoa(s) · as mudanças valem na hora no One a One e nas Férias</span>
                    <span class="mola"></span>
                    <input class="campo pf-colabs-busca" placeholder="Buscar…" @bind="_colabBusca" @bind:event="oninput" />
                </div>
                <div class="pf-colab nova">
                    <input class="campo" placeholder="Nome completo" @bind="_novoNome" />
                    <input class="campo" type="date" title="Data de admissão" @bind="_novaAdm" />
                    <input class="campo" placeholder="Liderança" list="pf-lids" @bind="_novaLid" />
                    <button class="btn btn-pri" @onclick="AdicionarColab" disabled="@(string.IsNullOrWhiteSpace(_novoNome))"><Icone Nome="mais" Tamanho="15" /> Adicionar</button>
                </div>
                <datalist id="pf-lids">@foreach (var l in lids) { <option value="@l"></option> }</datalist>
                @if (E.OneBase == null) { <p class="muted pequeno"><span class="ia-spin pequeno"></span> Carregando…</p> }
                @foreach (var x in lista.Where(x => _colabBusca == "" || x.Nome.Contains(_colabBusca, StringComparison.CurrentCultureIgnoreCase)).Take(400))
                {
                    var xx = x;
                    <div class="pf-colab" @key="x.Id">
                        <span class="pf-colab-nome"><b>@x.Nome</b>@if (p.Admin) { <small>@(x.Coordenacao == "" ? "sem coordenação" : x.Coordenacao)</small> }@if (x.Fonte == "lideranca") { <small class="pf-colab-fonte" title="A liderança cadastrou esta pessoa. A planilha da coordenação não sobrescreve os dados dela.">cadastrado pela liderança</small> }</span>
                        <input class="campo" type="date" title="Data de admissão" value="@(x.Admissao?.ToString("yyyy-MM-dd"))" @onchange="e => MudarAdm(xx, e)" />
                        <input class="campo" placeholder="Liderança" list="pf-lids" value="@x.Lideranca" @onchange="e => MudarLid(xx, e)" />
                        <button class="btn btn-sec btn-peq" title="Excluir colaborador" @onclick="() => ExcluirColab(xx)"><Icone Nome="lixo" Tamanho="14" /> Excluir</button>
                    </div>
                }
            </div>
        }

        @if (p.Papel == "lideranca")
        {
            <div class="pf-sec"><b>Minha equipe</b><span>nome, admissão e nascimento · a coordenação já recebe no One a One e nas Férias</span></div>
            <div class="pf-card pf-base">
                <div class="pf-base-ac">
                    <span class="pf-base-ic"><Icone Nome="usuarios" Tamanho="26" /></span>
                    <div>
                        <b>Cadastre seus colaboradores</b>
                        <p class="muted pequeno">Carregue uma planilha com <b>Nome</b>, <b>Data de admissão</b> e <b>Data de nascimento</b> (baixe o modelo; uma coluna Liderança, se houver, é ignorada: todo mundo entra na sua equipe) ou adicione um por um abaixo.
                            Só as lideranças carregam planilha. Quem é da sua equipe e não veio na planilha sai da equipe, com o histórico guardado. No dia do aniversário, administradores, coordenação e lideranças recebem um aviso no sininho.</p>
                        <div class="pf-base-bts">
                            <label class="btn btn-pri @(_lidEnviando ? "disabled" : "")">
                                @if (_lidEnviando) { <span class="ia-spin pequeno"></span> <span>Enviando…</span> } else { <Icone Nome="upload" Tamanho="15" /> <span>Carregar planilha (.xlsx ou .csv)</span> }
                                <InputFile OnChange="CarregarLid" accept=".xlsx,.xlsm,.csv" @key="_chaveLid" disabled="@_lidEnviando" />
                            </label>
                            <button class="btn btn-sec" @onclick="BaixarModeloLid"><Icone Nome="download" Tamanho="15" /> Baixar modelo</button>
                        </div>
                    </div>
                </div>
                <div class="pf-base-info">
                    @if (_lid == null) { <p class="muted pequeno"><span class="ia-spin pequeno"></span> Carregando…</p> }
                    else
                    {
                        <div class="pf-lid-eq">
                            <span class="pf-lid-av">@IniciaisDe(Txt(_lid, "lideranca"))</span>
                            <div><small>SUA EQUIPE</small><b>@Txt(_lid, "lideranca")</b>
                                @if (Txt(_lid, "coordenacao") is { Length: > 0 } co) { <span class="pf-lid-co ok"><Icone Nome="check" Tamanho="12" /> coordenação @co</span> }
                                else { <span class="pf-lid-co sem" title="O administrador liga sua equipe a uma coordenação em Equipe e acessos. Seus cadastros ficam guardados mesmo assim."><Icone Nome="alerta" Tamanho="12" /> ainda sem coordenação</span> }
                            </div>
                            <em>@LidPessoas().Count<small>pessoas</small></em>
                        </div>
                        @if (_lid["ultima"] is System.Text.Json.Nodes.JsonObject ul)
                        {
                            <div class="pf-base-ult">
                                <small>ÚLTIMA PLANILHA</small>
                                <b>@Quando(Txt(ul, "em"))@(Txt(ul, "arquivo") is { Length: > 0 } ar ? $" · {ar}" : "")</b>
                                <span>@(Num(ul, "linhas")) pessoas · @(Num(ul, "novos")) novas · @(Num(ul, "atualizados")) atualizadas · @(Num(ul, "arquivados")) saíram</span>
                                @if (Num(ul, "recusadasN") > 0) { <span class="pf-base-alerta"><Icone Nome="alerta" Tamanho="13" /> @(Num(ul, "recusadasN")) não entraram (são de outra equipe ou coordenação)</span> }
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="pf-card pf-colabs">
                <div class="pf-colabs-cab">
                    <b>Colaboradores da sua equipe</b>
                    <span class="muted pequeno">nome, admissão e nascimento são obrigatórios</span>
                    <span class="mola"></span>
                    <input class="campo pf-colabs-busca" placeholder="Buscar…" @bind="_colabBusca" @bind:event="oninput" />
                </div>
                <div class="pf-colab nova lid rot"><span>Nome completo</span><span>Admissão</span><span>Nascimento</span><span></span></div>
                <div class="pf-colab nova lid">
                    <input class="campo" placeholder="Nome completo" @bind="_novoNome" @bind:event="oninput" />
                    <input class="campo" type="date" title="Data de admissão" @bind="_novaAdm" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <input class="campo" type="date" title="Data de nascimento" @bind="_novoNasc" min="1930-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <button class="btn btn-pri" @onclick="AdicionarLid" disabled="@(string.IsNullOrWhiteSpace(_novoNome) || _novaAdm == null || _novoNasc == null || _lidSalvando)"><Icone Nome="mais" Tamanho="15" /> Adicionar</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_novoNome) && (_novaAdm == null || _novoNasc == null))
                {
                    <small class="pf-lid-falta"><Icone Nome="info" Tamanho="12" /> Falta @(_novaAdm == null && _novoNasc == null ? "a data de admissão e a de nascimento" : _novaAdm == null ? "a data de admissão" : "a data de nascimento").</small>
                }
                @if (LidPessoas().Count(x => Txt(x, "nascimento") == "") is var semNasc && semNasc > 0)
                {
                    <small class="pf-lid-falta"><Icone Nome="alerta" Tamanho="12" /> @semNasc pessoa(s) da equipe ainda sem data de nascimento: complete na lista abaixo.</small>
                }
                @foreach (var x in LidPessoas().Where(x => _colabBusca == "" || Txt(x, "nome").Contains(_colabBusca, StringComparison.CurrentCultureIgnoreCase)))
                {
                    var xx = x; var id = Txt(x, "id");
                    <div class="pf-colab lid" @key="id">
                        <span class="pf-colab-nome"><b>@Txt(x, "nome")</b><small>@(Txt(x, "fonte") == "lideranca" ? "cadastrado por você" : "veio da planilha da coordenação")</small></span>
                        <input class="campo" type="date" title="Data de admissão" value="@Txt(x, "admissao")" @onchange="e => MudarAdmLid(xx, e)" />
                        <input class="campo @(Txt(x, "nascimento") == "" ? "falta" : "")" type="date" title="Data de nascimento" value="@Txt(x, "nascimento")" min="1930-01-01" max="@DateTime.Today.ToString("yyyy-MM-dd")" @onchange="e => MudarNascLid(xx, e)" />
                        <button class="btn btn-sec btn-peq" title="Tirar da sua equipe" @onclick="() => TirarLid(xx)"><Icone Nome="sair" Tamanho="14" /> Tirar</button>
                    </div>
                }
                @if (_lid != null && LidPessoas().Count == 0) { <p class="muted pequeno" style="padding:8px 4px">Ninguém na sua equipe ainda. Carregue a planilha ou adicione acima.</p> }
            </div>
        }

        @if (p.Admin)
        {
            <div class="pf-sec"><b>Tema da plataforma</b><span>layout comemorativo · vale para todo mundo, inclusive na tela de entrada</span></div>
            <div class="pf-card tm-card">
                <div class="tm-opcoes">
                    @foreach (var (k, nome, emoji, desc) in TemasFesta)
                    {
                        var kk = k;
                        var ehNatal = k == "natal";
                        var chave = ehNatal ? NatalVar : k;
                        var emUso = Grupo(E.Festa) == k;
                        <div class="tm-op tm-@(k == "" ? "padrao" : chave) @(Grupo(_temaSel) == k ? "sel" : "")" role="button" tabindex="0" @onclick="() => _temaSel = ehNatal ? NatalVar : kk">
                            <span class="tm-prev"><i></i><i></i><i></i><em>@emoji</em></span>
                            <b>@nome</b>
                            @if (ehNatal)
                            {
                                <span class="tm-var">
                                    <button class="@(NatalVar == "natal" ? "on" : "")" @onclick:stopPropagation="true" @onclick="@(() => { _natalVar = "natal"; _temaSel = "natal"; })">Clássico</button>
                                    <button class="@(NatalVar == "natalsuave" ? "on" : "")" @onclick:stopPropagation="true" @onclick="@(() => { _natalVar = "natalsuave"; _temaSel = "natalsuave"; })">Suave</button>
                                </span>
                                <small>@(NatalVar == "natal" ? "vermelho e verde, neve, pisca-pisca e gorro no logo" : "cores delicadas, bolinhas penduradas e neve leve")</small>
                            }
                            else { <small>@desc</small> }
                            @if (emUso) { <span class="tm-tag">em uso@(ehNatal ? (E.Festa == "natal" ? " · clássico" : " · suave") : "")</span> }
                        </div>
                    }
                </div>
                <div class="tm-pe">
                    @if (_temaSel != "")
                    {
                        <label class="tm-ate">Voltar ao normal sozinho em <input type="date" @bind="_temaAte" min="@DateTime.Today.ToString("yyyy-MM-dd")" /><small>opcional · a partir desse dia volta ao padrão</small></label>
                    }
                    <span class="mola"></span>
                    @if (E.FestaPor != "" && E.FestaEm != "") { <small class="muted">Última troca: @E.FestaPor · @DataFesta(E.FestaEm)</small> }
                    <button class="btn btn-pri" disabled="@(_salvandoTema || (_temaSel == E.Festa && (_temaAte?.ToString("yyyy-MM-dd") ?? "") == E.FestaAte))" @onclick="AplicarTema">
                        <Icone Nome="check" Tamanho="15" /> @(_temaSel == "" ? "Voltar ao padrão para todos" : "Aplicar para todos")</button>
                </div>
            </div>

            <div class="pf-sec"><b>Equipe e acessos</b><span>aprovar cadastros, definir papéis e equipes</span>
                <button class="btn btn-sec pf-rec" @onclick="CarregarUsuarios"><Icone Nome="atualizar" Tamanho="14" /> Atualizar</button></div>
            @if (_usuarios == null) { <p class="muted"><span class="ia-spin pequeno"></span> Carregando…</p> }
            else
            {
                @if (_equipes?.Where(g => g.CoordenadorId == 0).ToList() is { Count: > 0 } soltas)
                {
                    <div class="pf-eq-soltas"><Icone Nome="alerta" Tamanho="15" />
                        <span><b>@soltas.Count equipe(s) sem coordenação</b> (só o administrador vê): @string.Join(", ", soltas.Select(g => $"{(g.Lideranca == "" ? "sem liderança" : g.Lideranca)} ({g.Pessoas})")). Atrele cada uma a um coordenador em “+ equipe”.</span></div>
                }
                <div class="pf-card pf-equipe">
                    <div class="pf-eq-cab"><span>Pessoa</span><span>Papel</span><span>Equipes</span><span>Situação</span><span></span></div>
                    @foreach (var u in _usuarios)
                    {
                        var eu = u.Id == p.Id;
                        <div class="pf-eq-lin @u.Status">
                            <div><b>@u.Nome @u.Sobrenome</b><small>@("@" + u.Usuario)@(u.Ultimo_acesso is { Length: > 9 } ua ? " · último acesso " + Dia(ua) : " · nunca entrou")</small></div>
                            <select class="campo" value="@u.Papel" disabled="@eu" @onchange="e => MudarPapel(u, e.Value?.ToString())">
                                <option value="usuario">Usuário</option><option value="lideranca">Liderança</option>
                                <option value="coordenador">Coordenador</option><option value="admin">Administrador</option>
                            </select>
                            <div class="pf-eqs">
                                @if (u.Papel == "coordenador")
                                {
                                    @foreach (var g in (_equipes ?? new()).Where(g => g.CoordenadorId == u.Id))
                                    {
                                        var gg = g;
                                        bool aberto = _eqMenu == (u.Id, g.Lideranca);
                                        <span class="pf-eq-chip @(aberto ? "on" : "")">
                                            <button class="pf-eq-chip-bt" @onclick="() => _eqMenu = aberto ? null : (u.Id, gg.Lideranca)" title="Mover ou tirar esta equipe"><b>@(g.Lideranca == "" ? "sem liderança" : g.Lideranca)</b> · @g.Pessoas</button>
                                            @if (aberto)
                                            {
                                                <span class="pf-eq-menu">
                                                    <small>Equipe @(g.Lideranca) · @g.Pessoas pessoa(s)</small>
                                                    <select class="campo" value="0" @onchange="e => MoverEquipe(gg, u, e.Value?.ToString())">
                                                        <option value="0">Mover para…</option>
                                                        @foreach (var c in _usuarios!.Where(x => x.Papel == "coordenador" && x.Id != u.Id)) { <option value="@c.Id">@c.Nome @c.Sobrenome</option> }
                                                    </select>
                                                    <button class="btn btn-sec btn-peq" @onclick="() => TirarEquipe(gg, u)">Tirar da coordenação</button>
                                                </span>
                                            }
                                        </span>
                                    }
                                    <select class="campo pf-eq-add" value="" @onchange="e => AdicionarEquipe(u, e.Value?.ToString())" title="Trazer uma equipe para esta coordenação">
                                        <option value="">+ equipe</option>
                                        @if (_lideresSem.Count > 0)
                                        {
                                            <optgroup label="Lideranças com conta, ainda sem equipe">
                                                @foreach (var n in _lideresSem) { <option value="@("L:" + n)">@n (nova equipe)</option> }
                                            </optgroup>
                                        }
                                        <optgroup label="Equipes que já existem">
                                            @foreach (var (g, i) in (_equipes ?? new()).Select((g, i) => (g, i)).Where(t => t.g.CoordenadorId != u.Id))
                                            {
                                                <option value="@i">@(g.Lideranca == "" ? "sem liderança" : g.Lideranca) · @g.Pessoas@(g.CoordenadorId == 0 ? " (sem coordenação)" : $" (hoje: {NomeCoord(g.CoordenadorId)})")</option>
                                            }
                                        </optgroup>
                                    </select>
                                }
                                else if (u.Papel == "lideranca")
                                {
                                    var minhas = (_equipes ?? new()).Where(g => Norm(g.Lideranca) == Norm($"{u.Nome} {u.Sobrenome}")).ToList();
                                    @if (minhas.Count == 0) { <small class="pf-eq-info">Nenhuma equipe com o nome dela na base</small> }
                                    @foreach (var g in minhas) { <small class="pf-eq-info">Equipe de @g.Pessoas pessoa(s) · @(g.CoordenadorId == 0 ? "sem coordenação" : $"coordenação de {NomeCoord(g.CoordenadorId)}")</small> }
                                }
                                else { <small class="pf-eq-info">—</small> }
                            </div>
                            <span class="pf-st @u.Status">@(u.Status switch { "ativo" => "Ativo", "pendente" => "Aguardando aprovação", _ => "Bloqueado" })</span>
                            <div class="pf-eq-ac">
                                @if (u.Status == "pendente") { <button class="btn btn-pri rx-mini" @onclick="() => Status(u, Ativo)">Aprovar</button> }
                                else if (u.Status == "ativo" && !eu) { <button class="btn btn-sec rx-mini" @onclick="() => Status(u, Bloqueado)">Bloquear</button> }
                                else if (u.Status == "bloqueado") { <button class="btn btn-sec rx-mini" @onclick="() => Status(u, Ativo)">Desbloquear</button> }
                                @if (u.Status == "ativo" && !eu) { <button class="btn btn-sec rx-mini" title="Ver o QSmart pelos olhos dessa pessoa (só visualização)" @onclick="() => VerComo(u)"><Icone Nome="olho" Tamanho="15" /></button> }
                                <button class="btn btn-sec rx-mini" title="Gera um código de recuperação novo para a pessoa trocar a senha" @onclick="() => NovoCodigo(u)">Novo código</button>
                                @if (!eu) { <button class="btn btn-sec rx-mini" title="Excluir a conta" @onclick="() => Excluir(u)"><Icone Nome="lixo" Tamanho="14" /></button> }
                            </div>
                        </div>
                    }
                </div>
                <p class="muted pequeno">Só <b>coordenador</b> e <b>administrador</b> entram na seção Coordenação (Férias, Pontos de ação e One a One); liderança e usuário usam o resto do QSmart. Cada coordenador carrega no Perfil a planilha da sua equipe: ele vê no One a One só essas pessoas e, nas Férias, vê o painel geral mas marca só as suas.</p>
            }
        }
    </div>
}

@code {
    // ---------------- tema da plataforma (administrador) ----------------
    static readonly (string k, string nome, string emoji, string desc)[] TemasFesta =
    {
        ("", "Padrão", "✨", "o visual de sempre"),
        ("natal", "Natal", "🎄", ""),
        ("pascoa", "Páscoa", "🐰", "tons pastel, ovinhos e orelhas de coelho"),
        ("anonovo", "Ano Novo", "🥂", "dourado, fogos e confete"),
    };
    string? _temaEscolha;
    string? _natalVar;
    // Natal tem duas versões dentro do mesmo bloco: Clássico (natal) e Suave (natalsuave)
    string NatalVar => _natalVar ?? (_temaSel == "natalsuave" ? "natalsuave" : "natal");
    static string Grupo(string t) => t.StartsWith("natal") ? "natal" : t;
    string _temaSel { get => _temaEscolha ?? E.Festa; set => _temaEscolha = value; }
    DateTime? _temaAteEsc;
    bool _temaAteMexeu;
    DateTime? _temaAte { get => _temaAteMexeu ? _temaAteEsc : DateTime.TryParse(E.FestaAte, out var a) ? a : null; set { _temaAteEsc = value; _temaAteMexeu = true; } }
    bool _salvandoTema;
    static string DataFesta(string iso) => DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.AdjustToUniversal, out var d) ? d.AddHours(-3).ToString("dd/MM/yyyy HH:mm") : "";
    async Task AplicarTema()
    {
        _salvandoTema = true;
        try
        {
            var r = await E.Conta.Chamar("PUT", "admin/tema", new System.Text.Json.Nodes.JsonObject { ["tema"] = _temaSel, ["ate"] = _temaSel == "" ? "" : _temaAte?.ToString("yyyy-MM-dd") ?? "" });
            if (!r.Ok) { await J.Aviso("Tema da plataforma", r.Erro); return; }
            E.Festa = "\u0000";   // força reler e mostrar a saudação nova
            await E.CarregarFesta();
            _temaEscolha = null; _temaAteMexeu = false;
            _ = E.Conta.Registrar("tema." + (_temaSel == "" ? "padrao" : _temaSel), true);
        }
        finally { _salvandoTema = false; }
    }

    const string Ativo = "ativo", Bloqueado = "bloqueado";
    string _atual = "", _nova = "", _nova2 = "";
    bool _enviando;
    List<UsuarioAdmin>? _usuarios;
    System.Text.Json.Nodes.JsonNode? _base;
    int _baseCoord;
    bool _colabsAberto;
    string _colabBusca = "", _novoNome = "", _novaLid = "";
    DateTime? _novaAdm;

    async Task AbrirColabs()
    {
        _colabsAberto = !_colabsAberto;
        if (_colabsAberto) await E.CarregarOne(true);
    }

    /// <summary>Nome da coordenação escolhida pelo administrador (do coordenador selecionado), ou nulo.</summary>
    string? CoordAdmin()
    {
        if (_baseCoord == 0 || _usuarios?.FirstOrDefault(x => x.Id == _baseCoord) is not { } c) return null;
        return string.IsNullOrWhiteSpace(c.Lideranca) ? $"{c.Nome} {c.Sobrenome}".Trim() : c.Lideranca.Trim();
    }

    static string Norm(string s) => QSmart.Core.Coordenacao.Ferias.Norm(s);

    List<QSmart.Core.Coordenacao.PessoaOO> Colabs()
    {
        var ps = (E.OneBase?.Pessoas ?? new()).Where(x => !x.Arquivado);
        if (E.Conta.Perfil?.Admin == true && CoordAdmin() is { } c) { var n = Norm(c); ps = ps.Where(x => Norm(x.Coordenacao) == n); }
        return ps.OrderBy(x => x.Nome, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    async Task AdicionarColab()
    {
        var nome = System.Text.RegularExpressions.Regex.Replace(_novoNome.Trim(), @"\s+", " ");
        if (nome == "") return;
        var b = E.OneBase;
        if (b == null) { await E.CarregarOne(true); b = E.OneBase; if (b == null) return; }
        var eu = E.Conta.Perfil!;
        string coord;
        if (eu.Admin) { if (CoordAdmin() is not { } ca) { await J.Aviso("Adicionar colaborador", "Escolha acima de qual coordenador é o colaborador."); return; } coord = ca; }
        else coord = E.OneCoordenacao;
        if (b.Pessoas.Any(x => Norm(x.Nome) == Norm(nome) && !x.Arquivado)) { await J.Aviso("Adicionar colaborador", $"“{nome}” já está na base."); return; }
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var adm = _novaAdm is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
        bool novo = adm == null || adm.Value.AddDays(90) > hoje;
        var lid = _novaLid.Trim();
        var p = new QSmart.Core.Coordenacao.PessoaOO { Nome = nome, Lideranca = lid, Tipo = novo ? "Novo" : "Antigo", Entrada = novo ? (adm ?? hoje) : null, Admissao = adm, Coordenacao = coord };
        if (lid != "") p.Vinculos.Add(new QSmart.Core.Coordenacao.VinculoOO { Lideranca = lid, Desde = adm ?? hoje });
        b.Pessoas.Add(p);
        if (lid != "" && !b.Liderancas.Contains(lid)) b.Liderancas.Add(lid);
        await E.SalvarOne();
        E.FeColabs = null;
        _novoNome = ""; _novaAdm = null;
        _ = E.Conta.Registrar("base.adicionar", true);
    }

    async Task MudarAdm(QSmart.Core.Coordenacao.PessoaOO x, ChangeEventArgs e)
    {
        x.Admissao = DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
        await E.SalvarOne(); E.FeColabs = null;
    }

    async Task MudarLid(QSmart.Core.Coordenacao.PessoaOO x, ChangeEventArgs e)
    {
        var l = (e.Value?.ToString() ?? "").Trim();
        if (l == x.Lideranca) return;
        QSmart.Core.Coordenacao.OneAOne.TrocarLideranca(x, l, DateOnly.FromDateTime(DateTime.Today));
        if (l != "" && E.OneBase != null && !E.OneBase.Liderancas.Contains(l)) E.OneBase.Liderancas.Add(l);
        await E.SalvarOne(); E.FeColabs = null;
    }

    async Task ExcluirColab(QSmart.Core.Coordenacao.PessoaOO x)
    {
        if (!await J.Pergunta("Excluir colaborador", $"Excluir “{x.Nome}” da base? Somem também o histórico de 1:1 e as férias dele. Se a pessoa só saiu da equipe e você quer guardar o histórico, use Arquivar na ficha do One a One.")) return;
        E.OneBase?.Pessoas.Remove(x);
        await E.SalvarOne();
        E.FeColabs = null;
        await LerBase();
    }

    async Task LerBase()
    {
        var r = await E.BaseResumo();
        _base = r.Ok ? r.Json : new System.Text.Json.Nodes.JsonObject();
    }

    static string Txt(System.Text.Json.Nodes.JsonNode? n, string k) => n?[k] is System.Text.Json.Nodes.JsonValue v && v.TryGetValue<string>(out var x) ? x : "";
    static string? TxtOuNulo(System.Text.Json.Nodes.JsonNode? n, string k) => n?[k] is System.Text.Json.Nodes.JsonValue v && v.TryGetValue<string>(out var x) ? x : null;
    static int Num(System.Text.Json.Nodes.JsonNode? n, string k) => n?[k] is System.Text.Json.Nodes.JsonValue v && v.TryGetValue<int>(out var x) ? x : 0;
    static bool Sim(System.Text.Json.Nodes.JsonNode? n, string k) => n?[k] is System.Text.Json.Nodes.JsonValue v && v.TryGetValue<bool>(out var x) && x;
    static string Quando(string? iso) => DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var d) ? d.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm") : "";


    static readonly string[] Ferramentas = Abas.Todas.Concat(Abas.Internas).Where(a => !a.Externo).Select(a => a.Chave).ToArray();

    protected override async Task OnInitializedAsync()
    {
        E.Conta.Mudou += Atualizar;
        await E.Conta.CarregarEu();
        if (E.Conta.Perfil?.Coordenacao == true) await LerBase();
        if (E.Conta.Perfil?.Admin == true) await CarregarUsuarios();
        if (E.Conta.Perfil?.Papel == "lideranca") await LerLid();
    }

    // ---------------- liderança: a própria equipe ----------------
    System.Text.Json.Nodes.JsonNode? _lid;
    bool _lidEnviando, _lidSalvando;
    int _chaveLid;

    async Task LerLid()
    {
        var r = await E.Conta.Chamar("GET", "lid/base");
        _lid = r.Ok ? r.Json : new System.Text.Json.Nodes.JsonObject();
        if (!r.Ok) await J.Erro("Minha equipe", r.Erro);
    }

    List<System.Text.Json.Nodes.JsonNode> LidPessoas() => (_lid?["pessoas"] as System.Text.Json.Nodes.JsonArray ?? new()).Where(x => x != null).Select(x => x!).ToList();

    void PegarLista(RespostaApi r) { if (r.Ok && _lid is System.Text.Json.Nodes.JsonObject o && r.Json?["pessoas"] is System.Text.Json.Nodes.JsonArray a) o["pessoas"] = a.DeepClone(); }

    static string IniciaisDe(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : p.Length == 1 ? p[0][..1].ToUpperInvariant() : $"{p[0][0]}{p[^1][0]}".ToUpperInvariant(); }

    async Task BaixarModeloLid() => await E.Nav.Baixar("Modelo minha equipe.xlsx", QSmart.Core.Coordenacao.FeriasClt.ModeloLideranca(), Navegador.MimeXlsx);

    DateTime? _novoNasc;

    async Task AdicionarLid()
    {
        var nome = System.Text.RegularExpressions.Regex.Replace(_novoNome.Trim(), @"\s+", " ");
        if (nome == "" || _novaAdm == null || _novoNasc == null) { await J.Aviso("Adicionar colaborador", "Informe o nome, a data de admissão e a data de nascimento."); return; }
        if (_novaAdm > DateTime.Today) { await J.Aviso("Adicionar colaborador", "A data de admissão não pode ser no futuro."); return; }
        if (_novoNasc > DateTime.Today || _novoNasc < new DateTime(1930, 1, 1)) { await J.Aviso("Adicionar colaborador", "Confira a data de nascimento."); return; }
        _lidSalvando = true;
        var r = await E.Conta.Chamar("PUT", "lid/base", new System.Text.Json.Nodes.JsonObject { ["nome"] = nome, ["admissao"] = _novaAdm.Value.ToString("yyyy-MM-dd"), ["nascimento"] = _novoNasc.Value.ToString("yyyy-MM-dd") });
        _lidSalvando = false;
        if (!r.Ok) { await J.Aviso("Adicionar colaborador", r.Erro); return; }
        PegarLista(r);
        _novoNome = ""; _novaAdm = null; _novoNasc = null;
        _ = E.Conta.Registrar("base.adicionar", true);
    }

    async Task MudarAdmLid(System.Text.Json.Nodes.JsonNode x, ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (v == "") { await J.Aviso("Data de admissão", "A data de admissão é obrigatória."); PegarLista(new RespostaApi(true, 200, new System.Text.Json.Nodes.JsonObject { ["pessoas"] = _lid?["pessoas"]?.DeepClone() }, "")); return; }
        var r = await E.Conta.Chamar("PUT", "lid/base", new System.Text.Json.Nodes.JsonObject { ["id"] = Txt(x, "id"), ["nome"] = Txt(x, "nome"), ["admissao"] = v, ["nascimento"] = Txt(x, "nascimento") });
        if (!r.Ok) { await J.Aviso("Data de admissão", r.Erro); return; }
        PegarLista(r);
    }

    async Task MudarNascLid(System.Text.Json.Nodes.JsonNode x, ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        if (v == "") return;
        if (Txt(x, "admissao") == "") { await J.Aviso("Data de nascimento", "Preencha antes a data de admissão dessa pessoa."); return; }
        var r = await E.Conta.Chamar("PUT", "lid/base", new System.Text.Json.Nodes.JsonObject { ["id"] = Txt(x, "id"), ["nome"] = Txt(x, "nome"), ["admissao"] = Txt(x, "admissao"), ["nascimento"] = v });
        if (!r.Ok) { await J.Aviso("Data de nascimento", r.Erro); return; }
        PegarLista(r);
    }

    async Task TirarLid(System.Text.Json.Nodes.JsonNode x)
    {
        if (!await J.Pergunta("Tirar da equipe", $"Tirar “{Txt(x, "nome")}” da sua equipe? O histórico de 1:1 e de férias fica guardado.")) return;
        var r = await E.Conta.Chamar("DELETE", "lid/base?id=" + Uri.EscapeDataString(Txt(x, "id")));
        if (!r.Ok) { await J.Aviso("Tirar da equipe", r.Erro); return; }
        PegarLista(r);
    }

    async Task CarregarLid(InputFileChangeEventArgs ev)
    {
        var f = ev.File;
        byte[] bytes;
        try { using var ms = new MemoryStream(); await f.OpenReadStream(30_000_000).CopyToAsync(ms); bytes = ms.ToArray(); }
        catch (Exception ex) { _chaveLid++; await J.Erro("Minha equipe", "Não consegui ler o arquivo: " + ex.Message); return; }
        _chaveLid++;
        List<QSmart.Core.Coordenacao.LinhaBase> linhas;
        try { linhas = await QSmart.Core.Coordenacao.FeriasClt.LerBase(new QSmart.Core.Planilhas.Arquivo(f.Name, bytes), exigeLideranca: false); }
        catch (Exception ex) { await J.Erro("Minha equipe", ex.Message); return; }
        int semAdm = linhas.Count(l => l.Admissao == null), semNasc = linhas.Count(l => l.Nascimento == null);
        var atuais = LidPessoas().Select(x => QSmart.Core.Coordenacao.Ferias.Norm(Txt(x, "nome"))).ToHashSet();
        int saem = atuais.Count(n => !linhas.Any(l => QSmart.Core.Coordenacao.Ferias.Norm(l.Nome) == n));
        var msg = $"{linhas.Count} pessoas entram na sua equipe ({Txt(_lid, "lideranca")})." +
                  (semAdm > 0 ? $"\n\n{semAdm} sem data de admissão: dá para completar depois na lista." : "") +
                  (semNasc > 0 ? $"\n\n{semNasc} sem data de nascimento (a coluna \"Data de nascimento\" {(semNasc == linhas.Count ? "não foi encontrada" : "está vazia para elas")}): dá para completar depois na lista." : "") +
                  (saem > 0 ? $"\n\n{saem} pessoa(s) da sua equipe não estão na planilha e saem da equipe (o histórico fica guardado)." : "") +
                  "\n\nEnviar?";
        if (!await J.Pergunta("Carregar minha equipe", msg)) return;
        _lidEnviando = true; StateHasChanged();
        var corpo = new System.Text.Json.Nodes.JsonObject { ["arquivo"] = f.Name, ["linhas"] = new System.Text.Json.Nodes.JsonArray(linhas.Select(l => (System.Text.Json.Nodes.JsonNode)new System.Text.Json.Nodes.JsonObject { ["nome"] = l.Nome, ["admissao"] = l.Admissao?.ToString("yyyy-MM-dd"), ["nascimento"] = l.Nascimento?.ToString("yyyy-MM-dd") }).ToArray()) };
        var r = await E.Conta.Chamar("POST", "lid/base", corpo);
        _lidEnviando = false;
        if (!r.Ok) { await J.Erro("Minha equipe", r.Erro); return; }
        await LerLid();
        _ = E.Conta.Registrar("base.carregar", true);
        var rec = Num(r.Json, "recusadasN");
        await J.Info("Minha equipe", $"Pronto! {Num(r.Json, "novos")} novas, {Num(r.Json, "atualizados")} atualizadas e {Num(r.Json, "arquivados")} saíram da equipe. A coordenação já vê no One a One e nas Férias." +
            (rec > 0 ? $"\n\n{rec} não entraram porque já estão em outra equipe ou coordenação (a coordenação pode transferir): {string.Join(", ", (r.Json?["recusadas"] as System.Text.Json.Nodes.JsonArray ?? new()).Select(x => x?.ToString()))}" : ""));
    }

    void Atualizar() => InvokeAsync(StateHasChanged);
    public void Dispose() => E.Conta.Mudou -= Atualizar;

    ResumoConta Calc() => Conquistas.Calcular(E.Conta.Uso, E.Conta.Dias, Ferramentas, DateOnly.FromDateTime(DateTime.Today));
    static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    static string Num(int v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(',', '.');
    static string TituloMedalha(Medalha m) => m.Como + (m.Ganha ? " · conquistada!" : $" · {m.Valor} de {m.Meta}");
    static string TituloTrofeu(Trofeu t) => $"{t.Nome}: bronze {t.Metas[0]}, prata {t.Metas[1]}, ouro {t.Metas[2]} {t.Como}";
    static string Dia(string iso) => DateTime.TryParse(iso, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AdjustToUniversal, out var d) ? d.ToLocalTime().ToString("dd/MM/yyyy") : iso;

    static string? Desde(string iso)
    {
        if (iso.Length < 7 || !int.TryParse(iso[..4], out var a) || !int.TryParse(iso[5..7], out var m)) return null;
        return Texto.MesesPt[m - 1][..3].ToLowerInvariant() + "/" + a;
    }

    async Task TrocarFoto(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (f.Size > 15_000_000) { await J.Aviso("Foto", "Escolha uma imagem de até 15 MB."); return; }
        _enviando = true; StateHasChanged();
        try
        {
            using var ms = new MemoryStream();
            await f.OpenReadStream(15_000_000).CopyToAsync(ms);
            var url = await E.Nav.ReduzirImagem(ms.ToArray(), 256);
            var r = await E.Conta.SalvarFoto(url);
            if (!r.Ok) await J.Aviso("Foto", r.Erro);
        }
        catch (Exception ex) { await J.Aviso("Foto", "Não consegui usar essa imagem: " + ex.Message); }
        finally { _enviando = false; StateHasChanged(); }
    }

    async Task TrocarSenha()
    {
        if (_nova.Length < 8) { await J.Aviso("Senha", "A nova senha precisa ter pelo menos 8 caracteres."); return; }
        if (_nova != _nova2) { await J.Aviso("Senha", "As duas senhas novas não estão iguais."); return; }
        var r = await E.Conta.TrocarSenha(_atual, _nova);
        if (!r.Ok) { await J.Aviso("Senha", r.Erro); return; }
        _atual = _nova = _nova2 = "";
        await J.Info("Senha", "Senha trocada. Use a nova senha da próxima vez que entrar.");
    }

    async Task Sair()
    {
        if (!await J.Pergunta("Sair", "Sair do QSmart neste computador?")) return;
        await E.Conta.Sair();
    }

    async Task CarregarUsuarios() { _usuarios = null; StateHasChanged(); _usuarios = await E.Conta.Usuarios() ?? new(); await LerEquipes(); }

    // ---------- equipes (lideranças) de cada coordenação ----------
    sealed record EquipeAdm(string Lideranca, string Coordenacao, int CoordenadorId, int Pessoas);
    List<EquipeAdm>? _equipes;
    List<string> _lideresSem = new();
    (int, string)? _eqMenu;

    async Task LerEquipes()
    {
        var r = await E.Conta.Chamar("GET", "admin/equipes");
        _equipes = (r.Json?["equipes"] as System.Text.Json.Nodes.JsonArray ?? new()).Select(x => new EquipeAdm(Txt(x, "lideranca"), Txt(x, "coordenacao"), Num(x, "coordenadorId"), Num(x, "pessoas"))).ToList();
        _lideresSem = (r.Json?["lideresSemEquipe"] as System.Text.Json.Nodes.JsonArray ?? new()).Select(x => x?.ToString() ?? "").Where(x => x != "").ToList();
    }

    async Task VerComo(UsuarioAdmin u)
    {
        var erro = await E.Conta.VerComo(u.Id);
        if (erro != null) { await J.Erro("Ver como", erro); return; }
        _ = E.Sino.Carregar();
        Navegar.NavigateTo("");
    }

    string NomeCoord(int id) => _usuarios?.FirstOrDefault(x => x.Id == id) is { } c ? $"{c.Nome} {c.Sobrenome}" : "?";

    async Task Mover(EquipeAdm g, int para, string pergunta)
    {
        if (!await J.Pergunta("Equipes", pergunta)) { _eqMenu = null; StateHasChanged(); return; }
        var r = await E.Conta.Chamar("POST", "admin/equipes", new System.Text.Json.Nodes.JsonObject { ["lideranca"] = g.Lideranca, ["de"] = g.Coordenacao, ["para"] = para });
        _eqMenu = null;
        if (!r.Ok) { await J.Erro("Equipes", r.Erro); return; }
        E.OneBase = null; E.FeColabs = null;
        await LerEquipes();
        if (E.Conta.Perfil?.Coordenacao == true) await LerBase();
    }

    async Task AdicionarEquipe(UsuarioAdmin u, string? v)
    {
        if (v != null && v.StartsWith("L:"))
        {
            var lider = v[2..];
            await Mover(new EquipeAdm(lider, "", 0, 0), u.Id, $"Criar a equipe de {lider} na coordenação de {u.Nome} {u.Sobrenome}?\n\nEla aparece como esteira no One a One de {u.Nome}; as pessoas entram pela planilha ou em “Ver, adicionar e excluir colaboradores”, com a liderança {lider}.");
            return;
        }
        if (!int.TryParse(v, out var i) || _equipes == null || i < 0 || i >= _equipes.Count) return;
        var g = _equipes[i];
        var nomeL = g.Lideranca == "" ? "sem liderança" : g.Lideranca;
        await Mover(g, u.Id, $"Trazer a equipe “{nomeL}” ({g.Pessoas} pessoa(s)){(g.CoordenadorId == 0 ? "" : $", que hoje é de {NomeCoord(g.CoordenadorId)},")} para a coordenação de {u.Nome} {u.Sobrenome}?\n\nO One a One e as Férias dessas pessoas passam a ser de {u.Nome}.");
    }

    async Task MoverEquipe(EquipeAdm g, UsuarioAdmin de, string? v)
    {
        if (!int.TryParse(v, out var para) || para == 0) return;
        var nomeL = g.Lideranca == "" ? "sem liderança" : g.Lideranca;
        await Mover(g, para, $"Mover a equipe “{nomeL}” ({g.Pessoas} pessoa(s)) de {de.Nome} {de.Sobrenome} para {NomeCoord(para)}?\n\nO One a One (com o histórico de 1:1) e as Férias dessas pessoas vão junto.");
    }

    async Task TirarEquipe(EquipeAdm g, UsuarioAdmin de)
    {
        var nomeL = g.Lideranca == "" ? "sem liderança" : g.Lideranca;
        await Mover(g, 0, $"Tirar a equipe “{nomeL}” ({g.Pessoas} pessoa(s)) da coordenação de {de.Nome} {de.Sobrenome}?\n\nAs pessoas e o histórico continuam guardados, mas ficam sem coordenação (só o administrador vê) até você atrelar a outro coordenador.");
    }

    async Task Aplicar(Task<RespostaApi> t)
    {
        var r = await t;
        if (!r.Ok) await J.Aviso("Equipe e acessos", r.Erro);
        await CarregarUsuarios();
    }

    async Task MudarPapel(UsuarioAdmin u, string? papel) { if (papel != null && papel != u.Papel) await Aplicar(E.Conta.AtualizarUsuario(u.Id, papel: papel)); }
    async Task MudarEquipe(UsuarioAdmin u, string? l) { if (l != null && l.Trim() != u.Lideranca) await Aplicar(E.Conta.AtualizarUsuario(u.Id, lideranca: l.Trim())); }
    async Task Status(UsuarioAdmin u, string st) => await Aplicar(E.Conta.AtualizarUsuario(u.Id, status: st));

    async Task NovoCodigo(UsuarioAdmin u)
    {
        if (!await J.Pergunta("Novo código", $"Gerar um código de recuperação novo para {u.Nome}? O código antigo deixa de valer.")) return;
        var r = await E.Conta.NovoCodigo(u.Id);
        if (!r.Ok) { await J.Aviso("Novo código", r.Erro); return; }
        var c = r.Json?["codigo"]?.GetValue<string>() ?? "";
        await E.Nav.Copiar(c);
        await J.Info("Novo código", $"Código de recuperação de {u.Nome} {u.Sobrenome} (@{u.Usuario}):\n\n{c}\n\nJá copiei. Passe para a pessoa: ela usa em “Esqueci a senha” para criar uma senha nova.");
    }

    async Task Excluir(UsuarioAdmin u)
    {
        if (!await J.Pergunta("Excluir conta", $"Excluir a conta de {u.Nome} {u.Sobrenome}? As medalhas dela se perdem. Os registros do One a One continuam.")) return;
        await Aplicar(E.Conta.Excluir(u.Id));
    }
}
