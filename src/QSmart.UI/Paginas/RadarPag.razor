    async Task PortalPF(string cpf, int seq)
    {
        var ceis = Ck("ceis")!; var ceaf = Ck("ceaf")!; var pep = Ck("pep")!; var ben = Ck("beneficios")!;
        if (!E.PortalPronto)
        {
            foreach (var c in new[] { ceis, ceaf, pep, ben }) { c.Status = StatusCheck.SemChave; c.Detalhe = "chave do Portal não configurada nesta máquina"; c.Url = Radar.UrlPortal; }
            return;
        }
        var tPf = E.Nav.GetH(E.UrlPortal(Radar.UrlPortalPF(cpf)), CabPortal()).AsTask();
        var tPep = E.Nav.GetH(E.UrlPortal(Radar.UrlPeps(cpf)), CabPortal()).AsTask();
        await Task.WhenAll(tPf, tPep);
        if (seq != _seq) return;
        var rPf = tPf.Result; var rPep = tPep.Result;
        if (rPf.Status == 200 && Radar.LerPortal(rPf.Texto) is { } p)
        {
            _pf = p;
            if (_cpfNome == "" && p.Nome != "") _cpfNome = Radar.NomeProprio(p.Nome);
            var m = new List<string>(); if (p.Ceis) m.Add("CEIS"); if (p.Cnep) m.Add("CNEP");
            ceis.Status = m.Count > 0 ? StatusCheck.Consta : StatusCheck.NadaConsta; ceis.Detalhe = m.Count > 0 ? "consta em " + string.Join(", ", m) : "";
            ceaf.Status = p.Ceaf ? StatusCheck.Consta : StatusCheck.NadaConsta; ceaf.Detalhe = p.Ceaf ? "expulsão da administração federal" : "";
            ben.Status = StatusCheck.Info; ben.Detalhe = p.RecebeBeneficio ? "recebe" : "não recebe";
            ceis.Url = ceaf.Url = Radar.UrlPortal + "/sancoes/consulta"; ben.Url = Radar.UrlPortal + "/beneficios";
            if (p.Servidor || p.ServidorInativo)
            {
                var rs = await E.Nav.GetH(E.UrlPortal(Radar.UrlServidor(cpf)), CabPortal());
                if (seq != _seq) return;
                if (rs.Status == 200) _vinculos = Radar.LerServidor(rs.Texto);
            }
        }
        else
        {
            foreach (var c in new[] { ceis, ceaf, ben }) { c.Status = rPf.Status == 0 ? StatusCheck.Atalho : StatusCheck.Erro; c.Detalhe = ErroP(rPf.Status); c.Url = Radar.UrlPortal; }
        }
        if (rPep.Status == 200)
        {
            _peps = Radar.LerPeps(rPep.Texto);
            pep.Status = _peps.Count > 0 ? StatusCheck.Atencao : StatusCheck.NadaConsta;
            pep.Detalhe = _peps.Count > 0 ? "sim" + (_peps[0].FimCarencia != "" ? " · até " + _peps[0].FimCarencia[^4..] : "") : "";
        }
        else { pep.Status = rPep.Status == 0 ? StatusCheck.Atalho : StatusCheck.Erro; pep.Detalhe = ErroP(rPep.Status); pep.Url = Radar.UrlPortal + "/pep"; }
        StateHasChanged();
    }

    async Task Qgi(int seq)
    {
        var c = Ck("qgi")!;
        c.Url = Radar.UrlBcProcessos;
        if (_cpfNome == "") { c.Status = StatusCheck.Atalho; c.Detalhe = "informe o nome para conferir"; Pronto(seq); return; }
        var r = await E.Nav.GetH(Radar.UrlQgi, null, 30000);
        if (seq != _seq) return;
        if (r.Status == 200)
        {
            var (achou, det) = Radar.BuscarQgi(r.Texto, _cpfNome, _cpf);
            c.Status = achou ? StatusCheck.Consta : StatusCheck.NadaConsta; c.Detalhe = achou ? det : "";
        }
        else { c.Status = StatusCheck.Atalho; c.Detalhe = "o Banco Central não respondeu agora"; }
        Pronto(seq);
    }

    async Task Ligadas(int seq, IEnumerable<string>? extras)
    {
        if (_cpfNome == "") return;
        _procurandoLigadas = true; Pronto(seq);
        try
        {
            var alvos = (extras ?? (_base?.Recentes.Select(r => r.Cnpj) ?? Enumerable.Empty<string>())).Distinct().Take(15).ToList();
            foreach (var cnpj in alvos)
            {
                if (_ligadas.Any(x => x.cnpj == cnpj)) continue;
                var (e, _) = await BuscarEmpresa(cnpj);
                if (seq != _seq) return;
                _conferidos++;
                if (e == null) continue;
                var s = e.Socios.FirstOrDefault(x => Radar.MesmoSocio(x, _cpfNome, _cpf));
                if (s != null) _ligadas.Add((e.Cnpj, e.Fantasia != "" ? e.Fantasia : e.RazaoSocial, Radar.Qualificacao(s.Qualificacao) + (s.Entrada != null ? " · desde " + s.Entrada.Value.Year : ""), Cnae.Frase(e.Situacao), e.Ativa));
                Pronto(seq);
            }
        }
        finally { if (seq == _seq) { _procurandoLigadas = false; Pronto(seq); } }
    }

    async Task ConferirExtra()
    {
        var lista = _cnpjsExtra.Split(new[] { ',', ';', '\n', ' ' }, StringSplitOptions.RemoveEmptyEntries).Select(Documento.Digitos).Where(Documento.CnpjValido).ToList();
        if (lista.Count == 0) { await J.Aviso("Empresas ligadas", "Digite um ou mais CNPJs válidos, separados por vírgula."); return; }
        await Ligadas(_seq, lista);
    }

    List<Placa> PlacarPF() => Radar.DimensoesPF.Select(d => Radar.Placar(d, _checks)).ToList();

    // =============================== Parecer, PDF e Teams ===============================

    async Task GerarParecer()
    {
        if (E.ChaveIA == null) { await J.Aviso("Contate o suporte", Estado.MsgSemIA); return; }
        var seq = _seq;
        _parecerRodando = true; _parecerErro = null; StateHasChanged();
        try
        {
            var fatos = _modo == "cnpj" && _emp != null
                ? RadarIA.FatosPJ(_emp, _checks, DateOnly.FromDateTime(DateTime.Today))
                : RadarIA.FatosPF(_finalidadeUsada, _checks.Concat(ExtrasPF()), _ligadas.Count);
            var r = await E.Nav.IA(AnaliseIA.Url, E.ChaveIA, RadarIA.Pedido(fatos, E.ModeloIA));
            if (seq != _seq) return;
            if (r.Status != 200) { _parecerErro = AnaliseIA.Erro(r.Status, r.Texto); return; }
            _parecer = RadarIA.Ler(r.Texto);
            if (_parecer == null) _parecerErro = "A IA devolveu um parecer vazio. Tente de novo.";
        }
        catch (Exception ex) { _parecerErro = ex.Message; }
        finally { if (seq == _seq) { _parecerRodando = false; StateHasChanged(); } }
    }

    /// <summary>Fatos do CPF que não estão nas checagens (para o parecer, sem nome nem número).</summary>
    IEnumerable<Checagem> ExtrasPF()
    {
        if (_peps.Count > 0) yield return new Checagem { Titulo = "Cargo PEP", Status = StatusCheck.Info, Detalhe = $"{_peps[0].Funcao} · {_peps[0].Orgao} · PEP até {_peps[0].FimCarencia}" };
        if (_pf?.Servidor == true) yield return new Checagem { Titulo = "Servidor federal", Status = StatusCheck.Info, Detalhe = _vinculos.Count > 0 ? _vinculos[0].Cargo : "sim" };
        foreach (var l in _ligadas) yield return new Checagem { Titulo = "Empresa ligada", Status = StatusCheck.Info, Detalhe = $"{l.qual} · {l.situacao}" };
    }

    async Task Pdf()
    {
        if (_emp == null) return;
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var bytes = QSmart.Core.Pdf.RadarPdf.Cnpj(_emp, PlacarPJ(), _checks, Radar.Linha(_emp, _base?.De(_emp.Cnpj) ?? new(), _junta), _parecer, hoje);
        await E.Salvar($"Radar360_{_emp.Cnpj}_{DateTime.Now:yyyyMMdd}.pdf", bytes, QSmart.UI.Servicos.Navegador.MimePdf, "Ficha 360");
    }

    async Task PdfCpf()
    {
        var emp = _ligadas.Select(l => $"{l.nome} · {l.qual} · {l.situacao}");
        var bytes = QSmart.Core.Pdf.RadarPdf.Cpf(_cpfNome, Documento.MascararCpf(_cpf), _finalidadeUsada, PlacarPF(), _checks, emp, _parecer);
        await E.Salvar($"Radar360_CPF_{DateTime.Now:yyyyMMdd_HHmm}.pdf", bytes, QSmart.UI.Servicos.Navegador.MimePdf, "Consulta de CPF");
    }

    async Task CopiarTeams()
    {
        if (_emp == null) return;
        var txt = Radar.TextoTeams(_emp, PlacarPJ(), _checks, _parecer, DateOnly.FromDateTime(DateTime.Today));
        if (await E.Nav.Copiar(txt)) await J.Info("Copiado", "Resumo da ficha 360 copiado. É só colar no Teams.");
        else await J.Aviso("Copiar", "Não consegui copiar automaticamente.");
    }

    async Task CopiarTeamsCpf()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"📡 Radar Smart360 · consulta de CPF {Documento.MascararCpf(_cpf)}");
        sb.AppendLine($"Finalidade: {_finalidadeUsada}");
        foreach (var p in PlacarPF()) sb.AppendLine($"{Radar.Emoji(p.Cor)} {p.Dimensao}: {p.Texto}");
        if (_ligadas.Count > 0) sb.AppendLine($"Empresas ligadas: {_ligadas.Count}");
        if (!string.IsNullOrWhiteSpace(_parecer)) { sb.AppendLine(); sb.AppendLine("Parecer do Mr. Smart: " + _parecer); }
        if (await E.Nav.Copiar(sb.ToString().TrimEnd())) await J.Info("Copiado", "Resumo copiado (sem o nome e com o CPF mascarado).");
    }

    async Task CopiarDoc(string doc) => await E.Nav.Copiar(Documento.Digitos(doc));

    // =============================== pedaços da tela ===============================

    RenderFragment Parecer() => __builder =>
    {
        <div class="rx-mr">
            <span class="rx-ow"><MrSmartLogo /></span>
            <div class="rx-mr-txt">
                <b>@(_modo == "cnpj" ? "Parecer 360 do Mr. Smart" : "Parecer do Mr. Smart")</b>
                @if (E.ChaveIA == null) { <p class="muted">@Estado.MsgSemIA</p> }
                else if (_parecerRodando) { <p class="muted"><span class="ia-spin pequeno"></span> O Mr. Smart está lendo as checagens…</p> }
                else if (_parecerErro != null) { <p class="txt-r">@_parecerErro</p> }
                else if (_parecer != null) { <p>@_parecer</p> }
                else { <p class="muted">O parecer sai quando as checagens terminarem.</p> }
            </div>
            @if (E.ChaveIA != null && !_parecerRodando && (_parecer != null || _parecerErro != null))
            {
                <button class="btn btn-sec rx-mini" @onclick="GerarParecer" title="Pede um novo parecer"><Icone Nome="faisca" Tamanho="14" /> Refazer</button>
            }
        </div>
    };

    RenderFragment Linha(Checagem c) => __builder =>
    {
        var (cls, ic) = c.Status switch
        {
            StatusCheck.NadaConsta => ("ok", "✓"), StatusCheck.Consta => ("no", "!"), StatusCheck.Atencao => ("at", "!"),
            StatusCheck.Info => ("info", "i"), StatusCheck.Carregando => ("load", ""), StatusCheck.SemChave => ("lk", "🔑"), StatusCheck.Erro => ("lk", "×"), _ => ("lk", "↗"),
        };
        <div class="rx-chk">
            <span class="rx-ic @cls">@if (c.Status == StatusCheck.Carregando) { <span class="ia-spin pequeno"></span> } else { @ic }</span>
            <div>
                <b>@c.Titulo</b>
                <small>@c.Fonte@(c.Detalhe != "" && c.Status is not (StatusCheck.Consta or StatusCheck.Atencao) ? " · " + c.Detalhe : "")</small>
                @if (c.Detalhe != "" && c.Status is StatusCheck.Consta or StatusCheck.Atencao) { <small class="@(c.Status == StatusCheck.Consta ? "txt-r" : "txt-y")">@c.Detalhe</small> }
                @if (c.Itens.Count > 0)
                {
                    <div class="rx-itens">
                        @foreach (var (t, u) in c.Itens)
                        {
                            @if (u != null) { <a href="@u" target="_blank" rel="noopener">@t ↗</a> } else { <span>@t</span> }
                        }
                    </div>
                }
            </div>
            @if (c.Url != "" && c.Status != StatusCheck.Carregando)
            {
                <a class="rx-st @cls" href="@c.Url" target="_blank" rel="noopener" @onclick="CopiarAtual">@c.Rotulo@(c.Status is StatusCheck.Atalho or StatusCheck.SemChave or StatusCheck.Erro ? " ↗" : "")</a>
            }
            else { <em class="rx-st @cls">@c.Rotulo</em> }
        </div>
    };

    async Task CopiarAtual() => await E.Nav.Copiar(_modo == "cnpj" ? _emp?.Cnpj ?? "" : _cpf);

    RenderFragment Rede(Empresa e) => __builder =>
    {
        var nos = e.Socios.Take(8).ToList();
        const double W = 320, H = 190, cx = W / 2, cy = H / 2;
        <svg class="rx-rede" viewBox="0 0 @W @H" role="img" aria-label="Rede de sócios">
            @for (int i = 0; i < nos.Count; i++)
            {
                var ang = -Math.PI / 2 + i * 2 * Math.PI / nos.Count;
                var x = cx + Math.Cos(ang) * 96; var y = cy + Math.Sin(ang) * 70;
                <line x1="@F(cx)" y1="@F(cy)" x2="@F(x)" y2="@F(y)" class="rx-rede-l" />
            }
            @for (int i = 0; i < nos.Count; i++)
            {
                var s = nos[i];
                var ang = -Math.PI / 2 + i * 2 * Math.PI / nos.Count;
                var x = cx + Math.Cos(ang) * 96; var y = cy + Math.Sin(ang) * 70;
                var nome = Curto14(Radar.NomeProprio(s.Nome));
                var w = nome.Length * 5.6 + 16;
                var cs = s.CnpjSocio;
                <g class="rx-no @(s.PJ ? "pj" : "")" @onclick="() => AbrirSocio(cs)">
                    <rect x="@F(x - w / 2)" y="@F(y - 10)" width="@F(w)" height="20" rx="10" />
                    <text x="@F(x)" y="@F(y + 3.5)" text-anchor="middle">@nome</text>
                </g>
            }
            @{ var cen = Curto14(Radar.NomeProprio(e.Fantasia != "" ? e.Fantasia : e.RazaoSocial)); var cw = cen.Length * 6 + 22; }
            <g class="rx-no centro">
                <rect x="@F(cx - cw / 2)" y="@F(cy - 12)" width="@F(cw)" height="24" rx="12" />
                <text x="@F(cx)" y="@F(cy + 4)" text-anchor="middle">@cen</text>
            </g>
        </svg>
    };

    static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    static string Curto14(string s) => s.Length > 18 ? s[..17] + "…" : s;
    async Task AbrirSocio(string? cnpj) { if (cnpj != null) await AbrirCnpj(cnpj); }

    public override void Dispose() => base.Dispose();
}
