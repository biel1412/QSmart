    void LimparCpf()
    {
        _cpf = ""; _cpfNome = ""; _pf = null; _peps = new(); _vinculos = new(); _ligadas = new(); _cpfFeito = false; _benAberto = false;
        if (_modo == "cpf") { _checks = new(); _parecer = null; }
    }

    async Task Consultar()
    {
        if (_buscando) return;
        _erro = null;
        if (_modo == "cnpj")
        {
            if (!Documento.CnpjValido(_entrada)) { _erro = Documento.Digitos(_entrada).Length != 14 ? "Digite os 14 números do CNPJ." : "Este CNPJ não é válido (os dígitos verificadores não conferem)."; return; }
            await ConsultarCnpj(Documento.Digitos(_entrada));
        }
        else
        {
            if (!Documento.CpfValido(_entrada)) { _erro = Documento.Digitos(_entrada).Length != 11 ? "Digite os 11 números do CPF." : "Este CPF não é válido (os dígitos verificadores não conferem)."; return; }
            if (_finalidade == "") { _erro = "Escolha a finalidade da consulta antes de consultar um CPF."; return; }
            await ConsultarCpf(Documento.Digitos(_entrada));
        }
    }

    async Task AbrirCnpj(string cnpj)
    {
        _modo = "cnpj"; LimparCpf();
        _entrada = Documento.FmtCnpj(cnpj);
        _erro = null;
        await ConsultarCnpj(Documento.Digitos(cnpj));
        await E.Nav.Rolar("rx-doc");
    }

    Dictionary<string, string> CabPortal() => E.CabecalhoPortal();
