    async Task MonitorarAtual()
    {
        if (_emp == null || _base == null) return;
        var r = _base.Recentes.FirstOrDefault(x => x.Cnpj == _emp.Cnpj);
        if (r == null) return;
        await AlternarMonitor(r);
