    async Task<(Empresa? e, string? erro)> BuscarEmpresa(string cnpj)
    {
        var r = await E.Nav.GetH(LeitorCnpj.UrlBrasilApi(cnpj), null, 20000);
        if (r.Status == 200 && LeitorCnpj.BrasilApi(r.Texto) is { } e1) return (e1, null);
        if (r.Status == 404) return (null, "CNPJ não encontrado na base da Receita. Se foi aberto há poucos dias, pode ainda não ter entrado nos dados abertos.");
        var r2 = await E.Nav.GetH(LeitorCnpj.UrlMinhaReceita(cnpj), null, 20000);
        if (r2.Status == 200 && LeitorCnpj.BrasilApi(r2.Texto, "Receita Federal (via Minha Receita)") is { } e2) return (e2, null);
        var r3 = await E.Nav.GetH(LeitorCnpj.UrlCnpja(cnpj), null, 20000);
        if (r3.Status == 200 && LeitorCnpj.Cnpja(r3.Texto) is { } e3) return (e3, null);
        if (r2.Status == 404 || r3.Status == 404) return (null, "CNPJ não encontrado na base da Receita.");
        return (null, "As fontes de CNPJ não responderam agora (BrasilAPI, Minha Receita e CNPJá). Confira a internet ou tente de novo em 1 minuto.");
    }

    async Task ConsultarCnpj(string cnpj)
    {
        var seq = ++_seq;
        _buscando = true; _parecer = null; _parecerErro = null; _junta = new(); _geo = null; _geoTentado = false; _geoCidade = false; _ibge = null;
        _ufJunta = null; _todasAtiv = _todosSocios = _tlTudo = false; _mudouAgora = new();
        StateHasChanged();
        try
        {
            var (e, erro) = await BuscarEmpresa(cnpj);
            if (seq != _seq) return;
            if (e == null) { _erro = erro; _emp = null; return; }
            _emp = e; _quando = DateTime.Now;
            _base ??= await E.CarregarRadar();
            _mudouAgora = _base.Registrar(e, _quando);
            await E.SalvarRadar();
            _checks = ChecagensIniciaisPJ(e);
        }
        finally { _buscando = false; StateHasChanged(); }

        var emp = _emp!;
        await Task.WhenAll(Tcu(emp, seq), PortalPJ(emp, seq), BancoCentral(emp, seq), Diarios(emp, seq), DominioRdap(emp, seq), Mapa(emp, seq), Ibge(emp, seq));
        if (seq != _seq) return;
        StateHasChanged();
        if (E.ChaveIA != null) await GerarParecer();
    }

    List<Checagem> ChecagensIniciaisPJ(Empresa e)
    {
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var l = new List<Checagem>();
        var cad = new Checagem { Id = "cadastro", Titulo = "Situação na Receita", Fonte = "Receita Federal", Dimensao = "Cadastro" };
        if (!e.Ativa) { cad.Status = StatusCheck.Consta; cad.Detalhe = Cnae.Frase(e.Situacao).ToLowerInvariant(); }
        else if (e.SituacaoEspecial != "") { cad.Status = StatusCheck.Atencao; cad.Detalhe = Cnae.Frase(e.SituacaoEspecial); }
        else if (e.Abertura is { } ab && ab > hoje.AddYears(-1)) { cad.Status = StatusCheck.Atencao; cad.Detalhe = "aberta há menos de 1 ano"; }
        else cad.Status = StatusCheck.NadaConsta;
        l.Add(cad);
        l.Add(new Checagem { Id = "tcu", Titulo = "TCU · CNJ · CEIS · CNEP", Fonte = "Consulta consolidada TCU", Dimensao = "Sanções e compliance" });
        l.Add(new Checagem { Id = "cgu", Titulo = "CGU · CEIS, CNEP, CEPIM e leniência", Fonte = "Portal da Transparência", Dimensao = "Sanções e compliance" });
        l.Add(new Checagem { Id = "ibama", Titulo = "IBAMA · embargos", Fonte = "Consulta pública de áreas embargadas", Dimensao = "Ambiental", Status = StatusCheck.Atalho, Url = Radar.UrlIbama, Detalhe = "pede o CNPJ no site" });
        l.Add(new Checagem { Id = "listasuja", Titulo = "Lista suja do trabalho", Fonte = "Ministério do Trabalho · cadastro de empregadores", Dimensao = "Trabalhista", Status = StatusCheck.Atalho, Url = Radar.UrlListaSuja, Detalhe = "lista em PDF; procure pelo CNPJ" });
        l.Add(new Checagem { Id = "bc", Titulo = "Banco Central", Fonte = "IF.data · Banco Central", Dimensao = "Financeiro (Banco Central)" });
        l.Add(new Checagem { Id = "contratos", Titulo = "Contratos com o governo federal", Fonte = "Portal da Transparência", Dimensao = "Governo" });
        l.Add(new Checagem { Id = "diarios", Titulo = "Diários oficiais municipais", Fonte = "Querido Diário", Dimensao = "Governo" });
        if (Radar.Dominio(e.Email) != null) l.Add(new Checagem { Id = "dominio", Titulo = "Domínio do e-mail", Fonte = "Registro.br", Dimensao = "Cadastro" });
        if (e.SociedadeAnonima) l.Add(new Checagem { Id = "cvm", Titulo = "CVM · companhias abertas", Fonte = "CVM", Dimensao = "Cadastro", Status = StatusCheck.Atalho, Url = Radar.UrlCvm, Detalhe = "documentos e fatos relevantes" });
        var cert = new Checagem { Id = "certidoes", Titulo = "Certidões com captcha", Fonte = "Receita/PGFN · TST · FGTS · protestos", Status = StatusCheck.Atalho, Url = Radar.AtalhosPJ[0].url };
        foreach (var (n, u) in Radar.AtalhosPJ.Take(4)) cert.Itens.Add((n, u));
        l.Add(cert);
        return l;
    }

    Checagem? Ck(string id) => _checks.FirstOrDefault(c => c.Id == id);

    void Pronto(int seq) { if (seq == _seq) InvokeAsync(StateHasChanged); }

    async Task Tcu(Empresa e, int seq)
    {
        var r = await E.Nav.GetH(Radar.UrlTcu(e.Cnpj), null, 30000);
        if (seq != _seq) return;
        var itens = r.Status == 200 ? Radar.LerTcu(r.Texto) : new();
        var i = _checks.FindIndex(c => c.Id == "tcu");
        if (i < 0) return;
        if (itens.Count > 0) { _checks.RemoveAt(i); _checks.InsertRange(i, itens); }
        else
        {
            var c = _checks[i];
            c.Status = StatusCheck.Atalho; c.Url = Radar.UrlTcuConsolidada;
            c.Detalhe = r.Status == 0 ? "o site do TCU não libera consulta direta do navegador" : "o TCU não respondeu agora";
        }
        Pronto(seq);
    }

    async Task PortalPJ(Empresa e, int seq)
    {
        var cgu = Ck("cgu")!; var con = Ck("contratos")!;
        if (!E.PortalPronto)
        {
            cgu.Status = con.Status = StatusCheck.SemChave;
            cgu.Url = Radar.UrlPortal + "/sancoes/consulta"; con.Url = Radar.UrlPortal + "/contratos";
            cgu.Detalhe = con.Detalhe = "chave do Portal não configurada nesta máquina";
            Pronto(seq); return;
        }
        var tPj = E.Nav.GetH(E.UrlPortal(Radar.UrlPortalPJ(e.Cnpj)), CabPortal()).AsTask();
        var tLen = E.Nav.GetH(E.UrlPortal(Radar.UrlLeniencia(e.Cnpj)), CabPortal()).AsTask();
        var tCon = E.Nav.GetH(E.UrlPortal(Radar.UrlContratos(e.Cnpj)), CabPortal()).AsTask();
        await Task.WhenAll(tPj, tLen, tCon);
        if (seq != _seq) return;
        var (rPj, rLen, rCon) = (tPj.Result, tLen.Result, tCon.Result);
        if (rPj.Status == 200 && Radar.LerPortal(rPj.Texto) is { } p)
        {
            var marcas = new List<string>();
            if (p.Ceis) marcas.Add("CEIS");
            if (p.Cnep) marcas.Add("CNEP");
            if (p.Cepim) marcas.Add("CEPIM");
            if (rLen.Status == 200 && Radar.ContarLista(rLen.Texto) > 0) marcas.Add("acordo de leniência");
            cgu.Status = marcas.Count > 0 ? StatusCheck.Consta : StatusCheck.NadaConsta;
            cgu.Detalhe = marcas.Count > 0 ? "consta em " + string.Join(", ", marcas) : "";
            cgu.Url = Radar.UrlPortal + "/sancoes/consulta";
        }
        else { cgu.Status = rPj.Status == 0 ? StatusCheck.Atalho : StatusCheck.Erro; cgu.Detalhe = ErroP(rPj.Status); cgu.Url = Radar.UrlPortal + "/sancoes/consulta"; }
        if (rCon.Status == 200)
        {
            var (qtd, total, ult) = Radar.LerContratos(rCon.Texto);
            con.Status = StatusCheck.Info;
            con.Detalhe = qtd == 0 ? "nenhum contrato" : $"{qtd}{(qtd >= 15 ? "+" : "")} contratos · {Radar.DinheiroCurto(total)}";
            if (ult != "") con.Fonte = "Portal da Transparência · último em " + ult;
        }
        else { con.Status = rCon.Status == 0 ? StatusCheck.Atalho : StatusCheck.Erro; con.Detalhe = ErroP(rCon.Status); }
        con.Url = Radar.UrlPortal + "/contratos";
        Pronto(seq);
    }

    async Task BancoCentral(Empresa e, int seq)
    {
        var c = Ck("bc")!;
        if (!e.Financeira && !e.Cooperativa)
        {
            c.Status = StatusCheck.Info; c.Detalhe = "não se aplica"; c.Fonte = "não é instituição financeira";
            Pronto(seq); return;
        }
        foreach (var url in Radar.UrlsIfData(e.Cnpj, DateOnly.FromDateTime(DateTime.Today)))
        {
            var r = await E.Nav.GetH(url, null, 20000);
            if (seq != _seq) return;
            if (r.Status != 200) break;
            if (Radar.LerIfData(r.Texto) is { } info)
            {
                c.Status = StatusCheck.Info; c.Detalhe = "em funcionamento"; c.Fonte = "IF.data · " + (info != "" ? info : "consta no cadastro do Banco Central");
                c.Url = Radar.UrlBcInstituicao; Pronto(seq); return;
            }
        }
        c.Status = StatusCheck.Atalho; c.Url = Radar.UrlBcInstituicao; c.Fonte = "Banco Central · Encontre uma instituição";
        c.Detalhe = "confira a autorização no site do BC";
        Pronto(seq);
    }

