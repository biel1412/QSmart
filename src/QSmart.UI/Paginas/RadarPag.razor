    async Task ConsultarCpf(string cpf)
    {
        var seq = ++_seq;
        LimparCpf();
        _cpf = cpf; _cpfNome = _nomeDigitado.Trim(); _finalidadeUsada = _finalidade;
        _buscando = true; _parecer = null; _parecerErro = null; _quando = DateTime.Now; _entrada = Documento.MascararCpf(cpf);
        _checks = ChecagensIniciaisPF();
        _cpfFeito = true;
        StateHasChanged();
        try
        {
            await PortalPF(cpf, seq);
            if (seq != _seq) return;
            await Task.WhenAll(Qgi(seq), Ligadas(seq, null));
        }
        finally { if (seq == _seq) { _buscando = false; StateHasChanged(); } }
        if (seq == _seq && E.ChaveIA != null) await GerarParecer();
    }

