    async Task VerificarMonitorados()
    {
        if (_base == null) return;
        _verificando = true; StateHasChanged();
        var res = new List<(string, string, string, bool)>();
        try
        {
            foreach (var r in _base.Recentes.Where(x => x.Monitorado).ToList())
            {
                var (e, erro) = await BuscarEmpresa(r.Cnpj);
                if (e == null) { res.Add((r.Cnpj, r.Nome, "não consegui consultar agora", false)); continue; }
                var dif = _base.Registrar(e, DateTime.Now);
                res.Add((r.Cnpj, r.Nome, dif.Count > 0 ? "mudou: " + string.Join(", ", dif) : $"sem mudanças · {Cnae.Frase(e.Situacao).ToLowerInvariant()}", dif.Count > 0));
            }
            await E.SalvarRadar();
        }
        finally { _verificando = false; _resMonitor = res; StateHasChanged(); }
    }

