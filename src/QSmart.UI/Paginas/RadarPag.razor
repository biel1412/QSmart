    async Task AnexarJunta(List<QSmart.Core.Planilhas.Arquivo> arqs)
    {
        if (arqs.Count == 0) return;
        try
        {
            var linhas = await E.Nav.PdfLinhas(arqs[0].Dados);
            var ev = Radar.LerCertidaoJunta(linhas);
            if (ev.Count == 0) { await J.Aviso("Certidão da Junta", "Não achei datas de arquivamento neste PDF. Se for uma imagem escaneada, o texto não pode ser lido."); return; }
            _junta = ev; _tlTudo = true;
            await J.Info("Certidão da Junta", $"{ev.Count} eventos entraram na linha do tempo (ficam só nesta consulta).");
        }
        catch (Exception ex) { await J.Aviso("Certidão da Junta", "Não consegui ler o PDF: " + ex.Message); }
    }

