@page "/radar-smart360"
@inherits PaginaBase
@using QSmart.Core.Relacionamento
@implements IDisposable

<Pagina Titulo="Radar Smart360" Grupo="@A.Grupo">
    <Acoes>
        @if (_emp != null && _modo == "cnpj")
        {
            <button class="btn btn-hero" @onclick="Pdf"><Icone Nome="pdf" Tamanho="17" /> Ficha em PDF</button>
            <button class="btn btn-hero" @onclick="CopiarTeams"><Icone Nome="copiar" Tamanho="17" /> Copiar p/ Teams</button>
        }
        else if (_cpfFeito && _modo == "cpf")
        {
            <button class="btn btn-hero" @onclick="PdfCpf"><Icone Nome="pdf" Tamanho="17" /> Ficha em PDF</button>
            <button class="btn btn-hero" @onclick="CopiarTeamsCpf"><Icone Nome="copiar" Tamanho="17" /> Copiar p/ Teams</button>
        }
    </Acoes>
    <ChildContent>
        <div class="rx-busca">
            <div class="rx-tipo">
                <button class="@(_modo == "cnpj" ? "on" : "")" @onclick="ModoCnpj"><Icone Nome="predio" Tamanho="15" /> CNPJ</button>
                <button class="@(_modo == "cpf" ? "on" : "")" @onclick="ModoCpf"><Icone Nome="pessoa" Tamanho="15" /> CPF</button>
            </div>
            <input id="rx-doc" class="rx-in" inputmode="numeric" autocomplete="off" placeholder="@(_modo == "cnpj" ? "00.000.000/0000-00" : "000.000.000-00")"
                   value="@_entrada" @oninput="Digitou" @onkeydown="Tecla" />
            @if (_modo == "cpf")
            {
                <select class="rx-fin @(_finalidade == "" ? "vazio" : "")" value="@_finalidade" @onchange="MudouFinalidade" title="Finalidade da consulta (obrigatória)">
                    <option value="">Finalidade…</option>
                    @foreach (var f in Finalidades) { <option value="@f">@f</option> }
                </select>
            }
            <button class="ia-btn rx-bt @(_buscando ? "rodando" : "")" @onclick="Consultar" disabled="@_buscando">
                @if (_buscando) { <span class="ia-spin"></span> <span>Consultando…</span> }
                else { <Icone Nome="busca" Tamanho="17" /> <span>Consultar</span> }
            </button>
        </div>
        @if (_modo == "cpf")
        {
            <div class="rx-cpf-extra">
                <input class="campo" placeholder="Nome completo (opcional: ajuda a achar inabilitados e empresas ligadas)" value="@_nomeDigitado" @oninput="MudouNome" @onkeydown="Tecla" />
            </div>
            <div class="rx-aviso"><Icone Nome="escudo" Tamanho="16" /> Consulta de CPF: o número aparece mascarado, nada desta consulta fica salvo no QSmart e a finalidade é obrigatória (LGPD).</div>
        }
        else if (_base != null && _base.Recentes.Count > 0)
        {
            <div class="rx-rec">
                <span class="muted">Recentes:</span>
                @foreach (var r in _base.Recentes.Take(8))
                {
                    <span class="rx-chip @(r.Monitorado ? "mon" : "")">
                        <button class="rx-estrela" title="@(r.Monitorado ? "Parar de monitorar" : "Monitorar este CNPJ")" @onclick="() => AlternarMonitor(r)"><Icone Nome="estrela" Tamanho="13" /></button>
                        <button class="rx-chip-txt" title="@Documento.FmtCnpj(r.Cnpj)" @onclick="() => AbrirCnpj(r.Cnpj)">@Curto(r.Nome)</button>
                    </span>
                }
                @if (_base.Recentes.Any(x => x.Monitorado))
                {
                    <button class="btn btn-sec rx-mini" @onclick="VerificarMonitorados" disabled="@_verificando">
                        <Icone Nome="radar" Tamanho="14" /> @(_verificando ? "Verificando…" : $"Verificar monitorados ({_base.Recentes.Count(x => x.Monitorado)})")
                    </button>
                }
            </div>
            @if (_resMonitor != null)
            {
                <div class="rx-monitor">
                    <div class="rx-ct">MONITORADOS <em>verificado às @DateTime.Now.ToString("HH:mm")</em><button class="rx-x" @onclick="FecharMonitor"><Icone Nome="x" Tamanho="14" /></button></div>
                    @foreach (var (cnpj, nome, msg, mudou) in _resMonitor)
                    {
                        <div class="rx-mon-l @(mudou ? "mudou" : "")"><span class="rx-dot @(mudou ? "y" : "g")"></span><button class="rx-link" @onclick="() => AbrirCnpj(cnpj)">@nome</button><small>@msg</small></div>
                    }
                </div>
            }
        }

        @if (_erro != null)
        {
            <div class="ia-erro"><Icone Nome="alerta" Tamanho="18" /><div><b>Não foi possível consultar</b><span>@_erro</span></div></div>
        }

        @if (_modo == "cnpj" && _emp == null && !_buscando && _erro == null)
        {
            <div class="rx-vazio">
                <span class="rx-radar"><Icone Nome="radar" Tamanho="38" /></span>
                <b>Digite um CNPJ para montar a ficha 360</b>
                <span class="muted">Cadastro da Receita, sócios e dirigentes, linha do tempo, Junta Comercial, mapa e checagens públicas (TCU, CNJ, CGU, Banco Central, diários oficiais), com placar e parecer do Mr. Smart.</span>
            </div>
        }
        @if (_modo == "cpf" && !_cpfFeito && !_buscando && _erro == null)
        {
            <div class="rx-vazio">
                <span class="rx-radar"><Icone Nome="pessoa" Tamanho="38" /></span>
                <b>Digite um CPF e escolha a finalidade</b>
                <span class="muted">Validação do CPF, sanções federais, PEP, vínculo de servidor, quadro de inabilitados do Banco Central, benefícios sociais e empresas ligadas.</span>
            </div>
        }

        @if (_modo == "cnpj" && _emp != null)
        {
            var e = _emp;
            var placar = PlacarPJ();
            var hoje = DateOnly.FromDateTime(DateTime.Today);
            <div class="rx-hero">
                <div class="rx-hero-esq">
                    <div class="rx-nome">@e.RazaoSocial</div>
                    <div class="rx-fant">@(e.Fantasia != "" ? $"Nome fantasia: {e.Fantasia} · " : "")CNPJ @e.CnpjFmt · <b>@(e.Matriz ? "Matriz" : "Filial")</b></div>
                    <div class="rx-tags">
                        <span class="rx-tag @(e.Ativa ? "ok" : "r")">● @Cnae.Frase(e.Situacao).ToUpperInvariant() desde @Radar.Dmy(e.DataSituacao)</span>
                        @if (!e.Ativa && e.MotivoSituacao != "") { <span class="rx-tag r">@Cnae.Frase(e.MotivoSituacao)</span> }
                        @if (e.Natureza != "") { <span class="rx-tag">@e.Natureza</span> }
                        @if (e.Porte != "") { <span class="rx-tag">Porte: @Cnae.Frase(e.Porte)</span> }
                        <span class="rx-tag @(e.Simples == true ? "c" : "")">@(e.Simples == true ? $"Simples desde {Radar.Dmy(e.SimplesDesde)}" : "Não optante do Simples")</span>
                        @if (e.Mei == true) { <span class="rx-tag c">MEI desde @Radar.Dmy(e.MeiDesde)</span> }
                        @if (e.SituacaoEspecial != "") { <span class="rx-tag a">⚠ @Cnae.Frase(e.SituacaoEspecial)</span> }
                        @{ var atencoes = _checks.Count(c => c.Status is StatusCheck.Consta or StatusCheck.Atencao); }
                        @if (atencoes > 0) { <span class="rx-tag a">⚠ @atencoes @(atencoes == 1 ? "ponto de atenção" : "pontos de atenção")</span> }
                        @if (_mudouAgora.Count > 0) { <span class="rx-tag k" title="@string.Join(", ", _mudouAgora)">↻ mudou desde a última consulta</span> }
                    </div>
                    <div class="rx-kv">
                        <div><small>ABERTURA</small><b>@Radar.Dmy(e.Abertura) · @e.Idade(hoje)</b></div>
                        <div><small>CAPITAL SOCIAL</small><b>@Radar.Dinheiro(e.Capital)</b></div>
                        <div><small>SEDE</small><b>@e.Municipio · @e.Uf</b></div>
                        <div><small>FONTE</small><b title="@e.Fonte">Receita · até 30 dias</b></div>
                    </div>
                </div>
                <div class="rx-placar">
                    <div class="rx-ct">PLACAR DO RADAR</div>
                    @foreach (var p in placar)
                    {
                        <div class="rx-pl"><i class="@p.Cor"></i><span>@p.Dimensao</span><b class="@p.Cor">@p.Texto</b></div>
                    }
                </div>
            </div>

            @Parecer()

            <div class="rx-g2">
                <div class="rx-card">
                    <div class="rx-ct">✓ CHECAGENS AUTOMÁTICAS <em>@(_quando.ToString("HH:mm"))</em></div>
                    @foreach (var c in _checks.Where(c => c.Id != "cadastro"))
                    {
                        @Linha(c)
                    }
                    @if (_ibge != null) { <p class="rx-nota">IBGE: @e.Municipio/@e.Uf · @_ibge</p> }
                    <p class="rx-nota">Filiais e processos judiciais não têm fonte pública aberta para consulta automática.</p>
                </div>
                <div class="rx-col">
                    <div class="rx-card">
                        <div class="rx-ct">🏭 ATIVIDADES <em>@e.Atividades.Count CNAE</em></div>
                        @foreach (var a in e.Atividades.Take(_todasAtiv ? 99 : 4))
                        {
                            <div class="rx-cnae">
                                <b>@a.CodigoFmt · @a.Descricao</b>
                                <small>@(a.Principal ? "principal" : "secundária")@(a.Area != "" ? " · " + a.Area : "")</small>
                            </div>
                        }
                        @if (e.Atividades.Count > 4) { <button class="rx-link" @onclick="AlternarAtiv">@(_todasAtiv ? "mostrar menos" : $"ver as {e.Atividades.Count} atividades")</button> }
                    </div>
                    <div class="rx-card">
                        <div class="rx-ct">📍 LOCALIZAÇÃO</div>
                        @if (_geo is { } g)
                        {
                            <iframe class="rx-mapa" src="@Radar.UrlMapa(g, _geoCidade ? 0.05 : 0.004)" loading="lazy" title="Mapa"></iframe>
                        }
                        else
                        {
                            <div class="rx-mapa vazio"><Icone Nome="mapa" Tamanho="26" /><span class="muted">@(_geoTentado ? "Endereço não localizado no mapa" : "Localizando…")</span></div>
                        }
                        <small class="rx-end">@e.Endereco · <a href="@Radar.UrlMapaAbrir(e, _geo)" target="_blank" rel="noopener">abrir no mapa ↗</a>@(_geoCidade ? " · (posição aproximada: centro da cidade)" : "")</small>
                        @if (e.Telefone != "" || e.Email != "") { <small class="rx-end">@(e.Telefone != "" ? "Telefone " + Telefone(e.Telefone) : "")@(e.Telefone != "" && e.Email != "" ? " · " : "")@e.Email.ToLowerInvariant()</small> }
                    </div>
                </div>
            </div>

            <div class="rx-g3">
                <div class="rx-card">
                    <div class="rx-ct">👥 SÓCIOS E DIRIGENTES (QSA) <em>@e.Socios.Count</em></div>
                    @if (e.Socios.Count == 0) { <p class="muted">A Receita não informa quadro de sócios para este CNPJ.</p> }
                    @foreach (var s in e.Socios.Take(_todosSocios ? 99 : 6))
                    {
                        <div class="rx-soc">
                            <span class="rx-av @(s.PJ ? "pj" : "")">@(s.PJ ? "PJ" : Radar.Iniciais(s.Nome))</span>
                            <div><b>@Radar.NomeProprio(s.Nome)</b><small>@Radar.Qualificacao(s.Qualificacao)@(s.Entrada != null ? " · desde " + Radar.Dmy(s.Entrada) : "")@(s.FaixaEtaria != "" && !s.PJ ? " · " + s.FaixaEtaria.ToLowerInvariant() : "")</small></div>
                            @if (s.CnpjSocio is { } cs) { <button class="rx-link" @onclick="() => AbrirCnpj(cs)">abrir ficha →</button> }
                        </div>
                    }
                    @if (e.Socios.Count > 6) { <button class="rx-link" @onclick="AlternarSocios">@(_todosSocios ? "mostrar menos" : $"ver todos ({e.Socios.Count})")</button> }
                    @if (e.Socios.Count > 0) { @Rede(e) }
                </div>
                <div class="rx-card">
                    <div class="rx-ct">🕑 LINHA DO TEMPO</div>
                    @{ var linha = Radar.Linha(e, _base?.De(e.Cnpj) ?? new(), _junta); }
                    <div class="rx-tl">
                        @foreach (var ev in linha.Take(_tlTudo ? 200 : 9))
                        {
                            <div class="rx-ev @ev.Cor"><b>@ev.Titulo</b><small>@Radar.Dmy(ev.Data)@(ev.Detalhe != "" ? " · " + ev.Detalhe : "")</small><span class="rx-f">@ev.Fonte</span></div>
                        }
                    </div>
                    @if (linha.Count > 9) { <button class="rx-link" @onclick="AlternarTl">@(_tlTudo ? "mostrar menos" : $"ver os {linha.Count} eventos")</button> }
                    <div class="rx-anexo">
                        <BotaoArquivo Texto="Anexar certidão da Junta (PDF)" Icone="upload" Aceita=".pdf" AoEscolher="AnexarJunta" />
                        @if (_junta.Count > 0) { <small class="muted">@_junta.Count eventos lidos da certidão (só nesta consulta)</small> }
                    </div>
                </div>
                <div class="rx-card">
                    <div class="rx-ct">🏛 JUNTAS COMERCIAIS</div>
                    @{ var j = Radar.JuntaDe(_ufJunta ?? e.Uf); }
                    @if (j != null)
                    {
                        <div class="rx-jun">
                            <div><b>@j.Sigla</b><small>@(j.Uf.Equals(e.Uf, StringComparison.OrdinalIgnoreCase) ? "Junta da UF da empresa" : "Junta selecionada") · @j.Estado</small></div>
                            <div class="rx-jun-bt">
                                <a class="btn btn-sec rx-mini" href="@j.Site" target="_blank" rel="noopener">Site da Junta ↗</a>
                                <a class="btn btn-sec rx-mini" href="@j.Drei" target="_blank" rel="noopener">Página no DREI ↗</a>
                            </div>
                        </div>
                    }
                    <div class="rx-uf">
                        @foreach (var x in Radar.Juntas)
                        {
                            <button class="@(x.Uf.Equals(e.Uf, StringComparison.OrdinalIgnoreCase) ? "on" : "") @(x.Uf == _ufJunta ? "sel" : "")" title="@x.Sigla · @x.Estado" @onclick="() => EscolherUf(x.Uf)">@x.Uf</button>
                        }
                    </div>
                    <p class="rx-nota">Peça a certidão simplificada ou de inteiro teor no site da Junta e anexe na linha do tempo.</p>
                    <div class="rx-ct" style="margin-top:12px">↗ ATALHOS OFICIAIS</div>
                    <div class="rx-atl">
                        @foreach (var (nome, url) in Radar.AtalhosPJ) { <a class="btn btn-sec rx-mini" href="@url" target="_blank" rel="noopener" @onclick="() => CopiarDoc(e.Cnpj)" title="Abre o site oficial (o CNPJ é copiado para colar)">@nome</a> }
                    </div>
                    <div class="rx-atl" style="margin-top:10px">
                        @{ var mon = _base?.Recentes.FirstOrDefault(r => r.Cnpj == e.Cnpj)?.Monitorado == true; }
                        <button class="btn @(mon ? "btn-pri" : "btn-sec") rx-mini" @onclick="MonitorarAtual"><Icone Nome="estrela" Tamanho="14" /> @(mon ? "Monitorando" : "Monitorar")</button>
                        <button class="btn btn-sec rx-mini" @onclick="Pdf"><Icone Nome="pdf" Tamanho="14" /> Ficha em PDF</button>
                        <button class="btn btn-sec rx-mini" @onclick="CopiarTeams"><Icone Nome="copiar" Tamanho="14" /> Copiar p/ Teams</button>
                    </div>
                </div>
            </div>
        }

        @if (_modo == "cpf" && _cpfFeito)
        {
            var placar = PlacarPF();
            <div class="rx-hero">
                <div class="rx-hero-esq">
                    <div class="rx-nome">@(_cpfNome != "" ? _cpfNome.ToUpperInvariant() : "PESSOA CONSULTADA")</div>
                    <div class="rx-fant">CPF @Documento.MascararCpf(_cpf) · consultado hoje, @_quando.ToString("HH:mm") · finalidade: @_finalidadeUsada.ToLowerInvariant()</div>
                    <div class="rx-tags">
                        <span class="rx-tag ok">✓ CPF válido</span>
                        @if (_peps.Count > 0) { <span class="rx-tag a">⚠ Pessoa politicamente exposta</span> }
                        @if (_pf?.Servidor == true) { <span class="rx-tag">Servidor(a) federal</span> }
                        @if (_pf?.ServidorInativo == true) { <span class="rx-tag">Servidor(a) federal inativo(a)</span> }
                        @if (_ligadas.Count > 0) { <span class="rx-tag">@_ligadas.Count @(_ligadas.Count == 1 ? "empresa ligada" : "empresas ligadas")</span> }
                        @if (_pf == null && !E.PortalPronto) { <span class="rx-tag">Portal da Transparência sem chave</span> }
                    </div>
                    <div class="rx-kv">
                        <div><small>SANÇÕES FEDERAIS</small><b class="@CorTxt(placar[0].Cor)">@placar[0].Texto</b></div>
                        <div><small>PEP</small><b class="@CorTxt(placar[2].Cor)">@placar[2].Texto</b></div>
                        <div><small>BANCO CENTRAL</small><b class="@CorTxt(placar[3].Cor)">@placar[3].Texto</b></div>
                        <div><small>BENEFÍCIOS SOCIAIS</small><b>@placar[5].Texto</b></div>
                    </div>
                </div>
                <div class="rx-placar">
                    <div class="rx-ct">PLACAR DO RADAR · CPF</div>
                    @foreach (var p in placar)
                    {
                        <div class="rx-pl"><i class="@p.Cor"></i><span>@p.Dimensao</span><b class="@p.Cor">@p.Texto</b></div>
                    }
                </div>
            </div>

            @Parecer()

            <div class="rx-g3">
                <div class="rx-card">
                    <div class="rx-ct">✓ CHECAGENS AUTOMÁTICAS <em>@(_quando.ToString("HH:mm"))</em></div>
                    @foreach (var c in _checks) { @Linha(c) }
                </div>
                <div class="rx-col">
                    <div class="rx-card">
                        <div class="rx-ct">🏛 PEP E VÍNCULO COM O GOVERNO</div>
                        @if (_pf == null && !E.PortalPronto)
                        {
                            <p class="muted">Precisa da chave do Portal da Transparência. @Estado.MsgSemIA</p>
                        }
                        else
                        {
                            @if (Ck("pep") is { Status: not (StatusCheck.NadaConsta or StatusCheck.Atencao) } pc) { <div class="rx-cnae"><b>Não consegui consultar a lista PEP</b><small>@pc.Detalhe</small></div> }
                            else if (_peps.Count == 0) { <div class="rx-cnae"><b>Não é pessoa politicamente exposta</b><small>Portal da Transparência · lista PEP</small></div> }
                            @foreach (var p in _peps)
                            {
                                <div class="rx-cnae"><b>Pessoa politicamente exposta</b><small>Portal da Transparência · lista PEP</small>
                                    <p>@p.Funcao@(p.Orgao != "" ? " · " + p.Orgao : "")@(p.Inicio != "" ? " · início " + p.Inicio : "")@(p.Fim != "" ? " · fim " + p.Fim : "")@(p.FimCarencia != "" ? " · PEP até " + p.FimCarencia : "")</p></div>
                            }
                            @if (_pf?.Servidor == true || _pf?.ServidorInativo == true || _vinculos.Count > 0)
                            {
                                <div class="rx-cnae"><b>Servidor(a) do Poder Executivo Federal</b><small>@(_pf?.ServidorInativo == true ? "inativo(a)" : "vínculo ativo")</small>
                                    @foreach (var v in _vinculos) { <p>@v.Cargo@(v.Orgao != "" ? " · " + v.Orgao : "")@(v.Situacao != "" ? " · " + v.Situacao.ToLowerInvariant() : "")</p> }
                                </div>
                            }
                            else if (_pf != null) { <div class="rx-cnae"><b>Sem vínculo de servidor federal</b><small>Portal da Transparência</small></div> }
                        }
                    </div>
                    <div class="rx-card">
                        <div class="rx-ct">💳 BENEFÍCIOS SOCIAIS</div>
                        @if (_pf == null)
                        {
                            <p class="muted">@(!E.PortalPronto ? "Precisa da chave do Portal da Transparência." : "O Portal não respondeu.") <a href="@Radar.UrlPortal/beneficios" target="_blank" rel="noopener">Consultar no Portal ↗</a></p>
                        }
                        else
                        {
                            <button class="rx-ben @(_benAberto ? "aberto" : "")" @onclick="AlternarBen">
                                <span class="rx-seta">▸</span>
                                <div><b>Recebe benefício social: @(_pf.RecebeBeneficio ? "sim" : "não")</b><small>@string.Join(", ", _pf.Beneficios.Select(b => b.programa))</small></div>
                                <span class="btn btn-sec rx-mini">@(_benAberto ? "fechar" : "ver detalhes")</span>
                            </button>
                            @if (_benAberto)
                            {
                                <div class="rx-ben-det">
                                    @foreach (var (prog, recebe) in _pf.Beneficios) { <div><span class="rx-dot @(recebe ? "b" : "cz")"></span>@prog<b>@(recebe ? "recebe ou recebeu" : "não")</b></div> }
                                    <small class="muted">Fonte: Portal da Transparência. Valores e parcelas: <a href="@Radar.UrlPortal/beneficios" target="_blank" rel="noopener">consultar no Portal ↗</a></small>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="rx-card">
                    <div class="rx-ct">🏢 EMPRESAS LIGADAS</div>
                    @if (_procurandoLigadas) { <p class="muted"><span class="ia-spin pequeno"></span> Procurando nos quadros de sócios…</p> }
                    @if (!_procurandoLigadas && _ligadas.Count == 0)
                    {
                        <p class="muted">@(_cpfNome == "" ? "Informe o nome para procurar a pessoa nos quadros de sócios." : $"Não encontrada no quadro de sócios dos {_conferidos} CNPJs conferidos.")</p>
                    }
                    @foreach (var (cnpj, nomeEmp, qual, situacao, ativa) in _ligadas)
                    {
                        <div class="rx-soc"><span class="rx-av pj">PJ</span><div><b>@nomeEmp</b><small>@qual · <span class="@(ativa ? "txt-g" : "txt-r")">@situacao.ToLowerInvariant()</span></small></div><button class="rx-link" @onclick="() => AbrirCnpj(cnpj)">ficha 360 →</button></div>
                    }
                    <div class="rx-conferir">
                        <input class="campo" placeholder="Conferir também nestes CNPJs (separe por vírgula)" value="@_cnpjsExtra" @oninput="MudouExtra" />
                        <button class="btn btn-sec rx-mini" @onclick="ConferirExtra" disabled="@(_procurandoLigadas || _cpfNome == "")">Conferir</button>
                    </div>
                    <p class="rx-nota">Busca aproximada: nome + dígitos visíveis do CPF no quadro de sócios dos CNPJs já consultados no Radar e dos que você digitar. Confira antes de concluir.</p>
                    <div class="rx-ct" style="margin-top:12px">↗ ATALHOS OFICIAIS</div>
                    <div class="rx-atl">
                        @foreach (var (nome, url) in Radar.AtalhosPF) { <a class="btn btn-sec rx-mini" href="@url" target="_blank" rel="noopener" @onclick="() => CopiarDoc(_cpf)" title="Abre o site oficial (o CPF é copiado para colar)">@nome</a> }
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "radar360";

    static readonly string[] Finalidades =
    {
