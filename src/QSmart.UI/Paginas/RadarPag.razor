    static string Curto(string s) => s.Length > 26 ? s[..24] + "…" : s;
    static string Telefone(string t) { var d = Documento.Digitos(t); return d.Length >= 10 ? $"({d[..2]}) {d[2..^4]}-{d[^4..]}" : t; }
    static string CorTxt(string c) => c switch { "g" => "txt-g", "rr" => "txt-r", "y" => "txt-y", _ => "" };

    void ModoCnpj() { if (_modo == "cnpj") return; _modo = "cnpj"; _entrada = _emp?.CnpjFmt ?? ""; _erro = null; LimparCpf(); }
    void ModoCpf() { if (_modo == "cpf") return; _modo = "cpf"; _entrada = ""; _erro = null; _parecer = null; _parecerErro = null; _checks = new(); }
    void Digitou(ChangeEventArgs a) => _entrada = Documento.Digitando(a.Value?.ToString(), _modo == "cnpj");
    void MudouFinalidade(ChangeEventArgs a) => _finalidade = a.Value?.ToString() ?? "";
    void MudouNome(ChangeEventArgs a) => _nomeDigitado = a.Value?.ToString() ?? "";
    void MudouExtra(ChangeEventArgs a) => _cnpjsExtra = a.Value?.ToString() ?? "";
