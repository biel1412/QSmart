    [JSInvokable] public void Digitando() { if (_status != "Editando…") { _status = "Editando…"; _statusCls = ""; InvokeAsync(StateHasChanged); } }
    [JSInvokable] public void Salvo() { _status = "Salvo"; _statusCls = "ok"; InvokeAsync(StateHasChanged); }

    [JSInvokable]
    public async Task Mudou(string id, string html)
    {
        var p = _pags.FirstOrDefault(x => x.Id == id);
        if (p == null) return;
        await _fila.WaitAsync();
        try
        {
            if (id == _pag) { _status = "Salvando…"; _statusCls = ""; await InvokeAsync(StateHasChanged); }
            var corpo = Meta(p, html);
            if (_versoes.TryGetValue(id, out var vb)) corpo["base"] = vb;
            var r = await E.Conta.Chamar("PUT", "sn/pagina", corpo);
            if (r.Status == 409)
            {
                // outra pessoa salvou esta página enquanto você editava: pausa e pergunta na própria página
                _conflito = (id, S(r.Json, "quem") is { Length: > 0 } q ? q : "Outra pessoa", html);
                if (id == _pag) { _status = "Não salvo"; _statusCls = "erro"; }
                return;
            }
            if (r.Ok) { p.AtualizadoEm = DateTime.UtcNow.ToString("o"); p.Por = ""; _versoes[id] = I(r.Json, "versao"); _mudouFora = null; if (id == _pag) { _status = $"Salvo às {DateTime.Now:HH:mm}"; _statusCls = "ok"; } }
            else { _status = r.Status == 413 ? r.Erro : "Não salvou: " + r.Erro; _statusCls = "erro"; if (r.Status == 413) await J.Aviso("Smart Note", r.Erro); }
        }
        finally { _fila.Release(); await InvokeAsync(StateHasChanged); }
    }

    static DateTime? Dt(string iso) => DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var d) ? d.ToLocalTime() : null;
    static string Quando(string iso)
    {
        if (Dt(iso) is not { } d) return "";
        var s = DateTime.Now - d;
        if (s.TotalMinutes < 1) return "Agora";
        if (s.TotalMinutes < 60) return $"Há {(int)s.TotalMinutes} min";
        if (d.Date == DateTime.Today) return $"Hoje, {d:HH:mm}";
        if (d.Date == DateTime.Today.AddDays(-1)) return $"Ontem, {d:HH:mm}";
        return d.ToString("dd/MM/yyyy");
    }
    static string DataLonga(string iso) => Dt(iso) is { } d ? $"{d.Day} de {QSmart.Core.Texto.MesesPt[d.Month - 1].ToLowerInvariant()} de {d.Year}, {d:HH:mm}" : "";

