        _carregando = false;
        if (!r.Ok) { await J.Erro("Smart Note", "Não consegui abrir os seus cadernos: " + r.Erro); return; }
        LerLista(r.Json);
        _timer = new System.Threading.Timer(_ => InvokeAsync(Sincronizar), null, 40000, 40000);
        // veio do sininho ou de uma fonte do Mr. Smart IA: smart-note?c=caderno&p=pagina
