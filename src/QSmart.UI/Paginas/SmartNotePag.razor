        else if (_pag != null && Pag is null) { await Fechar(false); }
        else if (Pag is { } p && atual != null && p.AtualizadoEm != atual && p.Por != "" && _versoes.ContainsKey(p.Id))
        {
            // alguém salvou esta página: confere se o texto mudou
            var rp = await E.Conta.Chamar("GET", "sn/pagina?id=" + Uri.EscapeDataString(p.Id));
            if (rp.Ok && I(rp.Json, "versao") != _versoes[p.Id]) _mudouFora = S(rp.Json, "por") is { Length: > 0 } quem ? quem : "Outra pessoa";
        }
