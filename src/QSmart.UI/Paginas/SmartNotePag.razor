    }

    async Task Opcoes(Pagina p)
    {
        var irmas = _pags.Where(x => x.Caderno == p.Caderno && x.Pai == p.Pai).OrderBy(x => x.Ordem).ThenBy(x => x.CriadoEm).ToList();
        int i = irmas.IndexOf(p);
        var ops = new List<(string, string)>();
        if (i > 0) ops.Add(("cima", "Mover para cima"));
        if (i < irmas.Count - 1) ops.Add(("baixo", "Mover para baixo"));
        if (i > 0) ops.Add(("dentro", $"Virar subpágina de “{(irmas[i - 1].Titulo == "" ? "Sem título" : irmas[i - 1].Titulo)}”"));
        if (p.Pai != "") ops.Add(("fora", "Subir um nível (deixar de ser subpágina)"));
        foreach (var c in _cads.Where(c => c.Id != p.Caderno && c.Edita)) ops.Add(("cad:" + c.Id, $"Mover para o caderno “{c.Nome}”"));
        ops.Add(("excluir", "Excluir página"));
        var op = await J.Um(p.Titulo == "" ? "Página sem título" : p.Titulo, ops, "", "O que fazer com esta página?", "");
        if (string.IsNullOrEmpty(op)) return;
        if (op == "excluir") { await ExcluirPagina(p); return; }
        var mexidas = new List<Pagina>();
        void Renumerar(IEnumerable<Pagina> l) { int k = 0; foreach (var x in l) { if (x.Ordem != k) { x.Ordem = k; mexidas.Add(x); } k++; } }
        if (op is "cima" or "baixo")
        {
            irmas.RemoveAt(i); irmas.Insert(op == "cima" ? i - 1 : i + 1, p);
            Renumerar(irmas);
        }
        else if (op == "dentro")
        {
            var novoPai = irmas[i - 1];
            p.Pai = novoPai.Id; _fechadas.Remove(novoPai.Id);
            var filhas = _pags.Where(x => x.Pai == novoPai.Id && x != p).ToList();
            p.Ordem = filhas.Count == 0 ? 0 : filhas.Max(x => x.Ordem) + 1; mexidas.Add(p);
        }
        else if (op == "fora")
        {
            var pai = _pags.First(x => x.Id == p.Pai);
            p.Pai = pai.Pai;
            var novas = _pags.Where(x => x.Caderno == p.Caderno && x.Pai == pai.Pai && x != p).OrderBy(x => x.Ordem).ThenBy(x => x.CriadoEm).ToList();
            novas.Insert(novas.IndexOf(pai) + 1, p);
            mexidas.Add(p); Renumerar(novas);
        }
        else if (op.StartsWith("cad:"))
        {
            var cad = op[4..];
            var tudo = Descendentes(p.Id); tudo.Insert(0, p);
            foreach (var x in tudo) x.Caderno = cad;
            p.Pai = "";
            var raiz = _pags.Where(x => x.Caderno == cad && x.Pai == "" && x != p).ToList();
            p.Ordem = raiz.Count == 0 ? 0 : raiz.Max(x => x.Ordem) + 1;
            mexidas.AddRange(tudo);
            if (_pag != null && tudo.Any(x => x.Id == _pag)) _cad = cad;
        }
        foreach (var x in mexidas.Distinct()) if (!await SalvarMeta(x)) break;
    }

    async Task ExcluirPagina(Pagina p)
    {
        var desc = Descendentes(p.Id);
        if (!await J.Pergunta("Excluir página", $"Excluir “{(p.Titulo == "" ? "Sem título" : p.Titulo)}”{(desc.Count > 0 ? $" e as {desc.Count} subpágina(s)" : "")}? Não dá para desfazer.")) return;
        bool aberta = _pag == p.Id || desc.Any(d => d.Id == _pag);
        if (aberta) await Fechar(false);
        var r = await E.Conta.Chamar("DELETE", "sn/pagina?id=" + Uri.EscapeDataString(p.Id));
        if (!r.Ok) { await J.Erro("Smart Note", r.Erro); return; }
        _pags.Remove(p); foreach (var d in desc) _pags.Remove(d);
        if (aberta && Cad != null && Arvore(Cad.Id).FirstOrDefault() is { } prox) await AbrirPagina(prox.p.Id);
    }

