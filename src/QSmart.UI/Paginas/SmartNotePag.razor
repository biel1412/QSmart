@page "/smart-note"
@inherits PaginaBase
@using System.Text.Json.Nodes
@using Microsoft.JSInterop

<div class="sn">
    @* ---------- cadernos ---------- *@
    <aside class="sn-cads">
        <div class="sn-cab">
            <span class="sn-marca"><Icone Nome="caderno" Tamanho="18" /> Smart Note</span>
            <span class="sn-cab-bts">
                <button class="sn-mais @(_linkGeral != "" ? "pub" : "")" title="Compartilhar todo o Smart Note por link (só leitura)" @onclick="AbrirTudo"><Icone Nome="link" Tamanho="16" /></button>
                <button class="sn-mais" title="Novo caderno" @onclick="NovoCaderno"><Icone Nome="mais" Tamanho="16" /></button>
            </span>
        </div>
        @if (_carregando) { <p class="muted pequeno sn-pad"><span class="ia-spin pequeno"></span> Abrindo…</p> }
        @foreach (var grupo in new[] { true, false })
        {
            var lista = _cads.Where(c => c.Meu == grupo).OrderBy(c => grupo ? c.Ordem.ToString("D6") : c.Nome).ToList();
            if (lista.Count == 0) { continue; }
            @if (!grupo || _cads.Any(c => !c.Meu)) { <div class="sn-grupo">@(grupo ? "Meus cadernos" : "Compartilhados comigo")</div> }
            @foreach (var c in lista)
            {
                int n = _pags.Count(p => p.Caderno == c.Id);
                <div class="sn-cad @(c.Id == _cad ? "on" : "")" style="--c:@c.Cor" @onclick="() => AbrirCaderno(c.Id)">
                    <span class="sn-cad-ic">@if (c.Meu && c.Membros == 0) { <Icone Nome="caderno" Tamanho="16" /> } else { <Icone Nome="pessoa" Tamanho="16" /> }</span>
                    <span class="sn-cad-nome"><b>@c.Nome</b>
                        <small>@if (c.Meu)
                            {
                                @(n == 1 ? "1 página" : $"{n} páginas")
                                @if (c.Membros > 0) { <em class="sn-cad-pub" title="Pessoas com acesso"> · @(c.Membros + 1) pessoas</em> }
                                @if (c.Link != "") { <em class="sn-cad-pub" title="Tem link de leitura ativo"><Icone Nome="link" Tamanho="11" /></em> }
                            }
                            else { <span>de @PrimeiroNome(c.Dono) · @(c.Edita ? "pode editar" : "só leitura")</span> }</small></span>
                    <span class="sn-cad-ac">
                        @if (c.Meu)
                        {
                            <button title="Compartilhar" @onclick:stopPropagation="true" @onclick="() => AbrirComp(c)"><Icone Nome="pessoa" Tamanho="14" /></button>
                            <button title="Renomear" @onclick:stopPropagation="true" @onclick="() => RenomearCaderno(c)"><Icone Nome="editar" Tamanho="14" /></button>
                            <button title="Mudar a cor" @onclick:stopPropagation="true" @onclick="() => MudarCor(c)"><span class="sn-bolinha"></span></button>
                            <button title="Excluir caderno" @onclick:stopPropagation="true" @onclick="() => ExcluirCaderno(c)"><Icone Nome="lixo" Tamanho="14" /></button>
                        }
                        else
                        {
                            <button title="Ver quem tem acesso" @onclick:stopPropagation="true" @onclick="() => AbrirComp(c)"><Icone Nome="pessoa" Tamanho="14" /></button>
                            <button title="Sair deste caderno" @onclick:stopPropagation="true" @onclick="() => SairCaderno(c)"><Icone Nome="sair" Tamanho="14" /></button>
                        }
                    </span>
                </div>
            }
        }
        <div class="sn-cads-pe"><Icone Nome="cadeado" Tamanho="13" /> Salvo criptografado · só vê quem você der acesso</div>
    </aside>

    @* ---------- páginas ---------- *@
    <section class="sn-pags" style="--c:@(Cad?.Cor ?? "#7C3AED")">
        @if (Cad is { } cad)
        {
            <div class="sn-cab">
                <b class="sn-pags-tit">@cad.Nome</b>
                <span class="sn-cab-bts">
                    <button class="sn-mais @(cad.Link != "" || cad.Membros > 0 ? "pub" : "")" title="@(cad.Meu ? "Compartilhar com pessoas ou por link" : "Quem tem acesso")" @onclick="() => AbrirComp(cad)"><Icone Nome="pessoa" Tamanho="16" /></button>
                    @if (cad.Edita) { <button class="sn-mais" title="Nova página" @onclick="() => NovaPagina(null)"><Icone Nome="mais" Tamanho="16" /></button> }
                </span>
            </div>
            @if (!cad.Meu) { <div class="sn-de"><Icone Nome="pessoa" Tamanho="13" /> Caderno de <b>@cad.Dono</b> · @(cad.Edita ? "você pode editar" : "somente leitura")</div> }
            <div class="sn-busca"><Icone Nome="busca" Tamanho="14" /><input placeholder="Buscar páginas…" @bind="_busca" @bind:event="oninput" /></div>
            <div class="sn-lista">
                @{ var arv = Arvore(cad.Id); }
                @if (arv.Count == 0) { <p class="muted pequeno sn-pad">@(cad.Edita ? "Nenhuma página. Clique em + para criar." : "Este caderno ainda não tem páginas.")</p> }
                @foreach (var (p, nivel, filhos) in arv)
                {
                    <div class="sn-pag @(p.Id == _pag ? "on" : "")" style="--n:@nivel" @onclick="() => AbrirPagina(p.Id)">
                        @if (filhos > 0)
                        {
                            <button class="sn-seta @(_fechadas.Contains(p.Id) ? "" : "aberta")" @onclick:stopPropagation="true" @onclick="() => Dobrar(p.Id)"><Icone Nome="direita" Tamanho="12" /></button>
                        }
                        else { <span class="sn-seta"></span> }
                        <span class="sn-pag-txt"><b>@(p.Titulo == "" ? "Sem título" : p.Titulo)</b><small>@Quando(p.AtualizadoEm)@(p.Por != "" ? " · " + PrimeiroNome(p.Por) : "")</small></span>
                        @if (cad.Edita)
                        {
                        <span class="sn-pag-ac">
                            <button title="Nova subpágina" @onclick:stopPropagation="true" @onclick="() => NovaPagina(p.Id)"><Icone Nome="subpagina" Tamanho="14" /></button>
                            <button title="Mais opções" @onclick:stopPropagation="true" @onclick="() => Opcoes(p)"><Icone Nome="menu" Tamanho="14" /></button>
                        </span>
                        }
                    </div>
                }
            </div>
        }
        else if (!_carregando)
        {
            <div class="sn-vazio-col"><p class="muted">Crie um caderno para começar.</p></div>
        }
    </section>

    @* ---------- editor ---------- *@
    <section class="sn-ed">
        @if (Pag is { } pg)
        {
            <div class="sn-topo">
                <div class="sn-trilha">@foreach (var t in Caminho(pg)) { <span>@t</span><Icone Nome="direita" Tamanho="11" /> }<b>@(pg.Titulo == "" ? "Sem título" : pg.Titulo)</b></div>
                <span class="sn-status @_statusCls">@_status</span>
            </div>
            @if (_conflito is { } cf && cf.id == pg.Id)
            {
                <div class="sn-aviso conflito"><Icone Nome="alerta" Tamanho="16" /> <span><b>@cf.quem</b> salvou esta página enquanto você editava. Suas mudanças ainda não foram salvas.</span>
                    <button class="btn btn-sec btn-peq" @onclick="VerDela">Ver a versão de @PrimeiroNome(cf.quem)</button>
                    <button class="btn btn-pri btn-peq" @onclick="ManterMinha">Manter a minha</button></div>
            }
            else if (_mudouFora != null)
            {
                <div class="sn-aviso"><Icone Nome="atualizar" Tamanho="15" /> <span><b>@_mudouFora</b> alterou esta página agora há pouco.</span><button class="btn btn-sec btn-peq" @onclick="RecarregarPagina">Ver a versão nova</button></div>
            }
            @if (Cad?.Edita == false)
            {
                <div class="sn-so-ler"><Icone Nome="olho" Tamanho="15" /> Somente leitura · caderno de @Cad.Dono</div>
            }
            else
            {
            <div class="sn-barra" @ref="_barra">
                <button title="Desfazer (Ctrl+Z)" data-cmd="undo"><Icone Nome="desfazer" Tamanho="16" /></button>
                <button title="Refazer (Ctrl+Y)" data-cmd="redo"><Icone Nome="refazer" Tamanho="16" /></button>
                <i></i>
                <button class="tx" title="Título" data-cmd="h1">T1</button>
                <button class="tx" title="Subtítulo" data-cmd="h2">T2</button>
                <button class="tx" title="Tópico" data-cmd="h3">T3</button>
                <button class="tx" title="Texto normal" data-cmd="p">¶</button>
                <i></i>
                <button class="tx b" title="Negrito (Ctrl+B)" data-cmd="bold">B</button>
                <button class="tx it" title="Itálico (Ctrl+I)" data-cmd="italic">I</button>
                <button class="tx u" title="Sublinhado (Ctrl+U)" data-cmd="underline">U</button>
                <button class="tx s" title="Tachado" data-cmd="strikeThrough">S</button>
                <span class="sn-cores" title="Cor do texto">
                    <Icone Nome="cor-texto" Tamanho="16" />
                    <span class="sn-paleta">@foreach (var c in CoresTexto) { <button style="background:@c" data-cmd="foreColor" data-val="@c"></button> }</span>
                </span>
                <span class="sn-cores" title="Marca-texto">
                    <Icone Nome="marca-texto" Tamanho="16" />
                    <span class="sn-paleta">@foreach (var c in CoresMarca) { <button style="background:@c" data-cmd="hiliteColor" data-val="@c"></button> }</span>
                </span>
                <i></i>
                <button title="Lista" data-cmd="insertUnorderedList"><Icone Nome="lista" Tamanho="16" /></button>
                <button title="Lista numerada" data-cmd="insertOrderedList"><Icone Nome="lista-num" Tamanho="16" /></button>
                <button title="Lista de tarefas (clique na caixinha para marcar)" data-cmd="check"><Icone Nome="lista-check" Tamanho="16" /></button>
                <button title="Diminuir recuo (Shift+Tab)" data-cmd="outdent"><Icone Nome="desrecuo" Tamanho="16" /></button>
                <button title="Aumentar recuo (Tab)" data-cmd="indent"><Icone Nome="recuo" Tamanho="16" /></button>
                <i></i>
                <span class="sn-cores" title="Alinhamento">
                    <Icone Nome="alinhar-esq" Tamanho="16" />
                    <span class="sn-paleta sn-menu">
                        <button title="Alinhar à esquerda" data-cmd="justifyLeft"><Icone Nome="alinhar-esq" Tamanho="16" /></button>
                        <button title="Centralizar" data-cmd="justifyCenter"><Icone Nome="alinhar-centro" Tamanho="16" /></button>
                        <button title="Alinhar à direita" data-cmd="justifyRight"><Icone Nome="alinhar-dir" Tamanho="16" /></button>
                    </span>
                </span>
                <i></i>
                <button title="Imagem (ou cole com Ctrl+V)" data-cmd="imagem"><Icone Nome="imagem" Tamanho="16" /></button>
                <button title="Link" data-cmd="link"><Icone Nome="link" Tamanho="16" /></button>
                <span class="sn-cores" title="Inserir">
                    <Icone Nome="mais" Tamanho="16" />
                    <span class="sn-paleta sn-menu dir">
                        <button data-cmd="tabela"><Icone Nome="tabela" Tamanho="16" /> Tabela</button>
                        <button data-cmd="insertHorizontalRule"><Icone Nome="linha" Tamanho="16" /> Linha divisória</button>
                        <button data-cmd="data"><Icone Nome="calendario" Tamanho="16" /> Data de hoje</button>
                        <button data-cmd="blockquote"><Icone Nome="conversa" Tamanho="16" /> Citação</button>
                        <button data-cmd="removeFormat"><Icone Nome="borracha" Tamanho="16" /> Limpar formatação</button>
                    </span>
                </span>
            </div>
            }
            <input type="file" accept="image/*" multiple hidden @ref="_arq" />
            <div class="sn-folha" style="--c:@(Cad?.Cor ?? "#7C3AED")">
                <input class="sn-titulo" placeholder="Título da página" value="@pg.Titulo" @onchange="e => MudarTitulo(pg, e)" id="sn-titulo" readonly="@(Cad?.Edita == false)" />
                <div class="sn-meta">@DataLonga(pg.CriadoEm) · editada @Quando(pg.AtualizadoEm).ToLowerInvariant()@(pg.Por != "" ? " por " + pg.Por : "")</div>
                @if (_abrindo) { <p class="muted"><span class="ia-spin pequeno"></span> Abrindo a página…</p> }
                <div @key="pg.Id" class="sn-texto @(_abrindo ? "oculto" : "")" @ref="_ed" data-placeholder="Escreva aqui. Cole imagens com Ctrl+V ou arraste para cá."></div>
            </div>
        }
        else
        {
            <div class="sn-boas">
                <span class="sn-boas-ic"><Icone Nome="caderno" Tamanho="40" /></span>
                <h2>@(_cads.Count == 0 ? "Seu primeiro caderno" : "Escolha ou crie uma página")</h2>
                <p class="muted">Organize as anotações em <b>cadernos</b>, <b>páginas</b> e <b>subpáginas</b>. Formate o texto, faça listas de tarefas e tabelas e cole prints direto com Ctrl+V. Tudo fica salvo sozinho na sua conta e só você vê.</p>
                @if (_cads.Count == 0) { <button class="btn btn-pri" @onclick="NovoCaderno"><Icone Nome="mais" Tamanho="16" /> Criar caderno</button> }
                else if (Cad != null) { <button class="btn btn-pri" @onclick="() => NovaPagina(null)"><Icone Nome="mais" Tamanho="16" /> Nova página</button> }
            </div>
        }
    </section>
</div>

@if (_comp is { } cc)
{
    <div class="sn-comp-fundo" @onclick="() => _comp = null"></div>
    <div class="sn-comp" style="--c:@cc.Cor">
        <div class="sn-comp-cab">
            <span class="sn-cad-ic"><Icone Nome="pessoa" Tamanho="16" /></span>
            <div><b>@(cc.Meu ? $"Compartilhar “{cc.Nome}”" : $"Quem tem acesso a “{cc.Nome}”")</b>
                <small>@(cc.Meu ? "Dê acesso a pessoas do QSmart para editar ou só ler. Elas veem o caderno em “Compartilhados comigo”." : $"Este caderno é de {cc.Dono}. Só quem criou pode mudar os acessos.")</small></div>
            <button class="oo-x" @onclick="() => _comp = null" title="Fechar"><Icone Nome="x" Tamanho="18" /></button>
        </div>
        <div class="sn-comp-corpo">
            @if (cc.Meu)
            {
                <div class="sn-comp-add">
                    <select class="campo" value="@_novaPessoa" @onchange="@(e => _novaPessoa = e.Value?.ToString() ?? "")">
                        <option value="">Escolha uma pessoa do QSmart…</option>
                        @foreach (var x in _pessoas.Where(x => !_membros.Any(m => m.Id == x.Id))) { <option value="@x.Id">@x.Nome (@x.Usuario)</option> }
                    </select>
                    <select class="campo sn-comp-papel" value="@_novoPapel" @onchange="@(e => _novoPapel = e.Value?.ToString() ?? "editor")">
                        <option value="editor">Pode editar</option>
                        <option value="leitor">Só ler</option>
                    </select>
                    <button class="btn btn-pri" disabled="@(_novaPessoa == "" || _salvandoMembro)" @onclick="() => AdicionarMembro(cc)"><Icone Nome="mais" Tamanho="15" /> Dar acesso</button>
                </div>
            }
            <div class="sn-comp-tit">Pessoas com acesso</div>
            @if (_carregandoMembros) { <p class="muted pequeno"><span class="ia-spin pequeno"></span> Carregando…</p> }
            <ul class="sn-membros">
                @foreach (var mb in _membros)
                {
                    <li>
                        <span class="sn-mb-av" style="background:@CorNome(mb.Nome)">@if (mb.Foto != "") { <img src="@mb.Foto" alt="" /> } else { @IniciaisDe(mb.Nome) }</span>
                        <div><b>@mb.Nome@(mb.Id == E.Conta.Perfil?.Id ? " (você)" : "")</b><small>@mb.Usuario</small></div>
                        @if (mb.Papel == "dono") { <span class="sn-mb-papel dono">Dono</span> }
                        else if (cc.Meu)
                        {
                            <select class="campo sn-comp-papel" value="@mb.Papel" @onchange="e => MudarPapel(cc, mb, e)">
                                <option value="editor">Pode editar</option>
                                <option value="leitor">Só ler</option>
                            </select>
                            <button class="sn-mb-x" title="Tirar o acesso" @onclick="() => TirarMembro(cc, mb)"><Icone Nome="x" Tamanho="15" /></button>
                        }
                        else { <span class="sn-mb-papel">@(mb.Papel == "editor" ? "Pode editar" : "Só ler")</span> }
                    </li>
                }
            </ul>

            @if (cc.Meu)
            {
                <div class="sn-comp-sep"></div>
                <div class="sn-comp-tit">Link de leitura <small>para quem não tem acesso ao QSmart</small></div>
                @if (cc.Link == "")
                {
                    <p class="muted pequeno" style="margin:0">Quem tiver o link vê o caderno no navegador, sem login, e não consegue editar. Dá para salvar nos favoritos e desativar quando quiser.</p>
                    <button class="btn btn-sec" style="align-self:flex-start" disabled="@_gerando" @onclick="() => GerarLink(cc)"><Icone Nome="link" Tamanho="16" /> @(_gerando ? "Gerando…" : "Gerar link de leitura")</button>
                }
                else
                {
                    <span class="sn-comp-ativo"><i></i> Link ativo</span>
                    <div class="sn-comp-url"><input readonly value="@Url(cc)" /><button class="btn btn-pri" @onclick="() => CopiarLink(cc)"><Icone Nome="@(_copiado ? "check" : "copiar")" Tamanho="15" /> @(_copiado ? "Copiado" : "Copiar")</button></div>
                    <div class="sn-comp-pe">
                        <a class="btn btn-sec" href="@Url(cc)" target="_blank" rel="noopener"><Icone Nome="olho" Tamanho="15" /> Ver como os outros veem</a>
                        <span class="mola"></span>
                        <button class="btn btn-sec" disabled="@_gerando" @onclick="() => GerarLink(cc, true)" title="O link atual para de funcionar">Gerar outro link</button>
                        <button class="btn btn-sec sn-comp-off" @onclick="() => DesativarLink(cc)">Desativar</button>
                    </div>
                }
            }
            else
            {
                <button class="btn btn-sec sn-comp-off" style="align-self:flex-start" @onclick="() => SairCaderno(cc)"><Icone Nome="sair" Tamanho="15" /> Sair deste caderno</button>
            }
        </div>
    </div>
}

@if (_compTudo)
{
    <div class="sn-comp-fundo" @onclick="() => _compTudo = false"></div>
    <div class="sn-comp" style="--c:#7C3AED">
        <div class="sn-comp-cab">
            <span class="sn-cad-ic"><Icone Nome="link" Tamanho="16" /></span>
            <div><b>Compartilhar todo o Smart Note</b>
                <small>Um link só, com todos os seus cadernos (@_cads.Count(c => c.Meu)). Quem tiver o link lê no navegador, sem login, e não edita. Cadernos que você criar depois entram sozinhos.</small></div>
            <button class="oo-x" @onclick="() => _compTudo = false" title="Fechar"><Icone Nome="x" Tamanho="18" /></button>
        </div>
        <div class="sn-comp-corpo">
            @if (_cads.Any(c => !c.Meu)) { <p class="muted pequeno" style="margin:0"><Icone Nome="info" Tamanho="13" /> Os cadernos que outras pessoas compartilharam com você não entram: eles são delas.</p> }
            @if (_linkGeral == "")
            {
                <button class="btn btn-pri" style="align-self:flex-start" disabled="@_gerando" @onclick="GerarLinkGeral"><Icone Nome="link" Tamanho="16" /> @(_gerando ? "Gerando…" : "Gerar link do Smart Note inteiro")</button>
            }
            else
            {
                <span class="sn-comp-ativo"><i></i> Link ativo</span>
                <div class="sn-comp-url"><input readonly value="@UrlGeral" /><button class="btn btn-pri" @onclick="CopiarGeral"><Icone Nome="@(_copiado ? "check" : "copiar")" Tamanho="15" /> @(_copiado ? "Copiado" : "Copiar")</button></div>
                <div class="sn-comp-pe">
                    <a class="btn btn-sec" href="@UrlGeral" target="_blank" rel="noopener"><Icone Nome="olho" Tamanho="15" /> Ver como os outros veem</a>
                    <span class="mola"></span>
                    <button class="btn btn-sec" disabled="@_gerando" @onclick="() => GerarLinkGeral(true)" title="O link atual para de funcionar">Gerar outro link</button>
                    <button class="btn btn-sec sn-comp-off" @onclick="DesativarGeral">Desativar</button>
                </div>
            }
        </div>
    </div>
}

@code {
    protected override string Chave => "smartnote";
    bool _compTudo;
    string _linkGeral = "";
    string UrlGeral => Rotas.BaseUri + "?caderno=" + Uri.EscapeDataString(_linkGeral);
    void AbrirTudo() { _compTudo = true; _copiado = false; }
    async Task GerarLinkGeral() => await GerarLinkGeral(false);
    async Task GerarLinkGeral(bool trocar)
    {
        if (trocar && !await J.Pergunta("Gerar outro link", "O link atual do Smart Note inteiro vai parar de funcionar para quem já tem. Gerar um novo?")) return;
        _gerando = true;
        var r = await E.Conta.Chamar("POST", "sn/link", new JsonObject { ["caderno"] = "*" });
        _gerando = false;
        if (!r.Ok) { await J.Erro("Compartilhar", r.Erro); return; }
        _linkGeral = S(r.Json, "token");
        await CopiarGeral();
        _ = E.Conta.Registrar("nota.link", true);
    }
    async Task CopiarGeral() { _copiado = await E.Nav.Copiar(UrlGeral); StateHasChanged(); }
    async Task DesativarGeral()
    {
        if (!await J.Pergunta("Desativar link", "Quem tiver o link do seu Smart Note inteiro não vai mais conseguir abrir. Desativar?")) return;
        var r = await E.Conta.Chamar("DELETE", "sn/link?caderno=*");
        if (!r.Ok) { await J.Erro("Compartilhar", r.Erro); return; }
        _linkGeral = ""; _copiado = false;
    }
    Caderno? _comp;
    bool _gerando, _copiado, _carregandoMembros, _salvandoMembro;
    readonly Dictionary<string, int> _versoes = new();
    List<Membro> _membros = new();
    List<PessoaQS> _pessoas = new();
    string _novaPessoa = "", _novoPapel = "editor";

    async Task AbrirComp(Caderno c)
    {
        _comp = c; _membros = new(); _novaPessoa = ""; _novoPapel = "editor"; _copiado = false; _carregandoMembros = true;
        StateHasChanged();
        await CarregarMembros(c);
        if (c.Meu && _pessoas.Count == 0)
        {
            var r = await E.Conta.Chamar("GET", "sn/pessoas");
            if (r.Ok) _pessoas = (r.Json?["pessoas"] as JsonArray ?? new()).Select(x => new PessoaQS(I(x, "id"), S(x, "nome"), S(x, "usuario"))).ToList();
        }
    }

    async Task CarregarMembros(Caderno c)
    {
        var r = await E.Conta.Chamar("GET", "sn/membros?caderno=" + Uri.EscapeDataString(c.Id));
        _carregandoMembros = false;
        if (!r.Ok) { await J.Erro("Compartilhar", r.Erro); return; }
