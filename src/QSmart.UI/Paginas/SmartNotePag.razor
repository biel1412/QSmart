    void LerLista(JsonNode? j)
    {
        _cads.Clear(); _pags.Clear();
        _linkGeral = S(j, "linkGeral");
        foreach (var x in j?["cadernos"] as JsonArray ?? new())
            _cads.Add(new Caderno { Id = S(x, "id"), Nome = S(x, "nome"), Cor = S(x, "cor") is { Length: > 0 } c ? c : Cores[0], Ordem = I(x, "ordem"), Link = S(x, "link"), Papel = S(x, "papel") is { Length: > 0 } pp ? pp : "dono", Dono = S(x, "dono"), Membros = I(x, "membros") });
        foreach (var x in j?["paginas"] as JsonArray ?? new())
            _pags.Add(new Pagina { Id = S(x, "id"), Caderno = S(x, "caderno"), Pai = S(x, "pai"), Titulo = S(x, "titulo"), Ordem = I(x, "ordem"), CriadoEm = S(x, "criadoEm"), AtualizadoEm = S(x, "atualizadoEm"), Por = S(x, "por") });
    }

    string? _urlTratada;
    async Task<bool> AbrirDaUrl()
    {
        if (_urlTratada == Rotas.Uri) return false;
        _urlTratada = Rotas.Uri;
        var q = new Uri(Rotas.Uri).Query.TrimStart('?').Split('&').Select(x => x.Split('=', 2)).Where(x => x.Length == 2).ToDictionary(x => x[0], x => Uri.UnescapeDataString(x[1]));
        if (q.TryGetValue("p", out var pid) && _pags.FirstOrDefault(x => x.Id == pid) is { } pg) { _cad = pg.Caderno; _busca = ""; await AbrirPagina(pg.Id); return true; }
        if (q.TryGetValue("c", out var cid) && _cads.Any(c => c.Id == cid)) { AbrirCaderno(cid); return true; }
        return false;
    }
