@page "/one-a-one"
@inherits PaginaBase
@using QSmart.Core.Coordenacao

@{ var b = E.OneBase; Montar(); }
<Pagina Titulo="One a One" Grupo="@A.Grupo"
        Sub="Cada colaborador é um cartão que anda sozinho na esteira conforme o tempo passa: Em dia → Chegando → Atrasado. Fez o 1:1? Registre e o cartão volta para o começo."
        Kpis="@(b != null && _ativos > 0 ? KpisOO : null)">
    <Acoes>
        <button class="btn btn-hero" disabled="@(b == null || b.Pessoas.Count == 0)" @onclick="Exportar" title="A carteira em planilha, com o histórico"><Icone Nome="download" Tamanho="17" /> Exportar planilha</button>
    </Acoes>
    <ChildContent>
        @if (E.OneErro != null)
        {
            <div class="oo-bloqueio"><Icone Nome="cadeado" Tamanho="26" /><div><b>@E.OneErro</b><p class="muted">O One a One é da coordenação: cada coordenador vê as pessoas da planilha que carregou no Perfil e o administrador vê todas.</p></div></div>
        }
        else if (b == null)
        {
            <p class="muted"><span class="ia-spin pequeno"></span> Abrindo a carteira do banco…</p>
        }
        else if (b.Pessoas.Count == 0 && b.TodasLiderancas().Count == 0)
        {
            @if (_antigo != null)
            {
                <div class="oo-migra"><Icone Nome="upload" Tamanho="22" /><div><b>Este navegador tem uma carteira antiga com @Ferias.Plural(_antigo.Pessoas.Count, "pessoa", "pessoas")</b>
                    <p class="muted">Ela era guardada só aqui. Envie uma vez para o banco do QSmart e ela passa a valer para toda a coordenação, com o histórico de 1:1.</p></div>
                    <button class="btn btn-pri" @onclick="EnviarAntigo" disabled="@_enviando">@(_enviando ? "Enviando…" : "Enviar para o banco")</button></div>
            }
            <div class="fa-intro">
                <div class="fa-passo"><span>1</span><div><b>Carregue a base no Perfil</b><p class="muted">A planilha com nome, admissão e liderança, carregada uma vez no seu Perfil, já monta as esteiras aqui e as Férias. Ou cadastre à mão:</p>
                    <a class="btn btn-pri" href="perfil"><Icone Nome="upload" Tamanho="15" /> Carregar a planilha</a>
                    @if (E.OneGere) { <button class="btn btn-sec" @onclick="NovaLideranca"><Icone Nome="mais" Tamanho="15" /> Liderança</button> }</div></div>
                <div class="fa-passo"><span>2</span><div><b>Cadastre as pessoas</b><p class="muted">Nome, liderança e tipo: Novo (1:1 a cada 30 dias) ou Antigo (a cada 90).</p>
                    <button class="btn btn-sec" @onclick="NovaPessoa"><Icone Nome="mais" Tamanho="15" /> Pessoa</button></div></div>
                <div class="fa-passo"><span>3</span><div><b>Registre cada 1:1</b><p class="muted">Clique no cartão, anote o que foi conversado e a ação combinada. O próximo 1:1 é calculado sozinho.</p></div></div>
            </div>
            <p class="fa-privado"><Icone Nome="escudo" Tamanho="16" /> Tudo fica no banco do QSmart, criptografado. Só a coordenação entra, e cada coordenador vê só as pessoas da sua coordenação. A planilha serve só para exportar.</p>
        }
        else
        {
            @if (_coord == null)
            {
                <div class="oc-cab">
                    <div><b>@(E.OneVeTudo ? "Coordenações" : "Sua coordenação")</b><span class="muted pequeno">@(E.OneVeTudo ? "clique numa coordenação para ver a carteira das lideranças" : "clique para ver a carteira das suas lideranças")</span></div>
                    <span class="mola"></span>
                    <span class="fa-cadeado" title="Salvo no banco do QSmart, criptografado"><Icone Nome="escudo" Tamanho="14" /> salvo no banco · criptografado</span>
                    <button class="btn btn-sec" @onclick="Recarregar" title="Buscar as mudanças feitas por outras pessoas"><Icone Nome="atualizar" Tamanho="15" /></button>
                </div>
                <div class="oc-grade">
                    @foreach (var c in _coords)
                    {
                        var cc = c;
                        int t = c.Pessoas.Count, em = c.Pessoas.Count(p => OneAOne.Faixa(p, _hoje) == FaixaOO.EmDia), ch = c.Pessoas.Count(p => OneAOne.Faixa(p, _hoje) == FaixaOO.Chegando), at = t - em - ch;
                        int pct = t == 0 ? 0 : (int)Math.Round(em * 100.0 / t);
                        <button class="oc-card @(c.Chave == "" ? "sem" : "")" @onclick="() => AbrirCoord(cc.Chave)">
                            <div class="oc-topo">
                                <span class="oc-av" style="background:@CorLider(c.Nome)">@(c.Chave == "" ? "?" : Iniciais(c.Nome))</span>
                                <div><b>@c.Nome</b><small>@Ferias.Plural(c.Lids.Count, "liderança", "lideranças") · @Ferias.Plural(t, "colaborador", "colaboradores")</small></div>
                                <span class="oc-pct" style="--p:@pct"><span>@pct%</span></span>
                            </div>
                            <div class="oc-barra">
                                <i class="g" style="flex:@em"></i><i class="a" style="flex:@ch"></i><i class="r" style="flex:@at"></i>
                                @if (t == 0) { <i class="v" style="flex:1"></i> }
                            </div>
                            <div class="oc-nums"><span class="g">@em em dia</span><span class="a">@ch chegando</span><span class="r">@at atrasados</span></div>
                            <div class="oc-lids">
                                @foreach (var l in c.Lids.Take(8))
                                {
                                    var n = c.Pessoas.Count(p => p.Lideranca == l);
                                    <span style="--c:@CorLider(l)"><i></i>@l <small>@n</small></span>
                                }
                                @if (c.Lids.Count > 8) { <span>+@(c.Lids.Count - 8)</span> }
                                @if (c.Lids.Count == 0) { <small class="muted">nenhuma liderança ainda</small> }
                            </div>
                            <span class="oc-abrir">Ver carteira <Icone Nome="direita" Tamanho="14" /></span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="oc-trilha">
                    <button class="btn btn-sec btn-peq" @onclick="() => AbrirCoord(null)"><Icone Nome="esquerda" Tamanho="14" /> Coordenações</button>
                    <span class="oc-av peq" style="background:@CorLider(NomeCoord)">@(_coord == "" ? "?" : Iniciais(NomeCoord))</span>
                    <b>@NomeCoord</b>
                    <small class="muted">@Ferias.Plural(_lids.Count, "liderança", "lideranças")</small>
                </div>
            @if (_mud != null) { @PainelMudancas }

            <div class="barra-ferr">
                <span class="rotulo">Liderança</span>
                <select class="campo" style="min-width:150px" value="@_lider" @onchange="e => _lider = e.Value?.ToString() ?? Todas">
                    <option value="@Todas">Todas (@_lids.Count)</option>
                    @foreach (var l in _lids) { <option value="@l">@l</option> }
                </select>
                <input class="campo" style="width:200px" placeholder="Buscar pessoa…" @bind="_busca" @bind:event="oninput" />
                <button class="btn btn-sec" @onclick="NovaPessoa"><Icone Nome="mais" Tamanho="15" /> Pessoa</button>
                @if (E.OneGere) { <button class="btn btn-sec" @onclick="NovaLideranca"><Icone Nome="mais" Tamanho="15" /> Liderança</button> }
                <span class="mola"></span>
                <span class="fa-cadeado" title="Salvo no banco do QSmart, criptografado"><Icone Nome="escudo" Tamanho="14" /> salvo no banco · criptografado</span>
                <button class="btn btn-sec" @onclick="Recarregar" title="Buscar as mudanças feitas por outras pessoas"><Icone Nome="atualizar" Tamanho="15" /></button>
            </div>
            @if (_antigo != null)
            {
                <div class="oo-migra"><Icone Nome="upload" Tamanho="22" /><div><b>Este navegador ainda tem a carteira antiga (@Ferias.Plural(_antigo.Pessoas.Count, "pessoa", "pessoas"))</b>
                    <p class="muted">Envie para o banco para não perder o histórico. Quem já existir com o mesmo cadastro é atualizado.</p></div>
                    <button class="btn btn-pri" @onclick="EnviarAntigo" disabled="@_enviando">@(_enviando ? "Enviando…" : "Enviar para o banco")</button></div>
            }

            <div class="oo-grade">
                <div>
                    <div class="oo-legenda"><div></div><div><i class="g"></i>EM DIA</div><div title="Vence em até @OneAOne.Chegando dias"><i class="a"></i>CHEGANDO</div><div><i class="r"></i>ATRASADO (DIAS)</div></div>
                    @if (_lids.Count == 0) { <p class="muted">Nenhuma liderança ainda. Use “+ Liderança”.</p> }
                    @foreach (var l in _lids.Where(l => _lider == Todas || l == _lider))
                    {
                        var ps = b.Ativos.Where(p => p.Lideranca == l).ToList();
                        int em = ps.Count(p => OneAOne.Faixa(p, _hoje) == FaixaOO.EmDia), ch = ps.Count(p => OneAOne.Faixa(p, _hoje) == FaixaOO.Chegando), at = ps.Count - em - ch;
                        int pct = ps.Count == 0 ? 0 : (int)Math.Round(em * 100.0 / ps.Count);
                        var cor = CorLider(l);
                        <section class="oo-lane @(_soltar == l ? "alvo" : "")" style="--l:@cor" @ondragover="() => Sobre(l)" @ondragover:preventDefault="true" @ondrop="() => Soltar(l)" @ondrop:preventDefault="true">
                            <header>
                                <span class="oo-lav">@(l.Length > 0 ? l[..1].ToUpperInvariant() : "?")</span>
                                <div><b title="@(E.OneGere ? "Clique para renomear" : l)" @onclick="() => Renomear(l)">@l</b><small>@Ferias.Plural(ps.Count, "colaborador", "colaboradores")</small></div>
                                <div class="oo-ring" style="--p:@pct"><span>@pct%</span></div>
                                <small class="oo-emd">em dia</small>
                                <div class="oo-mini"><span class="g" title="Em dia">@em</span><span class="a" title="Chegando">@ch</span><span class="r" title="Atrasado">@at</span></div>
                                @if (E.OneGere)
                                {
                                    <div class="oo-lane-ac">
                                        <button class="btn btn-sec btn-peq" title="Renomear a liderança" @onclick="() => Renomear(l)"><Icone Nome="editar" Tamanho="14" /></button>
                                        <button class="btn btn-sec btn-peq" title="Excluir a liderança" @onclick="() => ExcluirLideranca(l)"><Icone Nome="lixo" Tamanho="14" /></button>
                                    </div>
                                }
                            </header>
                            <div class="oo-belt">
                                @foreach (var fx in new[] { FaixaOO.EmDia, FaixaOO.Chegando, FaixaOO.Atrasado })
                                {
                                    var lista = ps.Where(p => OneAOne.Faixa(p, _hoje) == fx).OrderBy(p => OneAOne.Faltam(p, _hoje) ?? int.MinValue).ToList();
                                    if (fx == FaixaOO.EmDia) lista.Reverse();
                                    <div class="oo-z @Cls(fx)">
                                        @foreach (var p in lista) { @Cartao(p) }
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>

                <aside class="oo-lado">
                    <Painel Titulo="🔥 Próximos da fila" Sangrar="true">
                        <ul class="oo-fila">
                            @foreach (var p in b.Ativos.Where(Visivel).Where(p => OneAOne.Faixa(p, _hoje) != FaixaOO.EmDia).OrderBy(p => OneAOne.Faltam(p, _hoje) ?? int.MinValue).Take(8))
                            {
                                var f = OneAOne.Faltam(p, _hoje);
                                <li @onclick="() => Abrir(p)">
                                    <span class="oo-av" style="background:@CorLider(p.Lideranca)">@Iniciais(p.Nome)</span>
                                    <div><b>@Curto(p.Nome)</b><small>@p.Lideranca · @(p.Ultimo is DateOnly u ? $"último {u:dd/MM}" : "sem 1:1")</small></div>
                                    <em class="@(f is null or < 0 ? "r" : "a")">@(f == null ? "—" : f < 0 ? $"{-f} d" : $"em {f} d")</em>
                                </li>
                            }
                        </ul>
                    </Painel>
                    @if (_acoes.Count > 0)
                    {
                        <Painel Titulo="Ações combinadas em aberto" Nota="@_acoes.Count.ToString()" Sangrar="true">
                            <ul class="oo-fila">
                                @foreach (var (p, r) in _acoes.Take(8))
                                {
                                    bool venc = r.AcaoPrazo is DateOnly pz && pz < _hoje;
                                    <li @onclick="() => Abrir(p)">
                                        <span class="oo-av" style="background:@CorLider(p.Lideranca)">@Iniciais(p.Nome)</span>
                                        <div><b>@r.Acao</b><small>@Curto(p.Nome) · combinado em @r.Data.ToString("dd/MM")</small></div>
                                        @if (r.AcaoPrazo is DateOnly pz2) { <em class="@(venc ? "r" : "")">@pz2.ToString("dd/MM")</em> }
                                    </li>
                                }
                            </ul>
                        </Painel>
                    }
                    <Painel Titulo="Evolução mês a mês" Nota="% em dia">
                        @{ var meses = b.Fotos.OrderBy(k => k.Key).TakeLast(6).ToList(); }
                        @if (meses.Count < 2) { <p class="muted pequeno">O QSmart guarda uma foto por mês (quantas pessoas e quantas em dia). A comparação aparece a partir do 2º mês.</p> }
                        <div class="oo-meses">
                            @foreach (var (k, v) in meses)
                            {
                                int t = v.Values.Sum(x => x.Total), e = v.Values.Sum(x => x.EmDia); int pc = t == 0 ? 0 : (int)Math.Round(e * 100.0 / t);
                                <div title="@($"{e} de {t} em dia")"><span style="height:@(Math.Max(4, pc))%"></span><b>@pc%</b><small>@MesCurto(k)</small></div>
                            }
                        </div>
                    </Painel>
                    @if (_arquivados > 0)
                    {
                        <Painel Titulo="Arquivados" Nota="@_arquivados.ToString()" Sangrar="true">
                            <ul class="oo-fila">
                                @foreach (var p in b.Pessoas.Where(p => p.Arquivado).OrderByDescending(p => p.ArquivadoEm).Take(_verArq ? 999 : 4))
                                {
                                    <li @onclick="() => Abrir(p)"><span class="oo-av" style="background:#94A3B8">@Iniciais(p.Nome)</span>
                                        <div><b>@Curto(p.Nome)</b><small>@p.Lideranca · saiu @(p.ArquivadoEm?.ToString("dd/MM/yyyy"))</small></div></li>
                                }
                            </ul>
                            @if (_arquivados > 4) { <button class="btn btn-sec btn-peq" style="margin:8px 16px" @onclick="() => _verArq = !_verArq">@(_verArq ? "Ver menos" : "Ver todos")</button> }
                        </Painel>
                    }
                    <Painel Titulo="Como a esteira anda">
                        <p class="muted pequeno">Novo: 1:1 a cada @OneAOne.CicloNovo dias. Antigo: a cada @OneAOne.CicloAntigo. O Novo vira Antigo sozinho depois de @OneAOne.NovoViraAntigo dias.
                            Quem muda de liderança ganha um 1:1 em até @OneAOne.AposMudanca dias. Arraste um cartão para outra esteira para mudar a pessoa de liderança.</p>
                    </Painel>
                </aside>
            </div>
            }
        }

        @if (_ficha != null) { @Ficha }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "oneaone";
    const string Todas = "\u0001todas";
    static readonly string[] Paleta = { "#0891B2", "#7C3AED", "#059669", "#DB2777", "#D97706", "#2563EB", "#0D9488", "#9333EA", "#DC2626", "#65A30D" };
    readonly DateOnly _hoje = DateOnly.FromDateTime(DateTime.Today);
    string _lider = Todas, _busca = "";
    string? _soltar;
    PessoaOO? _arrastando, _ficha;
    List<string> _lids = new();
    List<(PessoaOO p, RegistroOO r)> _acoes = new();
    int _ativos, _arquivados;
    bool _verArq;
    // mudanças da planilha nova
    MudancasOO? _mud;
    HashSet<string> _confirmados = new();
    bool _arquivarSaidas = true;
    // formulário da ficha
    string _fData = "", _fObs = "", _fAcao = "", _fPrazo = "";

    QSmart.Core.Coordenacao.BaseOO? _antigo;
    bool _enviando;

    protected override async Task OnInitializedAsync()
    {
        await E.CarregarOne(true);
        if (E.OneGere) _antigo = await E.OneLocalAntigo();
    }

    async Task Recarregar() { E.OneBase = null; await E.CarregarOne(true); }

    async Task EnviarAntigo()
    {
        if (_antigo == null) return;
        if (!await J.Pergunta("Enviar para o banco", $"Enviar a carteira deste navegador ({Ferias.Plural(_antigo.Pessoas.Count, "pessoa", "pessoas")}) para o banco do QSmart? Depois do envio, a cópia antiga deste navegador é apagada.")) return;
        _enviando = true; StateHasChanged();
        try
        {
            var (ok, falhas) = await E.EnviarOneLocal(_antigo);
            _antigo = falhas == 0 ? null : _antigo;
            await J.Info("One a One", falhas == 0 ? $"Pronto: {Ferias.Plural(ok, "registro enviado", "registros enviados")} para o banco." : $"{ok} enviados e {falhas} recusados (de outras equipes).");
        }
        catch (Exception ex) { await J.Aviso("One a One", ex.Message); }
        finally { _enviando = false; StateHasChanged(); }
    }

    sealed record CoordOO(string Chave, string Nome, List<string> Lids, List<PessoaOO> Pessoas);
    List<CoordOO> _coords = new();
    string? _coord;
    string NomeCoord => _coords.FirstOrDefault(c => c.Chave == _coord)?.Nome ?? "";

    string CoordDe(PessoaOO p) => p.Coordenacao != "" ? p.Coordenacao : E.OneVeTudo ? "" : E.OneCoordenacao;
    static string ChaveC(string c) => Ferias.Norm(c);

    void AbrirCoord(string? k) { _coord = k; E.OneCoordAberta = k; _lider = Todas; }

    /// <summary>Liderança com o nome já cadastrado (sem diferença de maiúsculas, acentos e espaços).</summary>
    string OficialLid(string l)
    {
        l = System.Text.RegularExpressions.Regex.Replace(l ?? "", @"\s+", " ").Trim();
        var b = E.OneBase;
        var achou = (b?.TodasLiderancas() ?? new()).Concat(E.OneEquipes.Keys).FirstOrDefault(x => Ferias.Norm(x) == Ferias.Norm(l));
        return achou ?? l;
    }

    void MontarCoords(BaseOO b)
    {
        var ativos = b.Ativos.ToList();
        var nomes = new Dictionary<string, string>();
        void Nome(string c) { var k = ChaveC(c); if (!nomes.ContainsKey(k)) nomes[k] = c == "" ? "Sem coordenação" : c; }
        if (!E.OneVeTudo && E.OneCoordenacao != "") Nome(E.OneCoordenacao);
        foreach (var p in ativos) Nome(CoordDe(p));
        var lidCoord = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var l in b.TodasLiderancas())
        {
            var dela = ativos.Where(p => string.Equals(p.Lideranca, l, StringComparison.OrdinalIgnoreCase)).GroupBy(p => ChaveC(CoordDe(p))).OrderByDescending(g => g.Count()).FirstOrDefault();
            string c = dela != null ? CoordDe(dela.First()) : E.OneEquipes.TryGetValue(l, out var ce) ? ce : E.OneVeTudo ? "" : E.OneCoordenacao;
            Nome(c);
            lidCoord[l] = ChaveC(c);
        }
        _coords = nomes.Select(kv => new CoordOO(kv.Key, kv.Value,
                b.TodasLiderancas().Where(l => lidCoord.GetValueOrDefault(l) == kv.Key || ativos.Any(p => p.Lideranca == l && ChaveC(CoordDe(p)) == kv.Key)).ToList(),
                ativos.Where(p => ChaveC(CoordDe(p)) == kv.Key).ToList()))
            .OrderBy(c => c.Chave == "" ? 1 : 0).ThenBy(c => c.Nome, StringComparer.CurrentCultureIgnoreCase).ToList();
        _coords.RemoveAll(c => c.Chave == "" && c.Pessoas.Count == 0 && c.Lids.Count == 0);
        if (_coord != null && !_coords.Any(c => c.Chave == _coord)) _coord = null;
    }

    void Montar()
    {
        var b = E.OneBase;
        if (b == null) return;
        _coord ??= E.OneCoordAberta;
        MontarCoords(b);
        _lids = _coord == null ? b.TodasLiderancas() : _coords.First(c => c.Chave == _coord).Lids;
        if (_lider != Todas && !_lids.Contains(_lider)) _lider = Todas;
        _ativos = b.Ativos.Count();
        _arquivados = b.Pessoas.Count(p => p.Arquivado);
        _acoes = OneAOne.AcoesAbertas(b).Where(x => Visivel(x.p)).OrderBy(x => x.r.AcaoPrazo ?? DateOnly.MaxValue).ToList();
    }

    bool Visivel(PessoaOO p) => (_coord == null || ChaveC(CoordDe(p)) == _coord) && (_lider == Todas || p.Lideranca == _lider);
    static string CorLider(string l) { if (l == "") return "#64748B"; int h = 0; foreach (var ch in Ferias.Norm(l)) h = unchecked(h * 31 + ch); return Paleta[(int)((uint)h % Paleta.Length)]; }
    static string Cls(FaixaOO f) => f switch { FaixaOO.EmDia => "g", FaixaOO.Chegando => "a", _ => "r" };
    static string Iniciais(string nome) { var p = nome.Replace("(jovem)", "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(x => char.IsUpper(x[0])).ToArray(); return p.Length == 0 ? "?" : p.Length == 1 ? p[0][..Math.Min(2, p[0].Length)].ToUpperInvariant() : $"{p[0][0]}{p[^1][0]}".ToUpperInvariant(); }
    static string Curto(string n) { var p = n.Replace("(jovem)", "").Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length > 1 ? $"{p[0]} {p[^1][0]}." : n; }
    static string MesCurto(string k) { var m = int.Parse(k[5..]); return Texto.MesesPt[m - 1][..3].ToLowerInvariant() + "/" + k[2..4]; }
    static string Iso(DateOnly? d) => d?.ToString("yyyy-MM-dd") ?? "";
    static DateOnly? DeIso(string s) => DateOnly.TryParseExact(s, "yyyy-MM-dd", out var d) ? d : null;

    RenderFragment Cartao(PessoaOO p) => @<text>
        @{ var f = OneAOne.Faltam(p, _hoje); var fx = OneAOne.Faixa(p, _hoje);
           bool apagado = _busca.Trim() != "" && !Ferias.Norm(p.Nome).Contains(Ferias.Norm(_busca));
           bool mudou = p.MudouEm is DateOnly m && (p.Ultimo == null || p.Ultimo < m);
           bool acaoVenc = p.Registros.Any(r => r.Acao != "" && !r.AcaoFeita && r.AcaoPrazo is DateOnly pz && pz < _hoje); }
        <div class="oo-c @(apagado ? "apagado" : "")" draggable="true" @ondragstart="() => Pegar(p)" @ondragend="Largar"
             @onclick="() => Abrir(p)" title="@($"{p.Nome} · {p.Lideranca} · {(p.Ultimo is DateOnly u ? $"último 1:1 em {u:dd/MM/yyyy}" : "sem 1:1 registrado")}")">
            <span class="oo-av-c">@Iniciais(p.Nome)</span>
            <div>
                <span class="n">@Curto(p.Nome)@if (OneAOne.EhNovo(p, _hoje)) { <i class="oo-tag nv">novo</i> }@if (mudou) { <i class="oo-tag mv" title="Mudou de liderança">mudou</i> }</span>
                <b class="t @Cls(fx)">@(f == null ? "sem 1:1" : f < 0 ? $"{-f} d" : f == 0 ? "hoje" : $"em {f} d")</b>
            </div>
            @if (acaoVenc) { <span class="oo-dot" title="Ação combinada vencida"></span> }
        </div>
    </text>;

    RenderFragment KpisOO => @<text>
        @{ var b = E.OneBase!; var vis = b.Ativos.Where(Visivel).ToList(); int t = vis.Count;
           int em = vis.Count(p => OneAOne.Faixa(p, _hoje) == FaixaOO.EmDia), ch = vis.Count(p => OneAOne.Faixa(p, _hoje) == FaixaOO.Chegando), at = t - em - ch;
           int nunca = vis.Count(p => p.Ultimo == null && OneAOne.Faixa(p, _hoje) == FaixaOO.Atrasado); double ritmo = vis.Sum(p => 7.0 / OneAOne.Ciclo(p, _hoje)); }
        <Kpi Titulo="Em dia" Cor="green" Valor="@($"{(t == 0 ? 0 : Math.Round(em * 100.0 / t)):0}%")" Detalhe="@($"{em} de {t} colaboradores")" Proporcao="@(t == 0 ? 0 : (double)em / t)" />
        <Kpi Titulo="Atrasados" Cor="red" Valor="@Fmt(at)" Detalhe="@(nunca > 0 ? $"{nunca} sem nenhum 1:1 registrado" : "passaram do prazo de 30 / 90 dias")" />
        <Kpi Titulo="Chegando" Cor="amber" Valor="@Fmt(ch)" Detalhe="@($"vencem nos próximos {OneAOne.Chegando} dias")" />
        <Kpi Titulo="Ritmo necessário" Cor="blue" Valor="@($"{Math.Ceiling(ritmo):0}/semana")" Detalhe="1:1 por semana para manter todos em dia" />
        <Kpi Titulo="Ações em aberto" Cor="purple" Valor="@Fmt(_acoes.Count)" Detalhe="@($"{_acoes.Count(x => x.r.AcaoPrazo is DateOnly pz && pz < _hoje)} com prazo vencido")" />
    </text>;

    RenderFragment PainelMudancas => @<text>
        @{ var m = _mud!; }
        <Painel Titulo="O que mudou com a planilha nova" Nota="@m.Lida.Arquivo" Classe="oo-mud">
            <p class="muted pequeno">Confira antes de aplicar. Nada é apagado: quem saiu vai para “Arquivados” com o histórico guardado.</p>
            <div class="oo-mud-grade">
                <div class="oo-mud-bloco g"><b>🟢 Entraram (@m.Entraram.Count)</b>
                    @if (m.Entraram.Count == 0) { <small class="muted">ninguém</small> }
                    @foreach (var p in m.Entraram) { <span>@p.Nome <small>@p.Lideranca · @p.Tipo</small></span> }
                </div>
                <div class="oo-mud-bloco b"><b>🔄 Mudaram de liderança (@m.MudaramLideranca.Count)</b>
                    @if (m.MudaramLideranca.Count == 0) { <small class="muted">ninguém</small> }
                    @foreach (var (a, de, para) in m.MudaramLideranca) { <span>@a.Nome <small>@de → <b>@para</b></small></span> }
                </div>
                <div class="oo-mud-bloco c"><b>⚪ Saíram (@m.Sairam.Count)</b>
                    @if (m.Sairam.Count == 0) { <small class="muted">ninguém</small> }
                    @foreach (var p in m.Sairam) { <span>@p.Nome <small>@p.Lideranca</small></span> }
                    @if (m.Sairam.Count > 0) { <label class="oo-chk"><input type="checkbox" @bind="_arquivarSaidas" /> arquivar quem saiu</label> }
                </div>
                <div class="oo-mud-bloco a"><b>❓ Nome parecido (@m.Parecidos.Count)</b>
                    @if (m.Parecidos.Count == 0) { <small class="muted">nenhum</small> }
                    @foreach (var (a, n) in m.Parecidos)
                    {
                        <label class="oo-chk"><input type="checkbox" checked="@_confirmados.Contains(a.Id)" @onchange="e => { if (e.Value is true) _confirmados.Add(a.Id); else _confirmados.Remove(a.Id); }" />
                            <span>“@n.Nome” é <b>@a.Nome</b>?</span></label>
                    }
                </div>
            </div>
            @if (m.NovosRegistros > 0) { <p class="pequeno">📅 @Ferias.Plural(m.NovosRegistros, "1:1 novo", "1:1 novos") vindos da planilha.</p> }
            <div class="fa-card-pe">
                <button class="btn btn-sec" @onclick="() => _mud = null">Cancelar</button>
                <button class="btn btn-pri" @onclick="AplicarMudancas"><Icone Nome="check" Tamanho="15" /> Aplicar mudanças</button>
            </div>
        </Painel>
    </text>;

    RenderFragment Ficha => @<text>
        @{ var p = _ficha!; var f = OneAOne.Faltam(p, _hoje); var fx = OneAOne.Faixa(p, _hoje); var prox = OneAOne.Proximo(p, _hoje); var vira = OneAOne.ViraAntigoEm(p);
           int ciclo = OneAOne.Ciclo(p, _hoje); var ult = p.Ultimo; int? desde = ult is DateOnly uu ? _hoje.DayNumber - uu.DayNumber : null;
           var regs = p.Registros.OrderByDescending(r => r.Data).ToList();
           var inter = regs.Zip(regs.Skip(1), (a, b) => a.Data.DayNumber - b.Data.DayNumber).ToList();
           int? media = inter.Count == 0 ? null : (int)Math.Round(inter.Average());
           int ano = p.Registros.Count(r => r.Data > _hoje.AddYears(-1));
           double uso = desde is int dd ? Math.Clamp(dd / (double)ciclo, 0, 1.15) : 1.15; }
        <div class="oo-fundo" @onclick="Fechar"></div>
        <div class="oo-ficha" style="--l:@CorLider(p.Lideranca)">
            <div class="oo-ficha-cab">
                <span class="oo-av grande" style="background:@CorLider(p.Lideranca)">@Iniciais(p.Nome)</span>
                <div>
                    <b>@p.Nome</b>
                    <small>@(p.Lideranca == "" ? "sem liderança" : p.Lideranca) · @(OneAOne.EhNovo(p, _hoje) ? "Novo" : "Antigo")</small>
                </div>
                <span class="oo-st @Cls(fx)">@(p.Arquivado ? "arquivado" : f == null ? "sem 1:1" : f < 0 ? $"{-f} d atrasado" : f <= OneAOne.Chegando ? $"em {f} d" : "em dia")</span>
                <button class="oo-x" @onclick="Fechar" title="Fechar"><Icone Nome="x" Tamanho="18" /></button>
            </div>
            <div class="oo-ficha-corpo">
                @if (!p.Arquivado)
                {
                    <div class="of-ciclo @Cls(fx)">
                        <div class="of-ciclo-txt">
                            <span>@(desde is int d0 ? (d0 == 0 ? "1:1 feito hoje" : $"{Ferias.Plural(d0, "dia", "dias")} desde o último 1:1") : "Nenhum 1:1 registrado ainda")</span>
                            <b>@(prox is DateOnly pd ? $"próximo {pd:dd/MM/yyyy}" : "agendar")</b>
                        </div>
                        <div class="of-ciclo-barra"><i style="width:@((Math.Min(uso, 1) * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></i><em title="limite do ciclo"></em></div>
                        <small>Ciclo de @ciclo dias (@(OneAOne.EhNovo(p, _hoje) ? "colaborador novo" : "colaborador antigo"))@(vira is DateOnly va && OneAOne.EhNovo(p, _hoje) ? $" · vira Antigo em {va:dd/MM/yyyy}" : "")</small>
                    </div>
                }
                else { <p class="muted pequeno">Arquivado em @p.ArquivadoEm?.ToString("dd/MM/yyyy"). O histórico continua guardado.</p> }

                <div class="of-stats">
                    <div><small>Último 1:1</small><b>@(ult is DateOnly u1 ? u1.ToString("dd/MM/yy") : "—")</b><span>@(desde is int d1 ? (d1 == 0 ? "hoje" : $"há {Ferias.Plural(d1, "dia", "dias")}") : "nunca")</span></div>
                    <div><small>1:1 feitos</small><b>@p.Registros.Count</b><span>@ano nos últimos 12 meses</span></div>
                    <div class="@(media is int m0 && m0 > ciclo ? "r" : media != null ? "g" : "")"><small>Intervalo médio</small><b>@(media is int m1 ? $"{m1} d" : "—")</b><span>@(media is int m2 ? (m2 > ciclo ? $"acima dos {ciclo} d" : $"dentro dos {ciclo} d") : "precisa de 2 registros")</span></div>
                </div>

                <div class="oo-campos">
                    <label>Liderança
                        <select class="campo" value="@p.Lideranca" disabled="@(!E.OneGere)" @onchange="e => MudarLideranca(p, e.Value?.ToString() ?? p.Lideranca)">
                            @foreach (var l in _lids) { <option value="@l">@l</option> }
                        </select></label>
                    <label>Tipo
                        <select class="campo" value="@(Ferias.Norm(p.Tipo).StartsWith("novo") ? "Novo" : "Antigo")" @onchange="e => { p.Tipo = e.Value?.ToString() ?? p.Tipo; Salvar(); }">
                            <option value="Novo">Novo (30 dias)</option><option value="Antigo">Antigo (90 dias)</option>
                        </select></label>
                </div>

                @if (_feito != null)
                {
                    var prx = ProximoDaFila(p);
                    <div class="of-ok">
                        <div class="of-ok-ic"><Icone Nome="check" Tamanho="30" /></div>
                        <b>1:1 registrado!</b>
                        <span>@p.Nome voltou para <em class="g">Em dia</em>@(_feitoAntes != FaixaOO.EmDia ? $" (estava {(_feitoAntes == FaixaOO.Atrasado ? "atrasado" : "chegando")})" : "").</span>
                        <div class="of-ok-info">
                            <div><small>Data do 1:1</small><b>@_feito.Data.ToString("dd/MM/yyyy")</b></div>
                            <div><small>Próximo 1:1</small><b>@(prox?.ToString("dd/MM/yyyy"))</b><span>@(f is int f2 ? $"daqui a {Ferias.Plural(f2, "dia", "dias")}" : "")</span></div>
                        </div>
                        @if (_feito.Acao != "") { <div class="of-ok-acao"><Icone Nome="lista-check" Tamanho="14" /> Ação combinada: <b>@_feito.Acao</b>@(_feito.AcaoPrazo is DateOnly ap ? $" até {ap:dd/MM}" : "")</div> }
                        <div class="of-ok-bts">
                            @if (prx != null) { <button class="btn btn-pri" @onclick="() => Abrir(prx)">Próximo da fila: @Curto(prx.Nome) <Icone Nome="direita" Tamanho="14" /></button> }
                            <button class="btn btn-sec" @onclick="Fechar">Fechar</button>
                        </div>
                    </div>
                }
                else if (!p.Arquivado)
                {
                    <div class="oo-form of-form">
                        <div class="of-form-cab"><b>Registrar 1:1</b>
                            <span class="of-dias">
                                <button class="@(_fData == Iso(_hoje) ? "on" : "")" @onclick="() => _fData = Iso(_hoje)">Hoje</button>
                                <button class="@(_fData == Iso(_hoje.AddDays(-1)) ? "on" : "")" @onclick="() => _fData = Iso(_hoje.AddDays(-1))">Ontem</button>
                                <input class="campo" type="date" value="@_fData" max="@Iso(_hoje)" @onchange="@(e => _fData = e.Value?.ToString() ?? "")" />
                            </span>
                        </div>
                        <div class="of-clima">
                            <small>Como a pessoa está?</small>
                            <div>
                                @for (int c = 1; c <= 4; c++)
                                {
                                    var cc = c;
                                    <button class="@(_fClima == cc ? "on" : "") c@(cc)" @onclick="() => _fClima = _fClima == cc ? null : cc" title="@ClimaNome(cc)"><span>@ClimaEmoji(cc)</span>@ClimaNome(cc)</button>
                                }
                            </div>
                        </div>
                        <label>O que foi conversado<textarea class="campo area" rows="3" @bind="_fObs" @bind:event="oninput" placeholder="Pontos da conversa, como a pessoa está, feedbacks…"></textarea></label>
                        <div class="of-acao">
                            <label>Ação combinada<input class="campo" @bind="_fAcao" @bind:event="oninput" placeholder="Opcional · ex.: fazer o treinamento X" /></label>
                            <label>Até<input class="campo" type="date" min="@_fData" value="@_fPrazo" disabled="@(_fAcao.Trim() == "")" @onchange="@(e => _fPrazo = e.Value?.ToString() ?? "")" /></label>
                        </div>
                        <button class="btn btn-pri of-reg" @onclick="() => RegistrarFicha(p)"><Icone Nome="check" Tamanho="16" /> Registrar 1:1 de @(DeIso(_fData) is DateOnly fd ? (fd == _hoje ? "hoje" : fd.ToString("dd/MM")) : "…")</button>
                    </div>
                }

                @{ var abertas = p.Registros.Where(r => r.Acao != "" && !r.AcaoFeita).OrderBy(r => r.AcaoPrazo ?? DateOnly.MaxValue).ToList(); }
                @if (abertas.Count > 0)
                {
                    <div class="oo-sec"><b>Ações em aberto (@abertas.Count)</b>
                        @foreach (var r in abertas)
                        {
                            bool venc = r.AcaoPrazo is DateOnly pz && pz < _hoje;
                            <label class="of-acao-ab @(venc ? "venc" : "")"><input type="checkbox" @onchange="() => { r.AcaoFeita = true; Salvar(); }" />
                                <span>@r.Acao <small>@(r.AcaoPrazo is DateOnly pz2 ? (venc ? $"venceu {pz2:dd/MM}" : $"até {pz2:dd/MM}") : "sem prazo") · combinada em @r.Data.ToString("dd/MM")</small></span></label>
                        }
                    </div>
                }

                <div class="oo-sec">
                    <div class="of-hist-cab"><b>Histórico</b>
                        <div class="of-meses" title="1:1 nos últimos 12 meses">
                            @for (int k = 11; k >= 0; k--)
                            {
                                var mm = new DateOnly(_hoje.Year, _hoje.Month, 1).AddMonths(-k);
                                bool teve = p.Registros.Any(r => r.Data.Year == mm.Year && r.Data.Month == mm.Month);
                                <i class="@(teve ? "on" : "")" title="@($"{Texto.MesesPt[mm.Month - 1]}/{mm.Year}: {(teve ? "teve 1:1" : "sem 1:1")}")">@Texto.MesesPt[mm.Month - 1][..1]</i>
                            }
                        </div>
                    </div>
                    @if (regs.Count == 0) { <small class="muted">Nenhum 1:1 registrado. O primeiro aparece aqui.</small> }
                    <ol class="of-tl">
                        @for (int k = 0; k < regs.Count; k++)
                        {
                            var r = regs[k]; int? gap = k + 1 < regs.Count ? r.Data.DayNumber - regs[k + 1].Data.DayNumber : null;
                            int ha = _hoje.DayNumber - r.Data.DayNumber;
                            <li class="@(r == _feito ? "novo" : "")">
                                <span class="of-tl-pt c@(r.Clima ?? 0)">@(r.Clima is int ci ? ClimaEmoji(ci) : "✓")</span>
                                <div class="of-tl-cx">
                                    <div class="of-tl-top">
                                        <b>@r.Data.ToString("dd/MM/yyyy")</b><small>@(ha == 0 ? "hoje" : ha == 1 ? "ontem" : $"há {ha} dias")</small>
                                        @if (gap is int g) { <span class="of-gap @(g > ciclo ? "r" : "g")" title="Intervalo desde o 1:1 anterior">+@g d</span> }
                                        <span class="mola"></span>
                                        <button class="oo-x peq" title="Editar" @onclick="() => EditarReg(r)"><Icone Nome="editar" Tamanho="13" /></button>
                                        <button class="oo-x peq" title="Apagar este registro" @onclick="() => ApagarRegistro(p, r)"><Icone Nome="lixo" Tamanho="13" /></button>
                                    </div>
                                    @if (_editReg == r)
                                    {
                                        <textarea class="campo area" rows="3" @bind="_eObs" @bind:event="oninput"></textarea>
                                        <input class="campo" @bind="_eAcao" @bind:event="oninput" placeholder="Ação combinada (opcional)" />
                                        <div class="of-ed-bts"><button class="btn btn-pri btn-peq" @onclick="() => SalvarReg(r)">Salvar</button><button class="btn btn-sec btn-peq" @onclick="() => _editReg = null">Cancelar</button></div>
                                    }
                                    else
                                    {
                                        <p class="@(r.Obs == "" ? "muted" : "")">@(r.Obs == "" ? "Sem anotações." : r.Obs)</p>
                                        @if (r.Acao != "")
                                        {
                                            bool vc = !r.AcaoFeita && r.AcaoPrazo is DateOnly pz3 && pz3 < _hoje;
                                            <button class="of-tag @(r.AcaoFeita ? "g" : vc ? "r" : "a")" title="Clique para marcar como @(r.AcaoFeita ? "em aberto" : "feita")" @onclick="() => { r.AcaoFeita = !r.AcaoFeita; Salvar(); }">
                                                @(r.AcaoFeita ? "✓ feita" : vc ? "vencida" : "em aberto") · @r.Acao@(r.AcaoPrazo is DateOnly pz4 ? $" (até {pz4:dd/MM})" : "")</button>
                                        }
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                </div>
                @if (p.Vinculos.Count > 1)
                {
                    <div class="oo-sec"><b>Passagem pelos times</b>
                        @foreach (var v in p.Vinculos) { <small class="muted" style="display:block">@v.Lideranca @(v.Desde is DateOnly de ? $"desde {de:MM/yyyy}" : "") @(v.Ate is DateOnly ate ? $"até {ate:MM/yyyy}" : "")</small> }
                    </div>
                }
                <div class="fa-card-pe">
                    <button class="btn btn-sec" @onclick="() => RenomearPessoa(p)">Corrigir nome</button>
                    <button class="btn btn-sec" @onclick="() => Arquivar(p)">@(p.Arquivado ? "Reativar" : "Arquivar (saiu da carteira)")</button>
                </div>
            </div>
        </div>
    </text>;

    // ===================== ações =====================

    void Salvar()
    {
        if (E.OneBase is { } b && E.OneGere) OneAOne.Fotografar(b, _hoje);
        _ = E.SalvarOne();
        E.Notificar();
    }

    void Abrir(PessoaOO p) { _ficha = p; _fData = Iso(_hoje); _fObs = ""; _fAcao = ""; _fPrazo = ""; _fClima = null; _feito = null; _editReg = null; }
    RegistroOO? _feito, _editReg;
    FaixaOO _feitoAntes;
    int? _fClima;
    string _eObs = "", _eAcao = "";
    static string ClimaEmoji(int c) => c switch { 1 => "😟", 2 => "😐", 3 => "🙂", _ => "🤩" };
    static string ClimaNome(int c) => c switch { 1 => "Preocupa", 2 => "Neutra", 3 => "Bem", _ => "Ótima" };

    /// <summary>Quem está mais urgente (atrasado/chegando) na mesma visão, sem contar a pessoa atual.</summary>
    PessoaOO? ProximoDaFila(PessoaOO atual) => E.OneBase?.Ativos.Where(x => x != atual && Visivel(x) && OneAOne.Faixa(x, _hoje) != FaixaOO.EmDia)
        .OrderBy(x => OneAOne.Faltam(x, _hoje) ?? int.MinValue).FirstOrDefault();

    void EditarReg(RegistroOO r) { _editReg = r; _eObs = r.Obs; _eAcao = r.Acao; }
    void SalvarReg(RegistroOO r)
    {
        r.Obs = _eObs.Trim();
        var a = _eAcao.Trim();
        if (a != r.Acao) { r.Acao = a; if (a == "") { r.AcaoPrazo = null; r.AcaoFeita = false; } }
        _editReg = null; Salvar();
    }
    void Fechar() => _ficha = null;

    async Task RegistrarFicha(PessoaOO p)
    {
        var d = DeIso(_fData);
        if (d == null) { await J.Aviso("1:1", "Informe a data do 1:1."); return; }
        if (d > _hoje) { await J.Aviso("1:1", "A data do 1:1 não pode ser no futuro."); return; }
        _feitoAntes = OneAOne.Faixa(p, _hoje);
        var reg = new RegistroOO { Data = d.Value, Obs = _fObs.Trim(), Acao = _fAcao.Trim(), AcaoPrazo = _fAcao.Trim() == "" ? null : DeIso(_fPrazo), Clima = _fClima };
        OneAOne.Registrar(p, reg);
        _ = E.Conta.Registrar(QSmart.Core.Conta.Conquistas.OoRegistro, true);
        _fObs = ""; _fAcao = ""; _fPrazo = ""; _fClima = null;
        Salvar();
        // mostra a confirmação na própria ficha (o registro pode ter sido juntado a um do mesmo dia)
        _feito = p.Registros.FirstOrDefault(x => x.Data == reg.Data) ?? reg;
    }

    async Task ApagarRegistro(PessoaOO p, RegistroOO r)
    {
        if (!await J.Pergunta("Apagar registro", $"Apagar o 1:1 de {r.Data:dd/MM/yyyy} de {p.Nome}?")) return;
        p.Registros.Remove(r); Salvar();
    }

    void MudarLideranca(PessoaOO p, string l) { OneAOne.TrocarLideranca(p, l, _hoje); Salvar(); }

    void Pegar(PessoaOO p) => _arrastando = p;
    void Largar() { _arrastando = null; _soltar = null; }
    void Sobre(string l) { if (_arrastando != null) _soltar = l; }

    void Soltar(string l)
    {
        var p = _arrastando; _arrastando = null; _soltar = null;
        if (!E.OneGere) return;
        if (p == null || p.Lideranca == l) return;
        OneAOne.TrocarLideranca(p, l, _hoje);
        Salvar();
    }

    async Task Arquivar(PessoaOO p)
    {
        if (!p.Arquivado && !await J.Pergunta("Arquivar", $"{p.Nome} saiu da carteira? O histórico fica guardado em “Arquivados” e dá para reativar depois.")) return;
        p.Arquivado = !p.Arquivado; p.ArquivadoEm = p.Arquivado ? _hoje : null;
        Salvar(); _ficha = null;
    }

    async Task RenomearPessoa(PessoaOO p)
    {
        var n = await J.Entrada("Corrigir nome", "Nome completo:", p.Nome);
        if (string.IsNullOrWhiteSpace(n)) return;
        p.Nome = string.Join(' ', n.Split(' ', StringSplitOptions.RemoveEmptyEntries)); Salvar();
    }

    async Task NovaPessoa()
    {
        var b = E.OneBase!;
        var n = await J.Entrada("Nova pessoa", "Nome completo:", "");
        if (string.IsNullOrWhiteSpace(n)) return;
        n = string.Join(' ', n.Split(' ', StringSplitOptions.RemoveEmptyEntries));
        if (b.Pessoas.FirstOrDefault(x => x.Chave == OneAOne.ChaveNome(n)) is { } ja)
        {
            await J.Aviso("Nova pessoa", ja.Arquivado ? $"{ja.Nome} já estava na carteira (arquivada). Abri a ficha para você reativar." : $"{ja.Nome} já está na carteira.");
            Abrir(ja); return;
        }
        string? l = !E.OneGere ? E.OneMinhaLideranca : _lider != Todas ? _lider : _lids.Count == 1 ? _lids[0] : null;
        if (l == null)
        {
            if (_lids.Count == 0) { l = await J.Entrada("Liderança", "Nome da liderança desta pessoa:", ""); }
            else l = await J.Um("Liderança", _lids.Select(x => (x, x)), "", "De qual liderança?", "");
            if (string.IsNullOrWhiteSpace(l)) return;
        }
        var p = new PessoaOO { Nome = n, Lideranca = OficialLid(l), Tipo = "Novo", Entrada = _hoje, Coordenacao = _coord is { Length: > 0 } ? NomeCoord : "" };
        p.Vinculos.Add(new VinculoOO { Lideranca = p.Lideranca, Desde = _hoje });
        b.Pessoas.Add(p);
        if (!b.Liderancas.Contains(p.Lideranca)) b.Liderancas.Add(p.Lideranca);
        Salvar(); Abrir(p);
    }

    async Task NovaLideranca()
    {
        var n = await J.Entrada("Nova liderança", "Nome da liderança:", "");
        if (string.IsNullOrWhiteSpace(n)) return;
        n = OficialLid(n);
        // administrador dentro de uma coordenação: a equipe já nasce nela
        if (E.OneVeTudo && _coord is { Length: > 0 })
        {
            var us = await E.Conta.Usuarios() ?? new();
            var co = us.FirstOrDefault(u => u.Papel == "coordenador" && (Ferias.Norm($"{u.Nome} {u.Sobrenome}") == _coord || Ferias.Norm(u.Lideranca) == _coord));
            if (co != null) { await E.Conta.Chamar("POST", "admin/equipes", new System.Text.Json.Nodes.JsonObject { ["lideranca"] = n, ["de"] = "", ["para"] = co.Id }); E.OneEquipes[n] = NomeCoord; }
        }
        if (!E.OneBase!.Liderancas.Contains(n, StringComparer.OrdinalIgnoreCase)) E.OneBase.Liderancas.Add(n);
        Salvar();
    }

    async Task Renomear(string l)
    {
        if (!E.OneGere) return;
        var n = await J.Entrada("Renomear liderança", $"Novo nome para “{l}” (todas as pessoas dela passam junto):", l);
        if (string.IsNullOrWhiteSpace(n) || n.Trim() == l) return;
        n = n.Trim();
        var b = E.OneBase!;
        foreach (var p in b.Pessoas.Where(p => p.Lideranca == l))
        {
            p.Lideranca = n;
            foreach (var v in p.Vinculos.Where(v => v.Lideranca == l)) v.Lideranca = n;
        }
        b.Liderancas.RemoveAll(x => x == l);
        if (!b.Liderancas.Contains(n)) b.Liderancas.Add(n);
        if (_lider == l) _lider = n;
        Salvar();
    }

    async Task ExcluirLideranca(string l)
    {
        var b = E.OneBase!;
        var ps = b.Pessoas.Where(p => !p.Arquivado && p.Lideranca == l).ToList();
        if (ps.Count == 0)
        {
            if (!await J.Pergunta("Excluir liderança", $"Excluir a liderança “{l}”? Ela está vazia.")) return;
        }
        else
        {
            const string Arquivar = "__arquivar";
            var opcoes = b.TodasLiderancas().Where(x => x != l).Select(x => (x, $"Mover para {x}"))
                .Append((Arquivar, "Arquivar todos (o histórico fica guardado)")).ToList();
            var destino = await J.Um("Excluir liderança", opcoes, "", $"“{l}” tem {Ferias.Plural(ps.Count, "colaborador", "colaboradores")}. O que fazer com eles?", "");
            if (string.IsNullOrEmpty(destino)) return;
            if (destino == Arquivar)
            {
                if (!await J.Pergunta("Excluir liderança", $"Arquivar {Ferias.Plural(ps.Count, "colaborador", "colaboradores")} e excluir “{l}”? Dá para reativar cada pessoa depois em Arquivados.")) return;
                foreach (var p in ps) { p.Arquivado = true; p.ArquivadoEm = _hoje; }
            }
            else foreach (var p in ps) OneAOne.TrocarLideranca(p, destino, _hoje);
        }
        b.Liderancas.RemoveAll(x => x == l);
        if (_lider == l) _lider = Todas;
        Salvar();
    }

    async Task Anexar(List<Arquivo> arqs)
    {
        var arq = arqs[0];
        BaseOO lida;
        try { lida = OneAOne.Ler(arq.Dados, arq.Nome); }
        catch (Exception ex) { await J.Erro("One a One", $"Não consegui ler “{arq.Nome}”.\n\n{ex.Message}"); return; }
        var b = E.OneBase;
        if (b == null || !b.Pessoas.Any())
        {
            b ??= new BaseOO();
            OneAOne.Aplicar(b, OneAOne.Comparar(b, lida), new List<string>(), true, _hoje);
            E.OneBase = b;
            Salvar();
            await J.Info("One a One", $"{Ferias.Plural(b.Pessoas.Count, "colaborador", "colaboradores")} em {Ferias.Plural(b.TodasLiderancas().Count, "liderança", "lideranças")}. Tudo fica salvo neste navegador, criptografado.");
            return;
        }
        var m = OneAOne.Comparar(b, lida);
        if (m.Vazia) { await J.Info("One a One", "A planilha não trouxe nenhuma mudança: as mesmas pessoas, nas mesmas lideranças, sem 1:1 novos."); return; }
        _mud = m;
        _confirmados = m.Parecidos.Select(x => x.atual.Id).ToHashSet();
        _arquivarSaidas = true;
    }

    void AplicarMudancas()
    {
        if (_mud == null || E.OneBase == null) return;
        OneAOne.Aplicar(E.OneBase, _mud, _confirmados, _arquivarSaidas, _hoje);
        _mud = null;
        Salvar();
    }

    async Task Exportar() => await E.Salvar($"One_a_one_{_hoje:yyyy-MM-dd}.xlsx", OneAOne.Exportar(E.OneBase!), Navegador.MimeXlsx, "Planilha exportada");
}
