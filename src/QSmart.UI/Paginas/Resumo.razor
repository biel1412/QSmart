@page "/resumo"
@inherits PaginaBase

<Pagina Titulo="Resumo" Grupo="@A.Grupo" Sub="@E.SubResumo">
    <Acoes>
        <button class="btn btn-hero" disabled="@E.Carregando" @onclick="GerarRelatorio"><Icone Nome="pdf" Tamanho="17" /> Relatório PDF</button>
        <BotaoArquivo Texto="@(E.Resultado != null ? "Abrir outra planilha" : "Abrir planilha")" Variante="pri" Icone="upload"
                      Aceita=".xlsx,.xlsm,.csv" Desativado="E.Carregando" AoEscolher="Carregar" />
    </Acoes>
    <ChildContent>
        @{ var r = E.Resultado; }
        <div class="rs-topo">
            <div class="rs-nums">
                <div><span>Decisões</span><b>@(r != null ? Fmt(r.Aprov + r.Reprov) : "—")</b>
                    <small>@(r == null ? "aprovações + reprovações" : r.Outros != 0 ? $"{Fmt(r.Outros)} fora da comparação" : "aprovações + reprovações")</small></div>
                <div><span>Aprovações</span><b class="verde">@(r != null ? Fmt(r.Aprov) : "—")</b><small>@(r != null ? $"{F1(r.PctAprov)}% das decisões" : "")</small></div>
                <div><span>Reprovações</span><b class="verm">@(r != null ? Fmt(r.Reprov) : "—")</b><small>@(r != null ? $"{F1(r.PctReprov)}% das decisões" : "")</small></div>
                <div class="rs-motivo"><span>Motivo nº 1</span>
                    @if (r != null && r.Tipos.Count > 0)
                    {
                        var t = r.Tipos[0];
                        <b>@Texto.Rotulo(t.tipo)</b><small>@($"{Fmt(t.qtd)} ocorrências · {F1(t.qtd / (double)(r.Reprov == 0 ? 1 : r.Reprov) * 100)}% das reprovações")</small>
                    }
                    else { <b>—</b><small>@(r != null ? "sem reprovações" : "")</small> }
                </div>
            </div>
            @if (r != null && r.Aprov + r.Reprov > 0)
            {
                <div class="rs-barra">
                    <div class="ap" style="flex:@(Math.Max(r.PctAprov, 0.5).ToString(System.Globalization.CultureInfo.InvariantCulture))" title="@($"Aprovações: {Fmt(r.Aprov)}")">@(r.PctAprov >= 16 ? $"Aprovações · {F1(r.PctAprov)}%" : "")</div>
                    <div class="rp" style="flex:@(Math.Max(r.PctReprov, 0.5).ToString(System.Globalization.CultureInfo.InvariantCulture))" title="@($"Reprovações: {Fmt(r.Reprov)}")">@(r.PctReprov >= 16 ? $"Reprovações · {F1(r.PctReprov)}%" : "")</div>
                </div>
                @if (r.PctReprov < 16) { <div class="rs-barra-leg"><span>@(r.PctAprov < 16 ? $"Aprovações · {F1(r.PctAprov)}%" : "")</span><span class="verm">Reprovações · @F1(r.PctReprov)%</span></div> }
            }
            else
            {
                <div class="rs-barra vazia">Abra uma planilha para ver a divisão entre aprovações e reprovações</div>
            }
        </div>
        <div class="barra-ferr">
            <button class="btn btn-sec" @onclick="Classificar"><Icone Nome="tabela" Tamanho="16" /> Classificar procedimentos</button>
            @foreach (var (chave, rot) in new[] { ("usuarios", "Usuários"), ("segmentos", "Segmentos"), ("dias", "Dias") })
            {
                var n = E.FiltrosResumo.Get(chave).Count;
                <button class="btn btn-sec @(n > 0 ? "ativo" : "")" @onclick="() => Escolher(chave, rot)"><Icone Nome="filtro" Tamanho="15" /> @(n > 0 ? $"{rot} ({n})" : rot)</button>
            }
            <button class="btn btn-sec" disabled="@(!E.FiltrosResumo.Algum)" @onclick="Limpar">Limpar filtros</button>
            <span class="mola"></span>
            <div class="rs-vista" role="tablist" aria-label="Forma de ver">
                <button class="@(_vista == "mosaico" ? "on" : "")" @onclick="@(() => Vista("mosaico"))" title="Blocos com área proporcional"><Icone Nome="mosaico" Tamanho="15" /> Mosaico</button>
                <button class="@(_vista == "radial" ? "on" : "")" @onclick="@(() => Vista("radial"))" title="Tudo num círculo: taxa de aprovação, motivos e segmentos"><Icone Nome="radial" Tamanho="15" /> Radial</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(E.Resultado?.FiltrosTexto))
        {
            <p class="muted">Filtros ativos: @E.Resultado.FiltrosTexto</p>
        }
        @if (_vista == "radial")
        {
            <Painel Titulo="Visão radial" Nota="por fora: aprovação × reprovação · no meio: motivos · por dentro: segmentos · passe o mouse para destacar">
                <ResumoRadial Aprov="@(E.Resultado?.Aprov ?? 0)" Reprov="@(E.Resultado?.Reprov ?? 0)"
                              Tipos="@(E.Resultado?.Tipos.Select(t => (Texto.Rotulo(t.tipo), t.qtd)).ToList() ?? new())"
                              Segmentos="@(E.Resultado?.Segmentos.Where(x => x.Dev > 0).Select(x => (x.Nome, x.Dev)).ToList() ?? new())"
                              CoresMotivos="CoresMotivos" Vazio="@(E.Resultado == null ? "Abra uma planilha para começar" : "Sem decisões nesta seleção")" />
            </Painel>
        }
        else
        {
        <div class="grade-2">
            <Painel Titulo="Tipos de reprovação" Nota="área = quantidade · % das reprovações">
                <MapaAreas Itens="@Tipos().Select(t => (t.Item1, t.Item2)).ToList()" Total="@(E.Resultado?.Reprov ?? 0)" Cores="CoresMotivos"
                           Vazio="@(E.Resultado == null ? "Abra uma planilha para começar" : "Sem reprovações")" />
            </Painel>
            <Painel Titulo="Devolutivas por segmento" Nota="área = quantidade · % das devolutivas">
                <MapaAreas Itens="@Segmentos().Select(t => (t.Item1, t.Item2)).ToList()" Total="@(E.Resultado?.Reprov ?? 0)"
                           Vazio="@(E.Resultado == null ? "Abra uma planilha para começar" : "Sem devolutivas")" />
            </Painel>
        </div>
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "resumo";
    string _vista = "mosaico";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try { if (await E.Nav.Ler("resumo_vista") is "radial") _vista = "radial"; } catch { }
    }

    async Task Vista(string v)
    {
        _vista = v;
        try { await E.Nav.Gravar("resumo_vista", v); } catch { }
    }
    static readonly string[] CoresMotivos = { "#F43F5E", "#FB7185", "#F97316", "#FB923C", "#F59E0B", "#EAB308", "#A855F7", "#8B5CF6", "#C084FC", "#E879F9" };

    List<(string, long, string?)> Tipos() => E.Resultado == null ? new() :
        E.Resultado.Tipos.Take(8).Select(t => (Texto.Rotulo(t.tipo), t.qtd, (string?)null)).ToList();

    List<(string, long, string?)> Segmentos() => E.Resultado == null ? new() :
        E.Resultado.Segmentos.Where(s => s.Dev > 0).Select(s => (s.Nome, s.Dev, (string?)null)).ToList();

    async Task Carregar(List<Arquivo> arqs)
    {
        var a = arqs[0];
        var classes = new Dictionary<string, string>(E.ClassesProc);
        await E.Executar(async prog =>
        {
            var (cubo, fluxos) = await Volume.CarregarComFluxos(new[] { a }, prog);
            var op = Volume.Opcoes(cubo);
            var r = Volume.CalcularResumo(cubo, classes, new FiltrosVolume(), a.Nome);
            return (cubo, op, r, fluxos);
        },
        async x =>
        {
            (E.CuboResumo, E.OpcoesResumo, E.Resultado, E.FluxosResumo) = x;
            E.FiltrosResumo = new();
            E.RecalcularTma();
            E.ArquivoResumo = a;
            E.AtualizarSubResumo();
            await Task.CompletedTask;
        },
        async ex =>
        {
            if (E.Resultado != null) E.AtualizarSubResumo(); else E.SubResumo = "Falha ao carregar a planilha.";
            await J.Erro("Erro ao ler a planilha", Estado.Mensagem(ex));
        },
        (s, _) => E.SubResumo = $"Lendo {a.Nome}… {s}s (planilhas grandes podem levar um tempo)");
    }

    async Task GerarRelatorio()
    {
        if (E.Resultado == null) { await J.Info("Relatório PDF", "Carregue uma planilha primeiro."); return; }
        byte[] pdf;
        try { pdf = Core.Pdf.Relatorios.Resumo(E.Resultado); }
        catch (Exception ex) { await J.Erro("Erro ao gerar o PDF", ex.Message); return; }
        var nome = $"Relatorio_Qualidade_{Path.GetFileNameWithoutExtension(E.Resultado.Arquivo)}_{Estado.Agora("yyyyMMdd_HHmm")}.pdf";
        await E.Salvar(nome, pdf, Navegador.MimePdf, "Relatório gerado");
    }

    async Task Classificar()
    {
        if (E.CuboResumo == null) { await J.Info("Classificar procedimentos", "Carregue a planilha primeiro."); return; }
        var novo = await J.Classes(E.OpcoesResumo!.Procedimentos, E.ClassesProc);
        if (novo != null) await E.AplicarClasses(novo);
    }

    async Task Escolher(string chave, string titulo)
    {
        if (E.CuboResumo == null) { await J.Info("Filtro", "Carregue a planilha primeiro."); return; }
        var ops = chave switch { "usuarios" => E.OpcoesResumo!.Usuarios, "segmentos" => E.OpcoesResumo!.Segmentos, _ => E.OpcoesResumo!.Dias };
        var res = await J.Multi(titulo, ops.Select(v => (v, v)), E.FiltrosResumo.Get(chave), "Marque um ou mais itens. Sem nada marcado, todos entram.");
        if (res == null) return;
        E.FiltrosResumo.Set(chave, res);
        E.RecalcularResumo();
        E.Notificar();
    }

    void Limpar()
    {
        E.FiltrosResumo = new();
        E.RecalcularResumo();
        E.Notificar();
    }
}
