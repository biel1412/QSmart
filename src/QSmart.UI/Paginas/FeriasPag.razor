@page "/ferias"
@inherits PaginaBase
@implements IDisposable
@using QSmart.Core.Coordenacao

<Pagina Titulo="Férias" Grupo="@A.Grupo"
        Sub="O painel geral de férias de todas as coordenações. Cada coordenação marca as suas; o QSmart mostra o prazo de cada pessoa pela CLT, avisa quando um mês passa do limite e sugere datas melhores."
        Kpis="@(_todos.Count > 0 ? KpisFe : null)">
    <Acoes>
        <button class="btn btn-hero" disabled="@(_todos.Count == 0)" @onclick="Exportar" title="O painel de férias em planilha"><Icone Nome="download" Tamanho="17" /> Exportar planilha</button>
    </Acoes>
    <ChildContent>
        @if (E.FeErro != null)
        {
            <div class="oo-bloqueio"><Icone Nome="cadeado" Tamanho="26" /><div><b>@E.FeErro</b><p class="muted">As Férias são da coordenação: só coordenador e administrador entram.</p></div></div>
        }
        else if (E.FeColabs == null)
        {
            <p class="muted"><span class="ia-spin pequeno"></span> Abrindo o painel de férias…</p>
        }
        else if (_todos.Count == 0)
        {
            <div class="vazio-grande">
                <span class="vazio-ic"><Icone Nome="ferias" Tamanho="34" /></span>
                <h3>Nenhuma pessoa na base ainda</h3>
                <p class="muted">Carregue no seu Perfil a planilha com <b>nome, data de admissão, liderança e coordenação</b>. Ela monta este painel e o One a One de uma vez.</p>
                <a class="btn btn-pri" href="perfil"><Icone Nome="upload" Tamanho="16" /> Carregar a planilha no Perfil</a>
            </div>
        }
        else
        {
            <div class="fv-barra">
                <div class="fv-seg">
                    <button class="@(!_geral ? "on" : "")" @onclick="() => _geral = false" disabled="@(E.FeAdmin)">Minha coordenação</button>
                    <button class="@(_geral ? "on" : "")" @onclick="() => _geral = true">Geral</button>
                </div>
                @if (_geral || E.FeAdmin)
                {
                    <select class="campo" value="@_coord" @onchange="e => { _coord = e.Value?.ToString() ?? Todas; _lid = Todas; }">
                        <option value="@Todas">Todas as coordenações (@_carga.Coordenacoes.Count)</option>
                        @foreach (var c in _carga.Coordenacoes) { <option value="@c">@c</option> }
                    </select>
                }
                <select class="campo" value="@_lid" @onchange="e => _lid = e.Value?.ToString() ?? Todas">
                    <option value="@Todas">Todas as lideranças</option>
                    @foreach (var l in Visiveis(false).Select(c => c.Lideranca).Where(l => l != "").Distinct().OrderBy(l => l)) { <option value="@l">@l</option> }
                </select>
                <input class="campo fv-busca" placeholder="Buscar pessoa…" @bind="_busca" @bind:event="oninput" />
                <label class="fv-chk"><input type="checkbox" @bind="_soPendentes" /> Só quem precisa marcar</label>
                <span class="mola"></span>
                <button class="btn btn-sec" @onclick="Recarregar" title="Buscar o que as outras coordenações marcaram"><Icone Nome="atualizar" Tamanho="15" /></button>
            </div>

            @* ======================================================== mapa dos meses *@
            <div class="fv-meses-cab">
                <b>Ocupação por mês</b>
                <span class="muted pequeno">até @FeriasClt.LimitePorCoordenacao pessoas por coordenação · @_carga.LimiteGeral no geral (@_carga.Coordenacoes.Count coordenações × @FeriasClt.LimitePorCoordenacao)@(_semImpacto > 0 ? $" · {_semImpacto} pessoa(s)-chave fora da conta" : "")</span>
                <span class="mola"></span>
                <button class="fv-nav" @onclick="() => Andar(-3)" title="Meses anteriores"><Icone Nome="esquerda" Tamanho="16" /></button>
                <button class="fv-nav txt" @onclick="Hoje">Hoje</button>
                <button class="fv-nav" @onclick="() => Andar(3)" title="Próximos meses"><Icone Nome="direita" Tamanho="16" /></button>
            </div>
            <div class="fv-meses">
                @foreach (var m in _meses)
                {
                    var k = FeriasClt.Mes(m.Year, m.Month);
                    var g = _carga.Geral(k);
                    bool estGeral = _carga.EstouraGeral(k);
                    bool estAlguma = _carga.Coordenacoes.Any(c => _carga.Estoura(k, c));
                    <button class="fv-mes @(estGeral || estAlguma ? "estoura" : "") @(k == _mesFoco ? "foco" : "") @(m.Year == _hoje.Year && m.Month == _hoje.Month ? "atual" : "")" @onclick="() => FocarMes(k)">
                        <span class="fv-mes-n">@FeriasClt.Meses[m.Month - 1]<small>@(m.Month == 1 || m == _meses[0] ? m.Year.ToString() : "")</small></span>
                        <span class="fv-mes-g"><b>@g</b>/@_carga.LimiteGeral</span>
                        <span class="fv-mes-barra"><i style="width:@Pc(g, _carga.LimiteGeral)"></i></span>
                        <span class="fv-mes-coords">
                            @foreach (var c in _carga.Coordenacoes)
                            {
                                var n = _carga.Na(k, c);
                                <span class="@(n > FeriasClt.LimitePorCoordenacao ? "x" : n == FeriasClt.LimitePorCoordenacao ? "cheio" : "")" style="--c:@CorCoord(c)" title="@($"{c}: {n} de {FeriasClt.LimitePorCoordenacao}")">
                                    @for (int i = 0; i < Math.Max(FeriasClt.LimitePorCoordenacao, n); i++) { <i class="@(i < n ? (i >= FeriasClt.LimitePorCoordenacao ? "a-mais" : "on") : "")"></i> }
                                </span>
                            }
                        </span>
                    </button>
                }
            </div>
            <div class="fv-legenda">
                @foreach (var c in _carga.Coordenacoes) { <span><i style="background:@CorCoord(c)"></i>@c@(Minha(c) ? " (sua)" : "")</span> }
                <span><i class="janela"></i>pode tirar (até o limite)</span>
                <span><i class="limite"></i>limite (fim do período concessivo)</span>
                <span><i class="conf"></i>mês acima do limite</span>
            </div>

            @if (_mesFoco != null)
            {
                var quem = _todos.Where(c => c.F.Periodos.SelectMany(FeriasClt.MesesDe).Contains(_mesFoco)).OrderBy(c => c.Coordenacao).ThenBy(c => c.Nome).ToList();
                <div class="fv-foco">
                    <div class="fv-foco-cab"><b>@FeriasClt.MesNome(_mesFoco)</b><span>@quem.Count(c => !c.F.SemImpacto) de @_carga.LimiteGeral no geral</span>
                        <span class="mola"></span><button class="sn-mais" @onclick="() => _mesFoco = null" title="Fechar"><Icone Nome="x" Tamanho="15" /></button></div>
                    <div class="fv-foco-lista">
                        @foreach (var c in quem)
                        {
                            var per = c.F.Periodos.First(p => FeriasClt.MesesDe(p).Contains(_mesFoco));
                            <button class="fv-chip @(c.F.SemImpacto ? "chave" : "") @(FeriasClt.Conflitos(c, _carga).Contains(_mesFoco) ? "conf" : "")" style="--c:@CorCoord(c.Coordenacao)" @onclick="() => Abrir(c)">
                                <span class="fv-av" style="background:@CorCoord(c.Coordenacao)">@Iniciais(c.Nome)</span>
                                <span><b>@Curto(c.Nome)</b><small>@per.Inicio.ToString("dd/MM") – @per.Fim.ToString("dd/MM") · @c.Coordenacao</small></span>
                                @if (c.F.SemImpacto) { <em title="Pessoa-chave: não entra na conta">chave</em> }
                            </button>
                        }
                        @if (quem.Count == 0) { <span class="muted pequeno">Ninguém de férias neste mês.</span> }
                    </div>
                </div>
            }

            @* ======================================================== linha do tempo *@
            var lista = Visiveis(true);
            <div class="fv-tl">
                <div class="fv-tl-cab">
                    <div class="fv-tl-nome">@lista.Count pessoa(s)</div>
                    <div class="fv-tl-grade">
                        @foreach (var m in _meses)
                        {
                            var k = FeriasClt.Mes(m.Year, m.Month);
                            <span class="@(_carga.EstouraGeral(k) || _carga.Coordenacoes.Any(c => _carga.Estoura(k, c)) ? "estoura" : "") @(k == _mesFoco ? "foco" : "")">@FeriasClt.Meses[m.Month - 1]</span>
                        }
                        @if (_hoje >= _ini && _hoje <= _fim) { <i class="fv-hoje" style="left:@Pos(_hoje)"><b>hoje</b></i> }
                    </div>
                </div>
                @foreach (var c in lista)
                {
                    var s = FeriasClt.Situacao(c, _hoje);
                    var conf = FeriasClt.Conflitos(c, _carga);
                    <div class="fv-tl-lin @(_sel == c ? "sel" : "") @(c.Minha ? "" : "outra")" @onclick="() => Abrir(c)" @key="c.Id">
                        <div class="fv-tl-nome">
                            <span class="fv-av" style="background:@CorCoord(c.Coordenacao)">@Iniciais(c.Nome)</span>
                            <div><b>@c.Nome</b><small>@(c.Lideranca == "" ? "sem liderança" : c.Lideranca)@(_geral ? $" · {c.Coordenacao}" : "")</small></div>
                            <span class="fv-st @Nivel(s.Nivel)" title="@Dica(s)">@(s.Nivel == NivelFer.Completo ? "✓" : s.Faltam > 0 && s.Nivel != NivelFer.SemAdmissao ? $"{s.Faltam}d" : "")</span>
                        </div>
                        <div class="fv-tl-grade">
                            @foreach (var _ in _meses) { <span></span> }
                            @if (s.Ciclo is { } ci && ci.Limite >= _ini && ci.Libera <= _fim && s.Faltam > 0)
                            {
                                <i class="fv-janela" style="left:@Pos(Max(ci.Libera, _ini));width:@Larg(Max(ci.Libera, _ini), Min(ci.Limite, _fim))" title="@($"Pode tirar de {ci.Libera:dd/MM/yyyy} a {ci.Limite:dd/MM/yyyy}")"></i>
                            }
                            @if (s.Ciclo is { } ci2 && ci2.Limite >= _ini && ci2.Limite <= _fim && s.Faltam > 0)
                            {
                                <i class="fv-limite" style="left:@Pos(ci2.Limite)" title="@($"Limite: {ci2.Limite:dd/MM/yyyy}")"></i>
                            }
                            @foreach (var p in c.F.Periodos.Where(p => p.Fim >= _ini && p.Inicio <= _fim))
                            {
                                bool pc = !c.F.SemImpacto && FeriasClt.MesesDe(p).Any(conf.Contains);
                                <i class="fv-per @(pc ? "conf" : "") @(c.F.SemImpacto ? "chave" : "") @(p.Status == "Pedido" ? "pedido" : "")" style="left:@Pos(Max(p.Inicio, _ini));width:@Larg(Max(p.Inicio, _ini), Min(p.Fim, _fim));--c:@CorCoord(c.Coordenacao)"
                                   title="@($"{p.Inicio:dd/MM/yyyy} a {p.Fim:dd/MM/yyyy} · {p.Dias} dias{(p.Vende ? " + 10 vendidos" : "")} · {p.Status}")">@(p.Dias >= 10 ? $"{p.Dias}d" : "")</i>
                            }
                        </div>
                    </div>
                }
                @if (lista.Count == 0) { <p class="muted pequeno fv-vazio">Ninguém com esses filtros.</p> }
            </div>
        }
    </ChildContent>
</Pagina>

@* ======================================================== painel da pessoa *@
@if (_sel is { } c0)
{
    var sit = FeriasClt.Situacao(c0, _hoje);
    var avisos = FeriasClt.Validar(c0, _hoje);
    var conf0 = FeriasClt.Conflitos(c0, _carga);
    bool ed = c0.Minha;
    <div class="fv-fundo" @onclick="Fechar"></div>
    <aside class="fv-painel">
        <header>
            <span class="fv-av gde" style="background:@CorCoord(c0.Coordenacao)">@Iniciais(c0.Nome)</span>
            <div><b>@c0.Nome</b><small>@(c0.Coordenacao == "" ? "sem coordenação" : c0.Coordenacao) · @(c0.Lideranca == "" ? "sem liderança" : c0.Lideranca)</small></div>
            <button class="sn-mais" @onclick="Fechar" title="Fechar"><Icone Nome="x" Tamanho="17" /></button>
        </header>
        @if (!ed) { <div class="fv-so-ver"><Icone Nome="olho" Tamanho="14" /> Da coordenação <b>@c0.Coordenacao</b>: você só vê. Quem marca é essa coordenação.</div> }

        <section class="fv-prazo @Nivel(sit.Nivel)">
            @if (sit.Ciclo is { } ci)
            {
                <div class="fv-anel" style="--p:@((int)Math.Round((sit.Marcados + sit.Vendidos) * 100.0 / 30))">
                    <span><b>@(sit.Marcados + sit.Vendidos)</b>/30</span>
                </div>
                <div class="fv-prazo-txt">
                    <span class="fv-st-txt @Nivel(sit.Nivel)">@sit.Rotulo</span>
                    <b>Limite @ci.Limite.ToString("dd/MM/yyyy")</b>
                    <small>Pode tirar de @ci.Libera.ToString("dd/MM/yyyy") até @ci.Limite.ToString("dd/MM/yyyy")@(sit.Faltam > 0 && sit.InicioMax is { } im ? $" · começar até {im:dd/MM/yyyy}" : "")</small>
                    <small>Admissão @(c0.Admissao?.ToString("dd/MM/yyyy")) · @sit.Marcados dias marcados@(sit.Vendidos > 0 ? " + 10 vendidos" : "")@(sit.Faltam > 0 ? $" · faltam {sit.Faltam}" : "")</small>
                </div>
            }
            else
            {
                <div class="fv-prazo-txt"><span class="fv-st-txt sem">Sem data de admissão</span><small>Atualize a planilha base no Perfil com a data de admissão desta pessoa.</small></div>
            }
        </section>

        <label class="fv-chave @(c0.F.SemImpacto ? "on" : "")">
            <input type="checkbox" checked="@c0.F.SemImpacto" disabled="@(!ed)" @onchange="e => MudarChave(c0, e.Value is true)" />
            <span class="fv-sw"></span>
            <span><b>Pessoa-chave: não impacta</b><small>Fica fora da conta de quantos estão de férias no mês (não gera conflito nem alerta).</small></span>
        </label>

        <div class="fv-sec"><b>Férias marcadas</b>@if (ed) { <button class="btn btn-sec btn-peq" @onclick="() => NovoPeriodo(c0, sit)"><Icone Nome="mais" Tamanho="14" /> Período</button> }</div>
        @if (c0.F.Periodos.Count == 0) { <p class="muted pequeno">Nenhum período marcado ainda.</p> }
        @foreach (var p in c0.F.Periodos.OrderBy(p => p.Inicio).ToList())
        {
            var pp = p;
            bool pc = !c0.F.SemImpacto && FeriasClt.MesesDe(p).Any(conf0.Contains);
            <div class="fv-per-card @(pc ? "conf" : "") @(_perSel == p ? "sel" : "")" @onclick="() => _perSel = pp">
                <div class="fv-per-lin">
                    <label>Início<input type="date" value="@p.Inicio.ToString("yyyy-MM-dd")" disabled="@(!ed)" @onchange="e => MudarInicio(c0, pp, e)" /></label>
                    <label>Dias<input type="number" min="5" max="30" value="@p.Dias" disabled="@(!ed)" @onchange="e => MudarDias(c0, pp, e)" /></label>
                    <label>Situação
                        <select value="@p.Status" disabled="@(!ed)" @onchange="e => MudarStatus(c0, pp, e)">
                            @foreach (var st in FeriasBanco.StatusPossiveis) { <option value="@st">@st</option> }
                        </select>
                    </label>
                    @if (ed) { <button class="sn-mais" title="Excluir este período" @onclick:stopPropagation="true" @onclick="() => ExcluirPeriodo(c0, pp)"><Icone Nome="lixo" Tamanho="15" /></button> }
                </div>
                <div class="fv-per-info">
                    <span>@p.Inicio.ToString("ddd dd/MM", Br) → @p.Fim.ToString("ddd dd/MM/yyyy", Br) · volta @p.Fim.AddDays(1).ToString("dd/MM", Br)</span>
                    <label class="fv-vende"><input type="checkbox" checked="@p.Vende" disabled="@(!ed)" @onchange="e => MudarVende(c0, pp, e.Value is true)" /> vende 10 dias</label>
                </div>
                @if (pc)
                {
                    <div class="fv-per-conf"><Icone Nome="alerta" Tamanho="13" />
                        @string.Join(" · ", FeriasClt.MesesDe(p).Where(conf0.Contains).Select(m => $"{FeriasClt.MesNome(m)}: {_carga.Na(m, c0.Coordenacao)}/{FeriasClt.LimitePorCoordenacao} na coordenação, {_carga.Geral(m)}/{_carga.LimiteGeral} no geral"))
                    </div>
                }
            </div>
        }

        @if (avisos.Count > 0)
        {
            <div class="fv-avisos">
                @foreach (var a in avisos) { <span class="@(a.Erro ? "erro" : "")"><Icone Nome="@(a.Erro ? "alerta" : "info")" Tamanho="13" /> @a.Texto</span> }
            </div>
        }

        @if (ed && c0.Admissao != null)
        {
            var alvo = _perSel != null && c0.F.Periodos.Contains(_perSel) ? _perSel : null;
            int diasSug = alvo?.Dias ?? Math.Max(5, sit.Faltam > 0 ? sit.Faltam - (sit.Vendidos == 0 && sit.Faltam == 30 ? 0 : 0) : 30);
            var sugs = FeriasClt.Sugerir(c0, _todos, diasSug, _hoje, alvo);
            <div class="fv-sec"><b>Sugestões @(alvo != null ? $"para o período de {alvo.Inicio:dd/MM}" : $"para {diasSug} dias")</b></div>
            <p class="muted pequeno fv-sug-dica">Datas próximas que cabem no prazo, com menos gente da coordenação e da mesma liderança fora junto.</p>
            <div class="fv-sugs">
                @foreach (var sg in sugs)
                {
                    var ss = sg;
                    <div class="fv-sug">
                        <div class="fv-sug-data"><b>@sg.Inicio.ToString("dd/MM")</b><span>→</span><b>@sg.Fim.ToString("dd/MM")</b><small>@sg.Inicio.ToString("ddd, dd 'de' MMM yyyy", Br)</small></div>
                        <small>@sg.Dias dias · @sg.Motivo</small>
                        <button class="btn btn-pri btn-peq" @onclick="() => UsarSugestao(c0, alvo, ss)"><Icone Nome="check" Tamanho="14" /> @(alvo != null ? "Mudar para esta" : "Marcar esta")</button>
                    </div>
                }
                @if (sugs.Count == 0) { <span class="muted pequeno">Não achei datas livres no prazo. Veja o mapa dos meses ou marque a pessoa como chave.</span> }
            </div>
        }
    </aside>
}

@code {
    protected override string Chave => "ferias";
    const string Todas = "\u0001todas";
    static readonly System.Globalization.CultureInfo Br = Core.Pacote.FormatoPt.Pt;
    static readonly string[] Paleta = { "#6366F1", "#0EA5E9", "#10B981", "#F59E0B", "#EC4899", "#8B5CF6", "#14B8A6", "#EF4444", "#84CC16", "#F97316" };

    DateOnly _hoje = DateOnly.FromDateTime(DateTime.Today);
    DateOnly _ini, _fim;
    List<DateOnly> _meses = new();
    List<ColabFer> _todos = new();
    FeriasClt.Carga _carga = new();
    bool _geral, _soPendentes;
    string _coord = Todas, _lid = Todas, _busca = "";
    string? _mesFoco;
    int _semImpacto;
    ColabFer? _sel;
    PeriodoFer? _perSel;
    string? _urlTratada;

    protected override async Task OnInitializedAsync()
    {
        Rotas.LocationChanged += Mudou;
        Janela(0);
        await E.CarregarFerias(true);
        Recalcular();
        LerUrl();
    }

    void Mudou(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { LerUrl(); InvokeAsync(StateHasChanged); }

    void LerUrl()
    {
        if (_urlTratada == Rotas.Uri) return;
        _urlTratada = Rotas.Uri;
        var q = new Uri(Rotas.Uri).Query.TrimStart('?').Split('&').Select(x => x.Split('=', 2)).Where(x => x.Length == 2).ToDictionary(x => x[0], x => Uri.UnescapeDataString(x[1]));
        if (q.TryGetValue("mes", out var m) && m.Length == 7 && DateOnly.TryParseExact(m + "-01", "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var d))
        {
            _geral = true; _coord = Todas; _mesFoco = m;
            if (d < _ini || d > _fim) { _ini = d.AddMonths(-2); Janela(0, _ini); }
        }
    }

    public override void Dispose() { base.Dispose(); Rotas.LocationChanged -= Mudou; }

    void Recalcular()
    {
        _todos = E.FeColabs ?? new();
        _carga = FeriasClt.Calcular(_todos);
        _semImpacto = _todos.Count(c => c.F.SemImpacto);
        if (E.FeAdmin) _geral = true;
        StateHasChanged();
    }

    async Task Recarregar() { await E.CarregarFerias(true); if (_sel != null) _sel = E.FeColabs?.FirstOrDefault(c => c.Id == _sel.Id); Recalcular(); }

    // ---------------------------------------------------- janela de 12 meses
    void Janela(int deslocar, DateOnly? de = null)
    {
        var baseM = de ?? (_ini == default ? new DateOnly(_hoje.Year, _hoje.Month, 1).AddMonths(-1) : _ini);
        _ini = new DateOnly(baseM.Year, baseM.Month, 1).AddMonths(deslocar);
        _fim = _ini.AddMonths(12).AddDays(-1);
        _meses = Enumerable.Range(0, 12).Select(i => _ini.AddMonths(i)).ToList();
    }
    void Andar(int n) => Janela(n);
    void Hoje() { _ini = default; Janela(0); }
    void FocarMes(string k) => _mesFoco = _mesFoco == k ? null : k;

    int TotalDias => _fim.DayNumber - _ini.DayNumber + 1;
    string Pos(DateOnly d) => Pct((d.DayNumber - _ini.DayNumber) * 100.0 / TotalDias);
    string Larg(DateOnly a, DateOnly b) => Pct(Math.Max(0.35, (b.DayNumber - a.DayNumber + 1) * 100.0 / TotalDias));
    static string Pct(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";
    static string Pc(int a, int b) => Pct(Math.Min(100, b == 0 ? 0 : a * 100.0 / b));
    static DateOnly Max(DateOnly a, DateOnly b) => a > b ? a : b;
    static DateOnly Min(DateOnly a, DateOnly b) => a < b ? a : b;

    // ---------------------------------------------------- filtros
    bool Minha(string coord) => E.FeAdmin || _todos.Any(c => c.Minha && string.Equals(c.Coordenacao, coord, StringComparison.OrdinalIgnoreCase));

    List<ColabFer> Visiveis(bool completo)
    {
        IEnumerable<ColabFer> q = _todos;
        if (!_geral && !E.FeAdmin) q = q.Where(c => c.Minha);
        else if (_coord != Todas) q = q.Where(c => string.Equals(c.Coordenacao, _coord, StringComparison.OrdinalIgnoreCase));
        if (!completo) return q.ToList();
        if (_lid != Todas) q = q.Where(c => c.Lideranca == _lid);
        if (_busca.Trim() != "") { var b = Ferias.Norm(_busca); q = q.Where(c => Ferias.Norm(c.Nome).Contains(b)); }
        if (_soPendentes) q = q.Where(c => FeriasClt.Situacao(c, _hoje) is { Faltam: > 0 } s && s.Nivel is not NivelFer.Aguardando);
        if (_mesFoco != null) { }
        // urgentes primeiro, depois por nome
        return q.OrderBy(c => Ordem(FeriasClt.Situacao(c, _hoje).Nivel)).ThenBy(c => c.Coordenacao).ThenBy(c => c.Nome, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    static int Ordem(NivelFer n) => n switch { NivelFer.Estourado => 0, NivelFer.Urgente => 1, NivelFer.Atencao => 2, NivelFer.SemAdmissao => 3, NivelFer.Ok => 4, NivelFer.Aguardando => 5, _ => 6 };
    static string Nivel(NivelFer n) => n switch { NivelFer.Estourado => "estourado", NivelFer.Urgente => "urgente", NivelFer.Atencao => "atencao", NivelFer.Ok => "ok", NivelFer.Completo => "completo", NivelFer.Aguardando => "aguardando", _ => "sem" };
    static string Dica(SituacaoFer s) => s.Ciclo is { } c ? $"{s.Rotulo} · pode tirar de {c.Libera:dd/MM/yyyy} a {c.Limite:dd/MM/yyyy}{(s.Faltam > 0 ? $" · faltam {s.Faltam} dias" : "")}" : s.Rotulo;

    string CorCoord(string c)
    {
        var i = _carga.Coordenacoes.FindIndex(x => string.Equals(x, c, StringComparison.OrdinalIgnoreCase));
        return i < 0 ? "#94A3B8" : Paleta[i % Paleta.Length];
    }

    static string Iniciais(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length == 0 ? "?" : (p[0][..1] + (p.Length > 1 ? p[^1][..1] : "")).ToUpperInvariant(); }
    static string Curto(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length <= 2 ? n : $"{p[0]} {p[^1]}"; }

    // ---------------------------------------------------- edição
    void Abrir(ColabFer c) { _sel = c; _perSel = c.F.Periodos.Where(p => p.Fim >= _hoje).OrderBy(p => p.Inicio).FirstOrDefault(); }
    void Fechar() { _sel = null; _perSel = null; }

    async Task Salvar(ColabFer c)
    {
        Recalcular();
        await E.SalvarFerias(c);
        Recalcular();
    }

    async Task MudarChave(ColabFer c, bool on) { c.F.SemImpacto = on; await Salvar(c); }

    async Task NovoPeriodo(ColabFer c, SituacaoFer s)
    {
        int dias = s.Faltam > 0 ? Math.Min(30, s.Faltam) : 30;
        if (dias < 5) dias = 5;
        var sug = FeriasClt.Sugerir(c, _todos, dias, _hoje, null, 1).FirstOrDefault();
        var ini = sug?.Inicio ?? Ferias.ProximoDiaUtil(Max(s.Ciclo?.Libera ?? _hoje, _hoje.AddDays(30)));
        var p = new PeriodoFer { Inicio = ini, Pedido = ini, Dias = dias };
        c.F.Periodos.Add(p);
        _perSel = p;
        await Salvar(c);
    }

    async Task ExcluirPeriodo(ColabFer c, PeriodoFer p)
    {
        if (!await J.Pergunta("Excluir período", $"Excluir as férias de {p.Inicio:dd/MM/yyyy} a {p.Fim:dd/MM/yyyy}?")) return;
        c.F.Periodos.Remove(p);
        if (_perSel == p) _perSel = null;
        await Salvar(c);
    }

    async Task MudarInicio(ColabFer c, PeriodoFer p, ChangeEventArgs e)
    {
        if (!DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var d)) return;
        p.Inicio = d; if (p.Status == "Pedido") p.Pedido = d;
        await Salvar(c);
    }

    async Task MudarDias(ColabFer c, PeriodoFer p, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var d)) return;
        p.Dias = Math.Clamp(d, 1, 30);
        await Salvar(c);
    }

    async Task MudarStatus(ColabFer c, PeriodoFer p, ChangeEventArgs e) { p.Status = e.Value?.ToString() ?? p.Status; await Salvar(c); }

    async Task MudarVende(ColabFer c, PeriodoFer p, bool on)
    {
        if (on)
        {
            // uma venda por ciclo: tira dos outros do mesmo ciclo
            var ci = c.Admissao is { } adm ? FeriasClt.CicloDe(adm, p.Inicio) : null;
            foreach (var o in c.F.Periodos.Where(o => o != p && ci != null && FeriasClt.CicloDe(c.Admissao!.Value, o.Inicio) == ci)) o.Vende = false;
            if (c.F.Periodos.Count(o => ci != null && FeriasClt.CicloDe(c.Admissao!.Value, o.Inicio) == ci) == 1 && p.Dias == 30) p.Dias = 20;
        }
        p.Vende = on;
        await Salvar(c);
    }

    async Task UsarSugestao(ColabFer c, PeriodoFer? alvo, SugestaoFer s)
    {
        if (alvo != null) { alvo.Inicio = s.Inicio; alvo.Dias = s.Dias; }
        else { alvo = new PeriodoFer { Inicio = s.Inicio, Pedido = s.Inicio, Dias = s.Dias }; c.F.Periodos.Add(alvo); }
        _perSel = alvo;
        _ = E.Conta.Registrar("ferias.sugestao", true);
        await Salvar(c);
    }

    // ---------------------------------------------------- exportar
    async Task Exportar()
    {
        var wb = new Core.Planilhas.XlsxWriter();
        var s = wb.Planilha("Férias");
        s.Cabecalho("Coordenação", "Liderança", "Nome", "Admissão", "Pode tirar a partir de", "Limite", "Situação", "Faltam marcar", "Início", "Fim", "Dias", "Vende 10 dias", "Status", "Pessoa-chave", "Mês acima do limite");
        s.NegritoLinha(0);
        int n = 1;
        foreach (var c in _todos.OrderBy(c => c.Coordenacao).ThenBy(c => c.Lideranca).ThenBy(c => c.Nome))
        {
            var st = FeriasClt.Situacao(c, _hoje);
            var conf = FeriasClt.Conflitos(c, _carga);
            var ps = c.F.Periodos.OrderBy(p => p.Inicio).ToList();
            if (ps.Count == 0) { s.Linha(c.Coordenacao, c.Lideranca, c.Nome, c.Admissao, st.Ciclo?.Libera, st.Ciclo?.Limite, st.Rotulo, st.Faltam, null, null, null, "", "", c.F.SemImpacto ? "Sim" : "Não", ""); n++; continue; }
            foreach (var p in ps)
            {
                s.Linha(c.Coordenacao, c.Lideranca, c.Nome, c.Admissao, st.Ciclo?.Libera, st.Ciclo?.Limite, st.Rotulo, st.Faltam, p.Inicio, p.Fim, p.Dias, p.Vende ? "Sim" : "Não", p.Status,
                    c.F.SemImpacto ? "Sim" : "Não", string.Join(", ", FeriasClt.MesesDe(p).Where(conf.Contains).Select(FeriasClt.MesNome)));
                n++;
            }
        }
        foreach (var col in new[] { 3, 4, 5, 8, 9 }) s.FormatoData(col, 1, Math.Max(1, n - 1));
        s.Congelar(1, 3);
        foreach (var (col, w) in new[] { (0, 22.0), (1, 22.0), (2, 32.0), (3, 12.0), (4, 14.0), (5, 12.0), (6, 20.0), (7, 10.0), (8, 12.0), (9, 12.0), (10, 7.0), (11, 12.0), (12, 11.0), (13, 12.0), (14, 30.0) }) s.Largura(col, w);
        await E.Nav.Baixar($"Férias {_hoje:yyyy-MM-dd}.xlsx", wb.Salvar(), Navegador.MimeXlsx);
    }

    // ---------------------------------------------------- indicadores
    RenderFragment KpisFe => @<text>
        @{ var meus = _todos.Where(c => c.Minha || E.FeAdmin).ToList();
           var sits = meus.Select(c => FeriasClt.Situacao(c, _hoje)).ToList();
           int urg = sits.Count(s => s.Nivel is NivelFer.Urgente or NivelFer.Estourado), aten = sits.Count(s => s.Nivel == NivelFer.Atencao);
           int mesesX = _meses.Select(m => FeriasClt.Mes(m.Year, m.Month)).Count(k => _carga.EstouraGeral(k) || _carga.Coordenacoes.Any(c => _carga.Estoura(k, c)));
           int semAdm = sits.Count(s => s.Nivel == NivelFer.SemAdmissao); }
        <Kpi Titulo="@(E.FeAdmin ? "Pessoas" : "Na sua coordenação")" Cor="blue" Valor="@Fmt(meus.Count)" Detalhe="@($"{_todos.Count} no painel geral · {_carga.Coordenacoes.Count} coordenações")" />
        <Kpi Titulo="Prazo urgente" Cor="red" Valor="@Fmt(urg)" Detalhe="precisam começar em até 45 dias" />
        <Kpi Titulo="Atenção" Cor="orange" Valor="@Fmt(aten)" Detalhe="prazo nos próximos 4 meses" />
        <Kpi Titulo="Meses acima do limite" Cor="amber" Valor="@Fmt(mesesX)" Detalhe="@($"nos 12 meses do painel · até {FeriasClt.LimitePorCoordenacao} por coordenação")" />
        <Kpi Titulo="Pessoas-chave" Cor="green" Valor="@Fmt(_semImpacto)" Detalhe="@(semAdm > 0 ? $"fora da conta · {semAdm} sem admissão" : "fora da conta de conflito")" />
    </text>;
}
