@page "/ferias"
@inherits PaginaBase
@using QSmart.Core.Coordenacao

@{ Calcular(); var d = E.Ferias; bool tem = d.Periodos.Count > 0; }
<Pagina Titulo="Férias" Grupo="@A.Grupo" Sub="Baixe o modelo, envie para a equipe preencher e anexe a planilha de volta: o QSmart compara os pedidos e mostra choques, datas próximas, quem quer vender e quem sai em breve."
        Kpis="@(tem ? KpisFerias : null)">
    <Acoes>
        <button class="btn btn-hero" @onclick="BaixarModelo" title="Planilha em branco para a equipe preencher"><Icone Nome="download" Tamanho="17" /> Baixar modelo</button>
        <button class="btn btn-hero" disabled="@(!tem)" @onclick="Exportar" title="Baixa a análise em Excel"><Icone Nome="download" Tamanho="17" /> Exportar análise</button>
        <BotaoArquivo Texto="@(tem ? "Trocar planilha" : "Anexar planilha preenchida")" Variante="pri" Icone="upload" Aceita=".xlsx,.xlsm" AoEscolher="Anexar"
                      Desativado="E.Carregando" Dica="A planilha de férias preenchida pela equipe" />
    </Acoes>
    <ChildContent>
        <div class="fer-etapas">
            <div class="fer-etapa">
                <span class="fer-etapa-n">1</span>
                <div class="fer-etapa-txt">
                    <b>Modelo para coleta</b>
                    <span class="muted">Envie para a equipe. Uma linha por pedido de férias, com estas colunas:</span>
                    <div class="fer-colunas">@foreach (var c in Ferias.ColunasModelo) { <span>@c</span> }</div>
                </div>
                <button class="btn btn-sec" @onclick="BaixarModelo"><Icone Nome="download" Tamanho="16" /> Baixar modelo</button>
            </div>
            <div class="fer-etapa @(tem ? "feita" : "")">
                <span class="fer-etapa-n">@(tem ? "✓" : "2")</span>
                <div class="fer-etapa-txt">
                    <b>Planilha preenchida</b>
                    @if (tem)
                    {
                        <span class="muted" title="@d.Arquivo"><b class="fer-arq">@d.Arquivo</b> · anexada em @d.CarregadoEm</span>
                        <span class="muted">@Ferias.Plural(d.Periodos.Count, "pedido") de @Ferias.Plural(_pessoas, "pessoa")@(_times > 0 ? $" em {Ferias.Plural(_times, "time")}" : "")@(d.Problemas.Count > 0 ? $" · {Ferias.Plural(d.Problemas.Count, "linha")} com problema" : "")</span>
                    }
                    else
                    {
                        <span class="muted">Quando a equipe devolver, anexe aqui. A análise fica salva só neste navegador até você trocar ou limpar.</span>
                    }
                </div>
                @if (tem)
                {
                    <button class="btn btn-sec" @onclick="Limpar" title="Apaga a análise deste navegador"><Icone Nome="lixo" Tamanho="16" /> Limpar</button>
                }
                <BotaoArquivo Texto="@(tem ? "Trocar" : "Anexar planilha")" Variante="@(tem ? "sec" : "pri")" Icone="upload" Aceita=".xlsx,.xlsm" AoEscolher="Anexar" Desativado="E.Carregando" />
            </div>
        </div>

        @if (!tem)
        {
            <div class="vazio-grande">
                <span class="vazio-ic"><Icone Nome="ferias" Tamanho="34" /></span>
                <h3>Nenhuma planilha de férias anexada</h3>
                <p class="muted">Baixe o modelo, peça para cada pessoa preencher usuário, time, data de início, total de dias e se deseja vender.
                    Depois anexe a planilha preenchida: o QSmart mostra choques de datas, datas muito próximas, quem quer vender e quem sai em breve.</p>
            </div>
        }
        else
        {
            <div class="barra-ferr">
                <span class="rotulo">Ano</span>
                <select class="campo" value="@_ano" @onchange="e => _ano = int.Parse(e.Value!.ToString()!)">
                    @foreach (var a in Anos()) { <option value="@a">@a</option> }
                </select>
                <span class="rotulo">Time</span>
                <select class="campo" style="min-width:150px" value="@_equipe" @onchange="e => _equipe = e.Value?.ToString() ?? EquipeTodas">
                    <option value="@EquipeTodas">Todos</option>
                    @foreach (var q in Equipes()) { <option value="@q">@(q == "" ? "Sem time" : q)</option> }
                </select>
                <div class="campo-busca"><Icone Nome="busca" Tamanho="16" /><input class="campo" placeholder="Procurar usuário" @bind="_busca" @bind:event="oninput" /></div>
                <span class="mola"></span>
                <span class="fer-regras" title="Dias livres entre a volta de um e a saída de outro">
                <span class="muted">Muito próximas &lt;</span>
                <input class="campo num" type="number" min="0" max="90" value="@d.MuitoProxima" @onchange="e => Mudar(e, n => d.MuitoProxima = Math.Min(n, d.DistanciaMinima))" />
                <span class="muted">dias · próximas &lt;</span>
                <input class="campo num" type="number" min="0" max="90" value="@d.DistanciaMinima" @onchange="e => Mudar(e, n => { d.DistanciaMinima = n; d.MuitoProxima = Math.Min(d.MuitoProxima, n); })" />
                <span class="muted">dias · em breve:</span>
                <input class="campo num" type="number" min="1" max="365" value="@d.EmBreve" @onchange="e => Mudar(e, n => d.EmBreve = Math.Max(1, n))" />
                <span class="muted">dias</span>
                </span>
                <button class="alternador @(d.PorEquipe ? "on" : "")" @onclick="AlternarEquipe" title="Ligado: só compara pessoas do mesmo time. Desligado: compara todos.">
                    <span class="bolinha"></span> Só no mesmo time
                </button>
            </div>

            <Painel Titulo="Alertas" Classe="fer-painel-alertas" Nota="@(_alertasVis.Count == 0 ? "" : $"{_alertasFilt.Count} de {_alertasVis.Count}")">
                <Extra>
                    <div class="segmentado">
                        @foreach (var (k, nome, qtd) in new[] { (-1, "Todos", _alertasVis.Count), (3, "Choques", Qtd(NivelFerias.Choque)), (2, "Muito próximas", Qtd(NivelFerias.MuitoProximo)), (1, "Próximas", Qtd(NivelFerias.Proximo)) })
                        {
                            <button class="seg @(_filtroNivel == k ? "on" : "")" @onclick="() => _filtroNivel = k">@nome (@qtd)</button>
                        }
                    </div>
                </Extra>
                <ChildContent>
                    <div class="fer-alertas">
                        @if (_alertasFilt.Count == 0)
                        {
                            <div class="fer-alerta ok grande"><Icone Nome="check" Tamanho="18" /> @(_alertasVis.Count == 0 ? "Tudo certo: nenhum pedido se choca ou fica próximo demais" : "Nada nesse tipo")@(Filtrando ? " com esses filtros" : "").</div>
                        }
                        @foreach (var al in _alertasFilt)
                        {
                            <div class="fer-alerta @Classe(al.Nivel)">
                                <Icone Nome="alerta" Tamanho="16" />
                                <span><b>@al.Titulo</b>@(al.A.Equipe != "" && Norm(al.A.Equipe) == Norm(al.B.Equipe) ? $" · {al.A.Equipe}" : "")<br />@al.Texto</span>
                            </div>
                        }
                    </div>
                </ChildContent>
            </Painel>

            <div class="grade-2">
                <Painel Titulo="@($"Saem em breve · próximos {d.EmBreve} dias")" Nota="@(_breve.Count == 0 ? "" : Ferias.Plural(_breve.Count, "pedido"))">
                    <div class="fer-lista">
                        @if (_agora.Count > 0)
                        {
                            @foreach (var p in _agora)
                            {
                                <div class="fer-item agora">
                                    <span class="fer-cont"><b>agora</b></span>
                                    <span class="fer-item-nome"><b>@p.Colaborador</b><span class="muted">@(p.Equipe != "" ? $"{p.Equipe} · " : "")em férias até @Texto.Dm(p.Fim), volta @Texto.DiaSemana(p.Retorno).ToLowerInvariant() @Texto.Dm(p.Retorno)</span></span>
                                </div>
                            }
                        }
                        @if (_breve.Count == 0 && _agora.Count == 0) { <div class="muted fer-lista-vazia">Ninguém sai nos próximos @d.EmBreve dias@(Filtrando ? " com esses filtros" : "").</div> }
                        @foreach (var p in _breve)
                        {
                            var falta = p.Inicio.DayNumber - _hojeD.DayNumber;
                            var n = Ferias.Nivel(p, _alertas);
                            <div class="fer-item @(falta <= 7 ? "urgente" : "")">
                                <span class="fer-cont"><b>@(falta == 0 ? "hoje" : falta.ToString())</b>@(falta == 0 ? "" : falta == 1 ? "dia" : "dias")</span>
                                <span class="fer-item-nome"><b>@p.Colaborador</b><span class="muted">@(p.Equipe != "" ? $"{p.Equipe} · " : "")@Texto.DiaSemana(p.Inicio).ToLowerInvariant() @Texto.Dm(p.Inicio) a @Texto.Dm(p.Fim) · @Ferias.Plural(p.Dias, "dia")</span></span>
                                @if (p.Vender) { <span class="etq verde">vende</span> }
                                @if (n != NivelFerias.Ok) { <span class="etq @Classe(n)">@Ferias.NomeNivel(n)</span> }
                            </div>
                        }
                    </div>
                </Painel>
                <Painel Titulo="Querem vender dias" Nota="@(_vender.Count == 0 ? "" : $"{Ferias.Plural(_vendedores, "pessoa")}")">
                    <div class="fer-lista">
                        @if (_vender.Count == 0) { <div class="muted fer-lista-vazia">Ninguém marcou que deseja vender@(Filtrando ? " com esses filtros" : "").</div> }
                        @foreach (var p in _vender)
                        {
                            <div class="fer-item">
                                <span class="fer-cont vende"><Icone Nome="check" Tamanho="15" /></span>
                                <span class="fer-item-nome"><b>@p.Colaborador</b><span class="muted">@(p.Equipe != "" ? $"{p.Equipe} · " : "")@Texto.Dmy(p.Inicio) a @Texto.Dmy(p.Fim) · @Ferias.Plural(p.Dias, "dia")</span></span>
                                @if (p.Inicio >= _hojeD && p.Inicio.DayNumber - _hojeD.DayNumber <= d.EmBreve) { <span class="etq azul">em breve</span> }
                            </div>
                        }
                    </div>
                </Painel>
            </div>

            <Painel Titulo="@($"Linha do tempo · {_ano}")" Classe="fer-painel">
                <Extra>
                    <div class="fer-legenda">
                        <span><i class="ok"></i>Sem conflito</span>
                        <span><i class="proximo"></i>Próximas</span>
                        <span><i class="muito"></i>Muito próximas</span>
                        <span><i class="choque"></i>Choque</span>
                        <span><i class="vende"></i>Quer vender</span>
                    </div>
                </Extra>
                <ChildContent>
                    @{ var ini = new DateOnly(_ano, 1, 1); int diasAno = DateTime.IsLeapYear(_ano) ? 366 : 365; }
                    <div class="fer-gantt">
                        <div class="fer-linha fer-cab">
                            <div class="fer-nome"></div>
                            <div class="fer-trilho">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var dm = new DateOnly(_ano, m, 1);
                                    <span class="fer-mes" style="left:@Pct(dm.DayNumber - ini.DayNumber, diasAno);width:@Pct(DateTime.DaysInMonth(_ano, m), diasAno)">@Texto.MesesPt[m - 1][..3]</span>
                                }
                            </div>
                        </div>
                        @if (_linhas.Count == 0)
                        {
                            <div class="g-vazio">Nenhum pedido em @_ano@(Filtrando ? " com esses filtros" : "").</div>
                        }
                        @foreach (var grupo in _linhas.GroupBy(l => l.equipe))
                        {
                            @if (_linhas.Select(l => l.equipe).Distinct().Count() > 1)
                            {
                                <div class="fer-grupo">@(grupo.Key == "" ? "Sem time" : grupo.Key)</div>
                            }
                            @foreach (var (nome, _, periodos) in grupo)
                            {
                                <div class="fer-linha">
                                    <div class="fer-nome" title="@nome">@nome</div>
                                    <div class="fer-trilho">
                                        @for (int m = 2; m <= 12; m++) { <span class="fer-div" style="left:@Pct(new DateOnly(_ano, m, 1).DayNumber - ini.DayNumber, diasAno)"></span> }
                                        @if (_hojeD.Year == _ano) { <span class="fer-hoje" style="left:@Pct(_hojeD.DayNumber - ini.DayNumber + 0.5, diasAno)" title="Hoje"></span> }
                                        @foreach (var p in periodos)
                                        {
                                            var a = Math.Max(p.Inicio.DayNumber, ini.DayNumber) - ini.DayNumber;
                                            var b = Math.Min(p.Fim.DayNumber, ini.DayNumber + diasAno - 1) - ini.DayNumber + 1;
                                            var n = Ferias.Nivel(p, _alertas);
                                            <span class="fer-barra @Classe(n) @(p.Vender ? "vende" : "")"
                                                  style="left:@Pct(a, diasAno);width:@Pct(Math.Max(b - a, 1), diasAno)" title="@Dica(p, n)">
                                                <span>@Texto.Dm(p.Inicio)–@Texto.Dm(p.Fim) · @(p.Dias)d@(p.Vender ? " · $" : "")</span>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </ChildContent>
            </Painel>

            <Painel Titulo="Pedidos" Nota="@($"{_tabela.Count} de {d.Periodos.Count}")" Sangrar="true">
                <div class="tabela-rolagem" style="max-height:460px">
                    <table class="tabela fer-tabela">
                        <colgroup><col style="width:17%" /><col style="width:11%" /><col style="width:13%" /><col style="width:10%" /><col style="width:6%" /><col style="width:13%" /><col style="width:7%" /><col style="width:9%" /><col style="width:10%" /><col style="width:4%" /></colgroup>
                        <thead><tr><th>Usuário</th><th>Time</th><th>Início</th><th>Fim</th><th class="al-c">Dias</th><th>Volta em</th><th class="al-c">Vender</th><th class="al-c">Sai em</th><th>Situação</th><th class="al-c" title="Linha na planilha anexada">#</th></tr></thead>
                        <tbody>
                            @foreach (var p in _tabela)
                            {
                                var n = Ferias.Nivel(p, _alertas);
                                var falta = p.Inicio.DayNumber - _hojeD.DayNumber;
                                <tr>
                                    <td title="@p.Colaborador"><b>@p.Colaborador</b></td>
                                    <td>@p.Equipe</td>
                                    <td><span class="muted">@Texto.DiaSemana(p.Inicio).ToLowerInvariant()</span> @Texto.Dmy(p.Inicio)</td>
                                    <td>@Texto.Dmy(p.Fim)</td>
                                    <td class="al-c"><b>@p.Dias</b></td>
                                    <td><span class="muted">@Texto.DiaSemana(p.Retorno).ToLowerInvariant()</span> @Texto.Dmy(p.Retorno)</td>
                                    <td class="al-c">@if (p.Vender) { <span class="etq verde">sim</span> } else { <span class="muted">não</span> }</td>
                                    <td class="al-c">@(falta > 0 ? Ferias.Plural(falta, "dia") : falta == 0 ? "hoje" : p.Fim >= _hojeD ? "em férias" : "já passou")</td>
                                    <td><span class="etq @Classe(n)">@Ferias.NomeNivel(n)</span></td>
                                    <td class="al-c muted">@p.Linha</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_tabela.Count == 0) { <div class="tabela-vazia">Nenhum pedido com esses filtros.</div> }
                </div>
            </Painel>

            @if (d.Problemas.Count > 0 || _clt.Count > 0)
            {
                <Painel Titulo="Pontos de atenção" Nota="linhas ignoradas e regras da CLT">
                    <div class="fer-alertas">
                        @foreach (var x in d.Problemas)
                        {
                            <div class="fer-alerta choque"><Icone Nome="alerta" Tamanho="16" /><span><b>Planilha</b><br />@x</span></div>
                        }
                        @foreach (var x in _clt)
                        {
                            <div class="fer-alerta clt"><Icone Nome="alerta" Tamanho="16" /><span><b>CLT</b><br />@x</span></div>
                        }
                    </div>
                </Painel>
            }
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "ferias";
    const string EquipeTodas = "\u0001todas";
    int _ano = DateTime.Today.Year, _filtroNivel = -1, _pessoas, _times, _vendedores;
    string _equipe = EquipeTodas, _busca = "";
    DateOnly _hojeD = DateOnly.FromDateTime(DateTime.Today);
    List<AlertaFerias> _alertas = new(), _alertasVis = new(), _alertasFilt = new();
    List<PeriodoFerias> _agora = new(), _breve = new(), _vender = new(), _tabela = new();
    List<string> _clt = new();
    List<(string nome, string equipe, List<PeriodoFerias> periodos)> _linhas = new();

    static string Norm(string s) => Ferias.Norm(s);
    bool Filtrando => _equipe != EquipeTodas || _busca.Trim() != "";
    int Qtd(NivelFerias n) => _alertasVis.Count(a => a.Nivel == n);
    static string Pct(double v, int total) => (v * 100.0 / total).ToString("0.###", CultureInfo.InvariantCulture) + "%";
    static string Classe(NivelFerias n) => n switch { NivelFerias.Choque => "choque", NivelFerias.MuitoProximo => "muito", NivelFerias.Proximo => "proximo", _ => "ok" };

    static string Dica(PeriodoFerias p, NivelFerias n)
        => $"{p.Colaborador}{(p.Equipe != "" ? $" ({p.Equipe})" : "")}\n{Texto.Dmy(p.Inicio)} a {Texto.Dmy(p.Fim)} · {Ferias.Plural(p.Dias, "dia")}\nVolta em {Texto.Dmy(p.Retorno)}"
           + (p.Vender ? "\nQuer vender dias" : "") + (n != NivelFerias.Ok ? $"\n⚠ {Ferias.NomeNivel(n)}" : "") + $"\nLinha {p.Linha} da planilha";

    RenderFragment KpisFerias => __b =>
    {
        var d = E.Ferias;
        int ch = _alertas.Count(a => a.Nivel == NivelFerias.Choque), mp = _alertas.Count(a => a.Nivel == NivelFerias.MuitoProximo), pr = _alertas.Count(a => a.Nivel == NivelFerias.Proximo);
        __b.OpenComponent<Kpi>(0); __b.AddAttribute(1, "Titulo", "Pedidos"); __b.AddAttribute(2, "Cor", "blue"); __b.AddAttribute(3, "Valor", Fmt(d.Periodos.Count));
        __b.AddAttribute(4, "Detalhe", $"{Ferias.Plural(_pessoas, "pessoa")}{(_times > 0 ? $" · {Ferias.Plural(_times, "time")}" : "")}"); __b.CloseComponent();
        __b.OpenComponent<Kpi>(10); __b.AddAttribute(11, "Titulo", "Choques de datas"); __b.AddAttribute(12, "Cor", "red"); __b.AddAttribute(13, "Valor", Fmt(ch));
        __b.AddAttribute(14, "Detalhe", ch == 0 ? "ninguém fora ao mesmo tempo" : "pessoas fora ao mesmo tempo"); __b.CloseComponent();
        __b.OpenComponent<Kpi>(20); __b.AddAttribute(21, "Titulo", "Muito próximas"); __b.AddAttribute(22, "Cor", "orange"); __b.AddAttribute(23, "Valor", Fmt(mp));
        __b.AddAttribute(24, "Detalhe", $"menos de {Ferias.Plural(d.MuitoProxima, "dia")} de intervalo"); __b.CloseComponent();
        __b.OpenComponent<Kpi>(30); __b.AddAttribute(31, "Titulo", "Próximas"); __b.AddAttribute(32, "Cor", "amber"); __b.AddAttribute(33, "Valor", Fmt(pr));
        __b.AddAttribute(34, "Detalhe", $"de {d.MuitoProxima} a {d.DistanciaMinima - 1} dias de intervalo"); __b.CloseComponent();
        __b.OpenComponent<Kpi>(40); __b.AddAttribute(41, "Titulo", "Querem vender"); __b.AddAttribute(42, "Cor", "green"); __b.AddAttribute(43, "Valor", Fmt(_vendedores));
        __b.AddAttribute(44, "Detalhe", _pessoas == 0 ? "" : $"{Texto.F(_vendedores * 100.0 / _pessoas, 0)}% das pessoas");
        __b.AddAttribute(45, "Proporcao", _pessoas == 0 ? (double?)null : _vendedores / (double)_pessoas); __b.CloseComponent();
        __b.OpenComponent<Kpi>(50); __b.AddAttribute(51, "Titulo", "Saem em breve"); __b.AddAttribute(52, "Cor", "purple"); __b.AddAttribute(53, "Valor", Fmt(_breve.Count));
        __b.AddAttribute(54, "Detalhe", _breve.Count == 0 ? $"ninguém nos próximos {d.EmBreve} dias" : $"próxima: {_breve[0].Colaborador} em {Texto.Dm(_breve[0].Inicio)}"); __b.CloseComponent();
    };

    IEnumerable<int> Anos()
    {
        var anos = E.Ferias.Periodos.SelectMany(p => new[] { p.Inicio.Year, p.Fim.Year }).Append(_ano);
        return anos.Distinct().OrderBy(a => a);
    }

    IEnumerable<string> Equipes() => E.Ferias.Periodos.Select(p => p.Equipe.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);

    bool Passa(PeriodoFerias p)
    {
        if (_equipe != EquipeTodas && Norm(p.Equipe) != Norm(_equipe)) return false;
        var b = Texto.NormalizarBusca(_busca);
        return b == "" || Texto.NormalizarBusca(p.Colaborador + " " + p.Equipe).Contains(b);
    }

    void Calcular()
    {
        var d = E.Ferias;
        _hojeD = DateOnly.FromDateTime(DateTime.Today);
        _alertas = Ferias.Alertas(d);
        _pessoas = d.Periodos.Select(p => Norm(p.Colaborador)).Distinct().Count();
        _times = d.Periodos.Select(p => Norm(p.Equipe)).Where(x => x != "").Distinct().Count();
        var vis = d.Periodos.Where(Passa).ToList();
        _agora = vis.Where(p => p.Inicio < _hojeD && p.Fim >= _hojeD).OrderBy(p => p.Fim).ToList();
        _breve = vis.Where(p => p.Inicio >= _hojeD && p.Inicio.DayNumber - _hojeD.DayNumber <= d.EmBreve).OrderBy(p => p.Inicio).ThenBy(p => p.Colaborador).ToList();
        _vender = vis.Where(p => p.Vender).OrderBy(p => p.Inicio).ToList();
        _vendedores = d.Periodos.Where(p => p.Vender).Select(p => Norm(p.Colaborador)).Distinct().Count();
        _tabela = vis.OrderBy(p => p.Inicio).ThenBy(p => p.Colaborador, StringComparer.Ordinal).ToList();
        _alertasVis = _alertas.Where(a => Passa(a.A) || Passa(a.B)).ToList();
        _alertasFilt = _filtroNivel < 0 ? _alertasVis : _alertasVis.Where(a => (int)a.Nivel == _filtroNivel).ToList();
        _clt = Ferias.AvisosClt(d.Periodos).Where(x => Passa(x.p)).Select(x => x.texto).ToList();
        _linhas = vis.Where(p => p.Inicio.Year <= _ano && p.Fim.Year >= _ano)
            .GroupBy(p => (Norm(p.Equipe), Norm(p.Colaborador)))
            .Select(g => (g.First().Colaborador, g.First().Equipe, g.OrderBy(p => p.Inicio).ToList()))
            .OrderBy(x => x.Item2 == "" ? 1 : 0).ThenBy(x => x.Item2, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.Item3[0].Inicio).ThenBy(x => x.Item1)
            .ToList();
    }

    async Task BaixarModelo() => await E.Salvar("Modelo_coleta_ferias.xlsx", Ferias.Modelo(), Navegador.MimeXlsx, "Modelo baixado");

    async Task Anexar(List<Arquivo> arqs)
    {
        var arq = arqs[0];
        (List<PeriodoFerias> periodos, List<string> problemas) r;
        try { r = await Ferias.LerPlanilha(arq.Dados); }
        catch (Exception ex) { await J.Erro("Planilha de férias", $"Não consegui ler “{arq.Nome}”.\n\n{ex.Message}"); return; }
        if (r.periodos.Count == 0)
        {
            await J.Erro("Planilha de férias", $"Nenhum pedido válido em “{arq.Nome}”.\n\n" + string.Join("\n", r.problemas.Take(12)));
            return;
        }
        var d = E.Ferias;
        d.Periodos = r.periodos;
        d.Problemas = r.problemas;
        d.Arquivo = arq.Nome;
        d.CarregadoEm = Texto.Agora();
        _filtroNivel = -1; _equipe = EquipeTodas; _busca = "";
        var anos = r.periodos.Select(p => p.Inicio.Year).ToList();
        _ano = anos.Contains(_hojeD.Year) ? _hojeD.Year : anos.GroupBy(a => a).OrderByDescending(g => g.Count()).First().Key;
        await E.SalvarFerias();
        if (r.problemas.Count > 0)
            await J.Aviso("Planilha de férias", $"{Ferias.Plural(r.periodos.Count, "pedido")} lido(s). {Ferias.Plural(r.problemas.Count, "linha")} com problema — veja em Pontos de atenção, no fim da página.");
    }

    async Task Limpar()
    {
        if (!await J.Pergunta("Limpar férias", "Apagar a análise da planilha anexada deste navegador? A planilha original no seu computador não é afetada.")) return;
        var d = E.Ferias;
        d.Periodos = new(); d.Problemas = new(); d.Arquivo = ""; d.CarregadoEm = "";
        await E.SalvarFerias();
    }

    async Task Mudar(ChangeEventArgs e, Action<int> aplicar)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n)) return;
        aplicar(Math.Clamp(n, 0, 365));
        await E.SalvarFerias();
    }

    async Task AlternarEquipe()
    {
        E.Ferias.PorEquipe = !E.Ferias.PorEquipe;
        await E.SalvarFerias();
    }

    async Task Exportar() => await E.Salvar($"Analise_ferias_{Estado.Agora("yyyy-MM-dd")}.xlsx", Ferias.Exportar(E.Ferias, _hojeD), Navegador.MimeXlsx);
}
