    async Task TamanhoOriginal(Elemento e)
    {
        var t = await E.Nav.TelaTamanhoImagem(e.Src);
        if (t.Length < 2 || t[0] == 0) return;
        Guardar();
        e.H = Math.Round(e.W * t[1] / t[0]);
