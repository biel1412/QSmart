    }

    void Tabela(Elemento e, string op)
    {
        Guardar();
        int cols = e.Celulas[0].Count;
        switch (op)
        {
            case "+l": e.Celulas.Add(Enumerable.Repeat("", cols).ToList()); e.H += e.H / Math.Max(1, e.Celulas.Count - 1); break;
            case "-l": if (e.Celulas.Count > 1) { e.H -= e.H / e.Celulas.Count; e.Celulas.RemoveAt(e.Celulas.Count - 1); } break;
            case "+c": foreach (var l in e.Celulas) l.Add(e.Celulas.IndexOf(l) == 0 && e.CabDestaque ? $"Coluna {cols + 1}" : ""); break;
            case "-c": if (cols > 1) foreach (var l in e.Celulas) l.RemoveAt(l.Count - 1); break;
            case "cab": e.CabDestaque = !e.CabDestaque; break;
        }
        Mudou();
    }

