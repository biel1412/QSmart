    void CorForma(Elemento e, string qual, string cor)
    {
        Guardar();
        if (qual == "pre") e.Preench = cor;
        else { e.Borda = cor; if (cor == "") e.BordaL = 0; else if (e.BordaL == 0) e.BordaL = 2; }
