    }

    void AlinharVarios(string como)
    {
        var els = SelEls().ToList();
        if (els.Count < 2) return;
        Guardar();
        double x1 = els.Min(e => e.X), x2 = els.Max(e => e.X + e.W), y1 = els.Min(e => e.Y), y2 = els.Max(e => e.Y + e.H);
        switch (como)
        {
            case "esq": els.ForEach(e => e.X = x1); break;
            case "dir": els.ForEach(e => e.X = x2 - e.W); break;
            case "centro": els.ForEach(e => e.X = (x1 + x2) / 2 - e.W / 2); break;
            case "topo": els.ForEach(e => e.Y = y1); break;
            case "base": els.ForEach(e => e.Y = y2 - e.H); break;
            case "meio": els.ForEach(e => e.Y = (y1 + y2) / 2 - e.H / 2); break;
            case "dist-h":
            {
                var ord = els.OrderBy(e => e.X).ToList(); var livre = (x2 - x1 - ord.Sum(e => e.W)) / (ord.Count - 1); double x = x1;
                foreach (var e in ord) { e.X = x; x += e.W + livre; }
                break;
            }
            case "dist-v":
            {
                var ord = els.OrderBy(e => e.Y).ToList(); var livre = (y2 - y1 - ord.Sum(e => e.H)) / (ord.Count - 1); double y = y1;
                foreach (var e in ord) { e.Y = y; y += e.H + livre; }
                break;
            }
        }
        Mudou();
    }

    // ====================================================== painel de formatação
    void Geo(Elemento e, string campo, ChangeEventArgs v)
    {
        if (!double.TryParse(v.Value?.ToString(), NumberStyles.Float, Inv, out var d)) return;
        Guardar();
        switch (campo) { case "x": e.X = d; break; case "y": e.Y = d; break; case "w": e.W = Math.Max(1, d); break; case "h": e.H = Math.Max(0, d); break; case "r": e.Rot = ((d % 360) + 360) % 360; break; }
        Mudou();
    }

