        var novos = sel.Select(e => { var c = e.Clonar(); c.X += 18; c.Y += 18; return c; }).ToList();
        S.Elementos.AddRange(novos);
        _sel = novos.Select(e => e.Id).ToHashSet();
        S.Renumerar();
