        await Task.CompletedTask;
    }

    async Task<bool> PodeTrocar() => !_sujo || await J.Pergunta("Smart Screen", "A apresentação atual tem alterações que não foram salvas em .pptx. Continuar mesmo assim?");

    void Carregar(Apresentacao a, string nome, string status)
    {
        _ap = a; _si = 0; _sel.Clear(); _editando = null; _congelado = null;
        _nome = nome; _status = status; _sujo = false;
        _desfazer.Clear(); _refazer.Clear();
    }

    async Task Nova()
    {
        if (!await PodeTrocar()) return;
        Carregar(Apresentacao.Nova(), "Apresentação sem título", "apresentação nova");
        await E.Nav.LsDel(Rascunho);
    }

    async Task Abrir(InputFileChangeEventArgs e)
    {
        var f = e.File;
        using var ms = new MemoryStream();
        try { await f.OpenReadStream(150_000_000).CopyToAsync(ms); }
        catch (Exception ex) { _chaveArq++; await J.Erro("Abrir", "Não consegui ler esse arquivo: " + ex.Message); return; }
        _chaveArq++;   // só depois de ler: trocar o InputFile antes apaga o arquivo escolhido no navegador
        if (!await PodeTrocar()) return;
        try
        {
            var a = PptxPasta.Ler(ms.ToArray());
            Carregar(a, Path.GetFileNameWithoutExtension(f.Name), $"aberto de {f.Name}");
            _recuperar = null;
            _ = E.Conta.Registrar("screen.abrir", true);
        }
        catch (Exception ex) { await J.Erro("Abrir apresentação", "Não consegui abrir esse arquivo: " + ex.Message); }
    }

    async Task Salvar()
    {
        if (_salvando) return;
        if (_editando != null) { await E.Nav.TelaFimEdicao(); await Task.Delay(50); }
        _salvando = true; StateHasChanged();
        try
        {
            var bytes = PptxPasta.Gravar(_ap, _nome);
            var nome = string.Concat(_nome.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c)).Trim();
            await E.Nav.Baixar((nome == "" ? "Apresentação" : nome) + ".pptx", bytes, Navegador.MimePptx);
            _sujo = false; _status = $"salvo em Downloads às {DateTime.Now:HH:mm}";
            await E.Nav.LsDel(Rascunho);
            _ = E.Conta.Registrar("screen.salvar", true);
        }
        catch (Exception ex) { await J.Erro("Salvar .pptx", "Não consegui gerar o arquivo: " + ex.Message); }
        finally { _salvando = false; }
    }

    async Task Imprimir()
    {
        if (_editando != null) await E.Nav.TelaFimEdicao();
        _imprimindo = true; StateHasChanged();
        await Task.Delay(150);
        await E.Nav.TelaImprimir();
        await Task.Delay(1500);
        _imprimindo = false; StateHasChanged();
    }

    async Task Recuperar()
    {
        if (_recuperar is not { } r) return;
        try { Carregar(Apresentacao.DeJson(r.json), r.nome, ""); _sujo = true; }
        catch { await J.Aviso("Smart Screen", "Não consegui recuperar a apresentação."); }
        _recuperar = null;
    }

    async Task Descartar() { _recuperar = null; await E.Nav.LsDel(Rascunho); }

    public override void Dispose()
    {
        base.Dispose();
        _relogio?.Dispose();
        if (_montado) { try { _ = E.Nav.TelaDesmontar(_palco); } catch { } }
        _ = Task.Delay(3000).ContinueWith(_ => _ref?.Dispose());
    }
