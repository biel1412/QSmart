    // ====================================================== apresentação
    List<Slide> Visiveis() { var v = _ap.Slides.Where(s => !s.Oculto).ToList(); return v.Count > 0 ? v : _ap.Slides.ToList(); }

    async Task Apresentar(int deSlide)
    {
        if (_editando != null) await E.Nav.TelaFimEdicao();
        var vis = Visiveis();
        var alvo = _ap.Slides[Math.Clamp(deSlide, 0, _ap.Slides.Count - 1)];
        _sh = Math.Max(0, vis.IndexOf(alvo)); if (alvo.Oculto) _sh = 0;
        _passo = 0; _animar = false; _fimShow = false; _trans = ""; _telaShow = ""; _entradas++;
        _mostrando = true; _showMontar = true; _apresentador = false; _escalarShow = true;
        _inicioShow = DateTime.Now; _versaoShow = DateTime.UtcNow.Ticks;
        _relogio?.Dispose();
        _relogio = new System.Threading.Timer(_ => { if (_apresentador) InvokeAsync(StateHasChanged); }, null, 1000, 1000);
        _ = E.Conta.Registrar("screen.apresentar", true);
        StateHasChanged();
        await Task.CompletedTask;
    }

    string Decorrido() { var t = DateTime.Now - _inicioShow; return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"mm\:ss"); }

    [JSInvokable]
    public async Task ShowTecla(string acao)
    {
        if (!_mostrando) return;
        var vis = Visiveis();
        var atual = _sh < vis.Count ? vis[_sh] : null;
        switch (acao)
        {
            case "avancar":
                if (_telaShow != "") { _telaShow = ""; break; }
                if (_fimShow) { await Sair(); return; }
                if (atual != null && _passo < atual.Animados.Count) { _passo++; _animar = true; }
                else if (_sh + 1 < vis.Count) { _sh++; _passo = 0; _animar = false; _trans = vis[_sh].Transicao == "" ? "" : "ss-tr-" + vis[_sh].Transicao; _entradas++; }
                else { _fimShow = true; }
                break;
            case "voltar":
                if (_telaShow != "") { _telaShow = ""; break; }
                if (_fimShow) { _fimShow = false; break; }
                if (_passo > 0) { _passo--; _animar = false; }
                else if (_sh > 0) { _sh--; _passo = vis[_sh].Animados.Count; _animar = false; _trans = ""; _entradas++; }
                break;
            case "inicio": _sh = 0; _passo = 0; _fimShow = false; _trans = ""; _entradas++; break;
            case "fim": _sh = vis.Count - 1; _passo = vis[_sh].Animados.Count; _fimShow = false; _trans = ""; _entradas++; break;
            case "preto": _telaShow = _telaShow == "preto" ? "" : "preto"; break;
            case "branco": _telaShow = _telaShow == "branco" ? "" : "branco"; break;
            case "apresentador": _apresentador = !_apresentador; _escalarShow = true; break;
            case "sair": await Sair(); return;
            case "saiu-tela-cheia": if (!_apresentador) { await Sair(); return; } break;
        }
        await E.Nav.PlateiaEnviar(_sh, _fimShow ? -2 : _passo, _telaShow, _versaoShow);
        StateHasChanged();
    }

    async Task AlternarTelaCheia() => await E.Nav.TelaCheia(_showEl, true);

    async Task Sair()
    {
        _relogio?.Dispose(); _relogio = null;
        await E.Nav.TelaFimShow(_showEl);
        await E.Nav.PlateiaFim();
        var vis = Visiveis();
        if (_sh < vis.Count) _si = _ap.Slides.IndexOf(vis[_sh]);
        _mostrando = false; _sel.Clear();
        StateHasChanged();
        await E.Nav.TelaFocar();
    }

