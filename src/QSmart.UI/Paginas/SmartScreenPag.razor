    async Task VerTransicao()
    {
        if (S.Transicao == "") return;
        _previaTrans = "ss-tr-" + S.Transicao; _previaChave = Guid.NewGuid().ToString("N")[..6];
        StateHasChanged();
        await Task.Delay(900);
        _previaTrans = ""; StateHasChanged();
    }

    void MudarAnim(string a)
    {
        var els = SelEls().ToList();
        if (els.Count == 0) return;
        Guardar();
        int prox = S.Elementos.Where(e => e.Anim != "").Select(e => e.Ordem).DefaultIfEmpty(0).Max();
        foreach (var e in els)
        {
            if (a == "") { e.Anim = ""; e.Ordem = 0; continue; }
            if (e.Anim == "") e.Ordem = ++prox;
            e.Anim = a;
        }
        S.Renumerar();
        Mudou();
        if (a != "") _ = VerUma(els);
    }

    async Task VerUma(List<Elemento> els)
    {
        var o = els.Min(e => e.Ordem);
        _previaPasso = o; _previaChave = Guid.NewGuid().ToString("N")[..6];
        StateHasChanged();
        await Task.Delay(800);
        _previaPasso = -1; StateHasChanged();
    }

    async Task VerAnimacoes()
    {
        var n = S.Animados.Count;
        for (int p = 0; p <= n; p++)
        {
            _previaPasso = p; _previaChave = "a" + p;
            StateHasChanged();
            await Task.Delay(p == 0 ? 400 : 750);
        }
        _previaPasso = -1; _previaChave = ""; StateHasChanged();
    }

    void OrdemAnim(Elemento e, int d)
    {
        var lista = S.Animados;
        int i = lista.IndexOf(e), j = i + d;
        if (j < 0 || j >= lista.Count) return;
        Guardar();
        (lista[i].Ordem, lista[j].Ordem) = (lista[j].Ordem, lista[i].Ordem);
        S.Renumerar();
        Mudou();
    }

