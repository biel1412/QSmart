@page "/"
@inherits PaginaBase

<div class="inicio">
    <section class="boas-vindas">
        <div class="bv-texto" @onmouseenter="() => _pausa = true" @onmouseleave="() => _pausa = false">
            <div class="bv-linha">
                @{ var (icC, txC) = Chip(); }
                <div class="bv-saudacao"><Icone Nome="@icC" Tamanho="16" /> @txC</div>@Relogio
            </div>
            <div class="bv-slides" aria-live="polite">
                <div class="bv-slide @(_slide == 0 ? "on" : "")">
                    <h1>Bem-vindo ao <span class="grad">QSmart</span></h1>
                    <p>A plataforma de qualidade da <b>Insi</b>: decisões, inspeções, pareceres, operação, coordenação e relacionamento com as cooperativas em um só lugar, com Feed, chat e downloads para a equipe. As planilhas são lidas aqui mesmo, no seu computador.</p>
                </div>
                <div class="bv-slide @(_slide == 1 ? "on" : "")">
                    <h1>@Ferramentas() ferramentas, <span class="grad">@Areas() áreas</span></h1>
                    <div class="bv-fatos">
                        <span><Icone Nome="escudo" Tamanho="15" /> Suas planilhas são lidas no seu computador</span>
                        <span><Icone Nome="faisca" Tamanho="15" /> Funciona direto no navegador, sem instalar</span>
                        <span><Icone Nome="download" Tamanho="15" /> Relatórios em Excel e PDF</span>
                        <span><Icone Nome="faisca" Tamanho="15" /> Mr. Smart com IA para analisar e escrever</span>
                        <span><Icone Nome="conversa" Tamanho="15" /> Feed e chat para falar com a equipe</span>
                        <span><Icone Nome="cadeado" Tamanho="15" /> Dados da equipe criptografados no banco</span>
                    </div>
                </div>
                <div class="bv-slide @(_slide == 2 ? "on" : "")">
                    @{ var lc = Curiosidades.Where(x => Abas.Por(x.chave) is { } a0 && E.Permitida(a0.Chave)).ToArray(); if (lc.Length == 0) lc = Curiosidades;
                       var c = lc[_cur % lc.Length]; var ab = Abas.Por(c.chave); }
                    <h1 class="bv-curio"><span class="bv-curio-ic"><Icone Nome="@(ab?.Icone ?? "faisca")" Tamanho="22" /></span> <span class="grad">@(ab?.Nome ?? c.chave)</span></h1>
                    <p>@c.texto @if (ab != null && E.AbaAtiva(ab.Chave)) { <a class="bv-link" href="@ab.Rota">Abrir <Icone Nome="seta" Tamanho="14" /></a> }</p>
                </div>
                <div class="bv-slide @(_slide == 3 ? "on" : "")">
                    @{ var d = Dicas[_dica % Dicas.Length]; }
                    <h1>@d.titulo</h1>
                    <p>@d.texto</p>
                </div>
                <div class="bv-slide @(_slide == 4 ? "on" : "")">
                    <h1>@(Carregadas() == 0 ? "Pronto para começar" : $"{Carregadas()} de 4 bases abertas")</h1>
                    <div class="bv-fatos">
                        <span class="@(E.Resultado != null ? "ok" : "")"><Icone Nome="@(E.Resultado != null ? "check" : "resumo")" Tamanho="15" /> Aprovações @(E.Resultado != null ? "· carregada" : "· não aberta")</span>
                        <span class="@(E.Evolucao != null ? "ok" : "")"><Icone Nome="@(E.Evolucao != null ? "check" : "inspecao")" Tamanho="15" /> Inspeção @(E.Evolucao != null ? "· carregada" : "· não aberta")</span>
                        <span class="@(E.Historico.Count > 0 ? "ok" : "")"><Icone Nome="@(E.Historico.Count > 0 ? "check" : "historico")" Tamanho="15" /> Histórico · @(E.Historico.Count) mês(es)</span>
                        <span class="@(E.ParPadroes.Count > 0 ? "ok" : "")"><Icone Nome="@(E.ParPadroes.Count > 0 ? "check" : "pareceres")" Tamanho="15" /> Pareceres padrão · @(E.ParPadroes.Count)</span>
                    </div>
                </div>
                <div class="bv-slide @(_slide == 5 ? "on" : "")">
                    <h1>O que há de <span class="grad">novo</span></h1>
                    <div class="bv-fatos">
                        <span><Icone Nome="estrela" Tamanho="15" /> Day off: pedido da liderança e calendário geral</span>
                        <span><Icone Nome="conversa" Tamanho="15" /> Chat com todos do QSmart</span>
                        <span><Icone Nome="download" Tamanho="15" /> Downloads: automações e materiais</span>
                        <span><Icone Nome="ferias" Tamanho="15" /> Férias com prazo da CLT e datas sugeridas</span>
                        <span><Icone Nome="calendario" Tamanho="15" /> One a One por coordenação, com histórico</span>
                        <span><Icone Nome="apresentacao" Tamanho="15" /> Smart Screen: apresentações no Pacote Smart</span>
                    </div>
                </div>
                <div class="bv-slide bv-frase @(_slide == 6 ? "on" : "")">
                    <h1><span class="grad">Grandes conquistas</span> começam com <span class="grad">pequenas atitudes diárias</span></h1>
                    <p>QSmart · Insi</p>
                </div>
                <div class="bv-slide bv-frase @(_slide == 7 ? "on" : "")">
                    <h1><span class="grad">Digital.</span> Simple. <span class="grad">Human.</span></h1>
                    <p>QSmart · Insi</p>
                </div>
            </div>
            <div class="bv-busca">
                <Icone Nome="busca" Tamanho="18" />
                <input class="campo" placeholder="O que você quer fazer? Ex.: pareceres, ociosidade, unir compilados…" @bind="_busca" @bind:event="oninput" @onkeydown="Tecla" id="busca-inicio"
                       @onfocus="() => _foco = true" @onblur="() => _foco = false" />
                @if (_busca != "") { <button class="btn-icone" @onclick="@(() => _busca = "")" title="Limpar"><Icone Nome="x" Tamanho="16" /></button> }
            </div>
            <div class="bv-pontos">
                @for (int i = 0; i < Slides; i++)
                {
                    var k = i;
                    <button class="@(_slide == k ? "on" : "")" @onclick="() => IrPara(k)" title="@($"Tela {k + 1}")" aria-label="@($"Tela {k + 1}")"><i style="@(_slide == k && !Parado ? $"animation-duration:{Intervalo}ms" : "")"></i></button>
                }
            </div>
        </div>
        <div class="bv-arte" aria-hidden="true">
            <Logo Tamanho="132" />
            <div class="bv-orbita o1"></div><div class="bv-orbita o2"></div>
        </div>
    </section>


    @{ var visiveis = Abas.Todas.Where(a => E.AbaAtiva(a.Chave) && Combina(a)).ToList(); }
    @if (_busca.Trim() == "")
    {
        <section class="dk" aria-label="Ferramentas do QSmart">
            <h2 class="dk-tit">O que vamos <span>resolver hoje?</span></h2>
            <p class="dk-sub">Em destaque, as ferramentas novas e as que você mais usa. Embaixo, todas as outras.</p>
            <div class="dk-areas">
                <button class="@(_area == null ? "on" : "")" @onclick="() => EscolherArea(null)">Destaques</button>
                @foreach (var g in Abas.Grupos.Where(g => visiveis.Any(a => a.Grupo == g)))
                {
                    <button class="@(_area == g ? "on" : "")" @onclick="() => EscolherArea(g)">@NomeArea(g)</button>
                }
            </div>
            @{ var cartas = Cartas(visiveis); var resto = visiveis.Where(a => !cartas.Contains(a)).ToList(); }
            <div class="dk-leque n@(cartas.Count)">
                @for (int k = 0; k < cartas.Count; k++)
                {
                    var a = cartas[k];
                    var pos = k * 2 - (cartas.Count - 1);
                    <a class="dk-carta @(pos == 0 ? "meio" : "")" style="--c:@CorCarta(a);--p:@pos;--a:@Math.Abs(pos)" href="@a.Rota" target="@(a.Externo ? "_blank" : null)" rel="@(a.Externo ? "noopener" : null)">
                        @if (Novos.Contains(a.Chave)) { <span class="dk-novo">NOVO</span> }
                        <span class="dk-fundo"><Icone Nome="@a.Icone" Tamanho="170" /></span>
                        <span class="dk-ic"><Icone Nome="@a.Icone" Tamanho="24" /></span>
                        <span class="dk-area">@NomeArea(a.Grupo).ToUpperInvariant()</span>
                        <b>@a.Menu</b>
                        <span class="dk-frase">@Frase(a)</span>
                        <span class="dk-abrir">Abrir <Icone Nome="@(a.Externo ? "externo" : "seta")" Tamanho="14" /></span>
                    </a>
                }
            </div>
            <div class="dk-fichas">
                @foreach (var a in resto)
                {
                    <a class="dk-ficha" style="--c:@CorCarta(a)" href="@a.Rota" target="@(a.Externo ? "_blank" : null)" rel="@(a.Externo ? "noopener" : null)" title="@a.Descricao">
                        <i><Icone Nome="@a.Icone" Tamanho="16" /></i>@a.Menu
                        @if (Novos.Contains(a.Chave)) { <span class="dk-novo mini">NOVO</span> }
                    </a>
                }
            </div>
        </section>
    }
    <section class="vitrine @(_busca.Trim() == "" ? "dk-alt" : "")">
        <span class="vt-luz l1"></span><span class="vt-luz l2"></span><span class="vt-luz l3"></span>
        <div class="vt-conteudo">
    @if (visiveis.Count == 0)
    {
        <div class="g-vazio grande">Nenhum módulo corresponde a “@_busca”.</div>
    }
    @foreach (var g in Abas.Grupos)
    {
        var itens = visiveis.Where(a => a.Grupo == g).ToList();
        if (itens.Count == 0) continue;
        <section class="grupo-mod">
            <h2 class="grupo-titulo"><span class="gt-ponto g-@Indice(g)"></span>@g @if (DescGrupo(g) != "") { <span class="gt-desc">@DescGrupo(g)</span> }</h2>
            <div class="cartoes">
                @foreach (var a in itens)
                {
                    <a class="cartao g-@Indice(g)" href="@a.Rota" target="@(a.Externo ? "_blank" : null)" rel="@(a.Externo ? "noopener" : null)">
                        <span class="cartao-ic"><Icone Nome="@a.Icone" Tamanho="22" /></span>
                        <span class="cartao-txt">
                            <span class="cartao-nome">@a.Nome</span>
                            <span class="cartao-desc">@a.Descricao</span>
                            @if (Status(a.Chave) is string st) { <span class="cartao-status"><i></i>@st</span> }
                        </span>
                        <span class="cartao-seta"><Icone Nome="@(a.Externo ? "externo" : "seta")" Tamanho="18" /></span>
                    </a>
                }
            </div>
        </section>
    }
        </div>
    </section>
</div>

@code {
    protected override string Chave => "resumo";
    string _busca = "";

    // ---- outdoor da faixa de boas-vindas ----
    const int Slides = 8, Intervalo = 5000;
    int _slide, _cur = Random.Shared.Next(100), _dica = Random.Shared.Next(100);
    bool _pausa, _foco;
    bool Parado => _pausa || _foco || _busca != "";
    System.Threading.Timer? _timer;

    static readonly (string chave, string texto)[] Curiosidades =
    {
        ("estrategia", "Calcula o SLA do dia, resume os serviços e monta a mensagem para o Teams; o Mr. Smart ainda escreve a estratégia para você."),
        ("radar360", "Monta a ficha 360 de um CNPJ em segundos: Receita, sócios, linha do tempo, Junta Comercial, sanções e contratos públicos, com placar e parecer do Mr. Smart."),
        ("corredor", "Une vários compilados num só, tira as linhas repetidas e ainda junta PDFs na ordem que você escolher."),
        ("pareceres", "Confere as justificativas com os pareceres padrão e aponta o que está diferente."),
        ("ferias", "Mostra o prazo de cada pessoa pela CLT, avisa os meses acima do limite e sugere datas melhores, com quanto o impacto diminui."),
        ("dayoff", "A liderança pede o day off, a coordenação aprova ou reprova e o calendário geral mostra quem está de folga, até 5 pessoas por dia."),
        ("dayoffpedir", "Peça o day off de alguém da sua equipe vendo na hora quantas vagas o dia ainda tem; se for reprovado, é só remarcar."),
        ("downloads", "Automações, modelos e materiais prontos para baixar com um clique, publicados pelo administrador."),
        ("smartscreen", "Monte apresentações como no PowerPoint: temas, gráficos, tabelas, transições e modo apresentação; abre e salva .pptx."),
        ("pacote", "Smart Write para textos (.docx), Smart Math para planilhas com fórmulas e gráficos (.xlsx) e Smart Note para os cadernos."),
        ("pontos", "Calcula a média diária de ações por usuário e permite justificar quem ficou abaixo da meta."),
        ("servicos3069", "O Mr. Smart confere a nossa resposta para a 3069 antes de ir pelo Teams: se responde, se é objetiva e o que pode ser contestado, com nota e sugestões."),
        ("oneaone", "Mostra numa esteira quem está em dia, chegando ou atrasado no 1:1, por coordenação e liderança, com o histórico de cada conversa."),
        ("monitor", "Mostra o tempo ocioso de cada colaborador, dia a dia, a partir das finalizações."),
        ("historico", "Guarda os meses gravados e mostra a evolução mês a mês, com mensagem pronta para o Teams."),
        ("resumo", "Mostra aprovações, reprovações e os motivos mais frequentes, com relatório em PDF."),
    };

    static readonly (string titulo, string texto)[] Dicas =
    {
        ("Busque e aperte Enter", "Digite o que quer fazer na busca abaixo (ex.: ociosidade) e aperte Enter para abrir a ferramenta direto."),
        ("Recolha o menu", "Clique em “Recolher menu” para ganhar espaço na tela; os ícones continuam lá com as cores de cada área."),
        ("Modo escuro", "No rodapé do menu você troca entre modo claro e escuro. A preferência fica salva neste navegador."),
        ("Esconda o que não usa", "Em Configurações dá para desligar as abas que você não usa, deixando o menu mais limpo."),
        ("Faça backup", "Em Configurações você salva um backup dos seus dados para não perder nada ao trocar de computador."),
        ("Relatórios prontos", "Resumo e Evolução geram PDF com um clique; várias abas também exportam para Excel."),
        ("Passe o mouse", "Nos gráficos e mapas, passe o mouse sobre um item para ver o nome completo, a quantidade e o percentual."),
        ("Próximos feriados", "Passe o mouse na data, ao lado da saudação, para ver os próximos feriados nacionais."),
        ("Monitore um CNPJ", "No Radar Smart360, clique na estrela de um CNPJ e use “Verificar monitorados” para ver o que mudou desde a última consulta."),
        ("Pergunte ao Mr. Smart", "O botão da coruja, no canto da tela, responde dúvidas sobre qualquer ferramenta do QSmart."),
        ("Chame alguém no chat", "O ícone de balões no topo mostra todo mundo do QSmart; quem está online tem a bolinha verde. As mensagens somem depois de 10 dias."),
        ("Fique de olho no sininho", "Pedidos de day off, alertas de férias e novidades do Feed chegam no sininho, no canto superior direito."),
        ("Cadastre sua equipe", "Lideranças podem cadastrar a própria equipe em Perfil › Minha equipe: a coordenação recebe tudo no One a One e nas Férias."),
    };

    int Carregadas() => (E.Resultado != null ? 1 : 0) + (E.Evolucao != null ? 1 : 0) + (E.Historico.Count > 0 ? 1 : 0) + (E.ParPadroes.Count > 0 ? 1 : 0);

    int Ferramentas() => Abas.Todas.Count(a => !a.Externo && a.Grupo != "Ferramentas");
    int Areas() => Abas.Todas.Where(a => !a.Externo && a.Grupo != "Ferramentas").Select(a => a.Grupo).Distinct().Count();

    protected override void Entrar()
    {
        _timer = new System.Threading.Timer(_ => Avancar(), null, Intervalo, Intervalo);
        // relógio: atualiza no começo de cada minuto
        var ate = 60_000 - (int)(DateTime.Now.Second * 1000 + DateTime.Now.Millisecond) + 200;
        _relogio = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, ate, 60_000);
        _ = E.CarregarFeriados();
    }

    System.Threading.Timer? _relogio;

    (string, string) Chip() => _slide switch
    {
        1 => ("escudo", "Sobre a plataforma"),
        2 => ("faisca", "Você sabia?"),
        3 => ("busca", "Dica rápida"),
        4 => ("resumo", "Seu painel agora"),
        5 => ("faisca", "Novidades"),
        _ => ("faisca", Saudacao()),
    };

    /// <summary>Data, hora e o aviso de feriado próximo, ao lado da saudação.</summary>
    RenderFragment Relogio => @<text>
        @{ var agora = DateTime.Now; var hoje = DateOnly.FromDateTime(agora); var aviso = QSmart.Core.Feriados.Aviso(E.FeriadosLista, hoje);
           var prox = E.FeriadosLista.Where(f => f.Data >= hoje).OrderBy(f => f.Data).Take(3).ToList(); }
        <span class="bv-pilula" title="@(prox.Count > 0 ? "Próximos feriados: " + string.Join(" · ", prox.Select(f => $"{f.Data:dd/MM} {f.Nome}")) : "")"><i></i>@QSmart.Core.Feriados.DiaCurto(hoje), @agora.ToString("dd/MM") · @agora.ToString("HH:mm")</span>
        @if (aviso != null) { <span class="bv-pilula feriado">🎉 @aviso</span> }
    </text>;

    void Avancar()
    {
        if (Parado) return;
        _slide = (_slide + 1) % Slides;
        if (_slide == 2) _cur++;
        if (_slide == 3) _dica++;
        InvokeAsync(StateHasChanged);
    }

    void IrPara(int k)
    {
        _slide = k;
        if (k == 2) _cur++;
        if (k == 3) _dica++;
        _timer?.Change(Intervalo, Intervalo);
    }

    public override void Dispose()
    {
        _timer?.Dispose();
        _relogio?.Dispose();
        base.Dispose();
    }

    static string Saudacao()
    {
        var h = DateTime.Now.Hour;
        return h < 12 ? "Bom dia" : h < 18 ? "Boa tarde" : "Boa noite";
    }

    bool Combina(Aba a)
    {
        var t = Texto.NormalizarBusca(_busca);
        if (t == "") return true;
        var alvo = Texto.NormalizarBusca($"{a.Nome} {a.Menu} {a.Grupo} {a.Descricao}");
        return t.Split(' ').All(alvo.Contains);
    }

    void Tecla(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var a = Abas.Todas.FirstOrDefault(x => E.AbaAtiva(x.Chave) && Combina(x));
        if (a == null) return;
        if (a.Externo) _ = E.Nav.AbrirUrl(a.Rota); else Rotas.NavigateTo(a.Rota);
    }

    static int Indice(string g) => Abas.Cor(g);

    // ---- Cartas em destaque ----
    static readonly HashSet<string> Novos = new() { "pacote", "radar360", "servicos3069", "oneaone" };
    static readonly string[] Destaques = { "oneaone", "pacote", "radar360", "servicos3069", "ferias" };
    string? _area;
    void EscolherArea(string? g) => _area = g;
    static string NomeArea(string g) => g == "Relacionamento e cooperativas" ? "Relacionamento" : g;

    List<Aba> Cartas(List<Aba> visiveis)
    {
        if (_area != null) return visiveis.Where(a => a.Grupo == _area).Take(5).ToList();
        var l = Destaques.Select(c => visiveis.FirstOrDefault(a => a.Chave == c)).Where(a => a != null).Select(a => a!).ToList();
        foreach (var a in visiveis) { if (l.Count >= 5) break; if (!l.Contains(a)) l.Add(a); }
        return l;
    }


    static string CorCarta(Aba a) => a.Chave switch
    {
        "radar360" => "#EC4899", "servicos3069" => "#C026D3", "oneaone" => "#14B8A6", "ferias" => "#0EA5E9", "pontos" => "#0D9488",
        "estrategia" => "#F59E0B", "volume" => "#F97316", "monitor" => "#EAB308", "corredor" => "#D97706",
        "resumo" => "#10B981", "usuarios" => "#059669", "evolucao" => "#0EA5E9", "inspecao" => "#3B82F6", "historico" => "#6366F1",
        "pareceres" => "#8B5CF6", "pacote" => "#2563EB", _ => "#64748B",
    };

    static string Frase(Aba a) => a.Chave switch
    {
        "radar360" => "Ficha 360 de CNPJ e CPF em segundos.",
        "servicos3069" => "Resposta revisada pelo Mr. Smart antes do Teams.",
        "oneaone" => "Ninguém fica sem 1:1.",
        "estrategia" => "O Mr. Smart escreve a estratégia do dia.",
        "ferias" => "Choques de datas resolvidos sozinhos.",
        "pontos" => "Meta diária e justificativas do mês.",
        "resumo" => "Aprovações, reprovações e motivos.",
        "usuarios" => "Quem mais devolve, num ranking.",
        "evolucao" => "Desvios por autorização e inspetor.",
        "inspecao" => "Internas por inspetor e por dia.",
        "historico" => "A evolução mês a mês.",
        "pareceres" => "Justificativas conferidas com o padrão.",
        "volume" => "Quanto cada pessoa executou.",
        "monitor" => "O tempo ocioso, dia a dia.",
        "corredor" => "Compilados e PDFs num arquivo só.",
        "depurador" => "O que foi lido da planilha.",
        "pacote" => "Textos, planilhas e cadernos num lugar só.",
        _ => "Abre em uma nova aba.",
    };

    static string DescGrupo(string g) => g switch
    {
        "Decisões" => "aprovações, reprovações e quem decide",
        "Inspeção" => "desvios, inspeções internas e histórico mensal",
        "Conformidade" => "pareceres conferidos com o padrão",
        "Operação" => "volume, ociosidade, consolidação de arquivos e estratégia do dia",
        "Coordenação" => "férias, 1:1 e produtividade do mês",
        "Relacionamento e cooperativas" => "",
        "Extensão" => "utilidades do QSmart: o Pacote Smart com textos, planilhas e cadernos",
        _ => "diagnóstico das planilhas e outros sistemas da Insi",
    };

    string? Status(string chave) => chave switch
    {
        "resumo" or "usuarios" when E.Resultado != null => $"{E.Resultado.Arquivo} carregado",
        "evolucao" when E.Evolucao != null => $"{E.Evolucao.Arquivo} carregado",
        "historico" when E.Historico.Count > 0 => $"{E.Historico.Count} mês(es) no histórico",
        "pareceres" when E.ParDf != null => $"{E.ParArquivo?.Nome} carregado",
        "inspecao" when E.IntRes != null => $"{E.IntRes.Arquivo} carregado",
        "estrategia" when E.EstBase != null => $"{E.EstBase.Arquivos.Count} compilado(s) anexado(s)",
        "volume" when E.VolComp != null => $"{E.VolComp.Arquivos.Count} compilado(s) anexado(s)",
        "monitor" when E.MonBase != null => $"{E.MonBase.Arquivos.Count} planilha(s) anexada(s)",
        "corredor" when E.CorItens.Count > 0 => $"{E.CorItens.Count} compilado(s) na fila",
        "depurador" when E.DepRes != null => $"{E.DepRes.Arquivo} em análise",
        "pontos" when E.PtsRes != null => $"{E.PtsArquivos} carregado",
        "ferias" when E.FeriasResumo != null => E.FeriasResumo,
        "oneaone" when E.OneBase != null => $"{E.OneBase.Ativos.Count()} colaboradores na carteira",
        _ => null,
    };
}
