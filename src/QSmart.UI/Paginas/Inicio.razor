@page "/"
@inherits PaginaBase

<div class="inicio">
    <section class="boas-vindas">
        <div class="bv-texto" @onmouseenter="() => _pausa = true" @onmouseleave="() => _pausa = false">
            <div class="bv-slides" aria-live="polite">
                <div class="bv-slide @(_slide == 0 ? "on" : "")">
                    <div class="bv-saudacao"><Icone Nome="faisca" Tamanho="16" /> @Saudacao()</div>
                    <h1>Bem-vindo ao <span class="grad">QSmart</span></h1>
                    <p>A plataforma de qualidade da <b>Insi</b>: decisões, inspeções, pareceres e operação em um só lugar. As planilhas são lidas aqui mesmo, no seu computador.</p>
                </div>
                <div class="bv-slide @(_slide == 1 ? "on" : "")">
                    <div class="bv-saudacao"><Icone Nome="escudo" Tamanho="16" /> Sobre a plataforma</div>
                    <h1>@Ferramentas() ferramentas, <span class="grad">@Areas() áreas</span></h1>
                    <div class="bv-fatos">
                        <span><Icone Nome="escudo" Tamanho="15" /> Nenhum arquivo sai do seu computador</span>
                        <span><Icone Nome="faisca" Tamanho="15" /> Funciona direto no navegador, sem instalar</span>
                        <span><Icone Nome="download" Tamanho="15" /> Relatórios em Excel e PDF</span>
                    </div>
                </div>
                <div class="bv-slide @(_slide == 2 ? "on" : "")">
                    @{ var c = Curiosidades[_cur % Curiosidades.Length]; var ab = Abas.Por(c.chave); }
                    <div class="bv-saudacao"><Icone Nome="faisca" Tamanho="16" /> Você sabia?</div>
                    <h1 class="bv-curio"><span class="bv-curio-ic"><Icone Nome="@(ab?.Icone ?? "faisca")" Tamanho="22" /></span> <span class="grad">@(ab?.Nome ?? c.chave)</span></h1>
                    <p>@c.texto @if (ab != null && E.AbaAtiva(ab.Chave)) { <a class="bv-link" href="@ab.Rota">Abrir <Icone Nome="seta" Tamanho="14" /></a> }</p>
                </div>
                <div class="bv-slide bv-frase @(_slide == 3 ? "on" : "")">
                    <h1><span class="grad">Digital.</span> Simple. <span class="grad">Human.</span></h1>
                    <p>QSmart · Insi</p>
                </div>
            </div>
            <div class="bv-busca">
                <Icone Nome="busca" Tamanho="18" />
                <input class="campo" placeholder="O que você quer fazer? Ex.: pareceres, ociosidade, unir compilados…" @bind="_busca" @bind:event="oninput" @onkeydown="Tecla" id="busca-inicio"
                       @onfocus="() => _foco = true" @onblur="() => _foco = false" />
                @if (_busca != "") { <button class="btn-icone" @onclick="@(() => _busca = "")" title="Limpar"><Icone Nome="x" Tamanho="16" /></button> }
            </div>
            <div class="bv-pontos">
                @for (int i = 0; i < Slides; i++)
                {
                    var k = i;
                    <button class="@(_slide == k ? "on" : "")" @onclick="() => IrPara(k)" title="@($"Tela {k + 1}")" aria-label="@($"Tela {k + 1}")"><i style="@(_slide == k && !Parado ? $"animation-duration:{Intervalo}ms" : "")"></i></button>
                }
            </div>
        </div>
        <div class="bv-arte" aria-hidden="true">
            <Logo Tamanho="132" />
            <div class="bv-orbita o1"></div><div class="bv-orbita o2"></div>
        </div>
    </section>

    <section class="situacao">
        <div class="sit-card">
            <span class="sit-ic" style="--c:var(--green)"><Icone Nome="resumo" /></span>
            <div><div class="sit-rotulo">Planilha de aprovações</div><div class="sit-valor">@(E.Resultado?.Arquivo ?? "Nenhuma carregada")</div>
                <div class="sit-det">@(E.Resultado != null ? $"{Fmt(E.Resultado.Linhas)} registros · {E.Resultado.Usuarios} usuários" : "Abra no Resumo")</div></div>
        </div>
        <div class="sit-card">
            <span class="sit-ic" style="--c:var(--blue)"><Icone Nome="inspecao" /></span>
            <div><div class="sit-rotulo">Planilha de inspeção</div><div class="sit-valor">@(E.Evolucao?.Arquivo ?? "Nenhuma carregada")</div>
                <div class="sit-det">@(E.Evolucao != null ? $"{Fmt(E.Evolucao.Avaliacoes)} avaliações · {Fmt(E.Evolucao.Desvios)} desvios" : "Abra na Evolução")</div></div>
        </div>
        <div class="sit-card">
            <span class="sit-ic" style="--c:var(--purple)"><Icone Nome="historico" /></span>
            <div><div class="sit-rotulo">Histórico</div><div class="sit-valor">@(E.Historico.Count == 0 ? "Nenhum mês gravado" : $"{E.Historico.Count} mês(es) gravado(s)")</div>
                <div class="sit-det">@(E.Historico.Count > 0 ? $"{Texto.NomeMes(E.Historico[0].Mes)} a {Texto.NomeMes(E.Historico[^1].Mes)}" : "Grave a partir da Evolução")</div></div>
        </div>
        <div class="sit-card">
            <span class="sit-ic" style="--c:var(--amber)"><Icone Nome="pareceres" /></span>
            <div><div class="sit-rotulo">Pareceres padrão</div><div class="sit-valor">@(E.ParPadroes.Count == 0 ? "Nenhum documento" : $"{E.ParPadroes.Count} pareceres")</div>
                <div class="sit-det">@(E.ParDocumento != "" ? E.ParDocumento : "Anexe na aba Pareceres")</div></div>
        </div>
    </section>

    @{ var visiveis = Abas.Todas.Where(a => E.AbaAtiva(a.Chave) && Combina(a)).ToList(); }
    <section class="vitrine">
        <span class="vt-luz l1"></span><span class="vt-luz l2"></span><span class="vt-luz l3"></span>
        <div class="vt-conteudo">
    @if (visiveis.Count == 0)
    {
        <div class="g-vazio grande">Nenhum módulo corresponde a “@_busca”.</div>
    }
    @foreach (var g in Abas.Grupos)
    {
        var itens = visiveis.Where(a => a.Grupo == g).ToList();
        if (itens.Count == 0) continue;
        <section class="grupo-mod">
            <h2 class="grupo-titulo"><span class="gt-ponto g-@Indice(g)"></span>@g <span class="gt-desc">@DescGrupo(g)</span></h2>
            <div class="cartoes">
                @foreach (var a in itens)
                {
                    <a class="cartao g-@Indice(g)" href="@a.Rota" target="@(a.Externo ? "_blank" : null)" rel="@(a.Externo ? "noopener" : null)">
                        <span class="cartao-ic"><Icone Nome="@a.Icone" Tamanho="22" /></span>
                        <span class="cartao-txt">
                            <span class="cartao-nome">@a.Nome</span>
                            <span class="cartao-desc">@a.Descricao</span>
                            @if (Status(a.Chave) is string st) { <span class="cartao-status"><i></i>@st</span> }
                        </span>
                        <span class="cartao-seta"><Icone Nome="@(a.Externo ? "externo" : "seta")" Tamanho="18" /></span>
                    </a>
                }
            </div>
        </section>
    }
        </div>
    </section>
    <p class="inicio-rodape"><Icone Nome="escudo" Tamanho="15" /> QSmart · Insi — seus arquivos são processados no navegador e não são enviados para nenhum servidor.</p>
</div>

@code {
    protected override string Chave => "resumo";
    string _busca = "";

    // ---- outdoor da faixa de boas-vindas ----
    const int Slides = 4, Intervalo = 3000;
    int _slide, _cur = Random.Shared.Next(100);
    bool _pausa, _foco;
    bool Parado => _pausa || _foco || _busca != "";
    System.Threading.Timer? _timer;

    static readonly (string chave, string texto)[] Curiosidades =
    {
        ("estrategia", "Já calcula o TMA do dia, resume os serviços e monta a mensagem da estratégia pronta para o Teams."),
        ("corredor", "Une vários compilados num só, tira as linhas repetidas e ainda junta PDFs na ordem que você escolher."),
        ("pareceres", "Confere as justificativas com os pareceres padrão e aponta o que está diferente."),
        ("ferias", "Gera o modelo de planilha para a equipe e mostra choques de datas e quem quer vender dias."),
        ("pontos", "Calcula a média diária de ações por usuário e permite justificar quem ficou abaixo da meta."),
        ("monitor", "Mostra o tempo ocioso de cada colaborador, dia a dia, a partir das finalizações."),
        ("historico", "Guarda os meses gravados e mostra a evolução mês a mês, com mensagem pronta para o Teams."),
        ("resumo", "Mostra aprovações, reprovações e os motivos mais frequentes, com relatório em PDF."),
    };

    int Ferramentas() => Abas.Todas.Count(a => !a.Externo && a.Grupo != "Ferramentas");
    int Areas() => Abas.Todas.Where(a => !a.Externo && a.Grupo != "Ferramentas").Select(a => a.Grupo).Distinct().Count();

    protected override void Entrar()
    {
        _timer = new System.Threading.Timer(_ => Avancar(), null, Intervalo, Intervalo);
    }

    void Avancar()
    {
        if (Parado) return;
        _slide = (_slide + 1) % Slides;
        if (_slide == 2) _cur++;
        InvokeAsync(StateHasChanged);
    }

    void IrPara(int k)
    {
        _slide = k;
        if (k == 2) _cur++;
        _timer?.Change(Intervalo, Intervalo);
    }

    public override void Dispose()
    {
        _timer?.Dispose();
        base.Dispose();
    }

    static string Saudacao()
    {
        var h = DateTime.Now.Hour;
        return h < 12 ? "Bom dia" : h < 18 ? "Boa tarde" : "Boa noite";
    }

    bool Combina(Aba a)
    {
        var t = Texto.NormalizarBusca(_busca);
        if (t == "") return true;
        var alvo = Texto.NormalizarBusca($"{a.Nome} {a.Menu} {a.Grupo} {a.Descricao}");
        return t.Split(' ').All(alvo.Contains);
    }

    void Tecla(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var a = Abas.Todas.FirstOrDefault(x => E.AbaAtiva(x.Chave) && Combina(x));
        if (a == null) return;
        if (a.Externo) _ = E.Nav.AbrirUrl(a.Rota); else Rotas.NavigateTo(a.Rota);
    }

    static int Indice(string g) => Abas.Cor(g);

    static string DescGrupo(string g) => g switch
    {
        "Decisões" => "aprovações, reprovações e quem decide",
        "Inspeção" => "desvios, inspeções internas e histórico mensal",
        "Conformidade" => "pareceres conferidos com o padrão",
        "Operação" => "volume, ociosidade, consolidação de arquivos e estratégia do dia",
        "Coordenação" => "férias da equipe e produtividade do mês",
        _ => "diagnóstico das planilhas e outros sistemas da Insi",
    };

    string? Status(string chave) => chave switch
    {
        "resumo" or "usuarios" when E.Resultado != null => $"{E.Resultado.Arquivo} carregado",
        "evolucao" when E.Evolucao != null => $"{E.Evolucao.Arquivo} carregado",
        "historico" when E.Historico.Count > 0 => $"{E.Historico.Count} mês(es) no histórico",
        "pareceres" when E.ParDf != null => $"{E.ParArquivo?.Nome} carregado",
        "inspecao" when E.IntRes != null => $"{E.IntRes.Arquivo} carregado",
        "estrategia" when E.EstBase != null => $"{E.EstBase.Arquivos.Count} compilado(s) anexado(s)",
        "volume" when E.VolComp != null => $"{E.VolComp.Arquivos.Count} compilado(s) anexado(s)",
        "monitor" when E.MonBase != null => $"{E.MonBase.Arquivos.Count} planilha(s) anexada(s)",
        "corredor" when E.CorItens.Count > 0 => $"{E.CorItens.Count} compilado(s) na fila",
        "depurador" when E.DepRes != null => $"{E.DepRes.Arquivo} em análise",
        "pontos" when E.PtsRes != null => $"{E.PtsArquivos} carregado",
        "ferias" when E.FeriasResumo != null => E.FeriasResumo,
        _ => null,
    };
}
