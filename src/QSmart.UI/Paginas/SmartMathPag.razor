    [JSInvokable]
    public async Task TeclaEdicao(string tecla, bool shift, string valor)
    {
        _txt = valor;
        if (tecla == "Escape") { _editando = false; _erroFormula = null; StateHasChanged(); await E.Nav.GradeFocar(_grade); await E.Nav.GradeBarra(Ativa?.Entrada); return; }
        if (tecla == "Tab" && Sugestoes() is { Count: > 0 } sg && SufixoFuncao() != null) { InserirFuncao(sg[0]); StateHasChanged(); return; }
        if (!Confirmar()) { StateHasChanged(); return; }
