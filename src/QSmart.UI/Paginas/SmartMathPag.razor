    // ====================================================== formatação
    IEnumerable<Celula> CelulasSel(bool criar = true)
    {
        int r2 = Math.Min(_s.r2, Math.Max(_s.r1, F.UltLinha + 1)), c2 = Math.Min(_s.c2, Math.Max(_s.c1, F.UltColuna + 1));
        if (_s.r2 - _s.r1 < 2000) r2 = _s.r2;
        if (_s.c2 - _s.c1 < 60) c2 = _s.c2;
        for (int r = _s.r1; r <= r2; r++)
            for (int c = _s.c1; c <= c2; c++)
                yield return criar ? F.Pegar(r, c) : F.Get(r, c)!;
    }

    void Formatar(Action<EstiloCel> f) { Guardar(); foreach (var c in CelulasSel()) f(c.E); Mudou(); _ = E.Nav.GradeFocar(_grade); }

    void Estilo(string qual)
    {
        bool on = qual switch { "n" => !(Ativa?.E.N ?? false), "i" => !(Ativa?.E.I ?? false), _ => !(Ativa?.E.S ?? false) };
        Formatar(e => { if (qual == "n") e.N = on; else if (qual == "i") e.I = on; else e.S = on; });
    }

    [JSInvokable]
    public async Task Atalho(string qual)
    {
        switch (qual)
        {
            case "n": case "i": case "s": Estilo(qual); break;
            case "salvar": await Salvar(); break;
            case "baixo": PreencherAbaixo(); break;
            case "tudo": SelecionarTudo(); break;
        }
        StateHasChanged();
    }

    void Cor(string c) => Formatar(e => e.Cor = c);
    void Fundo(string c) => Formatar(e => e.Fundo = c);
    void Alinhar(string a) { var novo = Ativa?.E.Alinh == a ? "" : a; Formatar(e => e.Alinh = novo); }
    void MudarFormato(ChangeEventArgs ev) { var f = ev.Value?.ToString() ?? "geral"; Formatar(e => { e.Formato = f; if (f == "pct" && e.Casas > 2) e.Casas = 2; }); }
    void Casas(int d) => Formatar(e => { if (e.Formato is "geral" or "int") e.Formato = "num"; e.Casas = Math.Clamp(e.Casas + d, 0, 10); });
    void LimparFormatos() => Formatar(e => { e.N = e.I = e.S = false; e.Cor = e.Fundo = e.Alinh = ""; e.Formato = "geral"; e.Casas = 2; });

    string ClasseCel(int r, int c, object? v, Celula? cel, bool ativa)
    {
        var cl = "sm-c";
        if (r >= _s.r1 && r <= _s.r2 && c >= _s.c1 && c <= _s.c2) { cl += " sel"; if (r == _s.r1) cl += " bt"; if (r == _s.r2) cl += " bb"; if (c == _s.c1) cl += " bl"; if (c == _s.c2) cl += " br"; }
        if (ativa) cl += " ativa";
        if (v is ErroF) cl += " erro";
        if (_editando && _txt.StartsWith("=") && RefsEdicao().Any(x => r >= x.r1 && r <= x.r2 && c >= x.c1 && c <= x.c2)) cl += " ref";
        if (F.Filtro is { } fl && r == fl.Linha && c >= fl.C1 && c <= fl.C2) cl += " cab-filtro";
        return cl;
    }

    List<(int r1, int c1, int r2, int c2)>? _refsCache; string? _refsDe;
    List<(int r1, int c1, int r2, int c2)> RefsEdicao()
    {
        if (_refsDe == _txt && _refsCache != null) return _refsCache;
        _refsDe = _txt;
        try { _refsCache = Formula.Referencias(_txt[1..]).Where(x => x.folha == null || string.Equals(x.folha, F.Nome, StringComparison.OrdinalIgnoreCase)).Select(x => (x.r1, x.c1, x.r2, x.c2)).ToList(); }
        catch { _refsCache = new(); }
        return _refsCache;
    }

    static string EstiloCel(Celula? cel, object? v)
    {
        var e = cel?.E;
        var al = e?.Alinh is "esq" ? "left" : e?.Alinh is "centro" ? "center" : e?.Alinh is "dir" ? "right" : v is double ? "right" : v is bool or ErroF ? "center" : "left";
        var s = $"text-align:{al};";
        if (e == null) return s;
        if (e.N) s += "font-weight:700;";
        if (e.I) s += "font-style:italic;";
        if (e.S) s += "text-decoration:line-through;";
        if (e.Cor != "") s += $"color:{e.Cor};";
        if (e.Fundo != "") s += $"background:{e.Fundo};";
        return s;
    }

    static string? Dica(object? v) => (v as ErroF)?.Cod switch
    {
        "#DIV/0!" => "Divisão por zero", "#NOME?" => "Função ou nome que o Smart Math não conhece", "#REF!" => "Referência inválida (célula excluída?)",
        "#N/D" => "Valor não encontrado", "#CIRC!" => "Referência circular: a fórmula depende dela mesma", "#VALOR!" => "Tipo de valor errado (texto onde deveria ter número?)", _ => null,
    };

    (double soma, double media, int cont, int nums) Resumo()
    {
        double s = 0; int n = 0, cont = 0;
        if ((long)(_s.r2 - _s.r1 + 1) * (_s.c2 - _s.c1 + 1) > 50000) return (0, 0, 0, 0);
        int r2 = Math.Min(_s.r2, F.UltLinha), c2 = Math.Min(_s.c2, F.UltColuna);
        for (int r = _s.r1; r <= r2; r++)
            for (int c = _s.c1; c <= c2; c++)
            {
                var v = _calc.Valor(F, r, c);
                if (v == null) continue;
                cont++;
                if (v is double d) { s += d; n++; }
            }
        return (s, n == 0 ? 0 : s / n, cont, n);
    }

    // ====================================================== copiar / colar / preencher
    [JSInvokable]
    public string Copiar(bool recortar)
    {
        int r2 = Math.Min(_s.r2, Math.Max(_s.r1, F.UltLinha)), c2 = Math.Min(_s.c2, Math.Max(_s.c1, F.UltColuna));
        var cels = new List<(int, int, Celula)>();
        var sb = new System.Text.StringBuilder();
        for (int r = _s.r1; r <= r2; r++)
        {
            for (int c = _s.c1; c <= c2; c++)
            {
                if (c > _s.c1) sb.Append('\t');
                sb.Append(Texto(r, c).Replace("\t", " ").Replace("\n", " "));
                if (F.Get(r, c) is { } cel) cels.Add((r - _s.r1, c - _s.c1, cel.Clonar()));
            }
            if (r < r2) sb.Append("\r\n");
        }
        _clip = (sb.ToString(), _s.r1, _s.c1, cels, recortar, F);
        return sb.ToString();
    }

    [JSInvokable]
    public void Colar(string texto)
    {
        Guardar();
        var norm = texto.Replace("\r\n", "\n").TrimEnd('\n');
        if (_clip is { } cp && cp.tsv.Replace("\r\n", "\n").TrimEnd('\n') == norm)
        {
            // de dentro do Smart Math: cola com fórmulas (ajustando as referências) e formatos
            var tsvLinhas = norm.Split('\n');
            int h = tsvLinhas.Length, w = tsvLinhas.Max(l => l.Split('\t').Length);
            // como no Excel: se a seleção for múltipla do que foi copiado, repete para preencher toda a seleção
            int selH = _s.r2 - _s.r1 + 1, selW = _s.c2 - _s.c1 + 1;
            int repV = !cp.recortar && selH > h && selH % h == 0 && selH <= 5000 ? selH / h : 1;
            int repH = !cp.recortar && selW > w && selW % w == 0 && selW <= 500 ? selW / w : 1;
            int r0b = _s.r1, c0b = _s.c1;
            if (cp.recortar) foreach (var (r0, c0, _) in cp.cels) cp.origem.Limpar(cp.r1 + r0, cp.c1 + c0);
            for (int iv = 0; iv < repV; iv++)
                for (int ih = 0; ih < repH; ih++)
                {
                    int br = r0b + iv * h, bc = c0b + ih * w;
                    for (int rr = 0; rr < h; rr++) for (int cc = 0; cc < w; cc++) F.Limpar(br + rr, bc + cc);
                    foreach (var (r0, c0, cel) in cp.cels)
                    {
                        var nova = cel.Clonar();
                        if (nova.Entrada.StartsWith("=") && !cp.recortar) nova.Entrada = "=" + Formula.Deslocar(nova.Entrada[1..], br - cp.r1, bc - cp.c1);
                        F.Cel[Folha.K(br + r0, bc + c0)] = nova;
                    }
                }
            _ar = r0b; _ac = c0b; _anR = r0b; _anC = c0b; _s = (r0b, c0b, r0b + h * repV - 1, c0b + w * repH - 1);
            if (cp.recortar) _clip = null;
        }
        else
        {
            var linhas = norm.Split('\n');
            for (int i = 0; i < linhas.Length; i++)
            {
                var cols = linhas[i].Split('\t');
                for (int j = 0; j < cols.Length; j++)
                {
                    var v = cols[j].Trim();
                    if (v.Length > 1 && v.StartsWith("\"") && v.EndsWith("\"")) v = v[1..^1].Replace("\"\"", "\"");
                    var cel = F.Pegar(_ar + i, _ac + j);
                    cel.Entrada = v;
                    if (cel.E.Formato == "geral") { FormatoPt.Valor(v, out var sug); if (sug != "") cel.E.Formato = sug; }
                }
            }
            _anR = _ar; _anC = _ac; _s = (_ar, _ac, _ar + linhas.Length - 1, _ac + linhas.Max(l => l.Split('\t').Length) - 1);
        }
        Mudou(); StateHasChanged();
    }

    void PreencherAbaixo()
    {
        if (_s.r2 <= _s.r1) return;
        Guardar();
        for (int c = _s.c1; c <= _s.c2; c++)
        {
            var origem = F.Get(_s.r1, c);
            for (int r = _s.r1 + 1; r <= _s.r2; r++)
            {
                if (origem == null) { F.Limpar(r, c); continue; }
                var n = origem.Clonar();
                if (n.Entrada.StartsWith("=")) n.Entrada = "=" + Formula.Deslocar(n.Entrada[1..], r - _s.r1, 0);
                F.Cel[Folha.K(r, c)] = n;
            }
        }
        Mudou();
    }

    // ====================================================== Σ, ordenar, filtro
    async Task AutoSoma()
    {
        if (_editando) Confirmar();
        if (_s.r1 == _s.r2 && _s.c1 == _s.c2)
        {
            // procura números acima (ou à esquerda) da célula ativa
            int r = _ar - 1; while (r >= 0 && _calc.Valor(F, r, _ac) is double) r--;
            string faixa;
            if (r < _ar - 1) faixa = Ender.Faixa(r + 1, _ac, _ar - 1, _ac);
            else { int c = _ac - 1; while (c >= 0 && _calc.Valor(F, _ar, c) is double) c--; faixa = c < _ac - 1 ? Ender.Faixa(_ar, c + 1, _ar, _ac - 1) : ""; }
            _editando = true; _pelaBarra = false; _txt = _txtVisto = $"=SOMA({faixa})";
            StateHasChanged(); await Task.Delay(1); await E.Nav.GradeFocarEdicao(true);
            return;
        }
        Guardar();
        int ult = Math.Min(_s.r2, F.UltLinha);
        for (int c = _s.c1; c <= Math.Min(_s.c2, F.UltColuna); c++)
        {
            int dest = ult + 1;
            var cel = F.Pegar(dest, c);
            cel.Entrada = $"=SOMA({Ender.Faixa(_s.r1, c, ult, c)})"; cel.E.N = true;
        }
        Mudou();
    }

    /// <summary>A região de dados em volta da célula ativa (como o Excel faz ao classificar).</summary>
    (int r1, int c1, int r2, int c2) Regiao()
    {
        if (_s.r2 > _s.r1 || _s.c2 > _s.c1) return (_s.r1, _s.c1, Math.Min(_s.r2, F.UltLinha), Math.Min(_s.c2, F.UltColuna));
        bool Cheia(int r, int c) => r >= 0 && c >= 0 && !string.IsNullOrEmpty(F.Get(r, c)?.Entrada);
        int r1 = _ar, r2 = _ar, c1 = _ac, c2 = _ac;
        bool mudou = true;
        while (mudou)
        {
            mudou = false;
            if (Enumerable.Range(c1, c2 - c1 + 1).Any(c => Cheia(r1 - 1, c))) { r1--; mudou = true; }
            if (Enumerable.Range(c1, c2 - c1 + 1).Any(c => Cheia(r2 + 1, c))) { r2++; mudou = true; }
            if (Enumerable.Range(r1, r2 - r1 + 1).Any(r => Cheia(r, c1 - 1))) { c1--; mudou = true; }
            if (Enumerable.Range(r1, r2 - r1 + 1).Any(r => Cheia(r, c2 + 1))) { c2++; mudou = true; }
        }
        return (r1, c1, r2, c2);
    }

    bool TemCabecalho(int r1, int c1, int c2, int r2) =>
        r2 > r1 && Enumerable.Range(c1, c2 - c1 + 1).All(c => _calc.Valor(F, r1, c) is string or null) &&
        Enumerable.Range(c1, c2 - c1 + 1).Any(c => _calc.Valor(F, r1 + 1, c) is double) || (r2 > r1 && Enumerable.Range(c1, c2 - c1 + 1).Any(c => F.Get(r1, c)?.E.N == true));

    void Ordenar(bool cresc)
    {
        if (_editando) Confirmar();
        if (F.Filtro is { } fl) { OrdenarFaixa(fl.Linha + 1, fl.C1, SemTotais(fl.Linha + 1, fl.C1, Math.Max(fl.Linha + 1, F.UltLinha), fl.C2), fl.C2, _ac, cresc); return; }
        var (r1, c1, r2, c2) = Regiao();
        if (r2 <= r1) return;
        if (TemCabecalho(r1, c1, c2, r2)) r1++;
        r2 = SemTotais(r1, c1, r2, c2);
        OrdenarFaixa(r1, c1, r2, c2, Math.Clamp(_ac, c1, c2), cresc);
    }

    /// <summary>Tira do fim da faixa as linhas de total (fórmulas que somam as linhas de cima), para não embaralhar o total junto.</summary>
    int SemTotais(int r1, int c1, int r2, int c2)
    {
        while (r2 > r1)
        {
            bool total = false;
            for (int c = c1; c <= c2 && !total; c++)
            {
                var e = F.Get(r2, c)?.Entrada ?? "";
                if (!e.StartsWith("=")) continue;
                try { total = Formula.Referencias(e[1..]).Any(x => x.folha == null && x.r2 > x.r1 && x.r1 >= r1 - 1 && x.r2 < r2); } catch { }
            }
            if (!total) break;
            r2--;
        }
        return r2;
    }

    void OrdenarFaixa(int r1, int c1, int r2, int c2, int chave, bool cresc)
    {
        Guardar();
        var linhas = Enumerable.Range(r1, r2 - r1 + 1).Select(r => (r, v: _calc.Valor(F, r, chave))).ToList();
        var ord = linhas.OrderBy(x => x.v == null ? 1 : 0).ThenBy(x => x.v, Comparer<object?>.Create((a, b) => cresc ? Formula.Comparar(a, b) : Formula.Comparar(b, a))).Select(x => x.r).ToList();
        var copia = new Dictionary<(int, int), Celula?>();
        foreach (var r in ord) for (int c = c1; c <= c2; c++) copia[(r, c)] = F.Get(r, c)?.Clonar();
        for (int i = 0; i < ord.Count; i++)
        {
            int de = ord[i], para = r1 + i;
            for (int c = c1; c <= c2; c++)
            {
                var cel = copia[(de, c)];
                if (cel == null) { F.Limpar(para, c); continue; }
                if (cel.Entrada.StartsWith("=") && para != de) cel.Entrada = "=" + Formula.Deslocar(cel.Entrada[1..], para - de, 0);
                F.Cel[Folha.K(para, c)] = cel;
            }
        }
        Mudou();
    }

    void AlternarFiltro()
    {
        Guardar();
        if (F.Filtro != null) { F.Filtro = null; Mudou(); return; }
        var (r1, c1, _, c2) = Regiao();
        F.Filtro = new Filtro { Linha = r1, C1 = c1, C2 = c2 };
        Mudou();
    }

    void AbrirFiltro(int c)
    {
        var fl = F.Filtro!;
        var vals = new SortedSet<string>(StringComparer.CurrentCultureIgnoreCase);
        for (int r = fl.Linha + 1; r <= F.UltLinha; r++) { vals.Add(Texto(r, c)); if (vals.Count > 1000) break; }
        _filtroVals = vals.ToList();
        var esc = fl.Escondidos.GetValueOrDefault(c) ?? new HashSet<string>();
        _filtroMarc = _filtroVals.Where(v => !esc.Contains(v)).ToHashSet();
        _filtroBusca = ""; _filtroCol = c;
    }

    void MarcarTodos(bool on) => _filtroMarc = on ? _filtroVals.ToHashSet() : new();

    void AplicarFiltro()
    {
        if (_filtroCol is not int c || F.Filtro is not { } fl) return;
        var esc = _filtroVals.Where(v => !_filtroMarc.Contains(v)).ToHashSet();
        if (esc.Count == 0) fl.Escondidos.Remove(c); else fl.Escondidos[c] = esc;
        _filtroCol = null;
        Recontar();
    }

    void OrdenarColFiltro(int c, bool cresc)
    {
        var fl = F.Filtro!;
        _filtroCol = null;
        OrdenarFaixa(fl.Linha + 1, fl.C1, SemTotais(fl.Linha + 1, fl.C1, Math.Max(fl.Linha + 1, F.UltLinha), fl.C2), fl.C2, c, cresc);
    }

    // ====================================================== linhas e colunas
    async Task LinhasColunas(ChangeEventArgs e)
    {
        var op = e.Value?.ToString() ?? "";
        _chaveSel++;
        if (op == "") return;
        if (_editando) Confirmar();
        bool linhas = op[1] == 'l';
        bool inserir = op[0] == 'i';
        int pos = linhas ? _s.r1 : _s.c1;
        int n = inserir ? 1 : (linhas ? _s.r2 - _s.r1 + 1 : _s.c2 - _s.c1 + 1);
        if (!inserir && n > 500) { await J.Aviso("Smart Math", "Selecione menos linhas/colunas para excluir de uma vez."); return; }
        Guardar();
        var delta = inserir ? n : -n;
        var novo = new Dictionary<long, Celula>();
        foreach (var (k, cel) in F.Cel)
        {
            var (r, c) = Folha.DeK(k);
            int v = linhas ? r : c;
            if (!inserir && v >= pos && v < pos + n) continue;
            if (v >= pos) v += delta;
            novo[linhas ? Folha.K(v, c) : Folha.K(r, v)] = cel;
        }
        F.Cel = novo;
        if (!linhas)
            F.Larg = F.Larg.Where(x => inserir || x.Key < pos || x.Key >= pos + n).ToDictionary(x => x.Key >= pos ? x.Key + delta : x.Key, x => x.Value);
        // ajusta as fórmulas de todas as abas e as faixas dos gráficos
        foreach (var fo in _p.Folhas)
        {
            foreach (var cel in fo.Cel.Values.Where(x => x.Entrada.StartsWith("=")))
                cel.Entrada = "=" + Formula.Ajustar(cel.Entrada[1..], fo.Nome, F.Nome, linhas, pos, delta);
            foreach (var g in fo.Graficos.Where(_ => fo == F))
                g.Faixa = Formula.Ajustar(g.Faixa, F.Nome, F.Nome, linhas, pos, delta).Replace("#REF!", g.Faixa);
        }
        if (F.Filtro is { } fl && linhas && fl.Linha >= pos) fl.Linha = Math.Max(0, fl.Linha + delta);
        Mudou();
    }

    // ====================================================== gráficos
    void NovoGrafico(ChangeEventArgs e)
    {
        var tipo = e.Value?.ToString() ?? "";
        _chaveSel++;
        if (tipo == "") return;
        if (_editando) Confirmar();
        var (r1, c1, r2, c2) = Regiao();
        Guardar();
        var titulo = c2 == c1 + 1 ? Texto(r1, c1 + 1) : c2 == c1 ? Texto(r1, c1) : "";
        F.Graficos.Add(new Grafico { Tipo = tipo, Faixa = Ender.Faixa(r1, c1, r2, c2), Titulo = titulo });
        _painelGraf = true;
        Mudou();
        _ = E.Conta.Registrar("math.grafico", true);
    }

    void TituloGrafico(Grafico g, ChangeEventArgs e) { Guardar(); g.Titulo = e.Value?.ToString() ?? ""; Mudou(); }
    void TipoGrafico(Grafico g, ChangeEventArgs e) { Guardar(); g.Tipo = e.Value?.ToString() ?? g.Tipo; Mudou(); }
    void ExcluirGrafico(Grafico g) { Guardar(); F.Graficos.Remove(g); Mudou(); }
    void MudarFaixa(Grafico g, ChangeEventArgs e) { var t = (e.Value?.ToString() ?? "").Trim().ToUpperInvariant().Replace(" ", ""); if (Ender.LerFaixa(t, out _, out _, out _, out _)) { Guardar(); g.Faixa = t; Mudou(); } }
    void UsarSelecao(Grafico g) { var (r1, c1, r2, c2) = Regiao(); Guardar(); g.Faixa = Ender.Faixa(r1, c1, r2, c2); Mudou(); }

    // ====================================================== abas
    void TrocarFolha(int i) { if (_editando) Confirmar(); _fi = i; _anR = _anC = _ar = _ac = 0; _s = (0, 0, 0, 0); _filtroCol = null; _calc.Limpar(); Recontar(); _ = E.Nav.GradeFocar(_grade); }

    void NovaFolha()
    {
        int n = _p.Folhas.Count + 1;
        while (_p.Folha($"Planilha{n}") != null) n++;
        _p.Folhas.Add(new Folha { Nome = $"Planilha{n}" });
        TrocarFolha(_p.Folhas.Count - 1);
        Mudou();
    }

    async Task RenomearFolha(int i)
    {
        var f = _p.Folhas[i];
        var novo = (await J.Entrada("Renomear aba", "Nome da aba", f.Nome))?.Trim();
        if (string.IsNullOrEmpty(novo) || novo == f.Nome) return;
        if (_p.Folha(novo) != null) { await J.Aviso("Renomear aba", "Já existe uma aba com esse nome."); return; }
        novo = string.Concat(novo.Where(ch => !"[]:*?/\\".Contains(ch)));
        var antigo = f.Nome;
        foreach (var fo in _p.Folhas) foreach (var cel in fo.Cel.Values.Where(x => x.Entrada.StartsWith("="))) cel.Entrada = "=" + Formula.RenomearFolha(cel.Entrada[1..], antigo, novo);
        f.Nome = novo;
        Mudou();
    }

    async Task MenuFolha(int i)
    {
        var op = await J.Um(_p.Folhas[i].Nome, new[] { ("ren", "Renomear"), ("dup", "Duplicar"), ("esq", "Mover para a esquerda"), ("dir", "Mover para a direita"), ("exc", "Excluir aba") }, "", "O que fazer com esta aba?", "");
        switch (op)
        {
            case "ren": await RenomearFolha(i); break;
            case "dup":
            {
                var c = _p.Folhas[i].Clonar(); int n = 2; while (_p.Folha($"{c.Nome} ({n})") != null) n++; c.Nome = $"{c.Nome} ({n})";
                foreach (var g in c.Graficos) g.Id = Guid.NewGuid().ToString("N")[..8];
                _p.Folhas.Insert(i + 1, c); TrocarFolha(i + 1); Mudou(); break;
            }
            case "esq" when i > 0: (_p.Folhas[i - 1], _p.Folhas[i]) = (_p.Folhas[i], _p.Folhas[i - 1]); _fi = i - 1; Mudou(); break;
            case "dir" when i < _p.Folhas.Count - 1: (_p.Folhas[i + 1], _p.Folhas[i]) = (_p.Folhas[i], _p.Folhas[i + 1]); _fi = i + 1; Mudou(); break;
            case "exc":
                if (_p.Folhas.Count == 1) { await J.Aviso("Excluir aba", "A planilha precisa ter pelo menos uma aba."); break; }
                if (!await J.Pergunta("Excluir aba", $"Excluir a aba “{_p.Folhas[i].Nome}” e tudo o que está nela?")) break;
                _p.Folhas.RemoveAt(i); _desfazer.Clear(); _refazer.Clear(); TrocarFolha(Math.Max(0, i - 1)); Mudou(); break;
        }
    }

    [JSInvokable] public void Largura(int col, double px) { Guardar(); F.Larg[col] = Math.Round(px); Mudou(); StateHasChanged(); }

    // ====================================================== arquivo
    async Task MudarNome(ChangeEventArgs e)
    {
        var n = (e.Value?.ToString() ?? "").Trim();
        if (n.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)) n = n[..^5];
        _nome = n == "" ? "Planilha sem título" : n;
        await GuardarRascunho();
    }

    async Task<bool> PodeTrocar() => !_sujo || await J.Pergunta("Smart Math", "A planilha atual tem alterações que não foram salvas em .xlsx. Continuar mesmo assim?");

    void Carregar(Pasta p, string nome, string status)
    {
        _p = p; _fi = 0; _calc = new Formula.Calc(_p);
        _nome = nome; _status = status; _sujo = false;
        _desfazer.Clear(); _refazer.Clear(); _clip = null; _filtroCol = null; _editando = false;
        _anR = _anC = _ar = _ac = 0; _s = (0, 0, 0, 0);
        _painelGraf = _p.Folhas.Any(f => f.Graficos.Count > 0);
        Recontar();
    }

    async Task Nova()
    {
        if (!await PodeTrocar()) return;
        Carregar(new Pasta(), "Planilha sem título", "planilha nova");
        await E.Nav.LsDel(Rascunho);
    }

    async Task Abrir(InputFileChangeEventArgs e)
    {
        var f = e.File;
        using var ms = new MemoryStream();
        try { await f.OpenReadStream(60_000_000).CopyToAsync(ms); }
        catch (Exception ex) { _chaveArq++; await J.Erro("Abrir", "Não consegui ler esse arquivo: " + ex.Message); return; }
        _chaveArq++;   // só depois de ler: trocar o InputFile antes apaga o arquivo escolhido no navegador
        if (!await PodeTrocar()) return;
        try
        {
            var bytes = ms.ToArray();
            Pasta p;
            if (f.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                var txt = System.Text.Encoding.UTF8.GetString(bytes).Replace("\r", "");
                var sep = txt.Split('\n').FirstOrDefault()?.Count(ch => ch == ';') >= txt.Split('\n').FirstOrDefault()?.Count(ch => ch == ',') ? ';' : ',';
                p = new Pasta(); var fo = p.Folhas[0]; fo.Nome = Path.GetFileNameWithoutExtension(f.Name);
                var linhas = txt.TrimEnd('\n').Split('\n');
                for (int i = 0; i < linhas.Length; i++) { var cs = linhas[i].Split(sep); for (int j = 0; j < cs.Length; j++) if (cs[j].Trim('"') != "") fo.Pegar(i, j).Entrada = cs[j].Trim().Trim('"'); }
            }
            else p = XlsxPasta.Ler(bytes);
            Carregar(p, Path.GetFileNameWithoutExtension(f.Name), $"aberto de {f.Name}");
            _recuperar = null;
            _ = E.Conta.Registrar("math.abrir", true);
        }
        catch (Exception ex) { await J.Erro("Abrir planilha", "Não consegui abrir esse arquivo: " + ex.Message); }
    }

    async Task Salvar()
    {
        if (_salvando) return;
        if (_editando && !Confirmar()) return;
        _salvando = true; StateHasChanged();
        try
        {
            var bytes = XlsxPasta.Gravar(_p);
            var nome = string.Concat(_nome.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c)).Trim();
            await E.Nav.Baixar((nome == "" ? "Planilha" : nome) + ".xlsx", bytes, Navegador.MimeXlsx);
            _sujo = false; _status = $"salvo em Downloads às {DateTime.Now:HH:mm}";
            await E.Nav.LsDel(Rascunho);
            _ = E.Conta.Registrar("math.salvar", true);
        }
        catch (Exception ex) { await J.Erro("Salvar .xlsx", "Não consegui gerar o arquivo: " + ex.Message); }
        finally { _salvando = false; }
    }

    async Task Recuperar()
    {
        if (_recuperar is not { } r) return;
        try { Carregar(XlsxPasta.DeJson(r.json), r.nome, ""); _sujo = true; }
        catch { await J.Aviso("Smart Math", "Não consegui recuperar a planilha."); }
        _recuperar = null;
    }

    async Task Descartar() { _recuperar = null; await E.Nav.LsDel(Rascunho); }

    public override void Dispose()
    {
        base.Dispose();
        if (_montado) { try { _ = E.Nav.GradeDesmontar(_grade); } catch { } }
        _ = Task.Delay(3000).ContinueWith(_ => _ref?.Dispose());
    }
