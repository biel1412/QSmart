    }

    /// <summary>Grava o que foi digitado na célula ativa. Devolve falso se a fórmula estiver com erro.</summary>
    bool Confirmar()
    {
        if (!_editando) return true;
        var t = _txt;
        if (t.StartsWith("=") && t.Length > 1)
        {
            // fecha parênteses esquecidos, como o Excel
            int abre = t.Count(ch => ch == '('), fecha = t.Count(ch => ch == ')');
            if (abre > fecha && !t.Contains('"')) t += new string(')', abre - fecha);
            if (!Formula.Valida(t[1..])) { _erroFormula = "Fórmula com erro: confira parênteses, ; entre os argumentos e aspas nos textos."; return false; }
        }
        _editando = false; _pelaBarra = false; _erroFormula = null; _refInserida = null;
        var atual = Ativa?.Entrada ?? "";
        if (t == atual) return true;
        Guardar();
        var cel = F.Pegar(_ar, _ac);
        cel.Entrada = t;
        if (cel.E.Formato == "geral" && !t.StartsWith("=")) { FormatoPt.Valor(t, out var sug); if (sug != "") { cel.E.Formato = sug; if (sug == "pct" && !t.Contains(',')) cel.E.Casas = 0; } }
        if (t == "" && cel.E.Padrao) F.Limpar(_ar, _ac);
        Mudou();
        return true;
    }

    bool PodeInserirRef()
    {
        var t = _txt.TrimEnd();
        if (_refInserida != null) return true;
        return t.Length > 0 && "=(;+-*/^&<>:,".Contains(t[^1]);
    }

    void InserirRef(int r1, int c1, int r2, int c2)
    {
        var refTxt = Ender.Faixa(r1, c1, r2, c2);
        if (_refInserida is { } ri && ri.pos + ri.len <= _txt.Length) _txt = _txt[..ri.pos] + refTxt + _txt[(ri.pos + ri.len)..];
        else { _refInserida = (r1, c1, _txt.Length, 0); _txt += refTxt; }
        _refInserida = (r1, c1, _refInserida!.Value.pos, refTxt.Length);
        _ = Empurrar();
        StateHasChanged();
    }

    /// <summary>Manda para a caixa de edição um texto que o próprio Smart Math mudou (referência clicada, função escolhida).</summary>
    async Task Empurrar() { _txtVisto = _txt; await E.Nav.GradeValor(_txt); }

    string? SufixoFuncao()
    {
        if (!_txt.StartsWith("=")) return null;
        var m = System.Text.RegularExpressions.Regex.Match(_txt, @"([A-Za-zÀ-ú][A-Za-zÀ-ú.0-9]*)$");
        if (!m.Success || m.Value.Length < 1) return null;
        if (System.Text.RegularExpressions.Regex.IsMatch(m.Value, @"^[A-Za-z]{1,3}\d+$")) return null;
        return m.Value;
    }

    List<string> Sugestoes()
    {
        var s = SufixoFuncao();
        if (s == null) return new();
        var u = s.ToUpperInvariant();
        string Sem(string x) => new string(x.Normalize(System.Text.NormalizationForm.FormD).Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
        return Formula.FuncoesPt.Where(f => Sem(f).StartsWith(Sem(u))).Take(7).ToList();
    }

    void InserirFuncao(string fn)
    {
        var s = SufixoFuncao();
        if (s != null) _txt = _txt[..^s.Length];
        _txt += fn + "(";
        _ = Empurrar();
    }

    static string EstiloEd(Celula? cel) => cel == null ? "" : (cel.E.N ? "font-weight:700;" : "") + (cel.E.I ? "font-style:italic;" : "");

    [JSInvokable]
    public void Apagar()
