    void SelecionarTudo() { _anR = 0; _anC = 0; _ar = 0; _ac = 0; _s = (0, 0, Math.Max(0, F.UltLinha), Math.Max(0, F.UltColuna)); }

    [JSInvokable]
    public async Task Mover(int dr, int dc, bool estender, bool ctrl)
    {
        if (_editando) return;
        MoverJa(dr, dc, estender, ctrl);
        StateHasChanged();
        await E.Nav.GradeBarra(Ativa?.Entrada);
        await E.Nav.GradeRolar(_grade, _ar, _ac);
    }

    /// <summary>Parte síncrona do movimento: nada de await aqui, para que a próxima tecla já encontre a nova célula ativa.</summary>
    void MoverJa(int dr, int dc, bool estender, bool ctrl)
    {
        int r = estender ? (_s.r1 == _anR ? _s.r2 : _s.r1) : _ar, c = estender ? (_s.c1 == _anC ? _s.c2 : _s.c1) : _ac;
        if (estender) { r = _ar; c = _ac; }
        if (ctrl)
        {
            // pula até a borda dos dados (como o Ctrl+seta do Excel)
            bool Cheia(int rr, int cc) => rr >= 0 && cc >= 0 && !string.IsNullOrEmpty(F.Get(rr, cc)?.Entrada);
            int lim = Math.Max(_linhas, F.UltLinha + 1) + 1000;
            int nr = r, nc = c;
            bool inicioCheio = Cheia(nr, nc) && Cheia(nr + dr, nc + dc);
            while (nr + dr >= 0 && nc + dc >= 0 && nr + dr < lim && nc + dc < 16384)
            {
                nr += dr; nc += dc;
                if (inicioCheio ? !Cheia(nr + dr, nc + dc) : Cheia(nr, nc)) break;
                if (!inicioCheio && nr > F.UltLinha + 1 && dr > 0) break;
                if (!inicioCheio && nc > F.UltColuna + 1 && dc > 0) break;
            }
            r = nr; c = nc;
        }
        else
        {
            // pula linhas escondidas pelo filtro
            r += dr; c += dc;
            var esc = dr != 0 ? Escondidas() : null;
            while (esc != null && esc.Contains(r) && r > 0) r += Math.Sign(dr);
        }
        if (estender) { _ar = Math.Max(0, r); _ac = Math.Max(0, c); _s = (Math.Min(_anR, _ar), Math.Min(_anC, _ac), Math.Max(_anR, _ar), Math.Max(_anC, _ac)); if (_ar >= _linhas - 5 || _ac >= _cols - 2) Recontar(); }
        else Selecionar(r, c, false);
    }

