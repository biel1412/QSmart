@page "/smart-math"
@inherits PaginaBase
@using Microsoft.JSInterop
@using QSmart.Core.Pacote
@using Folha = QSmart.Core.Pacote.Folha
@using Celula = QSmart.Core.Pacote.Celula
@using Formula = QSmart.Core.Pacote.Formula

<div class="sm">
    <header class="sw-app sm-app">
        <a class="sw-volta" href="pacote-smart" title="Voltar ao Pacote Smart"><Icone Nome="esquerda" Tamanho="18" /></a>
        <span class="sw-logo sm-logo"><Icone Nome="grade-planilha" Tamanho="20" /></span>
        <div class="sw-nome">
            <input value="@_nome" @onchange="MudarNome" title="Nome do arquivo" spellcheck="false" />
            <small>@(_sujo ? (_rascunhoOk ? "alterações guardadas neste navegador · salve para gerar o .xlsx" : "alterações não salvas") : _status)</small>
        </div>
        <span class="mola"></span>
        <button class="sw-bt" @onclick="Nova" title="Planilha em branco"><Icone Nome="mais" Tamanho="16" /> Nova</button>
        <label class="sw-bt" title="Abrir uma planilha do Excel (.xlsx) ou um .csv do seu computador">
            <Icone Nome="upload" Tamanho="16" /> Abrir
            <InputFile OnChange="Abrir" accept=".xlsx,.xlsm,.csv" @key="_chaveArq" />
        </label>
        <button class="sw-bt @(_painelGraf ? "on" : "")" @onclick="() => _painelGraf = !_painelGraf" title="Gráficos desta aba"><Icone Nome="evolucao" Tamanho="16" /> Gráficos @(F.Graficos.Count > 0 ? $"({F.Graficos.Count})" : "")</button>
        <button class="sw-bt pri" @onclick="Salvar" disabled="@_salvando" title="Baixar como arquivo do Excel (Ctrl+S)"><Icone Nome="download" Tamanho="16" /> @(_salvando ? "Gerando…" : "Salvar .xlsx")</button>
    </header>

    @if (_recuperar != null)
    {
        <div class="sw-aviso">
            <Icone Nome="info" Tamanho="16" />
            <span>Você tem uma planilha que não foi salva: <b>@_recuperar.Value.nome</b>, editada @_recuperar.Value.quando.</span>
            <button class="btn btn-pri btn-peq" @onclick="Recuperar">Recuperar</button>
            <button class="btn btn-sec btn-peq" @onclick="Descartar">Descartar</button>
        </div>
    }

    @* ---------- faixa de ferramentas ---------- *@
    <div class="sw-faixa sm-faixa">
        <button @onclick="Desfazer" title="Desfazer (Ctrl+Z)" disabled="@(_desfazer.Count == 0)"><Icone Nome="desfazer" Tamanho="16" /></button>
        <button @onclick="Refazer" title="Refazer (Ctrl+Y)" disabled="@(_refazer.Count == 0)"><Icone Nome="refazer" Tamanho="16" /></button>
        <i></i>
        <button class="tx b @(Ativa?.E.N == true ? "on" : "")" @onclick='() => Estilo("n")' title="Negrito (Ctrl+B)">N</button>
        <button class="tx it @(Ativa?.E.I == true ? "on" : "")" @onclick='() => Estilo("i")' title="Itálico (Ctrl+I)">I</button>
        <button class="tx s @(Ativa?.E.S == true ? "on" : "")" @onclick='() => Estilo("s")' title="Tachado">abc</button>
        <span class="sw-cor" title="Cor da fonte"><Icone Nome="cor-texto" Tamanho="16" />
            <span class="sw-paleta">@foreach (var c in CoresTexto) { <button style="background:@(c == "" ? "transparent" : c)" @onclick="() => Cor(c)"></button> }</span></span>
        <span class="sw-cor" title="Cor de preenchimento"><Icone Nome="balde" Tamanho="16" />
            <span class="sw-paleta">@foreach (var c in CoresFundo) { <button style="background:@(c == "" ? "transparent" : c)" @onclick="() => Fundo(c)"></button> }</span></span>
        <i></i>
        <button class="@(Ativa?.E.Alinh == "esq" ? "on" : "")" @onclick='() => Alinhar("esq")' title="Alinhar à esquerda"><Icone Nome="alinhar-esq" Tamanho="16" /></button>
        <button class="@(Ativa?.E.Alinh == "centro" ? "on" : "")" @onclick='() => Alinhar("centro")' title="Centralizar"><Icone Nome="alinhar-centro" Tamanho="16" /></button>
        <button class="@(Ativa?.E.Alinh == "dir" ? "on" : "")" @onclick='() => Alinhar("dir")' title="Alinhar à direita"><Icone Nome="alinhar-dir" Tamanho="16" /></button>
        <i></i>
        <select class="sw-sel larga" value="@(Ativa?.E.Formato ?? "geral")" @onchange="MudarFormato" title="Formato do número">
            <option value="geral">Geral</option><option value="num">Número</option><option value="int">Inteiro</option><option value="moeda">Moeda (R$)</option>
            <option value="pct">Porcentagem</option><option value="data">Data</option><option value="texto">Texto</option>
        </select>
        <button @onclick="() => Casas(-1)" title="Diminuir casas decimais">,0←</button>
        <button @onclick="() => Casas(1)" title="Aumentar casas decimais">,00→</button>
        <i></i>
        <button @onclick="AutoSoma" title="Soma automática"><b class="sm-sigma">Σ</b></button>
        <button @onclick="() => Ordenar(true)" title="Classificar de A a Z (menor para maior)"><Icone Nome="ordenar-cresc" Tamanho="16" /></button>
        <button @onclick="() => Ordenar(false)" title="Classificar de Z a A (maior para menor)"><Icone Nome="ordenar-decresc" Tamanho="16" /></button>
        <button class="@(F.Filtro != null ? "on" : "")" @onclick="AlternarFiltro" title="Filtro (setas no cabeçalho)"><Icone Nome="filtro" Tamanho="16" /></button>
        <i></i>
        <select class="sw-sel" value="" @onchange="LinhasColunas" @key="@($"lc{_chaveSel}")" title="Inserir ou excluir linhas e colunas">
            <option value="">Linhas/colunas</option>
            <option value="il">Inserir linha acima</option><option value="ic">Inserir coluna à esquerda</option>
            <option value="el">Excluir linha(s)</option><option value="ec">Excluir coluna(s)</option>
        </select>
        <select class="sw-sel" value="" @onchange="NovoGrafico" @key="@($"ng{_chaveSel}")" title="Criar gráfico com as células selecionadas">
            <option value="">+ Gráfico</option><option value="colunas">Colunas</option><option value="barras">Barras</option><option value="linhas">Linhas</option><option value="pizza">Pizza</option>
        </select>
        <button @onclick="LimparFormatos" title="Limpar formatação"><Icone Nome="borracha" Tamanho="16" /></button>
    </div>

    @* ---------- barra de fórmulas ---------- *@
    <div class="sm-fx">
        <input class="sm-nome" value="@NomeSel" @onchange="IrPara" title="Célula ou intervalo selecionado (digite um endereço e Enter para ir)" spellcheck="false" />
        <span class="sm-fx-ic">fx</span>
        <div class="sm-fx-campo">
            <input class="@(_editando && _pelaBarra ? "sm-ed" : "")" value="@(_editando ? _txtVisto : Ativa?.Entrada ?? "")" spellcheck="false"
                   @onfocus="FocoBarra" @oninput="DigitouBarra" placeholder="Digite um valor ou uma fórmula, ex.: =SOMA(A1:A10)" />
            @if (_editando && Sugestoes() is { Count: > 0 } sg)
            {
                <div class="sm-sug">
                    @foreach (var fn in sg) { <button @onmousedown:preventDefault="true" @onclick="() => InserirFuncao(fn)"><b>@fn</b>(</button> }
                </div>
            }
        </div>
        @if (_erroFormula != null) { <span class="sm-fx-erro"><Icone Nome="alerta" Tamanho="14" /> @_erroFormula</span> }
    </div>

    <div class="sm-corpo">
        @* ---------- grade ---------- *@
        <div class="sm-rolar" tabindex="0" @ref="_grade" @onmouseleave="() => { }">
            <table class="sm-grade" style="width:@N(46 + Enumerable.Range(0, _cols).Sum(c => F.Largura(c)))px">
                <colgroup>
                    <col style="width:46px" />
                    @for (int c = 0; c < _cols; c++) { <col data-col="@c" style="width:@N(F.Largura(c))px" /> }
                </colgroup>
                <thead>
                    <tr>
                        <th class="sm-canto" @onclick="SelecionarTudo" title="Selecionar tudo"></th>
                        @for (int c = 0; c < _cols; c++)
                        {
                            var cc = c;
                            <th class="@(cc >= _s.c1 && cc <= _s.c2 ? "sel" : "")" @onmousedown="e => CabecalhoCol(cc, e)">
                                @Ender.Col(cc)
                                @if (F.Filtro is { } fl && cc >= fl.C1 && cc <= fl.C2) { }
                                <span class="sm-rz" data-col="@cc"></span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="_visiveis" ItemSize="25" OverscanCount="12" SpacerElement="tr" Context="r">
                        <tr @key="r">
                            <th class="@(r >= _s.r1 && r <= _s.r2 ? "sel" : "")" @onmousedown="e => CabecalhoLin(r, e)">@(r + 1)</th>
                            @for (int c = 0; c < _cols; c++)
                            {
                                var cc = c;
                                var cel = F.Get(r, c);
                                bool ativa = r == _ar && c == _ac;
                                if (ativa && _editando && !_pelaBarra)
                                {
                                    <td class="sm-c ativa edit" data-k="@($"{r}_{c}")">
                                        <input class="sm-ed" value="@_txtVisto" @oninput="DigitouCelula" spellcheck="false" style="@EstiloEd(cel)" />
                                    </td>
                                }
                                else
                                {
                                    var v = _calc.Valor(F, r, c);
                                    var txt = cel == null && v == null ? "" : FormatoPt.Exibir(v, cel?.E ?? Padrao);
                                    bool filtroAqui = F.Filtro is { } fl2 && r == fl2.Linha && c >= fl2.C1 && c <= fl2.C2;
                                    <td class="@ClasseCel(r, c, v, cel, ativa)" style="@EstiloCel(cel, v)" data-k="@($"{r}_{c}")"
                                        @onmousedown="e => Baixo(r, cc, e)" @onmouseover="e => Sobre(r, cc, e)" @ondblclick="() => Editar(null)" title="@(v is ErroF ? Dica(v) : null)">
                                        @txt
                                        @if (filtroAqui)
                                        {
                                            <button class="sm-filtro-bt @(F.Filtro!.Escondidos.ContainsKey(cc) ? "on" : "")" @onmousedown:stopPropagation="true" @onclick="() => AbrirFiltro(cc)" title="Filtrar e classificar"><Icone Nome="direita" Tamanho="10" /></button>
                                        }
                                    </td>
                                }
                            }
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>

        @* ---------- painel de gráficos ---------- *@
        @if (_painelGraf)
        {
            <aside class="sm-graf">
                <div class="sm-graf-cab">
                    <b>Gráficos · @F.Nome</b>
                    <button class="sn-mais" @onclick="() => _painelGraf = false" title="Fechar"><Icone Nome="x" Tamanho="16" /></button>
                </div>
                @if (F.Graficos.Count == 0)
                {
                    <div class="sm-graf-vazio">
                        <span class="vazio-ic"><Icone Nome="evolucao" Tamanho="28" /></span>
                        <p>Selecione uma tabela (títulos na primeira linha, nomes na primeira coluna e números ao lado) e escolha <b>+ Gráfico</b> na barra.</p>
                    </div>
                }
                @foreach (var g in F.Graficos)
                {
                    var gg = g;
                    <div class="sm-graf-card">
                        <div class="sm-graf-lin">
                            <input class="sm-graf-tit" value="@g.Titulo" placeholder="Título do gráfico" @onchange="e => TituloGrafico(gg, e)" />
                            <button class="sn-mais" title="Excluir gráfico" @onclick="() => ExcluirGrafico(gg)"><Icone Nome="lixo" Tamanho="15" /></button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(g.Titulo)) { <div class="sm-graf-h">@g.Titulo</div> }
                        <GraficoSvg D="@XlsxPasta.Dados(_calc, F, g.Faixa)" Tipo="@g.Tipo" />
                        <div class="sm-graf-lin">
                            <select class="sw-sel" value="@g.Tipo" @onchange="e => TipoGrafico(gg, e)">
                                <option value="colunas">Colunas</option><option value="barras">Barras</option><option value="linhas">Linhas</option><option value="pizza">Pizza</option>
                            </select>
                            <input class="sm-graf-faixa" value="@g.Faixa" title="Intervalo de dados (ex.: A1:C10)" @onchange="e => MudarFaixa(gg, e)" />
                            <button class="btn btn-sec btn-peq" @onclick="() => UsarSelecao(gg)" title="Usar as células selecionadas">Usar seleção</button>
                        </div>
                    </div>
                }
            </aside>
        }
    </div>

    @* ---------- abas e status ---------- *@
    <footer class="sm-pe">
        <div class="sm-abas">
            @for (int i = 0; i < _p.Folhas.Count; i++)
            {
                var ii = i;
                <button class="@(i == _fi ? "on" : "")" @onclick="() => TrocarFolha(ii)" @ondblclick="() => RenomearFolha(ii)" title="Clique duas vezes para renomear">
                    @_p.Folhas[i].Nome
                    @if (i == _fi) { <span class="sm-aba-menu" @onclick:stopPropagation="true" @onclick="() => MenuFolha(ii)" title="Opções da aba">⋯</span> }
                </button>
            }
            <button class="sm-aba-mais" @onclick="NovaFolha" title="Nova aba"><Icone Nome="mais" Tamanho="14" /></button>
        </div>
        <span class="mola"></span>
        @{ var (soma, media, cont, nums) = Resumo(); }
        @if (cont > 1)
        {
            @if (nums > 0) { <span>Média: <b>@FormatoPt.Geral(Math.Round(media, 6))</b></span> }
            <span>Contagem: <b>@cont</b></span>
            @if (nums > 0) { <span>Soma: <b>@FormatoPt.Geral(Math.Round(soma, 6))</b></span> }
        }
    </footer>

    @* ---------- filtro ---------- *@
    @if (_filtroCol is int fc && F.Filtro is { } flt)
    {
        <div class="sn-comp-fundo" @onclick="() => _filtroCol = null"></div>
        <div class="sm-filtro">
            <b>Coluna @Ender.Col(fc)@(Cab(fc) is { Length: > 0 } nomeCab ? $" · {nomeCab}" : "")</b>
            <div class="sm-filtro-ord">
                <button class="btn btn-sec btn-peq" @onclick="() => OrdenarColFiltro(fc, true)"><Icone Nome="ordenar-cresc" Tamanho="14" /> A → Z</button>
                <button class="btn btn-sec btn-peq" @onclick="() => OrdenarColFiltro(fc, false)"><Icone Nome="ordenar-decresc" Tamanho="14" /> Z → A</button>
            </div>
            <input class="campo" placeholder="Buscar valor…" @bind="_filtroBusca" @bind:event="oninput" />
            <label class="sm-filtro-todos"><input type="checkbox" checked="@(_filtroMarc.Count == _filtroVals.Count)" @onchange="e => MarcarTodos(e.Value is true)" /> (Selecionar tudo)</label>
            <div class="sm-filtro-lista">
                @foreach (var v in _filtroVals.Where(v => _filtroBusca == "" || v.Contains(_filtroBusca, StringComparison.CurrentCultureIgnoreCase)))
                {
                    var vv = v;
                    <label><input type="checkbox" checked="@_filtroMarc.Contains(vv)" @onchange="e => { if (e.Value is true) _filtroMarc.Add(vv); else _filtroMarc.Remove(vv); }" /> @(vv == "" ? "(Vazias)" : vv)</label>
                }
            </div>
            <div class="sm-filtro-pe">
                <button class="btn btn-sec btn-peq" @onclick="() => _filtroCol = null">Cancelar</button>
                <button class="btn btn-pri btn-peq" @onclick="AplicarFiltro">Aplicar</button>
            </div>
        </div>
    }
</div>

@code {
    protected override string Chave => "smartmath";
    const string Rascunho = "qsmart_sm_rascunho";
    static readonly EstiloCel Padrao = new();
    static readonly string[] CoresTexto = { "", "#000000", "#595959", "#C00000", "#FF0000", "#ED7D31", "#00B050", "#0070C0", "#2563EB", "#7030A0", "#DB2777", "#FFFFFF" };
    static readonly string[] CoresFundo = { "", "#FFFF00", "#FFF2CC", "#FCE4D6", "#E2EFDA", "#DDEBF7", "#EDE9FE", "#F2F2F2", "#BFBFBF", "#FFC7CE", "#C6EFCE", "#1F2937" };

    Pasta _p = new();
    int _fi;
    Folha F => _p.Folhas[Math.Min(_fi, _p.Folhas.Count - 1)];
    Formula.Calc _calc = null!;
    ElementReference _grade;
    DotNetObjectReference<SmartMathPag>? _ref;

    // seleção
    int _ar, _ac, _anR, _anC;
    (int r1, int c1, int r2, int c2) _s;
    bool _arrastando, _montado;
    // edição
    bool _editando, _pelaBarra;
    string _txt = "";
    // o que foi mandado para a tela; só muda quando o próprio Smart Math mexe no texto (o que o usuário digita fica no navegador,
    // senão a ida e volta ao servidor apagaria letras digitadas rápido)
    string _txtVisto = "";
    string? _erroFormula;
    (int r, int c, int pos, int len)? _refInserida;   // referência colocada na fórmula com clique
    // visual
    int _linhas = 80, _cols = 26, _chaveArq, _chaveSel;
    List<int> _visiveis = new();
    bool _painelGraf;
    // arquivo
    string _nome = "Planilha sem título", _status = "planilha nova";
    bool _sujo, _rascunhoOk, _salvando;
    (string nome, string json, string quando)? _recuperar;
    // desfazer
    readonly List<(int fi, Folha f)> _desfazer = new(), _refazer = new();
    // área de transferência interna (com fórmulas)
    (string tsv, int r1, int c1, List<(int dr, int dc, Celula cel)> cels, bool recortar, Folha origem)? _clip;
    // filtro
    int? _filtroCol;
    List<string> _filtroVals = new();
    HashSet<string> _filtroMarc = new();
    string _filtroBusca = "";

    Celula? Ativa => F.Get(_ar, _ac);
    string NomeSel => _s.r1 == _s.r2 && _s.c1 == _s.c2 ? Ender.Cel(_ar, _ac) : Ender.Faixa(_s.r1, _s.c1, _s.r2, _s.c2);
    static string N(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        _ref = DotNetObjectReference.Create(this);
        _calc = new Formula.Calc(_p);
        Selecionar(0, 0, false);
        Recontar();
        try
        {
            var r = await E.Nav.LsGet(Rascunho);
            if (!string.IsNullOrEmpty(r))
            {
                var j = System.Text.Json.Nodes.JsonNode.Parse(r);
                var json = j?["pasta"]?.GetValue<string>() ?? "";
                if (json.Contains("\"cel\":[[") || json.Contains("\"graf\":[{"))
                {
                    var em = DateTime.TryParse(j?["em"]?.GetValue<string>(), null, System.Globalization.DateTimeStyles.RoundtripKind, out var d) ? d.ToLocalTime() : DateTime.Now;
                    _recuperar = (j?["nome"]?.GetValue<string>() ?? "Planilha", json, em.Date == DateTime.Today ? $"hoje às {em:HH:mm}" : em.ToString("dd/MM 'às' HH:mm"));
                }
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (primeira) { await E.Nav.GradeMontar(_grade, _ref!); _montado = true; await E.Nav.GradeFocar(_grade); }
    }

    // ====================================================== util
    void Recontar()
    {
        _linhas = Math.Max(80, Math.Max(F.UltLinha, _s.r2) + 40);
        _cols = Math.Max(26, Math.Max(F.UltColuna, _s.c2) + 4);
        var esc = Escondidas();
        _visiveis = Enumerable.Range(0, _linhas).Where(r => !esc.Contains(r)).ToList();
    }

    HashSet<int> Escondidas()
    {
        var h = new HashSet<int>();
        if (F.Filtro is not { } fl || fl.Escondidos.Count == 0) return h;
        int ult = F.UltLinha;
        for (int r = fl.Linha + 1; r <= ult; r++)
            foreach (var (c, vals) in fl.Escondidos)
                if (vals.Contains(Texto(r, c))) { h.Add(r); break; }
        return h;
    }

    string Texto(int r, int c) { var cel = F.Get(r, c); var v = _calc.Valor(F, r, c); return cel == null && v == null ? "" : FormatoPt.Exibir(v, cel?.E ?? Padrao); }
    string Cab(int c) => F.Filtro is { } fl ? Texto(fl.Linha, c) : "";

    void Mudou()
    {
        _calc.Limpar();
        Recontar();
        if (!_sujo) _sujo = true;
        _ = GuardarRascunho();
    }

    System.Threading.CancellationTokenSource? _cts;
    async Task GuardarRascunho()
    {
        _cts?.Cancel(); var cts = _cts = new();
        try { await Task.Delay(900, cts.Token); } catch { return; }
        var j = new System.Text.Json.Nodes.JsonObject { ["nome"] = _nome, ["em"] = DateTime.UtcNow.ToString("o"), ["pasta"] = XlsxPasta.ParaJson(_p) };
        _rascunhoOk = await E.Nav.LsSet(Rascunho, j.ToJsonString());
        StateHasChanged();
    }

    void Guardar()
    {
        _desfazer.Add((_fi, F.Clonar()));
        if (_desfazer.Count > 60) _desfazer.RemoveAt(0);
        _refazer.Clear();
    }

    [JSInvokable] public void Desfazer()
    {
        if (_desfazer.Count == 0) return;
        var (fi, f) = _desfazer[^1]; _desfazer.RemoveAt(_desfazer.Count - 1);
        if (fi >= _p.Folhas.Count) return;
        _refazer.Add((fi, _p.Folhas[fi].Clonar()));
        _p.Folhas[fi] = f; _fi = fi;
        Mudou(); StateHasChanged();
    }

    [JSInvokable] public void Refazer()
    {
        if (_refazer.Count == 0) return;
        var (fi, f) = _refazer[^1]; _refazer.RemoveAt(_refazer.Count - 1);
        if (fi >= _p.Folhas.Count) return;
        _desfazer.Add((fi, _p.Folhas[fi].Clonar()));
        _p.Folhas[fi] = f; _fi = fi;
        Mudou(); StateHasChanged();
    }

    // ====================================================== seleção
    void Selecionar(int r, int c, bool estender)
    {
        r = Math.Max(0, r); c = Math.Max(0, Math.Min(16383, c));
        _ar = r; _ac = c;
        if (!estender) { _anR = r; _anC = c; }
        _s = (Math.Min(_anR, r), Math.Min(_anC, c), Math.Max(_anR, r), Math.Max(_anC, c));
        if (r >= _linhas - 5 || c >= _cols - 2) Recontar();
    }

    void Baixo(int r, int c, MouseEventArgs e)
    {
        if (e.Button != 0) return;
        if (_editando && _txt.StartsWith("=") && PodeInserirRef())
        {
            InserirRef(r, c, r, c);
            _arrastando = true; _anR = r; _anC = c;
            return;
        }
        if (_editando) Confirmar();
        if (_editando) return;
        Selecionar(r, c, e.ShiftKey);
        _arrastando = true;
        _ = E.Nav.GradeFocar(_grade);
    }

    void Sobre(int r, int c, MouseEventArgs e)
    {
        if (!_arrastando) return;
        if (e.Buttons == 0) { _arrastando = false; return; }
