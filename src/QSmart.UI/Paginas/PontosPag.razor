@page "/pontos"
@inherits PaginaBase
@using QSmart.Core.Coordenacao

@{ Calcular(); var r = E.PtsRes; var lim = E.PtsLimite; }
<Pagina Titulo="Pontos de ação mensal" Grupo="@A.Grupo" Sub="@E.SubPts">
    <Acoes>
        <button class="btn btn-hero" disabled="@(r == null || E.Carregando)" @onclick="Exportar"><Icone Nome="download" Tamanho="17" /> Exportar Excel</button>
        <BotaoArquivo Texto="@(r == null ? "Anexar compilado do mês" : "Trocar compilado")" Variante="pri" Icone="upload" Aceita=".xlsx,.xlsm,.csv" Varios="true"
                      Desativado="E.Carregando" AoEscolher="Abrir" Dica="O compilado mensal (ou vários diários do mesmo mês)" />
    </Acoes>
    <Kpis>
        <Kpi Titulo="Usuários analisados" Cor="blue" Valor="@(r != null ? Fmt(_todos.Count) : "—")"
             Detalhe="@(r == null ? "" : r.Dias.Count == 0 ? "sem datas" : $"{Texto.Dm(r.Dias[0])} a {Texto.Dm(r.Dias[^1])} · {Ferias.Plural(r.Dias.Count, "dia")} com registros")" />
        <Kpi Titulo="@($"Abaixo de {Texto.G(lim)} por dia")" Cor="red" Valor="@(r != null ? Fmt(_abaixo.Count) : "—")"
             Detalhe="@(r == null ? "" : _todos.Count == 0 ? "" : $"{Texto.F(_abaixo.Count * 100.0 / _todos.Count)}% dos usuários")"
             Proporcao="@(r != null && _todos.Count > 0 ? _abaixo.Count / (double)_todos.Count : null)" />
        <Kpi Titulo="Média de quem está abaixo" Cor="amber" Valor="@(r != null && _abaixo.Count > 0 ? Fv(_abaixo.Average(u => u.Media)) : "—")"
             Detalhe="@(r != null && _abaixo.Count > 0 ? $"{Texto.F(_abaixo.Average(u => u.Media) / lim * 100, 0)}% da meta · faltam {Fv(lim - _abaixo.Average(u => u.Media))} por dia" : "")"
             Proporcao="@(r != null && _abaixo.Count > 0 ? _abaixo.Average(u => u.Media) / lim : null)" />
        <Kpi Titulo="Média geral" Cor="green" Valor="@(r != null && _todos.Count > 0 ? Fv(_todos.Average(u => u.Media)) : "—")"
             Detalhe="@(r != null ? $"{Fmt(r.Acoes)} ações no período" : "")"
             Proporcao="@(r != null && _todos.Count > 0 ? _todos.Average(u => u.Media) / lim : null)" />
        @{ var pend = _abaixo.Where(u => Just(u) == null).ToList(); }
        <Kpi Titulo="Sem justificativa" Cor="purple" Valor="@(r != null ? Fmt(pend.Count) : "—")"
             Detalhe="@(r == null ? "" : _abaixo.Count == 0 ? "" : pend.Count == 0 ? "todos justificados" : $"menor média: {pend.MinBy(u => u.Media)!.Usuario} ({Fv(pend.Min(u => u.Media))})")"
             Proporcao="@(r != null && _abaixo.Count > 0 ? (_abaixo.Count - pend.Count) / (double)_abaixo.Count : null)" />
    </Kpis>
    <ChildContent>
        <div class="barra-ferr">
            <span class="rotulo">Meta</span>
            <input class="campo num" type="number" min="1" step="1" value="@Texto.G(lim)" @onchange="MudarLimite" title="Média de ações por dia" />
            <span class="muted">ações por dia</span>
            <span class="rotulo" style="margin-left:10px">Média por</span>
            <div class="segmentado">
                <button class="seg @(E.PtsPorDiaTrabalhado ? "on" : "")" @onclick="() => MudarDivisor(true)" title="Total de ações ÷ dias em que o usuário teve ações (folgas e férias não puxam a média para baixo)">Dia trabalhado</button>
                <button class="seg @(!E.PtsPorDiaTrabalhado ? "on" : "")" @onclick="() => MudarDivisor(false)" title="Total de ações ÷ todos os dias com registros no compilado">Todos os dias do mês</button>
            </div>
            <span class="rotulo" style="margin-left:10px">Ignorar quem trabalhou menos de</span>
            <input class="campo num" type="number" min="1" max="31" value="@E.PtsMinDias" @onchange="MudarMinDias" title="Tira da conta quem apareceu poucos dias no mês (ex.: gestores ou quem entrou no fim do mês)" />
            <span class="muted">dia(s)</span>
            <span class="mola"></span>
            <div class="campo-busca"><Icone Nome="busca" Tamanho="16" /><input class="campo" placeholder="Procurar usuário" @bind="_busca" @bind:event="oninput" /></div>
        </div>

        @if (r == null)
        {
            <div class="vazio-grande">
                <span class="vazio-ic"><Icone Nome="pontos" Tamanho="34" /></span>
                <h3>Anexe o compilado do mês</h3>
                <p class="muted">Pode ser o compilado mensal ou vários compilados diários. Cada linha conta como uma ação do usuário; a média é o total de ações
                    dividido pelos dias trabalhados. O painel mostra só quem fica abaixo de @Texto.G(lim) ações por dia.</p>
                <BotaoArquivo Texto="Anexar compilado do mês" Variante="pri" Icone="upload" Aceita=".xlsx,.xlsm,.csv" Varios="true" Desativado="E.Carregando" AoEscolher="Abrir" />
            </div>
        }
        else if (_abaixo.Count == 0)
        {
            <div class="vazio-grande">
                <span class="vazio-ic ok"><Icone Nome="check" Tamanho="34" /></span>
                <h3>Ninguém abaixo de @Texto.G(lim) ações por dia</h3>
                <p class="muted">Todos os @Fmt(_todos.Count) usuários analisados ficaram na meta ou acima@(_busca != "" ? " (com a busca atual)" : "").</p>
            </div>
        }
        else
        {
            var cont = Enumerable.Range(0, 4).Select(f => _abaixo.Count(u => FaixaDe(u) == f)).ToArray();
            string[] nomesF = { "Crítico", "Atenção", "Perto da meta", "Justificado" };
            <div class="pts-dist">
                <div class="pts-dist-cab">
                    <span class="rotulo">Quem está abaixo da meta, por faixa</span>
                    <span class="muted">@Fmt(_abaixo.Count) usuário(s)@(cont[3] > 0 ? $" · {cont[3]} justificado(s)" : "")</span>
                </div>
                <div class="pts-dist-barra">
                    @for (int f = 0; f < 4; f++)
                    {
                        if (cont[f] == 0) continue;
                        <span class="f@(f)" style="flex:@cont[f]" title="@($"{nomesF[f]}: {cont[f]} usuário(s)")">@(cont[f] * 100 / Math.Max(1, _abaixo.Count) >= 6 ? $"{Texto.F(cont[f] * 100.0 / _abaixo.Count, 0)}%" : "")</span>
                    }
                </div>
                <div class="pts-dist-leg">
                    @for (int f = 0; f < 4; f++)
                    {
                        var ff = f;
                        <button class="pts-dist-item f@(f) @(_filtroFaixa == f ? "on" : "")" @onclick="() => _filtroFaixa = _filtroFaixa == ff ? -1 : ff" title="Mostrar só esta faixa (clique de novo para mostrar todas)">
                            <i></i>
                            <b>@cont[f]</b>
                            <span>@nomesF[f]</span>
                            <span class="muted">@(f == 0 ? $"menos de {Texto.G(lim * .5)} por dia" : f == 1 ? $"{Texto.G(lim * .5)} a {Texto.G(lim * .8)}" : f == 2 ? $"{Texto.G(lim * .8)} a {Texto.G(lim)}" : "fora das faixas")</span>
                        </button>
                    }
                </div>
            </div>

            <div class="grade-32">
                <Painel Titulo="@($"Abaixo de {Texto.G(lim)} — média de ações por dia")" Nota="a linha marca a meta">
                    <div class="pts-barras">
                        @foreach (var u in _lista)
                        {
                            var f = FaixaDe(u); var j = Just(u);
                            <div class="pts-linha @(j != null ? "justificado" : "")" title="@($"{u.Usuario}: {Fv(u.Media)} por dia ({Texto.F(u.Media / lim * 100)}% da meta) · {Fmt(u.Total)} ações em {Ferias.Plural(u.DiasTrabalhados, "dia")}" + (j != null ? $"\nJustificado: {j}" : ""))">
                                <span class="pts-nome">@u.Usuario@if (j != null) { <span class="pts-just">@j</span> }</span>
                                <span class="pts-trilho">
                                    <span class="pts-barra f@(f)" style="width:@P(u.Media / lim)"></span>
                                    <span class="pts-meta"></span>
                                </span>
                                <span class="pts-val">@Fv(u.Media)</span>
                                <span class="pts-pct">@(Texto.F(u.Media / lim * 100, 0))%</span>
                            </div>
                        }
                    </div>
                </Painel>
                <Painel Titulo="Ações por dia" Nota="só quem está abaixo da meta">
                    <div class="pts-mapa">
                        <table>
                            <thead>
                                <tr><th></th>@foreach (var d in r.Dias) { <th title="@($"{Texto.DiaSemana(d)}, {Texto.Dmy(d)}")">@d.Day</th> }</tr>
                            </thead>
                            <tbody>
                                @foreach (var u in _lista)
                                {
                                    <tr class="@(Just(u) != null ? "justificado" : "")">
                                        <td class="pts-mapa-nome" title="@(u.Usuario + (Just(u) is string jj ? $" · {jj}" : ""))">@u.Usuario</td>
                                        @foreach (var d in r.Dias)
                                        {
                                            var n = u.PorDia.GetValueOrDefault(d);
                                            <td style="@CorDia(n, lim)" title="@($"{u.Usuario} · {Texto.DiaSemana(d)} {Texto.Dmy(d)}: {(n == 0 ? "sem ações" : Fmt(n) + " ações")}")">@(n == 0 ? "" : n.ToString())</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pts-mapa-leg"><span><i style="background:color-mix(in srgb, var(--red) 70%, transparent)"></i>bem abaixo</span><span><i style="background:color-mix(in srgb, var(--amber) 55%, transparent)"></i>abaixo</span><span><i style="background:color-mix(in srgb, var(--green) 45%, transparent)"></i>meta no dia</span><span><i class="vazio"></i>sem ações</span></div>
                </Painel>
            </div>

            <Painel Titulo="Detalhe e justificativas" Sangrar="true">
                <Extra>
                    <div class="segmentado">
                        <button class="seg @(_filtroJust == "" ? "on" : "")" @onclick="@(() => _filtroJust = "")">Todos (@_abaixo.Count)</button>
                        <button class="seg @(_filtroJust == "pend" ? "on" : "")" @onclick="@(() => _filtroJust = "pend")">Sem justificativa (@(_abaixo.Count - cont[3]))</button>
                        <button class="seg @(_filtroJust == "just" ? "on" : "")" @onclick="@(() => _filtroJust = "just")">Justificados (@cont[3])</button>
                    </div>
                </Extra>
                <ChildContent>
                    <div class="tabela-rolagem" style="max-height:560px">
                        <table class="tabela pts-tabela">
                            <colgroup><col style="width:19%" /><col style="width:8%" /><col style="width:8%" /><col style="width:11%" /><col style="width:19%" /><col style="width:8%" /><col style="width:9%" /><col style="width:6%" /><col style="width:12%" /></colgroup>
                            <thead><tr><th>Usuário</th><th class="al-c">Média/dia</th><th class="al-c">% da meta</th><th>Faixa</th><th>Justificativa</th><th class="al-c">Faltam/dia</th><th class="al-c">Ações</th><th class="al-c">Dias</th><th class="al-c">Menor / maior dia</th></tr></thead>
                            <tbody>
                                @foreach (var u in _tabela)
                                {
                                    var f = FaixaDe(u); var j = Just(u);
                                    <tr class="@(j != null ? "justificado" : "")" @key="u.Usuario">
                                        <td><b>@u.Usuario</b></td>
                                        <td class="al-c"><b class="pts-cor f@(f)">@Fv(u.Media)</b></td>
                                        <td class="al-c">@(Texto.F(u.Media / lim * 100))%</td>
                                        <td><span class="etq pts-etq f@(f)">@nomesF[f]</span></td>
                                        <td>
                                            <select class="campo-linha pts-sel @(j != null ? "on" : "")" value="@(j ?? "")" @onchange="e => Justificar(u, e.Value?.ToString())" title="Justificativa do mês @MesTexto">
                                                <option value="">— sem justificativa —</option>
                                                @foreach (var op in PontosAcao.Justificativas) { <option value="@op">@op</option> }
                                            </select>
                                        </td>
                                        <td class="al-c">@Fv(lim - u.Media)</td>
                                        <td class="al-c">@Fmt(u.Total)</td>
                                        <td class="al-c">@u.DiasTrabalhados</td>
                                        <td class="al-c" title="@DicaDias(u)">@Fmt(u.MenorDia) / @Fmt(u.MaiorDia)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_tabela.Count == 0) { <div class="tabela-vazia">Ninguém nesse filtro.</div> }
                    </div>
                </ChildContent>
            </Painel>
            <p class="muted pequeno">A justificativa vale para o mês do compilado (@MesTexto) e fica salva neste navegador. Justificado, o usuário sai de Crítico, Atenção e Perto da meta. Clique numa faixa acima para filtrar.</p>
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "pontos";
    string _busca = "";
    List<LinhaPontos> _todos = new(), _abaixo = new(), _lista = new(), _tabela = new();
    int _filtroFaixa = -1;
    string _filtroJust = "";

    string Mes => E.PtsRes == null ? "" : PontosAcao.Mes(E.PtsRes);
    string MesTexto => Mes == "" ? "—" : Texto.NomeMes(Mes);

    string? Just(LinhaPontos u)
        => E.PtsJust.TryGetValue(Mes, out var d) && d.TryGetValue(PontosAcao.ChaveUsuario(u.Usuario), out var j) ? j : null;

    static string DicaDias(LinhaPontos u)
        => (u.DataMenor is DateOnly a ? $"Menor: {Texto.Fmt(u.MenorDia)} em {Texto.Dmy(a)}" : "") +
           (u.DataMaior is DateOnly c ? $" · Maior: {Texto.Fmt(u.MaiorDia)} em {Texto.Dmy(c)}" : "");

    int FaixaDe(LinhaPontos u) => PontosAcao.Faixa(u.Media, E.PtsLimite, Just(u));

    async Task Justificar(LinhaPontos u, string? valor)
    {
        if (Mes == "") return;
        if (!E.PtsJust.TryGetValue(Mes, out var d)) E.PtsJust[Mes] = d = new();
        var k = PontosAcao.ChaveUsuario(u.Usuario);
        if (string.IsNullOrEmpty(valor) || !PontosAcao.Justificativas.Contains(valor)) d.Remove(k);   // só aceita as opções da lista
        else d[k] = valor;
        await E.SalvarPtsJust();
    }

    static string P(double x) => (Math.Clamp(x, 0.005, 1) * 100).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    static string CorDia(long n, double lim)
    {
        if (n == 0) return "";
        var x = n / lim;
        var (cor, forca) = x < .5 ? ("var(--red)", 30 + (int)(40 * (1 - x / .5))) : x < 1 ? ("var(--amber)", 25 + (int)(30 * (1 - (x - .5) / .5))) : ("var(--green)", 35);
        return $"background:color-mix(in srgb, {cor} {forca}%, transparent)";
    }

    void Calcular()
    {
        var r = E.PtsRes;
        if (r == null) { _todos = new(); _abaixo = new(); _lista = new(); _tabela = new(); return; }
        var b = Texto.NormalizarBusca(_busca);
        _todos = r.Usuarios.Where(u => u.DiasTrabalhados >= E.PtsMinDias).ToList();
        _abaixo = _todos.Where(u => u.Media < E.PtsLimite).OrderBy(u => u.Media).ThenBy(u => u.Usuario, StringComparer.Ordinal)
            .Where(u => b == "" || Texto.NormalizarBusca(u.Usuario).Contains(b)).ToList();
        // pendentes primeiro (do menor para o maior), justificados no fim
        var ordem = _abaixo.OrderBy(u => Just(u) != null ? 1 : 0).ThenBy(u => u.Media).ToList();
        _lista = ordem.Where(u => _filtroFaixa < 0 || FaixaDe(u) == _filtroFaixa).ToList();
        _tabela = _lista.Where(u => _filtroJust == "" || (_filtroJust == "just") == (Just(u) != null)).ToList();
    }

    void Recalcular()
    {
        if (E.PtsBase == null) return;
        E.PtsRes = PontosAcao.Calcular(E.PtsBase, E.PtsPorDiaTrabalhado);

    }

    async Task Abrir(List<Arquivo> arqs)
    {
        await E.Executar(prog => Compilados.Preparar(arqs, prog),
            async b =>
            {
                E.PtsBase = b;
                E.PtsArquivos = arqs.Count == 1 ? arqs[0].Nome : $"{arqs.Count} compilados";
                Recalcular();
                var r = E.PtsRes!;
                E.SubPts = $"{E.PtsArquivos} · {Fmt(r.Acoes)} ações de {Fmt(r.Usuarios.Count)} usuários" +
                           (r.Dias.Count > 0 ? $" · {Texto.Dmy(r.Dias[0])} a {Texto.Dmy(r.Dias[^1])}" : "") +
                           (r.SemData > 0 ? $" · {Fmt(r.SemData)} linha(s) sem data ficaram fora" : "");
                if (r.Dias.Count == 1)
                    await J.Aviso("Pontos de ação mensal", $"Esse compilado tem só um dia ({Texto.Dmy(r.Dias[0])}). A média vale para esse dia; para o mês, anexe o compilado mensal ou todos os diários do mês.");
            },
            async ex => { await J.Erro("Erro ao ler o compilado", Estado.Mensagem(ex)); },
            (s, msg) => E.SubPts = $"Lendo {arqs.Count} arquivo(s)… {msg} {s}s");
    }

    void MudarLimite(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString()?.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) && v > 0) E.PtsLimite = v;

    }

    void MudarMinDias(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n)) E.PtsMinDias = Math.Clamp(n, 1, 31);

    }

    void MudarDivisor(bool porDiaTrabalhado)
    {
        E.PtsPorDiaTrabalhado = porDiaTrabalhado;
        Recalcular();
    }

    async Task Exportar()
    {
        if (E.PtsRes == null) return;
        var r = E.PtsRes;
        var filtrado = new ResultadoPontos
        {
            Usuarios = r.Usuarios.Where(u => u.DiasTrabalhados >= E.PtsMinDias).ToList(), Dias = r.Dias, Acoes = r.Acoes,
            SemData = r.SemData, SemUsuario = r.SemUsuario, PorDiaTrabalhado = r.PorDiaTrabalhado, Arquivos = r.Arquivos,
        };
        var mes = r.Dias.Count > 0 ? r.Dias[^1].ToString("yyyy-MM", CultureInfo.InvariantCulture) : Estado.Agora("yyyy-MM");
        await E.Salvar($"Pontos_de_acao_{mes}.xlsx", PontosAcao.Exportar(filtrado, E.PtsLimite, E.PtsJust.GetValueOrDefault(PontosAcao.Mes(r))), Navegador.MimeXlsx);
    }
}
