@page "/servicos-3069"
@inherits PaginaBase
@using QSmart.Core.Relacionamento
@implements IDisposable

<Pagina Titulo="Serviços 3069" Grupo="@A.Grupo">
    <Acoes>
        <button class="btn btn-hero" @onclick="Exemplo" title="Carrega uma pergunta e uma resposta de exemplo"><Icone Nome="faisca" Tamanho="17" /> Exemplo</button>
        <button class="btn btn-hero" @onclick="Limpar" disabled="@(_pergunta == "" && _resposta == "")"><Icone Nome="lixo" Tamanho="17" /> Limpar</button>
        <button class="btn btn-pri" @onclick="Copiar" disabled="@(_resposta.Trim() == "")" title="Copia a resposta para colar no Teams"><Icone Nome="copiar" Tamanho="17" /> Copiar resposta</button>
    </Acoes>
    <ChildContent>
        @if (_carregado && _chave == null)
        {
            <div class="ia-bloqueio">
                <span class="ia-logo"><Icone Nome="escudo" Tamanho="22" /></span>
                <div><b>Ferramenta não liberada nesta máquina</b><span>@Estado.MsgSemIA</span></div>
            </div>
        }
        else if (_carregado)
        {
        <div class="rr-entrada">
            <label class="rr-caixa">
                <span class="rr-rot"><span class="rr-num">1</span> Pergunta da 3069 <small>cole a mensagem que chegou pelo Teams</small></span>
                <textarea class="campo area" rows="10" placeholder="Ex.: Bom dia! Qual o prazo para liberar o limite do associado? É possível aumentar para R$ 50 mil?"
                          value="@_pergunta" @oninput="MudouPergunta"></textarea>
            </label>
            <label class="rr-caixa resp">
                <span class="rr-rot"><span class="rr-num">2</span> Nossa resposta <small>o que vai ser enviado pelo Teams</small></span>
                <textarea class="campo area" rows="10" placeholder="Escreva ou cole a resposta aqui e clique em Analisar com Mr. Smart."
                          value="@_resposta" @oninput="MudouResposta"></textarea>
            </label>
        </div>

        <div class="ia-barra">
            <button class="ia-btn @(_analisando ? "rodando" : "")" @onclick="Analisar" disabled="@(_analisando || _chave == null || _pergunta.Trim() == "" || _resposta.Trim() == "")">
                @if (_analisando) { <span class="ia-spin"></span> <span>Analisando… @_segundos s</span> }
                else { <Icone Nome="faisca" Tamanho="18" /> <span>Analisar com Mr. Smart</span> }
            </button>
            <div class="ia-info">
                @if (_pergunta.Trim() == "" || _resposta.Trim() == "") { <span class="muted">Cole a pergunta e a resposta para analisar.</span> }
                else if (_desatualizada) { <span class="ia-aviso"><Icone Nome="alerta" Tamanho="14" /> A resposta mudou depois da análise. Clique em “Analisar com Mr. Smart”.</span> }
                else if (_res != null) { <span class="muted">Analisado pelo Mr. Smart às @_quando.ToString("HH:mm").</span> }
            </div>
        </div>

        @if (_erro != null)
        {
            <div class="ia-erro"><Icone Nome="alerta" Tamanho="18" /><div><b>Não foi possível analisar</b><span>@_erro</span></div></div>
        }

        @if (_analisando && _res == null)
        {
            <div class="ia-carregando">
                <div class="ia-pulso"></div>
                <div><b>A IA está lendo a pergunta e a resposta…</b><small class="muted">Confere se responde, objetividade, discordância, pontos contestáveis, tom e escrita. Leva alguns segundos.</small></div>
            </div>
        }

        @if (_res != null)
        {
            var a = _res.Analise;
            var vis = a.Achados.Where(x => !_ignorados.Contains(x.Chave)).ToList();
            var filtrados = vis.Where(x => _filtro == null || x.Categoria == _filtro).ToList();
            bool marcar = !_desatualizada;
            var locais = marcar ? filtrados.Where(x => x.Ini >= 0 && x.Fim > x.Ini).OrderBy(x => x.Ini).ThenByDescending(x => x.Grav).ToList() : new();
            var gerais = filtrados.Except(locais).OrderByDescending(x => x.Grav).ToList();
            var num = new Dictionary<string, int>();
            foreach (var x in locais) num.TryAdd(x.Chave, num.Count + 1);

            <div class="rr-hero @a.VereditoClasse @(_desatualizada ? "velho" : "")">
                <div class="rr-nota" style="--p:@a.Nota"><span><b>@a.Nota</b><small>de 100</small></span></div>
                <div class="rr-ver">
                    <span class="rotulo">Resultado da IA</span>
                    <b>@a.Veredito</b>
                    <small>@_res.Resumo</small>
                </div>
                <div class="rr-crit">
                    @foreach (var c in Categorias)
                    {
                        var n = a.NotaPorCategoria.TryGetValue(c, out var v) ? v : 100;
                        int q = vis.Count(x => x.Categoria == c) + (c == Cat.Responde ? a.Perguntas.Count(p => p.Status != StatusPergunta.Atendida) : 0);
                        <button class="rr-cr @c @(_filtro == c ? "on" : "") @(_filtro != null && _filtro != c ? "apaga" : "")" title="Mostrar só @Cat.Nome(c)" @onclick="() => _filtro = _filtro == c ? null : c">
                            <span class="rr-cr-anel" style="--p:@n;--k:@CorNota(n)"><b>@n</b></span>
                            <span class="rr-cr-nome">@Cat.Nome(c)</span>
                            <small>@(q == 0 ? "sem apontamentos" : q == 1 ? "1 apontamento" : $"{q} apontamentos")</small>
                        </button>
                    }
                </div>
            </div>

            @if (a.Perguntas.Count > 0 && (_filtro == null || _filtro == Cat.Responde))
            {
                <div class="rr-pxr">
                    <span class="rr-pxr-tit"><Icone Nome="info" Tamanho="15" /> Pergunta × resposta</span>
                    @foreach (var p in a.Perguntas)
                    {
                        var st = p.Status switch { StatusPergunta.Atendida => "g", StatusPergunta.Parcial => "a", _ => "r" };
                        <div class="rr-pq @st">
                            <span class="rr-pq-ic"><Icone Nome="@(st == "g" ? "check" : st == "a" ? "info" : "x")" Tamanho="14" /></span>
                            <div>
                                <b>“@p.Texto”</b>
                                <small><span class="rr-tipo">@p.Tipo</span>@(p.Status switch { StatusPergunta.Atendida => "Respondida. ", StatusPergunta.Parcial => "Respondida em parte. ", _ => "Não respondida. " })@p.Motivo@(p.Motivo == "" ? "" : ".")</small>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="rr-rev">
                <div class="rr-doc">
                    <div class="rr-doc-cab"><b>Resposta revisada</b><small class="muted">@(marcar ? "clique num destaque para ver o apontamento" : "analise de novo para ver os destaques")</small></div>
                    <div class="rr-doc-txt">@Documento(locais, num)</div>
                    <div class="rr-legenda">
                        @foreach (var c in Categorias) { <span class="rr-lg @c"><i></i>@Cat.Nome(c)</span> }
                    </div>
                </div>
                <div class="rr-mar">
                    @if (_filtro != null) { <div class="rr-filtro">Mostrando só <b>@Cat.Nome(_filtro)</b> <button class="btn btn-sec btn-peq" @onclick="() => _filtro = null">ver todos</button></div> }
                    @if (gerais.Count + locais.Count == 0)
                    {
                        <div class="rr-limpo"><Icone Nome="check" Tamanho="22" /><b>Nenhum apontamento@(_filtro != null ? " neste critério" : "")</b><small class="muted">Faça a conferência final abaixo antes de enviar.</small></div>
                    }
                    @if (locais.Count > 0)
                    {
                        <span class="rr-mar-tit">No texto</span>
                        @foreach (var x in locais) { @Cartao(x, num[x.Chave], marcar) }
                    }
                    @if (gerais.Count > 0)
                    {
                        <span class="rr-mar-tit">Sobre a resposta toda</span>
                        @foreach (var x in gerais) { @Cartao(x, null, false) }
                    }
                    @if (_ignorados.Count > 0) { <button class="rr-ign" @onclick="() => _ignorados.Clear()">@_ignorados.Count ignorado(s) · mostrar de novo</button> }
                </div>
            </div>

            <div class="ia-dupla">
                @if (_res.RespostaSugerida != "")
                {
                    <div class="ia-sug">
                        <div class="ia-sug-cab"><span class="ia-logo peq"><Icone Nome="faisca" Tamanho="15" /></span><b>Resposta sugerida pela IA</b>
                            <span class="mola"></span>
                            <button class="btn btn-sec btn-peq" @onclick="CopiarSugerida"><Icone Nome="copiar" Tamanho="13" /> Copiar</button>
                            <button class="btn btn-pri btn-peq" @onclick="UsarSugerida"><Icone Nome="check" Tamanho="13" /> Usar esta resposta</button>
                        </div>
                        <div class="ia-sug-txt">@Colchetes(_res.RespostaSugerida)</div>
                        @if (_res.RespostaSugerida.Contains('[')) { <small class="ia-aviso"><Icone Nome="alerta" Tamanho="13" /> Complete o que está entre colchetes com a informação real antes de enviar.</small> }
                    </div>
                }
                <div class="ia-reacao">
                    @if (_res.Reacao != "")
                    {
                        <div class="ia-bloco"><span class="ia-bloco-tit">💬 Como a 3069 deve reagir</span><p>@_res.Reacao</p></div>
                    }
                    @if (_res.PontosFortes.Count > 0)
                    {
                        <div class="ia-bloco forte"><span class="ia-bloco-tit">✓ Pontos fortes da resposta</span>
                            <ul>@foreach (var p in _res.PontosFortes) { <li>@p</li> }</ul>
                        </div>
                    }
                </div>
            </div>

            <Painel Titulo="Antes de enviar" Nota="confira você mesmo">
                <div class="rr-check">
                    @foreach (var (k, t) in Checklist)
                    {
                        <label class="oo-chk"><input type="checkbox" checked="@_checados.Contains(k)" @onchange="() => { if (!_checados.Add(k)) _checados.Remove(k); }" /> <span>@t</span></label>
                    }
                </div>
                @if (_checados.Count == Checklist.Length && a.VereditoClasse == "ok" && !_desatualizada) { <p class="rr-pronto"><Icone Nome="check" Tamanho="16" /> Tudo conferido. Pode copiar e enviar.</p> }
            </Painel>
        }
        else if (!_analisando && _erro == null)
        {
            <div class="rr-vazio">
                <div><b>O que a IA confere na resposta, sempre diante da pergunta</b>
                    <ul>
                        <li><b>Responde a pergunta?</b> Separa cada pergunta (inclusive pedidos e cobranças) e diz se foi respondida, em parte ou não.</li>
                        <li><b>Objetividade:</b> se a resposta principal vem logo no começo, sem rodeios.</li>
                        <li><b>Discordância:</b> se discorda da cooperativa de forma seca ou se contradiz (valores, datas e números diferentes da pergunta).</li>
                        <li><b>Pode ser contestado:</b> o que a 3069 pode questionar porque não ficou bem explicado.</li>
                        <li><b>Tom e escrita:</b> formalidade, acolhimento, alternativa para um “não” e português correto.</li>
                        <li><b>Além disso:</b> como a 3069 deve reagir, os pontos fortes e uma resposta reescrita pronta para o Teams.</li>
                    </ul>
                </div>
            </div>
        }
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "servicos3069";
    static readonly string[] Categorias = { Cat.Responde, Cat.Objetividade, Cat.Discordancia, Cat.Contestavel, Cat.Tom, Cat.Escrita };
    static readonly (string, string)[] Checklist =
    {
        ("nomes", "Nomes, cargos e o nome da cooperativa estão escritos certo."),
        ("numeros", "Números, valores, datas, protocolos e propostas conferidos com o sistema."),
        ("anexos", "Se a resposta cita anexo ou link, ele está junto da mensagem."),
        ("prazo", "Se há prazo ou compromisso, a área responsável já confirmou."),
        ("conversa", "É a conversa certa do Teams e a resposta está no fio da pergunta."),
        ("releitura", "Li a resposta inteira como se fosse a 3069 lendo."),
    };

    string _pergunta = "", _resposta = "";
    string? _erro, _filtro, _foco;
    string? _chave => E.IAPronta ? "ok" : null;
    string _modelo => E.ModeloIA;
    bool _carregado, _analisando, _desatualizada;
    int _segundos;
    DateTime _quando;
    ResultadoIA? _res;
    readonly HashSet<string> _checados = new(), _ignorados = new();
    System.Threading.Timer? _relogio;

    protected override async Task OnInitializedAsync()
    {
        await E.IAConfigurada();
        _carregado = true;
    }

    public void Dispose() => _relogio?.Dispose();

    void MudouPergunta(ChangeEventArgs e) { _pergunta = e.Value?.ToString() ?? ""; if (_res != null) _desatualizada = true; }
    void MudouResposta(ChangeEventArgs e) { _resposta = e.Value?.ToString() ?? ""; if (_res != null) _desatualizada = true; }

    static string CorNota(int n) => n >= 85 ? "#10B981" : n >= 60 ? "#F59E0B" : "#EF4444";
    static string Grav(Gravidade g) => g switch { Gravidade.Problema => "r", Gravidade.Atencao => "a", _ => "l" };
    static string IdCartao(string chave) => "rr-c-" + (uint)chave.GetHashCode();

    // ===================== análise =====================

    async Task Analisar()
    {
        if (_chave == null) { await J.Aviso("Contate o suporte", Estado.MsgSemIA); return; }
        _erro = null; _analisando = true; _segundos = 0;
        _relogio?.Dispose();
        _relogio = new System.Threading.Timer(_ => { _segundos++; InvokeAsync(StateHasChanged); }, null, 1000, 1000);
        StateHasChanged();
        try
        {
            var resposta = _resposta;
            var agora = DateTime.Now;
            var mapa = new Dictionary<string, string>();
            var corpo = AnaliseIA.Pedido(_pergunta, resposta, agora, mapa, _modelo);
            var r = await E.ChamarIA(corpo);
            if (AnaliseIA.ErroDeFormato(r.Status, r.Texto))
                r = await E.ChamarIA(AnaliseIA.Pedido(_pergunta, resposta, agora, mapa, _modelo, comEsquema: false));
            if (r.Status != 200) { _erro = AnaliseIA.Erro(r.Status, r.Texto); return; }
            ResultadoIA res;
            try { res = AnaliseIA.Ler(r.Texto, resposta, mapa, _modelo); }
            catch
            {
                // uma segunda tentativa no modo JSON simples
                var r2 = await E.ChamarIA(AnaliseIA.Pedido(_pergunta, resposta, agora, mapa, _modelo, comEsquema: false));
                if (r2.Status != 200) { _erro = AnaliseIA.Erro(r2.Status, r2.Texto); return; }
                res = AnaliseIA.Ler(r2.Texto, resposta, mapa, _modelo);
            }
            _res = res; _quando = agora; _desatualizada = resposta != _resposta;
            _ = E.Conta.Registrar(QSmart.Core.Conta.Conquistas.S3069Analise, true);
            _ignorados.Clear(); _checados.Clear(); _filtro = null; _foco = null;
        }
        catch (Exception ex) { _erro = ex.Message; }
        finally
        {
            _analisando = false;
            _relogio?.Dispose(); _relogio = null;
        }
    }

    async Task Focar(Achado x) { _foco = x.Chave; StateHasChanged(); await Task.Delay(30); await E.Nav.Rolar(IdCartao(x.Chave)); }

    /// <summary>Aplica a troca e reencontra a posição dos outros apontamentos, sem chamar a IA de novo.</summary>
    void AplicarAchado(Achado x)
    {
        if (_res == null || x.Troca == null || x.Ini < 0 || x.Fim > _resposta.Length) return;
        var depois = AnaliseResposta.Aplicar(_resposta, x);
        var a = _res.Analise;
        a.Achados.Remove(x);
        var novos = new List<Achado>();
        var usados = new List<(int, int)>();
        foreach (var y in a.Achados)
        {
            if (y.Ini < 0 || string.IsNullOrEmpty(y.Trecho)) { novos.Add(y); continue; }
            var (i, f) = AnaliseIA.Localizar(depois, y.Trecho, usados);
            if (i >= 0) usados.Add((i, f));
            novos.Add(y with { Ini = i, Fim = i >= 0 ? f : -1 });
        }
        a.Achados.Clear(); a.Achados.AddRange(novos);
        _resposta = depois;
        _foco = null;
    }

    RenderFragment Cartao(Achado x, int? n, bool aplicavel) => @<text>
        <div class="rr-c @x.Categoria @Grav(x.Grav) @(_foco == x.Chave ? "foco" : "")" id="@IdCartao(x.Chave)">
            <div class="rr-c-cab">
                @if (n != null) { <span class="rr-c-num">@n</span> } else { <span class="rr-c-num geral"><Icone Nome="info" Tamanho="12" /></span> }
                <b>@x.Titulo</b>
                <span class="rr-c-cat">@Cat.Nome(x.Categoria)</span>
            </div>
            @if (aplicavel && x.Troca != null && x.Fim > x.Ini && x.Fim <= _resposta.Length)
            {
                <div class="rr-dp"><del>@_resposta[x.Ini..x.Fim]</del> <Icone Nome="direita" Tamanho="13" /> @if (x.Troca.Trim() == "") { <ins class="rem">(retirar)</ins> } else { <ins>@Colchetes(x.Troca.Trim())</ins> }</div>
            }
            else if (!string.IsNullOrEmpty(x.Trecho))
            {
                <div class="rr-dp so"><span class="rr-q">@x.Trecho</span></div>
            }
            <p>@x.Explicacao</p>
            @if (x.Sugestao != null) { <p class="rr-c-sug"><Icone Nome="faisca" Tamanho="13" /> @x.Sugestao</p> }
            <div class="rr-c-acts">
                @if (aplicavel && x.Troca != null) { <button class="btn btn-pri btn-peq" @onclick="() => AplicarAchado(x)"><Icone Nome="check" Tamanho="13" /> Aplicar</button> }
                <button class="btn btn-sec btn-peq" @onclick="() => _ignorados.Add(x.Chave)">Ignorar</button>
            </div>
        </div>
    </text>;

    /// <summary>Destaca o que está entre colchetes (informação para completar).</summary>
    static RenderFragment Colchetes(string s) => b =>
    {
        int seq = 0, pos = 0;
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(s, @"\[[^\]\n]{1,60}\]"))
        {
            if (m.Index > pos) b.AddContent(seq++, s[pos..m.Index]);
            b.OpenElement(seq++, "span"); b.AddAttribute(seq++, "class", "ia-falta"); b.AddContent(seq++, m.Value); b.CloseElement();
            pos = m.Index + m.Length;
        }
        if (pos < s.Length) b.AddContent(seq++, s[pos..]);
    };

    RenderFragment Documento(List<Achado> locais, Dictionary<string, int> num) => b =>
    {
        int seq = 0, pos = 0;
        var texto = _resposta;
        int i = 0;
        while (i < locais.Count)
        {
            var m = locais[i];
            if (m.Ini < pos || m.Fim > texto.Length) { i++; continue; }
            var grupo = locais.Skip(i).TakeWhile(x => x.Ini < m.Fim).ToList();
            if (m.Ini > pos) b.AddContent(seq++, texto[pos..m.Ini]);
            b.OpenElement(seq++, "mark");
            b.AddAttribute(seq++, "class", $"rr-u {m.Categoria} {(grupo.Any(g => g.Chave == _foco) ? "foco" : "")}");
            b.AddAttribute(seq++, "title", m.Titulo);
            b.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Focar(m)));
            b.AddContent(seq++, texto[m.Ini..m.Fim]);
            b.CloseElement();
            foreach (var g in grupo.Where(g => num.ContainsKey(g.Chave)))
            {
                b.OpenElement(seq++, "sup");
                b.AddAttribute(seq++, "class", $"rr-n {g.Categoria}");
                b.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Focar(g)));
                b.AddContent(seq++, num[g.Chave]);
                b.CloseElement();
            }
            pos = Math.Max(m.Fim, grupo.Max(g => Math.Min(g.Fim, texto.Length)));
            i += grupo.Count;
        }
        if (pos < texto.Length) b.AddContent(seq++, texto[pos..]);
    };

    // ===================== ações =====================

    async Task Copiar()
    {
        if (System.Text.RegularExpressions.Regex.IsMatch(_resposta, @"\[[^\]\n]{1,60}\]")
            && !await J.Pergunta("Copiar", "A resposta ainda tem texto entre colchetes para completar. Copiar mesmo assim?")) return;
        if (await E.Nav.Copiar(_resposta)) await J.Info("Copiado", "Resposta copiada. É só colar no Teams.");
        else await J.Aviso("Copiar", "Não consegui copiar automaticamente. Selecione o texto e use Ctrl+C.");
    }

    async Task CopiarSugerida()
    {
        if (_res == null) return;
        if (await E.Nav.Copiar(_res.RespostaSugerida)) await J.Info("Copiado", "Resposta sugerida copiada.");
    }

    void UsarSugerida()
    {
        if (_res == null) return;
        _resposta = _res.RespostaSugerida;
        _desatualizada = true;
    }

    void Limpar() { _pergunta = ""; _resposta = ""; _res = null; _erro = null; _desatualizada = false; _checados.Clear(); _ignorados.Clear(); }

    void Exemplo()
    {
        _pergunta = "Bom dia! Ainda não tivemos retorno sobre a proposta 458812 do associado João Pereira, já pedimos várias vezes. Qual o prazo para liberação do limite? E é possível aumentar o valor para R$ 50 mil?";
        _resposta = "oi pessoal, tudo bem? Então, a gente vai verificar isso em breve com a equipe, mas acho que não é possível aumentar, como já informado anteriormente. Vocês devem enviar a documentação pra gente!! Conforme normativo, o prazo é de 5 dias. Qualquer coisa me chama";
        if (_res != null) _desatualizada = true;
    }
}
