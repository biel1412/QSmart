@page "/servicos-3069"
@inherits PaginaBase
@using QSmart.Core.Relacionamento

<Pagina Titulo="Serviços 3069" Grupo="@A.Grupo">
    <Acoes>
        <button class="btn btn-hero" @onclick="Exemplo" title="Carrega uma pergunta e uma resposta de exemplo"><Icone Nome="faisca" Tamanho="17" /> Exemplo</button>
        <button class="btn btn-hero" @onclick="Limpar" disabled="@(_pergunta == "" && _resposta == "")"><Icone Nome="lixo" Tamanho="17" /> Limpar</button>
        <button class="btn btn-hero" @onclick="AplicarTodas" disabled="@(_a == null || !_a.Achados.Any(x => x.Troca != null && !x.Troca.Contains('[')))" title="Aplica de uma vez todas as correções que o QSmart sabe fazer sozinho"><Icone Nome="check" Tamanho="17" /> Aplicar correções</button>
        <button class="btn btn-pri" @onclick="Copiar" disabled="@(_resposta.Trim() == "")" title="Copia a resposta para colar no Teams"><Icone Nome="copiar" Tamanho="17" /> Copiar resposta</button>
    </Acoes>
    <ChildContent>
        <div class="rr-entrada">
            <label class="rr-caixa">
                <span class="rr-rot"><span class="rr-num">1</span> Pergunta da 3069 <small>cole a mensagem que chegou pelo Teams</small></span>
                <textarea class="campo area" rows="11" placeholder="Ex.: Bom dia! Qual o prazo para liberar o limite do associado? É possível aumentar para R$ 50 mil?"
                          value="@_pergunta" @oninput="MudouPergunta"></textarea>
            </label>
            <label class="rr-caixa resp">
                <span class="rr-rot"><span class="rr-num">2</span> Nossa resposta <small>o que vai ser enviado pelo Teams</small></span>
                <textarea class="campo area" rows="11" placeholder="Escreva ou cole a resposta aqui. A análise aparece enquanto você escreve."
                          value="@_resposta" @oninput="MudouResposta"></textarea>
                @if (_a != null && _resposta.Trim() != "")
                {
                    <span class="rr-conta">@_a.Palavras palavras · @_a.Frases @(_a.Frases == 1 ? "frase" : "frases") · média de @_a.MediaPalavrasFrase.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture).Replace('.', ',') palavras por frase · leitura de ~@_a.SegundosLeitura s</span>
                }
            </label>
        </div>
        <p class="fa-privado"><Icone Nome="escudo" Tamanho="16" /> A análise é feita aqui, no seu navegador. A pergunta e a resposta não são enviadas para nenhum lugar e não ficam salvas.</p>

        @if (_a == null || _resposta.Trim() == "")
        {
            <div class="rr-vazio">
                <div><b>O que o QSmart confere na resposta</b>
                    <ul>
                        <li><b>Responde a pergunta?</b> Separa cada pergunta da mensagem e vê se a resposta atende: sim ou não, prazo, valor, responsável, como fazer, motivo.</li>
                        <li><b>Objetividade:</b> se a resposta vai direto ao ponto, frases longas, enchimento e repetição.</li>
                        <li><b>Discordância:</b> se discorda da cooperativa de forma seca ou se a própria resposta se contradiz.</li>
                        <li><b>Pode ser contestado:</b> termos vagos, promessas sem data, palavras absolutas, regra sem número, culpa.</li>
                        <li><b>Tom e escrita:</b> formalidade, saudação, fechamento, informalidade, acentos e erros comuns.</li>
                    </ul>
                </div>
            </div>
        }
        else
        {
            var a = _a;
            var vis = a.Achados.Where(x => !_ignorados.Contains(x.Chave)).ToList();
            var filtrados = vis.Where(x => _filtro == null || x.Categoria == _filtro).ToList();
            var locais = filtrados.Where(x => x.Ini >= 0 && x.Fim > x.Ini).OrderBy(x => x.Ini).ThenByDescending(x => x.Grav).ToList();
            var gerais = filtrados.Where(x => !(x.Ini >= 0 && x.Fim > x.Ini)).OrderByDescending(x => x.Grav).ToList();
            var num = new Dictionary<string, int>();
            foreach (var x in locais) num.TryAdd(x.Chave, num.Count + 1);
            <div class="rr-hero @a.VereditoClasse">
                <div class="rr-nota" style="--p:@a.Nota"><span><b>@a.Nota</b><small>de 100</small></span></div>
                <div class="rr-ver">
                    <span class="rotulo">Resultado</span>
                    <b>@a.Veredito</b>
                    <small>@Resumo(a)</small>
                    <small class="rr-leg">Leitura @a.LegibilidadeTexto · @a.Palavras palavras · ~@a.SegundosLeitura s</small>
                </div>
                <div class="rr-crit">
                    @foreach (var c in Categorias)
                    {
                        var n = a.NotaPorCategoria.TryGetValue(c, out var v) ? v : 100;
                        int q = c == Cat.Responde ? a.Perguntas.Count(p => p.Status != StatusPergunta.Atendida) + vis.Count(x => x.Categoria == c) : vis.Count(x => x.Categoria == c);
                        <button class="rr-cr @c @(_filtro == c ? "on" : "") @(_filtro != null && _filtro != c ? "apaga" : "")" title="Mostrar só @Cat.Nome(c)" @onclick="() => _filtro = _filtro == c ? null : c">
                            <span class="rr-cr-anel" style="--p:@n;--k:@CorNota(n)"><b>@n</b></span>
                            <span class="rr-cr-nome">@Cat.Nome(c)</span>
                            <small>@(q == 0 ? "sem apontamentos" : q == 1 ? "1 apontamento" : $"{q} apontamentos")</small>
                        </button>
                    }
                </div>
            </div>

            @if (a.Perguntas.Count > 0 && (_filtro == null || _filtro == Cat.Responde))
            {
                <div class="rr-pxr">
                    <span class="rr-pxr-tit"><Icone Nome="info" Tamanho="15" /> Pergunta × resposta</span>
                    @foreach (var p in a.Perguntas)
                    {
                        var st = p.Status switch { StatusPergunta.Atendida => "g", StatusPergunta.Parcial => "a", _ => "r" };
                        <div class="rr-pq @st">
                            <span class="rr-pq-ic"><Icone Nome="@(st == "g" ? "check" : st == "a" ? "info" : "x")" Tamanho="14" /></span>
                            <div>
                                <b>“@p.Texto”</b>
                                <small><span class="rr-tipo">@p.Tipo</span>@(p.Status switch { StatusPergunta.Atendida => "Respondida.", StatusPergunta.Parcial => "Em parte: " + p.Motivo + ".", _ => "Não respondida: " + p.Motivo + "." })</small>
                                @if (p.TermosFaltando.Count > 0) { <small class="muted">Não fala de: @string.Join(", ", p.TermosFaltando).</small> }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="rr-rev">
                <div class="rr-doc">
                    <div class="rr-doc-cab"><b>Resposta revisada</b><small class="muted">clique num destaque para ver o apontamento</small></div>
                    <div class="rr-doc-txt">@Documento(locais, num)</div>
                    <div class="rr-legenda">
                        @foreach (var c in Categorias) { <span class="rr-lg @c"><i></i>@Cat.Nome(c)</span> }
                    </div>
                </div>
                <div class="rr-mar">
                    @if (_filtro != null) { <div class="rr-filtro">Mostrando só <b>@Cat.Nome(_filtro)</b> <button class="btn btn-sec btn-peq" @onclick="() => _filtro = null">ver todos</button></div> }
                    @if (gerais.Count + locais.Count == 0)
                    {
                        <div class="rr-limpo"><Icone Nome="check" Tamanho="22" /><b>Nenhum apontamento@(_filtro != null ? " neste critério" : "")</b><small class="muted">Faça a conferência final abaixo antes de enviar.</small></div>
                    }
                    @if (gerais.Count > 0)
                    {
                        <span class="rr-mar-tit">Sobre a resposta toda</span>
                        @foreach (var x in gerais) { @Cartao(x, null) }
                    }
                    @if (locais.Count > 0)
                    {
                        <span class="rr-mar-tit">No texto</span>
                        @foreach (var x in locais) { @Cartao(x, num[x.Chave]) }
                    }
                    @if (_ignorados.Count > 0) { <button class="rr-ign" @onclick="() => _ignorados.Clear()">@_ignorados.Count ignorado(s) · mostrar de novo</button> }
                </div>
            </div>

            <Painel Titulo="Antes de enviar" Nota="confira você mesmo">
                <div class="rr-check">
                    @foreach (var (k, t) in Checklist)
                    {
                        <label class="oo-chk"><input type="checkbox" checked="@_checados.Contains(k)" @onchange="() => { if (!_checados.Add(k)) _checados.Remove(k); }" /> <span>@t</span></label>
                    }
                </div>
                @if (_checados.Count == Checklist.Length && a.VereditoClasse == "ok") { <p class="rr-pronto"><Icone Nome="check" Tamanho="16" /> Tudo conferido. Pode copiar e enviar.</p> }
            </Painel>
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "servicos3069";
    string _pergunta = "", _resposta = "";
    Analise? _a;
    readonly HashSet<string> _checados = new();
    static readonly string[] Categorias = { Cat.Responde, Cat.Objetividade, Cat.Discordancia, Cat.Contestavel, Cat.Tom, Cat.Escrita };
    static readonly (string, string)[] Checklist =
    {
        ("nomes", "Nomes, cargos e o nome da cooperativa estão escritos certo."),
        ("numeros", "Números, valores, datas, protocolos e propostas conferidos com o sistema."),
        ("anexos", "Se a resposta cita anexo ou link, ele está junto da mensagem."),
        ("prazo", "Se há prazo ou compromisso, a área responsável já confirmou."),
        ("conversa", "É a conversa certa do Teams e a resposta está no fio da pergunta."),
        ("releitura", "Li a resposta inteira como se fosse a 3069 lendo."),
    };

    void MudouPergunta(ChangeEventArgs e) { _pergunta = e.Value?.ToString() ?? ""; Analisar(); }
    void MudouResposta(ChangeEventArgs e) { _resposta = e.Value?.ToString() ?? ""; Analisar(); }
    void Analisar() { _a = AnaliseResposta.Analisar(_pergunta, _resposta); _checados.Clear(); }
    readonly HashSet<string> _ignorados = new();
    string? _filtro, _foco;

    static string CorNota(int n) => n >= 85 ? "#10B981" : n >= 60 ? "#F59E0B" : "#EF4444";
    static string IdCartao(string chave) => "rr-c-" + (uint)chave.GetHashCode();

    async Task Focar(Achado x) { _foco = x.Chave; StateHasChanged(); await Task.Delay(30); await E.Nav.Rolar(IdCartao(x.Chave)); }

    void AplicarAchado(Achado x)
    {
        _resposta = AnaliseResposta.Aplicar(_resposta, x);
        _foco = null;
        Analisar();
    }

    async Task AplicarTodas()
    {
        int n = 0;
        for (int i = 0; i < 60; i++)
        {
            var x = _a?.Achados.FirstOrDefault(x => x.Troca != null && x.Ini >= 0 && !x.Troca.Contains('[') && !_ignorados.Contains(x.Chave));
            if (x == null) break;
            _resposta = AnaliseResposta.Aplicar(_resposta, x); n++;
            Analisar();
        }
        await J.Info("Correções aplicadas", n == 0 ? "Não há correções automáticas para aplicar." : $"{n} correção(ões) aplicada(s). Os apontamentos que dependem de você (datas, motivos, valores) continuam na lista.");
    }

    RenderFragment Cartao(Achado x, int? n) => @<text>
        <div class="rr-c @x.Categoria @Grav(x.Grav) @(_foco == x.Chave ? "foco" : "")" id="@IdCartao(x.Chave)">
            <div class="rr-c-cab">
                @if (n != null) { <span class="rr-c-num">@n</span> } else { <span class="rr-c-num geral"><Icone Nome="info" Tamanho="12" /></span> }
                <b>@x.Titulo</b>
                <span class="rr-c-cat">@Cat.Nome(x.Categoria)</span>
            </div>
            @if (x.Troca != null && x.Fim > x.Ini)
            {
                <div class="rr-dp"><del>@_resposta[x.Ini..x.Fim]</del> <Icone Nome="direita" Tamanho="13" /> @if (x.Troca.Trim() == "") { <ins class="rem">(retirar)</ins> } else { <ins>@x.Troca.Trim()</ins> }</div>
            }
            else if (x.Troca != null)
            {
                <div class="rr-dp"><Icone Nome="mais" Tamanho="13" /> <ins>@x.Troca.Trim()</ins></div>
            }
            else if (!string.IsNullOrEmpty(x.Trecho))
            {
                <div class="rr-dp so"><span class="rr-q">@x.Trecho</span></div>
            }
            <p>@x.Explicacao</p>
            @if (x.Sugestao != null) { <p class="rr-c-sug"><Icone Nome="faisca" Tamanho="13" /> @x.Sugestao</p> }
            <div class="rr-c-acts">
                @if (x.Troca != null) { <button class="btn btn-pri btn-peq" @onclick="() => AplicarAchado(x)"><Icone Nome="check" Tamanho="13" /> Aplicar</button> }
                <button class="btn btn-sec btn-peq" @onclick="() => _ignorados.Add(x.Chave)">Ignorar</button>
            </div>
        </div>
    </text>;

    RenderFragment Documento(List<Achado> locais, Dictionary<string, int> num) => b =>
    {
        int seq = 0, pos = 0;
        var texto = _resposta;
        int i = 0;
        while (i < locais.Count)
        {
            var m = locais[i];
            if (m.Ini < pos || m.Fim > texto.Length) { i++; continue; }
            // todos os apontamentos que começam dentro deste destaque
            var grupo = locais.Skip(i).TakeWhile(x => x.Ini < m.Fim).ToList();
            if (m.Ini > pos) b.AddContent(seq++, texto[pos..m.Ini]);
            b.OpenElement(seq++, "mark");
            b.AddAttribute(seq++, "class", $"rr-u {m.Categoria} {(grupo.Any(g => g.Chave == _foco) ? "foco" : "")}");
            b.AddAttribute(seq++, "title", m.Titulo);
            b.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Focar(m)));
            b.AddContent(seq++, texto[m.Ini..m.Fim]);
            b.CloseElement();
            foreach (var g in grupo.Where(g => num.ContainsKey(g.Chave)))
            {
                b.OpenElement(seq++, "sup");
                b.AddAttribute(seq++, "class", $"rr-n {g.Categoria}");
                b.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => Focar(g)));
                b.AddContent(seq++, num[g.Chave]);
                b.CloseElement();
            }
            pos = Math.Max(pos, grupo.Max(g => Math.Min(g.Fim, texto.Length)));
            pos = Math.Max(pos, m.Fim);
            i += grupo.Count;
        }
        if (pos < texto.Length) b.AddContent(seq++, texto[pos..]);
    };

    static string Grav(Gravidade g) => g switch { Gravidade.Problema => "r", Gravidade.Atencao => "a", _ => "l" };

    static string Explica(string c) => c switch
    {
        Cat.Objetividade => "A resposta principal precisa estar nas primeiras linhas, em frases curtas e sem rodeios.",
        Cat.Discordancia => "Discordar da 3069 só com cuidado e com o fato; a resposta também não pode se contradizer.",
        Cat.Contestavel => "O que a cooperativa pode questionar porque não ficou bem explicado.",
        Cat.Tom => "Formal, cordial e institucional: como uma comunicação oficial.",
        _ => "Erros de português, acentos e pontuação.",
    };

    static string Resumo(Analise a)
    {
        int nao = a.Perguntas.Count(p => p.Status == StatusPergunta.NaoAtendida), parc = a.Perguntas.Count(p => p.Status == StatusPergunta.Parcial);
        int pr = a.Achados.Count(x => x.Grav == Gravidade.Problema), at = a.Achados.Count(x => x.Grav == Gravidade.Atencao);
        var l = new List<string>();
        if (a.Perguntas.Count > 0) l.Add(nao + parc == 0 ? $"responde {(a.Perguntas.Count == 1 ? "a pergunta" : $"as {a.Perguntas.Count} perguntas")}" : $"{(nao > 0 ? $"{nao} pergunta(s) sem resposta" : "")}{(nao > 0 && parc > 0 ? " e " : "")}{(parc > 0 ? $"{parc} respondida(s) em parte" : "")}");
        if (pr > 0) l.Add($"{pr} problema(s) para corrigir");
        if (at > 0) l.Add($"{at} ponto(s) de atenção");
        if (l.Count == 0 || (pr == 0 && at == 0 && nao + parc == 0)) return "Nenhum problema encontrado. Faça a conferência final abaixo antes de enviar.";
        return char.ToUpper(string.Join(" · ", l)[0]) + string.Join(" · ", l)[1..] + ".";
    }


    async Task Copiar()
    {
        if (await E.Nav.Copiar(_resposta)) await J.Info("Copiado", "Resposta copiada. É só colar no Teams.");
        else await J.Aviso("Copiar", "Não consegui copiar automaticamente. Selecione o texto e use Ctrl+C.");
    }

    void Limpar() { _pergunta = ""; _resposta = ""; _a = null; _checados.Clear(); }

    void Exemplo()
    {
        _pergunta = "Bom dia! Qual o prazo para liberação do limite do associado João Pereira? E é possível aumentar o valor para R$ 50 mil?";
        _resposta = "oi pessoal, tudo bem? Então, a gente vai verificar isso em breve com a equipe, mas acho que não é possível aumentar, como já informado anteriormente. Vocês devem enviar a documentação pra gente!! Conforme normativo, o prazo é de 5 dias. Qualquer coisa me chama";
        Analisar();
    }
}
