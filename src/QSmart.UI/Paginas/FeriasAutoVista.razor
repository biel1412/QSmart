@inherits PaginaBase
@using QSmart.Core.Coordenacao

@{ var b = E.FeriasAuto; Montar(); }
<Pagina Titulo="Férias" Grupo="@A.Grupo"
        Sub="Controle automatizado: anexe a planilha completa de controle de férias. Para cada data em choque o QSmart sugere outras datas, mostra quanto o impacto diminui e, se você aceitar, já altera a planilha."
        Kpis="@(b != null ? KpisAuto : null)">
    <Acoes>
        <button class="btn btn-hero" @onclick="BaixarModelo" title="Planilha de controle em branco, no mesmo formato"><Icone Nome="download" Tamanho="17" /> Modelo em branco</button>
        <button class="btn btn-hero" disabled="@(b == null || _alterados.Count == 0)" @onclick="BaixarAjustada" title="A sua planilha com as datas aceitas já trocadas"><Icone Nome="download" Tamanho="17" /> Baixar planilha ajustada</button>
        <BotaoArquivo Texto="@(b != null ? "Trocar planilha" : "Anexar planilha de controle")" Variante="pri" Icone="upload" Aceita=".xlsx,.xlsm" AoEscolher="Anexar"
                      Desativado="E.Carregando" Dica="A planilha completa de controle de férias do time" />
    </Acoes>
    <ChildContent>
        <FeriasModos />

        @if (b == null)
        {
            <div class="fa-intro">
                <div class="fa-passo"><span>1</span><div><b>Baixe o modelo em branco</b><p class="muted">Mesmo formato da planilha de controle: nome, admissão, períodos aquisitivo e concessivo, início das férias, dias, venda, agendamento e observações. As colunas calculadas já vêm com fórmula.</p>
                    <button class="btn btn-sec" @onclick="BaixarModelo"><Icone Nome="download" Tamanho="16" /> Baixar modelo em branco</button></div></div>
                <div class="fa-passo"><span>2</span><div><b>Anexe a planilha preenchida</b><p class="muted">O QSmart lê todas as abas de time, encontra quem fica fora junto com alguém do mesmo time e calcula os dias de choque.</p>
                    <BotaoArquivo Texto="Anexar planilha" Variante="pri" Icone="upload" Aceita=".xlsx,.xlsm" AoEscolher="Anexar" Desativado="E.Carregando" /></div></div>
                <div class="fa-passo"><span>3</span><div><b>Revise as sugestões</b><p class="muted">Uma data em choque por vez: veja a sugestão, outras datas próximas e quanto o choque do time diminui. Aceite, mantenha ou pule. No fim, baixe a planilha ajustada.</p></div></div>
            </div>
            <p class="fa-privado"><Icone Nome="escudo" Tamanho="16" /> A planilha não vai para nenhum servidor e não fica pública: é lida aqui, e guardada só neste navegador, criptografada (AES-256). Só quem usa este navegador consegue abrir.</p>
        }
        else
        {
            <div class="barra-ferr">
                <span class="rotulo">Planilha</span>
                <b class="fer-arq" title="@b.Arquivo">@b.Arquivo</b>
                <span class="muted pequeno">@Ferias.Plural(b.Funcs.Count, "pessoa") · @Ferias.Plural(b.Periodos.Count, "período") · anexada em @E.FeriasAutoEm</span>
                @if (b.Abas.Count > 1)
                {
                    <span class="rotulo" style="margin-left:8px">Time</span>
                    <select class="campo" style="min-width:150px" value="@_aba" @onchange="e => { _aba = e.Value?.ToString() ?? Todas; _i = 0; }">
                        <option value="@Todas">Todos os times</option>
                        @foreach (var a in b.Abas) { <option value="@a">@a</option> }
                    </select>
                }
                <span class="mola"></span>
                <span class="fa-cadeado" title="Guardada só neste navegador, criptografada"><Icone Nome="escudo" Tamanho="14" /> só neste navegador</span>
                <button class="btn btn-sec" @onclick="Limpar" title="Apaga a planilha deste navegador"><Icone Nome="lixo" Tamanho="16" /> Limpar</button>
            </div>

            <div class="fa-impacto">
                <div class="fa-imp-num">
                    <span class="rotulo">Dias de choque do time</span>
                    <div><b class="fa-de">@Fmt(_inicial)</b> <Icone Nome="direita" Tamanho="18" /> <b class="fa-para">@Fmt(_atual)</b></div>
                    <span class="muted pequeno">@(_inicial == 0 ? "nenhum choque na planilha" : _atual < _inicial ? $"{Pct(_inicial - _atual, _inicial)} a menos com as {Ferias.Plural(_alterados.Count, "alteração", "alterações")} aceitas" : "ainda sem alterações")</span>
                </div>
                <div class="fa-imp-barra" title="Choque atual em relação ao da planilha anexada">
                    <span style="width:@Pc(_atual, Math.Max(1, _inicial))"></span>
                    <em style="left:@Pc(_atual, Math.Max(1, _inicial))">@Pct(_atual, Math.Max(1, _inicial))</em>
                </div>
                <div class="fa-imp-lado">
                    <span><b>@_fila.Count</b> para revisar</span>
                    <span><b>@_alterados.Count</b> aceitas</span>
                    <span><b>@_mantidos</b> mantidas</span>
                    @if (_fila.Count > 1)
                    {
                        <button class="btn btn-sec" @onclick="AceitarTodas" title="Aceita a melhor sugestão de cada data em choque, uma de cada vez"><Icone Nome="check" Tamanho="15" /> Aceitar todas as melhores</button>
                    }
                </div>
            </div>

            <div class="grade-32">
                <Painel Titulo="Revisão das datas em choque" Nota="@(_fila.Count > 0 ? $"{Math.Min(_i, _fila.Count - 1) + 1} de {_fila.Count}" : "")" Classe="fa-revisao">
                    <Extra>
                        @if (_fila.Count > 1)
                        {
                            <div class="segmentado">
                                <button class="seg" @onclick="() => Mover(-1)" title="Anterior"><Icone Nome="esquerda" Tamanho="15" /></button>
                                <button class="seg" @onclick="() => Mover(1)" title="Próxima"><Icone Nome="direita" Tamanho="15" /></button>
                            </div>
                        }
                    </Extra>
                    <ChildContent>
                        @if (_fila.Count == 0)
                        {
                            <div class="fa-ok">
                                <span class="vazio-ic"><Icone Nome="check" Tamanho="30" /></span>
                                <h3>@(_inicial == 0 ? "Nenhuma data em choque" : "Tudo revisado")</h3>
                                <p class="muted">@(_alterados.Count > 0 ? "Baixe a planilha ajustada para levar as novas datas." : "Não há mais datas em choque que ainda possam mudar.")
                                    @(_presos > 0 ? $" {Ferias.Plural(_presos, "período")} em choque já começou ou está como “Já tirou” e não entra na revisão." : "")</p>
                                @if (_alterados.Count > 0) { <button class="btn btn-pri" @onclick="BaixarAjustada"><Icone Nome="download" Tamanho="16" /> Baixar planilha ajustada</button> }
                                @if (_mantidos > 0) { <button class="btn btn-sec" @onclick="RevisarMantidos">Revisar de novo as @_mantidos mantidas</button> }
                            </div>
                        }
                        else
                        {
                            var p = _fila[Math.Min(_i, _fila.Count - 1)];
                            var com = FeriasAuto.ComQuem(b, p);
                            int ch = FeriasAuto.Choque(b, p);
                            <div class="fa-card">
                                <div class="fa-quem">
                                    <span class="fa-av">@Iniciais(p.Nome)</span>
                                    <div>
                                        <b>@p.Nome</b>
                                        <span class="muted pequeno">@p.Aba · linha @p.Linha · @p.Status@(Vende(p) ? " · vende 10 dias" : "")</span>
                                    </div>
                                    <span class="fa-tag-choque">@Ferias.Plural(ch, "dia") de choque</span>
                                </div>
                                <div class="fa-agora">
                                    <span class="rotulo">Hoje na planilha</span>
                                    <b>@Texto.Dmy(p.Inicio) a @Texto.Dmy(p.Fim)</b> <span class="muted">(@p.Dias dias, @Texto.DiaSemana(p.Inicio).ToLowerInvariant())</span>
                                    <div class="fa-com">fora junto com: @foreach (var c in com) { <span>@c.nome <b>@c.dias d</b></span> }</div>
                                </div>

                                @{ var ops = Opcoes(p); }
                                @if (ops.Count == 0)
                                {
                                    <p class="hero-aviso"><Icone Nome="alerta" Tamanho="15" /> Não achei outra data que diminua o choque dentro das regras (início em dia permitido, sem passar do fim do concessivo e sem bater com outro período da mesma pessoa).</p>
                                }
                                else
                                {
                                    <FeriasAutoLinha P="p" Ops="ops" B="b" />
                                    <div class="fa-ops">
                                        @for (int k = 0; k < ops.Count; k++)
                                        {
                                            var o = ops[k];
                                            <div class="fa-op @(k == 0 ? "melhor" : "")">
                                                <div class="fa-op-topo">
                                                    <span class="fa-op-rot">@(k == 0 ? "Sugestão do QSmart" : o.Deslocamento < 0 ? "Data próxima, antes" : "Data próxima, depois")</span>
                                                    <span class="fa-op-desl">@(o.Deslocamento > 0 ? "+" : "")@o.Deslocamento dias</span>
                                                </div>
                                                <b class="fa-op-data">@Texto.Dmy(o.NovoInicio) a @Texto.Dmy(o.NovoFim)</b>
                                                <span class="muted pequeno">começa @Texto.DiaSemana(o.NovoInicio).ToLowerInvariant()@(o.ProximoDepois < 999 ? $" · {Ferias.Plural(o.ProximoDepois, "dia")} de folga até o colega mais perto" : "")</span>
                                                <div class="fa-op-imp">
                                                    <div><span>Choque da pessoa</span><b>@o.ChoqueAntes → @o.ChoqueDepois dias</b></div>
                                                    <div><span>Choque do time</span><b>@Fmt(o.TimeAntes) → @Fmt(o.TimeDepois)</b></div>
                                                    <div class="fa-op-red"><span>Impacto</span><b>−@Pct(o.TimeAntes - o.TimeDepois, Math.Max(1, o.TimeAntes))</b></div>
                                                </div>
                                                <button class="btn @(k == 0 ? "btn-pri" : "btn-sec")" @onclick="() => Aceitar(o)"><Icone Nome="check" Tamanho="15" /> Mudar para esta data</button>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="fa-card-pe">
                                    <button class="btn btn-sec" @onclick="() => Manter(p)" title="Fica com a data da planilha e sai da revisão">Manter a data atual</button>
                                    <button class="btn btn-sec" @onclick="() => Mover(1)" disabled="@(_fila.Count < 2)">Pular por agora</button>
                                </div>
                            </div>
                        }
                    </ChildContent>
                </Painel>

                <Painel Titulo="Alterações aceitas" Nota="@(_alterados.Count > 0 ? Ferias.Plural(_alterados.Count, "data") : "")" Sangrar="true">
                    @if (_alterados.Count == 0)
                    {
                        <p class="muted" style="padding:14px 18px">Nenhuma ainda. As datas que você aceitar aparecem aqui e podem ser desfeitas.</p>
                    }
                    else
                    {
                        <ul class="fa-lista">
                            @foreach (var p in _alterados)
                            {
                                <li>
                                    <div><b>@p.Nome</b><span class="muted pequeno">@Texto.Dmy(p.InicioOriginal) <Icone Nome="direita" Tamanho="12" /> <b class="fa-para">@Texto.Dmy(p.Inicio)</b> · @p.Dias dias</span></div>
                                    <button class="btn btn-sec btn-peq" @onclick="() => Desfazer(p)" title="Volta para a data original">Desfazer</button>
                                </li>
                            }
                        </ul>
                    }
                </Painel>
            </div>

            <div class="grade-2">
                <Painel Titulo="Prazos (CLT)" Nota="@(_prazos.Count > 0 ? Ferias.Plural(_prazos.Count, "pessoa") : "")" Sangrar="true">
                    @if (_prazos.Count == 0)
                    {
                        <p class="muted" style="padding:14px 18px">Nenhum prazo apertado.</p>
                    }
                    else
                    {
                        <ul class="fa-lista">
                            @foreach (var x in _prazos)
                            {
                                <li class="fa-pz @x.classe"><div><b>@x.f.Nome</b><span class="muted pequeno">@x.texto</span></div><span class="fa-pz-tag">@x.tag</span></li>
                            }
                        </ul>
                    }
                </Painel>
                <Painel Titulo="Regras e conferência" Nota="@((_regras.Count + b.Problemas.Count) > 0 ? Ferias.Plural(_regras.Count + b.Problemas.Count, "aviso") : "")">
                    <div class="fer-alertas">
                        @if (_regras.Count + b.Problemas.Count == 0) { <p class="muted">Nada a conferir.</p> }
                        @foreach (var x in _regras) { <div class="fer-alerta clt"><Icone Nome="alerta" Tamanho="16" /><span><b>CLT</b><br />@x</span></div> }
                        @foreach (var x in b.Problemas) { <div class="fer-alerta choque"><Icone Nome="alerta" Tamanho="16" /><span><b>Planilha</b><br />@x</span></div> }
                    </div>
                </Painel>
            </div>
        }
    </ChildContent>
</Pagina>

@code {
    protected override string Chave => "ferias";
    const string Todas = "\u0001todas";
    string _aba = Todas;
    int _i, _inicial, _atual, _mantidos, _presos;
    readonly DateOnly _hoje = DateOnly.FromDateTime(DateTime.Today);
    List<PeriodoAuto> _fila = new(), _alterados = new();
    List<string> _regras = new();
    List<(FuncAuto f, string classe, string tag, string texto)> _prazos = new();
    readonly Dictionary<(int id, DateOnly ini, int ver), List<SugestaoAuto>> _cache = new();
    int _versao;

    protected override async Task OnInitializedAsync() => await E.CarregarFeriasAuto();

    bool NoFiltro(PeriodoAuto p) => _aba == Todas || p.Aba == _aba;
    bool NoFiltro(FuncAuto f) => _aba == Todas || f.Aba == _aba;
    static bool Vende(PeriodoAuto p) => Ferias.Norm(p.Vende).StartsWith("s");

    void Montar()
    {
        var b = E.FeriasAuto;
        if (b == null) return;
        string? aba = _aba == Todas ? null : _aba;
        _atual = FeriasAuto.ChoqueTotal(b, aba);
        // choque inicial: com as datas originais
        var guarda = b.Periodos.ToDictionary(p => p, p => p.Inicio);
        foreach (var p in b.Periodos) p.Inicio = p.InicioOriginal;
        _inicial = FeriasAuto.ChoqueTotal(b, aba);
        foreach (var kv in guarda) kv.Key.Inicio = kv.Value;

        var emChoque = b.Periodos.Where(p => NoFiltro(p) && FeriasAuto.Choque(b, p) > 0).ToList();
        _presos = emChoque.Count(p => !FeriasAuto.Ajustavel(p, _hoje));
        _fila = emChoque.Where(p => FeriasAuto.Ajustavel(p, _hoje) && !b.Mantidos.Contains(p.Id))
            .OrderByDescending(p => FeriasAuto.Choque(b, p)).ThenBy(p => p.Inicio).ToList();
        _mantidos = b.Periodos.Count(p => NoFiltro(p) && b.Mantidos.Contains(p.Id));
        _alterados = b.Periodos.Where(p => NoFiltro(p) && p.Alterado).OrderBy(p => p.Inicio).ToList();
        if (_i >= _fila.Count) _i = 0;
        _regras = FeriasAuto.Regras(b, _hoje).Where(r => aba == null || b.Funcs.Any(f => f.Aba == aba && r.StartsWith(f.Nome + ":"))).ToList();

        _prazos = new();
        foreach (var f in b.Funcs.Where(NoFiltro))
        {
            var (t, d) = FeriasAuto.SituacaoPrazo(f, _hoje);
            bool marcou = b.Periodos.Any(p => p.Func == f && p.Fim >= _hoje);
            switch (t)
            {
                case FeriasAuto.Prazo.Vencido: _prazos.Add((f, "vencido", "vencido", $"concessivo terminou em {Texto.Dmy(f.FimConcessivo!.Value)}, há {Ferias.Plural(d, "dia")}")); break;
                case FeriasAuto.Prazo.ConcessivoPerto when !marcou: _prazos.Add((f, "perto", $"{d} dias", $"concessivo vence em {Texto.Dmy(f.FimConcessivo!.Value)} e não há férias marcadas")); break;
                case FeriasAuto.Prazo.SemAdmissao: _prazos.Add((f, "sem", "sem admissão", "sem data de admissão: não dá para calcular os prazos")); break;
            }
        }
        _prazos = _prazos.OrderBy(x => x.classe switch { "vencido" => 0, "perto" => 1, _ => 2 }).ToList();
    }

    List<SugestaoAuto> Opcoes(PeriodoAuto p)
    {
        var k = (p.Id, p.Inicio, _versao);
        if (!_cache.TryGetValue(k, out var l)) { l = FeriasAuto.Opcoes(E.FeriasAuto!, p, _hoje); _cache[k] = l; }
        return l;
    }

    void Mudou() { _versao++; _cache.Clear(); _ = E.SalvarFeriasAuto(); }

    void Aceitar(SugestaoAuto o) { o.Periodo.Inicio = o.NovoInicio; Mudou(); }
    void Manter(PeriodoAuto p) { E.FeriasAuto!.Mantidos.Add(p.Id); Mudou(); }
    void Desfazer(PeriodoAuto p) { p.Inicio = p.InicioOriginal; Mudou(); }
    void RevisarMantidos() { E.FeriasAuto!.Mantidos.RemoveWhere(id => E.FeriasAuto.Periodos.Any(p => p.Id == id && NoFiltro(p))); _i = 0; Mudou(); }
    void Mover(int d) { if (_fila.Count == 0) return; _i = ((_i + d) % _fila.Count + _fila.Count) % _fila.Count; }

    async Task AceitarTodas()
    {
        var b = E.FeriasAuto!;
        if (!await J.Pergunta("Aceitar todas", $"Aceitar a melhor sugestão para cada data em choque ({_fila.Count})? Elas são aplicadas uma de cada vez, da maior para a menor, e dá para desfazer cada uma depois.")) return;
        int n = 0;
        for (int volta = 0; volta < 3; volta++)
        {
            Montar();
            foreach (var p in _fila.ToList())
            {
                var s = FeriasAuto.Sugerir(b, p, _hoje);
                if (s != null) { p.Inicio = s.NovoInicio; n++; }
            }
        }
        Mudou();
        Montar();
        await J.Info("Aceitar todas", $"{Ferias.Plural(n, "data mudada", "datas mudadas")}. Choque do time: {Fmt(_inicial)} → {Fmt(_atual)} dias ({Pct(_inicial - _atual, Math.Max(1, _inicial))} a menos).");
    }

    async Task Anexar(List<Arquivo> arqs)
    {
        var arq = arqs[0];
        BaseAuto b;
        try { b = FeriasAuto.Ler(arq.Dados, arq.Nome); }
        catch (Exception ex) { await J.Erro("Controle de férias", $"Não consegui ler “{arq.Nome}”.\n\n{ex.Message}"); return; }
        if (b.Periodos.Count == 0 && b.Funcs.Count == 0) { await J.Erro("Controle de férias", $"Nenhuma pessoa encontrada em “{arq.Nome}”."); return; }
        if (E.FeriasAuto?.Periodos.Any(p => p.Alterado) == true
            && !await J.Pergunta("Trocar planilha", "As datas aceitas da planilha atual serão descartadas. Baixe a planilha ajustada antes se quiser guardar. Trocar mesmo assim?")) return;
        E.FeriasAuto = b;
        E.FeriasAutoEm = Texto.Agora();
        _aba = Todas; _i = 0;
        Mudou();
        E.Notificar();
    }

    async Task Limpar()
    {
        if (!await J.Pergunta("Limpar", "Apagar a planilha de controle deste navegador? As datas aceitas que não foram baixadas serão perdidas.")) return;
        E.FeriasAuto = null;
        await E.SalvarFeriasAuto();
        E.Notificar();
    }

    async Task BaixarModelo() => await E.Salvar("Modelo_controle_ferias.xlsx", FeriasAuto.Modelo(), Navegador.MimeXlsx, "Modelo baixado");

    async Task BaixarAjustada()
    {
        var b = E.FeriasAuto;
        if (b == null) return;
        byte[] bytes;
        try { bytes = FeriasAuto.GerarAjustada(b); }
        catch (Exception ex) { await J.Erro("Planilha ajustada", ex.Message); return; }
        var nome = System.IO.Path.GetFileNameWithoutExtension(b.Arquivo);
        await E.Salvar($"{nome}_ajustada.xlsx", bytes, Navegador.MimeXlsx, "Planilha ajustada baixada");
    }

    static string Pct(int a, int t) => t == 0 ? "0%" : $"{Math.Round(a * 100.0 / t):0}%";
    static string Pc(int a, int t) => (Math.Clamp(a * 100.0 / t, 0, 100)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    static string Iniciais(string nome) { var p = nome.Split(' ', '.', '_').Where(x => x != "").ToArray(); return (p.Length == 0 ? "?" : p.Length == 1 ? p[0][..Math.Min(2, p[0].Length)] : $"{p[0][0]}{p[^1][0]}").ToUpperInvariant(); }

    RenderFragment KpisAuto => @<text>
        @{ var b = E.FeriasAuto!; int longos = FeriasAuto.Pares(b).Count(x => (_aba == Todas || x.a.Aba == _aba) && x.dias > FeriasAuto.ChoqueLongo);
           int pend = b.Periodos.Count(p => NoFiltro(p) && Ferias.Norm(p.Status).StartsWith("pend")) + b.Funcs.Count(f => NoFiltro(f) && !b.Periodos.Any(p => p.Func == f));
           int venc = _prazos.Count(x => x.classe == "vencido"), perto = _prazos.Count(x => x.classe == "perto"); }
        <Kpi Titulo="Dias de choque" Cor="red" Valor="@Fmt(_atual)" Detalhe="@(_atual < _inicial ? $"eram {Fmt(_inicial)} · −{Pct(_inicial - _atual, _inicial)}" : "somando todos os pares do mesmo time")" Proporcao="@(_inicial == 0 ? null : (double)_atual / _inicial)" />
        <Kpi Titulo="Para revisar" Cor="orange" Valor="@Fmt(_fila.Count)" Detalhe="@($"{Ferias.Plural(longos, "choque")} de mais de {FeriasAuto.ChoqueLongo} dias")" />
        <Kpi Titulo="Datas aceitas" Cor="green" Valor="@Fmt(_alterados.Count)" Detalhe="@(_alterados.Count > 0 ? "baixe a planilha ajustada" : "nenhuma alteração ainda")" />
        <Kpi Titulo="Prazos" Cor="amber" Valor="@Fmt(venc + perto)" Detalhe="@($"{venc} vencido(s) · {perto} vencendo sem férias marcadas")" />
        <Kpi Titulo="Pendentes" Cor="blue" Valor="@Fmt(pend)" Detalhe="sem data ou com agendamento pendente" />
    </text>;
}
