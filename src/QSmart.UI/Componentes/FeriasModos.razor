@* Troca entre o controle de férias de sempre e o controle automatizado *@
@inject QSmart.UI.Servicos.Estado E
<div class="fa-modos" role="tablist">
    <button role="tab" class="fa-modo @(E.FeriasModo != "auto" ? "on" : "")" @onclick='() => Ir("manual")'>
        <Icone Nome="ferias" Tamanho="17" /> <span><b>Controle de férias</b><small>pedidos da equipe, choques e calendário</small></span>
    </button>
    <button role="tab" class="fa-modo @(E.FeriasModo == "auto" ? "on" : "")" @onclick='() => Ir("auto")'>
        <Icone Nome="faisca" Tamanho="17" /> <span><b>Controle automatizado de férias</b><small>planilha completa + sugestões de datas</small></span>
    </button>
</div>

@code {
    void Ir(string m) { if (E.FeriasModo == m) return; E.FeriasModo = m; E.Notificar(); }
}
