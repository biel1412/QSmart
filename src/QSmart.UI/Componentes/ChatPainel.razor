@using QSmart.UI.Servicos
@inject Estado E
@inject IJSRuntime JS
@implements IDisposable

<div class="ch-fundo" @onclick="Fechar"></div>
<div class="ch-painel" role="dialog" aria-label="Chat">
    @if (_novo || _adicionando)
    {
        var gAdd = E.Chat.GrupoAberto;
        <div class="ch-cab conv">
            <button class="ch-x" title="Voltar" @onclick="CancelarSelecao"><Icone Nome="esquerda" Tamanho="18" /></button>
            <span class="ch-cab-ic ch-grupo"><Icone Nome="usuarios" Tamanho="18" /></span>
            <div class="ch-cab-txt"><b>@(_novo ? "Novo grupo temporário" : "Adicionar pessoas")</b><small>@(_sel.Count == 0 ? "ninguém escolhido" : _sel.Count == 1 ? "1 pessoa escolhida" : $"{_sel.Count} pessoas escolhidas")</small></div>
            <button class="ch-x" title="Fechar" @onclick="Fechar"><Icone Nome="x" Tamanho="18" /></button>
        </div>
        @if (_novo)
        {
            <div class="ch-gform">
                <label class="ch-gl">Nome do grupo</label>
                <input class="campo" maxlength="60" placeholder="Ex.: Mutirão FONTE_RENDA" @bind="_gNome" @bind:event="oninput" />
                <label class="ch-gl">Foto do grupo <small>opcional</small></label>
                <div class="ch-gfoto">
                    @AvGrupo(_gFoto, "ch-av")
                    <label class="btn btn-sec btn-peq ch-gfoto-btn"><Icone Nome="camera" Tamanho="13" /> @(_gFoto == "" ? "Escolher foto" : "Trocar foto")<InputFile OnChange="EscolherFotoNovo" accept="image/*" /></label>
                    @if (_gFoto != "") { <button class="btn btn-sec btn-peq" @onclick="() => _gFoto = string.Empty">Tirar</button> }
                </div>
                <label class="ch-gl">Duração <small>o grupo e as mensagens somem sozinhos no fim</small></label>
                <div class="ch-dur">
                    @for (int d = 1; d <= E.Chat.GrupoMaxDias; d++)
                    {
                        var dd = d;
                        <button class="@(_gDias == dd ? "on" : "")" @onclick="() => _gDias = dd">@(dd == 1 ? "1 dia" : $"{dd} dias")</button>
                    }
                </div>
                <small class="muted pequeno">Expira em @DateTime.Now.AddDays(_gDias).ToString("dd/MM 'às' HH:mm")</small>
            </div>
        }
        <div class="ch-busca"><Icone Nome="busca" Tamanho="15" /><input placeholder="Buscar pessoa…" @bind="_busca" @bind:event="oninput" /></div>
        <div class="ch-lista">
            @foreach (var c in Filtrados().Where(c => gAdd == null || !gAdd.Membros.Contains(c.Id)).OrderByDescending(c => _sel.Contains(c.Id)).ThenBy(c => c.Nome))
            {
                bool marc = _sel.Contains(c.Id);
                <button class="ch-pessoa ch-esc @(marc ? "marc" : "")" @onclick="() => Alternar(c.Id)" @key="c.Id">
                    <span class="ch-av" style="background:@Cor(c.Nome)">@if (c.Foto != "") { <img src="@c.Foto" alt="" /> } else { @Ini(c.Nome) }</span>
                    <div class="ch-p-txt"><div class="ch-p-top"><b>@c.Nome</b></div><div class="ch-p-sub"><span>@Papel(c.Papel)</span></div></div>
                    <span class="ch-check">@if (marc) { <Icone Nome="check" Tamanho="14" /> }</span>
                </button>
            }
        </div>
        @if (_erro != "") { <div class="ch-erro">@_erro</div> }
        <div class="ch-gacoes">
            <button class="btn btn-pri" disabled="@(_sel.Count == 0 || (_novo && string.IsNullOrWhiteSpace(_gNome)) || _enviando)" @onclick="ConfirmarSelecao">
                @(_novo ? "Criar grupo" : "Adicionar ao grupo")
            </button>
        </div>
    }
    else if (E.Chat.GrupoAberto is { } g)
    {
        bool criador = g.Criador == E.Chat.MeuId;
        <div class="ch-cab conv">
            <button class="ch-x" title="Voltar para a lista" @onclick="Voltar"><Icone Nome="esquerda" Tamanho="18" /></button>
            @AvGrupo(g.Foto, "ch-cab-ic")
            <button class="ch-cab-txt ch-cab-btn" title="Pessoas e opções do grupo" @onclick="() => { _gInfo = !_gInfo; _confirmar = false; _renomear = false; }">
                <b>@g.Nome</b><small>@g.Membros.Count pessoas · some @Some(g.Expira - DateTime.Now)</small>
            </button>
            <button class="ch-x @(_gInfo ? "on" : "")" title="Pessoas e opções" @onclick="() => { _gInfo = !_gInfo; _confirmar = false; _renomear = false; }"><Icone Nome="info" Tamanho="18" /></button>
            <button class="ch-x" title="Fechar" @onclick="Fechar"><Icone Nome="x" Tamanho="18" /></button>
        </div>
        @if (_gInfo)
        {
            <div class="ch-ginfo">
                @if (criador)
                {
                    @if (_renomear)
                    {
                        <div class="ch-gren"><input class="campo" maxlength="60" @bind="_gNome" @bind:event="oninput" /><button class="btn btn-pri btn-peq" @onclick="Renomear">Salvar</button><button class="btn btn-sec btn-peq" @onclick="() => _renomear = false">Cancelar</button></div>
                    }
                    else { <button class="ch-glink" @onclick="() => { _renomear = true; _gNome = g.Nome; }"><Icone Nome="editar" Tamanho="13" /> Mudar o nome</button> }
                }
                @if (criador)
                {
                    <div class="ch-gfoto">
                        @AvGrupo(g.Foto, "ch-av")
                        <label class="btn btn-sec btn-peq ch-gfoto-btn"><Icone Nome="camera" Tamanho="13" /> @(g.Foto == "" ? "Colocar foto" : "Trocar foto")<InputFile OnChange="TrocarFotoGrupo" accept="image/*" /></label>
                        @if (g.Foto != "") { <button class="btn btn-sec btn-peq" @onclick="RemoverFotoGrupo">Remover foto</button> }
                    </div>
                }
                <div class="ch-gexp"><Icone Nome="relogio" Tamanho="13" /> Expira em @g.Expira.ToString("dd/MM 'às' HH:mm") · criado por @E.Chat.NomePessoa(g.Criador)</div>
                <div class="ch-sec">Pessoas (@g.Membros.Count)</div>
                <div class="ch-gmembros">
                    @foreach (var id in g.Membros)
                    {
                        var nm = E.Chat.NomePessoa(id); var cc = E.Chat.Contato(id);
                        <div class="ch-gm">
                            <span class="ch-av md" style="background:@Cor(nm)">@if (cc?.Foto is { Length: > 0 } f) { <img src="@f" alt="" /> } else { @Ini(nm) }</span>
                            <span class="ch-gm-n">@nm@if (id == g.Criador) { <em>criou</em> }</span>
                            @if (criador && id != E.Chat.MeuId) { <button class="ch-x" title="Remover do grupo" @onclick="() => Remover(id)"><Icone Nome="x" Tamanho="15" /></button> }
                        </div>
                    }
                </div>
                <div class="ch-gbot">
                    <button class="btn btn-sec btn-peq" @onclick="AbrirAdicionar"><Icone Nome="mais" Tamanho="13" /> Adicionar pessoas</button>
                    @if (_confirmar)
                    {
                        <span class="ch-gconf">@(criador ? "Encerrar apaga o grupo para todos." : "Sair do grupo?")
                            <button class="btn btn-peq ch-perigo" @onclick="Sair">@(criador ? "Encerrar" : "Sair")</button>
                            <button class="btn btn-sec btn-peq" @onclick="() => _confirmar = false">Cancelar</button></span>
                    }
                    else { <button class="btn btn-sec btn-peq ch-perigo-txt" @onclick="() => _confirmar = true">@(criador ? "Encerrar grupo" : "Sair do grupo")</button> }
                </div>
                @if (_erro != "") { <div class="ch-erro">@_erro</div> }
            </div>
        }
        <div class="ch-msgs" @ref="_lista">
            @{ DateTime? diaG = null; int? antG = null; }
            @foreach (var m in E.Chat.Msgs)
            {
                if (diaG != m.Em.Date) { diaG = m.Em.Date; antG = null; <div class="ch-dia"><span>@Dia(m.Em)</span></div> }
                if (m.De == 0) { antG = null; <div class="ch-evento" @key="m.Id">@m.Texto</div> continue; }
                bool minha = m.De == E.Chat.MeuId; bool junta = antG == m.De; antG = m.De;
                var quem = E.Chat.NomePessoa(m.De);
                <div class="ch-msg @(minha ? "eu" : "ele") @(junta ? "junta" : "")" @key="m.Id">
                    @if (!minha && !junta) { <small class="ch-autor" style="color:@Cor(quem)">@quem</small> }
                    <div class="ch-bolha" title="@($"Enviada em {m.Em:dd/MM/yyyy HH:mm}")">
                        <span class="ch-texto">@m.Texto</span>
                        <span class="ch-hora">@m.Em.ToString("HH:mm")</span>
                    </div>
                </div>
            }
        </div>
        <div class="ch-escrever">
            <div class="ch-emo-w">
                <button class="ch-emo-b @(_emoji ? "on" : "")" title="Emojis" @onclick="() => _emoji = !_emoji">😊</button>
                @if (_emoji)
                {
                    <div class="ch-emo">
                        @foreach (var em in Emojis) { <button title="@em" @onclick="() => PorEmoji(em)">@em</button> }
                    </div>
                }
            </div>
            <textarea @ref="_caixa" class="campo" rows="1" placeholder="Mensagem para o grupo…" maxlength="2000" value="@_texto"
                      @oninput="e => _texto = e.Value?.ToString() ?? string.Empty" @onkeydown="Tecla" @onkeydown:preventDefault="_segurarEnter"></textarea>
            <button class="ch-enviar" title="Enviar (Enter)" disabled="@(string.IsNullOrWhiteSpace(_texto) || _enviando)" @onclick="Enviar"><Icone Nome="enviar" Tamanho="18" /></button>
        </div>
        @if (_erro != "" && !_gInfo) { <div class="ch-erro">@_erro</div> }
    }
    else if (E.Chat.Com is int com && com > 0 && E.Chat.Contato(com) is { } ct)
    {
        <div class="ch-cab conv">
            <button class="ch-x" title="Voltar para a lista" @onclick="Voltar"><Icone Nome="esquerda" Tamanho="18" /></button>
            <span class="ch-av md" style="background:@Cor(ct.Nome)">@if (ct.Foto != "") { <img src="@ct.Foto" alt="" /> } else { @Ini(ct.Nome) }
                @if (E.Chat.Online.Contains(ct.Id)) { <i class="on"></i> }</span>
            <div class="ch-cab-txt"><b>@ct.Nome</b><small class="@(E.Chat.Online.Contains(ct.Id) ? "on" : "")">@E.Chat.Status(ct.Id) · @Papel(ct.Papel)</small></div>
            <button class="ch-x" title="Fechar" @onclick="Fechar"><Icone Nome="x" Tamanho="18" /></button>
        </div>
        <div class="ch-msgs" @ref="_lista">
            @if (E.Chat.Msgs.Count == 0)
            {
                <div class="ch-vazio conv"><span class="ch-av gg" style="background:@Cor(ct.Nome)">@if (ct.Foto != "") { <img src="@ct.Foto" alt="" /> } else { @Ini(ct.Nome) }</span>
                    <b>Comece a conversa com @Primeiro(ct.Nome)</b><small>Diga um oi 👋</small></div>
            }
            @{ DateTime? dia = null; int? ant = null; }
            @foreach (var m in E.Chat.Msgs)
            {
                if (dia != m.Em.Date) { dia = m.Em.Date; ant = null; <div class="ch-dia"><span>@Dia(m.Em)</span></div> }
                bool minha = m.De != com; bool junta = ant == m.De; ant = m.De;
                var falta = m.Expira - DateTime.Now;
                <div class="ch-msg @(minha ? "eu" : "ele") @(junta ? "junta" : "")" @key="m.Id">
                    <div class="ch-bolha" title="@($"Enviada em {m.Em:dd/MM/yyyy HH:mm} · some {Some(falta)}")">
                        <span class="ch-texto">@m.Texto</span>
                        <span class="ch-hora">@m.Em.ToString("HH:mm")@if (minha) { <i class="@(m.Lida ? "lida" : "")" title="@(m.Lida ? "Lida" : "Enviada")">@(m.Lida ? "✓✓" : "✓")</i> }</span>
                    </div>
                    @if (falta.TotalHours < 12) { <small class="ch-some">some @Some(falta)</small> }
                </div>
            }
        </div>
        <div class="ch-escrever">
            <div class="ch-emo-w">
                <button class="ch-emo-b @(_emoji ? "on" : "")" title="Emojis" @onclick="() => _emoji = !_emoji">😊</button>
                @if (_emoji)
                {
                    <div class="ch-emo">
                        @foreach (var em in Emojis) { <button title="@em" @onclick="() => PorEmoji(em)">@em</button> }
                    </div>
                }
            </div>
            <textarea @ref="_caixa" class="campo" rows="1" placeholder="Escreva uma mensagem…" maxlength="2000" value="@_texto"
                      @oninput="e => _texto = e.Value?.ToString() ?? string.Empty" @onkeydown="Tecla" @onkeydown:preventDefault="_segurarEnter"></textarea>
            <button class="ch-enviar" title="Enviar (Enter)" disabled="@(string.IsNullOrWhiteSpace(_texto) || _enviando)" @onclick="Enviar"><Icone Nome="enviar" Tamanho="18" /></button>
        </div>
        @if (_erro != "") { <div class="ch-erro">@_erro</div> }
    }
    else
    {
        <div class="ch-cab">
            <span class="ch-cab-ic"><Icone Nome="conversa" Tamanho="18" /></span>
            <div class="ch-cab-txt"><b>Chat</b><small>@E.Chat.Online.Count(id => E.Chat.Contato(id) != null) online · @E.Chat.Contatos.Count pessoas</small></div>
            <button class="ch-novo" title="Criar um grupo temporário" @onclick="AbrirNovo"><Icone Nome="usuarios" Tamanho="15" /> Novo grupo</button>
            <button class="ch-x" title="Fechar" @onclick="Fechar"><Icone Nome="x" Tamanho="18" /></button>
        </div>
        @if (E.Chat.Aviso != "") { <div class="ch-aviso-g"><span>@E.Chat.Aviso</span><button class="ch-x" title="Fechar" @onclick="() => E.Chat.Aviso = string.Empty"><Icone Nome="x" Tamanho="14" /></button></div> }
        <div class="ch-busca"><Icone Nome="busca" Tamanho="15" /><input placeholder="Buscar pessoa…" @bind="_busca" @bind:event="oninput" /></div>
        <div class="ch-lista">
            @if (E.Chat.Erro != "") { <div class="ch-erro">@E.Chat.Erro</div> }
            else if (E.Chat.Contatos.Count == 0) { <p class="muted pequeno" style="padding:16px"><span class="ia-spin pequeno"></span> Carregando…</p> }
            @{ var lista = Filtrados(); var recentes = lista.Where(c => E.Chat.Conversas.ContainsKey(c.Id)).OrderByDescending(c => E.Chat.Conversas[c.Id].Em).ToList();
               var outros = lista.Except(recentes).OrderByDescending(c => E.Chat.Online.Contains(c.Id)).ThenBy(c => c.Nome).ToList(); }
            @{ var grupos = E.Chat.Grupos.Values.Where(gr => _busca == "" || QSmart.Core.Coordenacao.Ferias.Norm(gr.Nome).Contains(QSmart.Core.Coordenacao.Ferias.Norm(_busca))).OrderByDescending(gr => gr.Em).ToList(); }
            @if (grupos.Count > 0)
            {
                <div class="ch-sec">Grupos temporários</div>
                @foreach (var gr in grupos)
                {
                    <button class="ch-pessoa @(gr.NaoLidas > 0 ? "nova" : "")" @onclick="() => Abrir(-gr.Id)" @key="-gr.Id">
                        @AvGrupo(gr.Foto, "ch-av")
                        <div class="ch-p-txt">
                            <div class="ch-p-top"><b>@gr.Nome</b><small class="ch-exp" title="@($"Expira em {gr.Expira:dd/MM HH:mm}")">@Restante(gr.Expira)</small></div>
                            <div class="ch-p-sub"><span>@E.Chat.UltimaDoGrupo(gr)</span>@if (gr.NaoLidas > 0) { <em>@gr.NaoLidas</em> }</div>
                        </div>
                    </button>
                }
            }
            @if (recentes.Count > 0)
            {
                <div class="ch-sec">Conversas</div>
                @foreach (var c in recentes) { @Linha(c) }
            }
            @if (outros.Count > 0)
            {
                <div class="ch-sec">@(recentes.Count > 0 ? "Todas as pessoas" : "Pessoas no QSmart")</div>
                @foreach (var c in outros) { @Linha(c) }
            }
            @if (E.Chat.Contatos.Count > 0 && lista.Count == 0) { <p class="muted pequeno" style="padding:16px">Ninguém com esse nome.</p> }
        </div>
        <div class="ch-rodape"><Icone Nome="cadeado" Tamanho="12" /> Conversas criptografadas · apagadas depois de @E.Chat.Dias dias · grupos duram até @E.Chat.GrupoMaxDias dias</div>
    }
</div>

@code {
    [Parameter] public EventCallback AoFechar { get; set; }
    ElementReference _lista, _caixa;
    string _busca = "", _texto = "", _erro = "", _gNome = "";
    bool _novo, _adicionando, _gInfo, _confirmar, _renomear, _emoji;
    string _gFoto = "";
    static readonly string[] Emojis = ("😀 😂 🤣 😊 😍 🥰 😎 🤩 😉 🙂 🤔 😅 😬 🙄 😴 😢 😭 😡 🤯 🥳 😇 🤝 👍 👎 👏 🙌 🙏 💪 👀 ✌️ 👌 🤞 ❤️ 💙 💚 💜 🔥 ✨ 🎉 🎂 ☕ 🍕 🥐 ✅ ❌ ⚠️ 📌 📊 📈 💡 ⏰ 🚀 🏆 ⭐ 💯").Split(' ');

    RenderFragment AvGrupo(string foto, string cls) => b =>
    {
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", cls + " ch-grupo" + (foto != "" ? " com-foto" : ""));
        if (foto != "") { b.OpenElement(2, "img"); b.AddAttribute(3, "src", foto); b.AddAttribute(4, "alt", ""); b.CloseElement(); }
        else { b.OpenComponent<Icone>(5); b.AddAttribute(6, "Nome", "usuarios"); b.AddAttribute(7, "Tamanho", 18); b.CloseComponent(); }
        b.CloseElement();
    };

    async Task<string?> LerFoto(InputFileChangeEventArgs ev)
    {
        try
        {
            if (ev.File.Size > 15 * 1024 * 1024) { _erro = "Imagem grande demais (até 15 MB)."; return null; }
            using var ms = new MemoryStream();
            await ev.File.OpenReadStream(15 * 1024 * 1024).CopyToAsync(ms);
            return await E.Nav.ReduzirImagem(ms.ToArray(), 160);
        }
        catch { _erro = "Não consegui ler essa imagem."; return null; }
    }

    async Task EscolherFotoNovo(InputFileChangeEventArgs ev) { _erro = ""; if (await LerFoto(ev) is { } f) _gFoto = f; }

    async Task TrocarFotoGrupo(InputFileChangeEventArgs ev)
    {
        _erro = "";
        if (E.Chat.GrupoAberto is not { } g || await LerFoto(ev) is not { } f) return;
        _erro = await E.Chat.FotoDoGrupo(g.Id, f) ?? "";
    }

    async Task RemoverFotoGrupo()
    {
        if (E.Chat.GrupoAberto is not { } g) return;
        _erro = await E.Chat.FotoDoGrupo(g.Id, "") ?? "";
    }

    async Task PorEmoji(string em)
    {
        try { _texto = await JS.InvokeAsync<string>("qsmart.inserirNoCursor", _caixa, em); }
        catch { _texto += em; }
    }
    int _gDias = 1;
    readonly HashSet<int> _sel = new();
    bool _enviando, _segurarEnter, _rolar = true;
    int _qtdAntes;

    static readonly string[] Paleta = { "#0891B2", "#7C3AED", "#059669", "#DB2777", "#D97706", "#2563EB", "#0D9488", "#9333EA", "#DC2626", "#65A30D" };
    static string Cor(string n) { int h = 0; foreach (var ch in n) h = unchecked(h * 31 + ch); return Paleta[(int)((uint)h % Paleta.Length)]; }
    static string Ini(string n) { var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return (p.Length == 0 ? "?" : p.Length == 1 ? p[0][..1] : $"{p[0][0]}{p[^1][0]}").ToUpperInvariant(); }
    static string Primeiro(string n) => n.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? n;
    static string Papel(string p) => PerfilConta.NomePapel(p);
    static string Dia(DateTime d) => d.Date == DateTime.Today ? "Hoje" : d.Date == DateTime.Today.AddDays(-1) ? "Ontem" : d.ToString("dd/MM");
    static string Some(TimeSpan t) => t.TotalMinutes < 1 ? "em instantes" : t.TotalHours < 1 ? $"em {(int)t.TotalMinutes} min" : t.TotalHours < 24 ? $"em {(int)t.TotalHours} h" : $"em {(int)Math.Ceiling(t.TotalDays)} dias";
    static string Quando(string iso)
    {
        if (!DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var d)) return "";
        d = d.ToLocalTime();
        return d.Date == DateTime.Today ? d.ToString("HH:mm") : d.Date == DateTime.Today.AddDays(-1) ? "ontem" : d.ToString("dd/MM");
    }

    List<ContatoChat> Filtrados()
    {
        var b = QSmart.Core.Coordenacao.Ferias.Norm(_busca);
        return E.Chat.Contatos.Where(c => b == "" || QSmart.Core.Coordenacao.Ferias.Norm(c.Nome).Contains(b)).ToList();
    }

    RenderFragment Linha(ContatoChat c) => @<text>
        @{ E.Chat.Conversas.TryGetValue(c.Id, out var r); bool on = E.Chat.Online.Contains(c.Id); }
        <button class="ch-pessoa @(r?.NaoLidas > 0 ? "nova" : "")" @onclick="() => Abrir(c.Id)" @key="c.Id">
            <span class="ch-av" style="background:@Cor(c.Nome)">@if (c.Foto != "") { <img src="@c.Foto" alt="" /> } else { @Ini(c.Nome) }
                @if (on) { <i class="on"></i> }</span>
            <div class="ch-p-txt">
                <div class="ch-p-top"><b>@c.Nome</b>@if (r != null) { <small>@Quando(r.Em)</small> }</div>
                <div class="ch-p-sub">
                    @if (r != null) { <span>@(r.Minha ? "Você: " : "")@r.Ultima</span> }
                    else { <span class="@(on ? "on" : "")">@(on ? "online" : Papel(c.Papel))</span> }
                    @if (r?.NaoLidas > 0) { <em>@r.NaoLidas</em> }
                </div>
            </div>
        </button>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        E.Chat.Mudou += Atualizar;
        E.Chat.Aberto = true;
        if (E.Chat.Contatos.Count == 0) await E.Chat.CarregarContatos();
        await E.Chat.AtualizarResumo();
        if (E.Chat.Com is int c) await E.Chat.AbrirConversa(c);
    }

    void Atualizar() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool primeiro)
    {
        if (E.Chat.Com == null) return;
        if (_rolar || E.Chat.Msgs.Count != _qtdAntes)
        {
            // decide tudo antes de qualquer await (vários renders podem chegar juntos)
            int qtd = E.Chat.Msgs.Count;
            bool forcar = _rolar || _qtdAntes == 0, focar = _rolar;
            if (qtd > 0) _rolar = false; // só considera feito quando as mensagens já apareceram
            _qtdAntes = qtd;
            try { await JS.InvokeVoidAsync("qsmart.chatFim", _lista, forcar); } catch { }
            if (focar) { try { await _caixa.FocusAsync(); } catch { } }
        }
        // Enter sem Shift nunca quebra linha (a mensagem é enviada); evita sobrar texto no campo
        try { await JS.InvokeVoidAsync("qsmart.travarEnter", _caixa); } catch { }
    }

    async Task Abrir(int id)
    {
        _rolar = true; _qtdAntes = 0; _erro = ""; _texto = ""; _gInfo = false; _confirmar = false; E.Chat.Aviso = "";
        await E.Chat.AbrirConversa(id);
        _rolar = true; // mensagens carregadas: vai para a última
        StateHasChanged();
    }
    void Voltar() { E.Chat.Com = null; _texto = ""; _gInfo = false; _confirmar = false; _erro = ""; _ = E.Chat.AtualizarResumo(); }

    static string Restante(DateTime exp)
    {
        var t = exp - DateTime.Now;
        return t.TotalHours < 1 ? $"{Math.Max(1, (int)t.TotalMinutes)} min" : t.TotalHours < 24 ? $"{(int)t.TotalHours} h" : $"{(int)Math.Ceiling(t.TotalDays)} d";
    }

    void AbrirNovo() { _novo = true; _adicionando = false; _sel.Clear(); _gNome = ""; _gFoto = ""; _gDias = 1; _busca = ""; _erro = ""; E.Chat.Aviso = ""; }
    void AbrirAdicionar() { _adicionando = true; _novo = false; _sel.Clear(); _busca = ""; _erro = ""; }
    void CancelarSelecao() { _novo = false; _adicionando = false; _sel.Clear(); _busca = ""; _erro = ""; }
    void Alternar(int id) { if (!_sel.Remove(id)) _sel.Add(id); }

    async Task ConfirmarSelecao()
    {
        if (_enviando) return;
        _enviando = true; _erro = "";
        try
        {
            if (_novo)
            {
                var (erro, id) = await E.Chat.CriarGrupo(_gNome, _gDias, _sel, _gFoto);
                if (erro != null) { _erro = erro; return; }
                _novo = false; _sel.Clear(); _busca = "";
                _ = E.Conta.Registrar("chat.grupo", true);
                await Abrir(-id);
            }
            else if (E.Chat.GrupoAberto is { } g)
            {
                var erro = await E.Chat.AdicionarAoGrupo(g.Id, _sel);
                if (erro != null) { _erro = erro; return; }
                _adicionando = false; _sel.Clear(); _busca = ""; _gInfo = true; _rolar = true;
            }
        }
        finally { _enviando = false; StateHasChanged(); }
    }

    async Task Remover(int uid)
    {
        if (E.Chat.GrupoAberto is not { } g) return;
        _erro = await E.Chat.RemoverDoGrupo(g.Id, uid) ?? "";
    }

    async Task Renomear()
    {
        if (E.Chat.GrupoAberto is not { } g) return;
        var erro = await E.Chat.RenomearGrupo(g.Id, _gNome);
        _erro = erro ?? ""; if (erro == null) _renomear = false;
    }

    async Task Sair()
    {
        if (E.Chat.GrupoAberto is not { } g) return;
        var erro = await E.Chat.SairDoGrupo(g.Id);
        if (erro != null) { _erro = erro; return; }
        _gInfo = false; _confirmar = false; _erro = "";
    }
    async Task Fechar() => await AoFechar.InvokeAsync();

    void Tecla(KeyboardEventArgs e)
    {
        _segurarEnter = e.Key == "Enter" && !e.ShiftKey;
        if (_segurarEnter) _ = Enviar();
    }

    async Task Enviar()
    {
        var t = _texto;
        if (string.IsNullOrWhiteSpace(t) || _enviando) return;
        _enviando = true; _texto = ""; _erro = ""; _emoji = false;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("qsmart.limparCampo", _caixa); } catch { }
        var erro = await E.Chat.Enviar(t);
        _enviando = false;
        if (erro != null) { _erro = erro; _texto = t; }
        else { _rolar = true; _ = E.Conta.Registrar("chat.enviar", true); }
        StateHasChanged();
    }

    public void Dispose() { E.Chat.Mudou -= Atualizar; E.Chat.Aberto = false; }
}
