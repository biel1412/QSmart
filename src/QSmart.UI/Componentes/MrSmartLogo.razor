@* Mascote do Mr Smart: robozinho com as cores aurora, gravata-borboleta e antena. *@
<svg class="mr-logo" viewBox="0 0 64 64" width="@Tamanho" height="@Tamanho" aria-hidden="true">
    <defs>
        <linearGradient id="@_id" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#059669" /><stop offset=".45" stop-color="#0891B2" /><stop offset="1" stop-color="#7C3AED" />
        </linearGradient>
    </defs>
    <line x1="32" y1="8" x2="32" y2="3" stroke="#C4B5FD" stroke-width="2.4" stroke-linecap="round" />
    <circle cx="32" cy="3.2" r="2.6" fill="#FDE68A" />
    <rect x="4" y="8" width="56" height="50" rx="18" fill="url(#@_id)" />
    <rect x="12" y="18" width="40" height="26" rx="13" fill="#0B1220" opacity=".92" />
    <circle cx="24" cy="31" r="4.2" fill="#6EE7B7" /><circle cx="40" cy="31" r="4.2" fill="#6EE7B7" />
    <circle cx="25.3" cy="29.7" r="1.3" fill="#fff" /><circle cx="41.3" cy="29.7" r="1.3" fill="#fff" />
    <path d="M27 38.5q5 3.5 10 0" stroke="#A7F3D0" stroke-width="2.4" fill="none" stroke-linecap="round" />
    <path d="M24 52l8 3 8-3-8-3z" fill="#fff" opacity=".95" /><circle cx="32" cy="52" r="2" fill="#7C3AED" />
</svg>

@code {
    [Parameter] public int Tamanho { get; set; } = 40;
    readonly string _id = "mrg" + Guid.NewGuid().ToString("N")[..8];
}
